}
button.gadget-close {
    all: unset;
    min-width: 18px; min-height: 18px;
    margin: 2px 8px 0 0;
    border-radius: 9px;
    font-weight: bold;
    color: #ffffff;
    background-color: rgba(0, 0, 0, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.5);
}
button.gadget-close:hover { background-color: #c42b1c; }
textview.gadget-note, textview.gadget-note text {
    background-color: transparent;
    color: #3d3510;
    font-family: "Comic Neue", "Segoe Print", cursive, sans-serif;
    font-size: 12px;
}
#add-button {
    all: unset;
    margin: 6px 10px;
    padding: 4px 8px;
    border-radius: 4px;
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.10);
