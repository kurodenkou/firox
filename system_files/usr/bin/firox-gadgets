#!/usr/bin/python3
"""
firox-gadgets: Desktop Gadgets, a Vista-style Sidebar on the right of the
screen, on the desktop behind your windows.

    firox-gadgets            show the Sidebar (or bring up Add Gadgets if it's
                             already showing)
    firox-gadgets start      at login: show it unless it's turned off
    firox-gadgets add        the Add Gadgets gallery
    firox-gadgets hide       close the Sidebar (it stays on for next login)
    firox-gadgets off|on     turn the Sidebar off or on at login

Gadgets: Clock, Calendar, CPU Meter, Weather (Open-Meteo: free, no account),
Slide Show (your Pictures folder), Notes, Now Playing (any MPRIS music or
video player), Network Meter, Feed Headlines (RSS/Atom), Timer, Picture
Puzzle, Currency (ECB rates via frankfurter.app, no account) and Disk Space. Hover over a gadget for its ×;
right-click for Options, Remove, Add Gadgets and Hide.

Settings: ~/.config/firox/gadgets.conf (also Settings > Taskbar).
"""

import json
import math
import os
import random
import sys
import threading
import time
import urllib.parse
import urllib.request

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GdkPixbuf", "2.0")
from gi.repository import Gdk, GdkPixbuf, Gio, GLib, Gtk  # noqa: E402

try:
    gi.require_version("GtkLayerShell", "0.1")
    from gi.repository import GtkLayerShell  # noqa: E402
except (ValueError, ImportError):
    GtkLayerShell = None

sys.path.insert(0, "/usr/lib/firox/python")
import firox_monitors  # noqa: E402

try:
    import psutil  # noqa: E402
except ImportError:
    psutil = None

CONFIG = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "firox")
CONF = os.path.join(CONFIG, "gadgets.conf")
NOTES = os.path.join(CONFIG, "gadget-notes.txt")
DEFAULTS = {"ENABLED": "1", "GADGETS": "clock,calendar,cpu,weather",
            "CITY": "", "LAT": "", "LON": "", "UNITS": "C", "PICTURES": "",
            "FEED": "https://feeds.bbci.co.uk/news/world/rss.xml", "TIMER_MINUTES": "5",
            "CURRENCY_FROM": "USD", "CURRENCY_TO": "EUR", "CURRENCY_AMOUNT": "1"}
WIDTH = 170          # Sidebar gadget width
SIDEBAR = WIDTH + 24


# ----------------------------------------------------------------- config --

def load_conf():
    conf = dict(DEFAULTS)
    try:
        with open(CONF) as fh:
            for line in fh:
                if "=" in line and not line.lstrip().startswith("#"):
                    k, v = line.rstrip("\n").split("=", 1)
                    conf[k.strip()] = v.strip()
    except OSError:
        pass
    return conf


def save_conf(conf):
    os.makedirs(CONFIG, exist_ok=True)
    tmp = CONF + ".tmp"
    with open(tmp, "w") as fh:
        fh.write("# Desktop Gadgets (firox-gadgets)\n")
        for k, v in conf.items():
            fh.write(f"{k}={v}\n")
    os.replace(tmp, CONF)


# ---------------------------------------------------------------- drawing --

def rounded(cr, x, y, w, h, r):
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
    cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
    cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
    cr.close_path()


def glass(cr, x, y, w, h, r=10, top=(0.30, 0.34, 0.40), bottom=(0.08, 0.10, 0.14), alpha=0.92):
    """A glossy dark Vista-style panel."""
    import cairo
    rounded(cr, x, y, w, h, r)
    g = cairo.LinearGradient(0, y, 0, y + h)
    g.add_color_stop_rgba(0, *top, alpha)
    g.add_color_stop_rgba(1, *bottom, alpha)
    cr.set_source(g)
    cr.fill_preserve()
    cr.set_source_rgba(1, 1, 1, 0.25)
    cr.set_line_width(1)
    cr.stroke()
    # shine on the upper half
    rounded(cr, x + 2, y + 2, w - 4, h / 2 - 2, r - 2)
    s = cairo.LinearGradient(0, y, 0, y + h / 2)
    s.add_color_stop_rgba(0, 1, 1, 1, 0.22)
    s.add_color_stop_rgba(1, 1, 1, 1, 0.02)
    cr.set_source(s)
    cr.fill()


def text(cr, s, x, y, size, rgba=(1, 1, 1, 1), bold=False, center=False, shadow=True):
    import cairo
    cr.select_font_face("Sans", cairo.FONT_SLANT_NORMAL,
                        cairo.FONT_WEIGHT_BOLD if bold else cairo.FONT_WEIGHT_NORMAL)
    cr.set_font_size(size)
    ext = cr.text_extents(s)
    if center:
        x -= ext.width / 2 + ext.x_bearing
    cr.new_path()
    if shadow:              # soft shadow under light text
        cr.set_source_rgba(0, 0, 0, 0.6 * rgba[3])
        cr.move_to(x + 1, y + 1)
        cr.show_text(s)
    cr.set_source_rgba(*rgba)
    cr.move_to(x, y)
    cr.show_text(s)
    return ext


# ---------------------------------------------------------------- gadgets --

class Gadget(Gtk.EventBox):
    """A gadget: a cairo-drawn tile with a hover ×, and a right-click menu."""

    KEY = ""
    TITLE = ""
    DESCRIPTION = ""
    ICON = "application-x-executable"
    HEIGHT = 150
    INTERVAL = 0              # seconds between redraws (0: none)

    def __init__(self, sidebar):
        super().__init__()
        self.sidebar = sidebar
        self.set_visible_window(False)
        self.add_events(Gdk.EventMask.ENTER_NOTIFY_MASK | Gdk.EventMask.LEAVE_NOTIFY_MASK
                        | Gdk.EventMask.BUTTON_PRESS_MASK)
        overlay = Gtk.Overlay()
        self.area = Gtk.DrawingArea()
        self.area.set_size_request(WIDTH, self.HEIGHT)
        self.area.connect("draw", lambda _w, cr: self.draw(cr, WIDTH, self.HEIGHT) or False)
        # The drawing area has its own window: clicks and hovering must be
        # taken there, or they never reach the gadget
        self.area.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.ENTER_NOTIFY_MASK
                             | Gdk.EventMask.LEAVE_NOTIFY_MASK)
        self.area.connect("button-press-event", self.on_press)
        self.area.connect("enter-notify-event", lambda *_: self.close.show() or False)
        self.area.connect("leave-notify-event", self.on_leave)
        overlay.add(self.area)
        self.close = Gtk.Button(label="×")
        self.close.get_style_context().add_class("gadget-close")
        self.close.set_halign(Gtk.Align.END)
        self.close.set_valign(Gtk.Align.START)
        self.close.set_tooltip_text("Close gadget")
        self.close.set_no_show_all(True)
        self.close.connect("clicked", lambda _b: sidebar.remove_gadget(self))
        overlay.add_overlay(self.close)
        self.add(overlay)
        self.connect("enter-notify-event", lambda *_: self.close.show() or False)
        self.connect("leave-notify-event", self.on_leave)
        self.connect("button-press-event", self.on_press)
        self.set_tooltip_text(self.TITLE)
        self.timer = None
        if self.INTERVAL:
            self.timer = GLib.timeout_add(int(self.INTERVAL * 1000), self.tick)
        self.connect("destroy", lambda *_: self.timer and GLib.source_remove(self.timer))

    def tick(self):
        self.area.queue_draw()
        return True

    def on_leave(self, _w, event):
        # Moving onto the × (or the note) isn't leaving the gadget
        x, y = self.translate_coordinates(self.get_toplevel(), 0, 0)
        alloc = self.get_allocation()
        px, py = event.x_root, event.y_root
        win = self.get_toplevel().get_window()
        if win is not None:
            ox, oy = win.get_origin()[1:]
            px, py = px - ox, py - oy
        if not (x <= px < x + alloc.width and y <= py < y + alloc.height):
            self.close.hide()
        return False

    def on_press(self, _w, event):
        if event.type != Gdk.EventType.BUTTON_PRESS:
            return False
        if event.button == 3:
            self.sidebar.gadget_menu(self, event)
            return True
        if event.button == 1:
            if _w is self.area:
                return bool(self.clicked_at(event.x, event.y))
            return bool(self.clicked())
        return False

    def clicked_at(self, x, y):
        """A left click at (x, y) on the gadget; by default, clicked()."""
        return self.clicked()

    def clicked(self):
        return False

    def options(self):
        """Show an options dialog; None if the gadget has none."""
        return None

    def draw(self, cr, w, h):
        pass


class Clock(Gadget):
    KEY, TITLE, ICON = "clock", "Clock", "preferences-system-time"
    DESCRIPTION = "The time, on a classic clock face."
    HEIGHT, INTERVAL = 170, 1

    def draw(self, cr, w, h):
        import cairo
        cx, cy, r = w / 2, 80, 70
        # face
        g = cairo.RadialGradient(cx - 20, cy - 25, 5, cx, cy, r)
        g.add_color_stop_rgb(0, 1, 1, 1)
        g.add_color_stop_rgb(1, 0.80, 0.84, 0.90)
        cr.arc(cx, cy, r, 0, 2 * math.pi)
        cr.set_source(g)
        cr.fill_preserve()
        cr.set_line_width(5)
        rim = cairo.LinearGradient(0, cy - r, 0, cy + r)
        rim.add_color_stop_rgb(0, 0.55, 0.60, 0.68)
        rim.add_color_stop_rgb(1, 0.15, 0.17, 0.22)
        cr.set_source(rim)
        cr.stroke()
        # marks
        for i in range(60):
            a = i * math.pi / 30
            inner = r - (12 if i % 5 == 0 else 7)
            cr.set_line_width(2.5 if i % 5 == 0 else 1)
            cr.set_source_rgb(0.15, 0.17, 0.22)
            cr.move_to(cx + inner * math.sin(a), cy - inner * math.cos(a))
            cr.line_to(cx + (r - 4) * math.sin(a), cy - (r - 4) * math.cos(a))
            cr.stroke()
        now = time.localtime()
        secs = now.tm_sec
        mins = now.tm_min + secs / 60
        hours = (now.tm_hour % 12) + mins / 60

        def hand(angle, length, width, rgb):
            cr.set_line_width(width)
            cr.set_line_cap(cairo.LINE_CAP_ROUND)
            cr.set_source_rgb(*rgb)
            cr.move_to(cx - 8 * math.sin(angle), cy + 8 * math.cos(angle))
            cr.line_to(cx + length * math.sin(angle), cy - length * math.cos(angle))
            cr.stroke()
        hand(hours * math.pi / 6, r * 0.5, 5, (0.12, 0.14, 0.18))
        hand(mins * math.pi / 30, r * 0.75, 3.5, (0.12, 0.14, 0.18))
        hand(secs * math.pi / 30, r * 0.82, 1.5, (0.80, 0.12, 0.10))
        cr.arc(cx, cy, 4, 0, 2 * math.pi)
        cr.set_source_rgb(0.80, 0.12, 0.10)
        cr.fill()
        text(cr, time.strftime("%A", now), cx, 166, 11, center=True)

    def clicked(self):
        spawn(["firox-calendar", "toggle"])
        return True


class Calendar(Gadget):
    KEY, TITLE, ICON = "calendar", "Calendar", "x-office-calendar"
    DESCRIPTION = "Today's date, like a page torn from a desk calendar."
    HEIGHT, INTERVAL = 150, 60

    def draw(self, cr, w, h):
        import cairo
        now = time.localtime()
        x, y, pw, ph = 18, 6, w - 36, h - 12
        # paper
        rounded(cr, x, y, pw, ph, 8)
        cr.set_source_rgb(0.98, 0.98, 0.98)
        cr.fill()
        # red header with the month
        rounded(cr, x, y, pw, 34, 8)
        g = cairo.LinearGradient(0, y, 0, y + 34)
        g.add_color_stop_rgb(0, 0.86, 0.22, 0.18)
        g.add_color_stop_rgb(1, 0.62, 0.08, 0.06)
        cr.set_source(g)
        cr.fill()
        cr.rectangle(x, y + 26, pw, 8)
        cr.set_source(g)
        cr.fill()
        text(cr, time.strftime("%B", now), w / 2, y + 23, 15, bold=True, center=True)
        text(cr, str(now.tm_mday), w / 2, y + 96, 54, rgba=(0.15, 0.15, 0.18, 1), bold=True, center=True,
             shadow=False)
        text(cr, time.strftime("%A", now), w / 2, y + 122, 13, rgba=(0.35, 0.35, 0.40, 1), center=True,
             shadow=False)
        cr.set_source_rgba(0, 0, 0, 0.25)
        rounded(cr, x, y, pw, ph, 8)
        cr.set_line_width(1)
        cr.stroke()

    def clicked(self):
        spawn(["firox-calendar", "toggle"])
        return True


class CpuMeter(Gadget):
    KEY, TITLE, ICON = "cpu", "CPU Meter", "utilities-system-monitor"
    DESCRIPTION = "How busy the processor is and how much memory is in use."
    HEIGHT, INTERVAL = 120, 1.5

    def __init__(self, sidebar):
        self.cpu = self.mem = 0.0
        if psutil:
            psutil.cpu_percent(None)
        super().__init__(sidebar)

    def tick(self):
        if psutil:
            self.cpu = psutil.cpu_percent(None)
            self.mem = psutil.virtual_memory().percent
        return super().tick()

    def dial(self, cr, cx, cy, r, value, label):
        import cairo
        cr.new_path()
        cr.arc(cx, cy, r, 0, 2 * math.pi)
        g = cairo.RadialGradient(cx - r / 3, cy - r / 3, 2, cx, cy, r)
        g.add_color_stop_rgb(0, 0.30, 0.32, 0.36)
        g.add_color_stop_rgb(1, 0.05, 0.06, 0.08)
        cr.set_source(g)
        cr.fill_preserve()
        cr.set_source_rgb(0.65, 0.68, 0.72)
        cr.set_line_width(3)
        cr.stroke()
        start, end = math.radians(135), math.radians(405)
        for i in range(11):
            a = start + (end - start) * i / 10
            cr.set_source_rgb(0.9, 0.3, 0.2) if i >= 8 else cr.set_source_rgb(0.85, 0.85, 0.85)
            cr.set_line_width(1.5)
            cr.move_to(cx + (r - 9) * math.cos(a), cy + (r - 9) * math.sin(a))
            cr.line_to(cx + (r - 4) * math.cos(a), cy + (r - 4) * math.sin(a))
            cr.stroke()
        a = start + (end - start) * min(100, value) / 100
        cr.set_source_rgb(0.95, 0.35, 0.15)
        cr.set_line_width(2.5)
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        cr.move_to(cx, cy)
        cr.line_to(cx + (r - 8) * math.cos(a), cy + (r - 8) * math.sin(a))
        cr.stroke()
        cr.arc(cx, cy, 3.5, 0, 2 * math.pi)
        cr.set_source_rgb(0.8, 0.8, 0.8)
        cr.fill()
        text(cr, f"{value:.0f}%", cx, cy + r * 0.62, 11, bold=True, center=True)
        text(cr, label, cx, cy + r + 16, 10, rgba=(0.85, 0.88, 0.95, 1), center=True)

    def draw(self, cr, w, h):
        glass(cr, 4, 4, w - 8, h - 8)
        self.dial(cr, 50, 52, 36, self.cpu, "CPU")
        self.dial(cr, w - 50, 52, 36, self.mem, "Memory")

    def clicked(self):
        spawn(["firox-taskmgr", "performance"])
        return True


WMO = {  # Open-Meteo weather codes -> (description, icon)
    0: ("Clear", "weather-clear"), 1: ("Mostly clear", "weather-few-clouds"),
    2: ("Partly cloudy", "weather-few-clouds"), 3: ("Cloudy", "weather-overcast"),
    45: ("Fog", "weather-fog"), 48: ("Fog", "weather-fog"),
    51: ("Drizzle", "weather-showers-scattered"), 53: ("Drizzle", "weather-showers-scattered"),
    55: ("Drizzle", "weather-showers-scattered"), 56: ("Freezing drizzle", "weather-freezing-rain"),
    57: ("Freezing drizzle", "weather-freezing-rain"), 61: ("Light rain", "weather-showers-scattered"),
    63: ("Rain", "weather-showers"), 65: ("Heavy rain", "weather-showers"),
    66: ("Freezing rain", "weather-freezing-rain"), 67: ("Freezing rain", "weather-freezing-rain"),
    71: ("Light snow", "weather-snow"), 73: ("Snow", "weather-snow"), 75: ("Heavy snow", "weather-snow"),
    77: ("Snow grains", "weather-snow"), 80: ("Showers", "weather-showers-scattered"),
    81: ("Showers", "weather-showers"), 82: ("Heavy showers", "weather-showers"),
    85: ("Snow showers", "weather-snow"), 86: ("Snow showers", "weather-snow"),
    95: ("Thunderstorm", "weather-storm"), 96: ("Thunderstorm", "weather-storm"),
    99: ("Thunderstorm", "weather-storm"),
}


# Weather service (override for a self-hosted Open-Meteo, or for testing)
OPEN_METEO = os.environ.get("FIROX_OPEN_METEO", "https://api.open-meteo.com").rstrip("/")
OPEN_METEO_GEO = os.environ.get("FIROX_OPEN_METEO_GEOCODING", "https://geocoding-api.open-meteo.com").rstrip("/")


def fetch_json(url):
    req = urllib.request.Request(url, headers={"User-Agent": "firox-gadgets"})
    with urllib.request.urlopen(req, timeout=15) as resp:
        return json.loads(resp.read().decode())


class Weather(Gadget):
    KEY, TITLE, ICON = "weather", "Weather", "weather-few-clouds"
    DESCRIPTION = "Current weather and today's high and low (Open-Meteo)."
    HEIGHT = 130

    def __init__(self, sidebar):
        self.data = None
        self.error = ""
        super().__init__(sidebar)
        self.fetch()
        self.timer = GLib.timeout_add_seconds(1800, lambda: self.fetch() or True)

    def fetch(self):
        conf = self.sidebar.conf
        if not (conf.get("LAT") and conf.get("LON")):
            self.data, self.error = None, ""
            self.area.queue_draw()
            return
        units = "fahrenheit" if conf.get("UNITS") == "F" else "celsius"
        url = (OPEN_METEO + "/v1/forecast?" + urllib.parse.urlencode({
            "latitude": conf["LAT"], "longitude": conf["LON"], "temperature_unit": units,
            "current": "temperature_2m,weather_code,is_day",
            "daily": "temperature_2m_max,temperature_2m_min", "timezone": "auto", "forecast_days": 1}))

        def work():
            try:
                data, err = fetch_json(url), ""
            except Exception as e:  # noqa: BLE001 - offline, DNS, HTTP...
                data, err = None, "Can't get the weather right now"
                print(f"gadgets: weather: {e}", file=sys.stderr)
            GLib.idle_add(self.got, data, err)
        threading.Thread(target=work, daemon=True).start()

    def got(self, data, err):
        if data is not None or not self.data:
            self.data, self.error = data, err
        self.area.queue_draw()
        return False

    def draw(self, cr, w, h):
        glass(cr, 4, 4, w - 8, h - 8, top=(0.22, 0.45, 0.78), bottom=(0.06, 0.20, 0.45))
        conf = self.sidebar.conf
        if not conf.get("LAT"):
            text(cr, "Weather", w / 2, 50, 15, bold=True, center=True)
            text(cr, "Click to choose", w / 2, 78, 11, center=True)
            text(cr, "your city", w / 2, 94, 11, center=True)
            return
        city = conf.get("CITY") or "Weather"
        text(cr, city[:22], w / 2, 24, 11, rgba=(0.9, 0.95, 1, 1), center=True)
        if self.data is None:
            text(cr, self.error or "Loading…", w / 2, 72, 11, center=True)
            return
        cur = self.data.get("current", {})
        daily = self.data.get("daily", {})
        code = int(cur.get("weather_code", 0))
        desc, icon = WMO.get(code, ("", "weather-few-clouds"))
        if not cur.get("is_day", 1) and icon in ("weather-clear", "weather-few-clouds"):
            icon += "-night"
        theme = Gtk.IconTheme.get_default()
        if not theme.has_icon(icon):
            icon = "weather-few-clouds" if theme.has_icon("weather-few-clouds") else "image-missing"
        try:
            pb = theme.load_icon(icon, 56, Gtk.IconLookupFlags.FORCE_SIZE)
            Gdk.cairo_set_source_pixbuf(cr, pb, 14, 32)
            cr.paint()
        except GLib.Error:
            pass
        unit = "°F" if conf.get("UNITS") == "F" else "°C"
        temp = cur.get("temperature_2m")
        if temp is not None:
            text(cr, f"{round(temp)}{unit}", 118, 72, 26, bold=True, center=True)
        text(cr, desc, w / 2, 104, 11, center=True)
        try:
            hi, lo = round(daily["temperature_2m_max"][0]), round(daily["temperature_2m_min"][0])
            text(cr, f"H {hi}°  L {lo}°", w / 2, 118, 10, rgba=(0.85, 0.9, 1, 1), center=True)
        except (KeyError, IndexError, TypeError):
            pass

    def clicked(self):
        self.options()
        return True

    def options(self):
        dlg = Gtk.Dialog(title="Weather Options", modal=True)
        dlg.add_button("Cancel", Gtk.ResponseType.CANCEL)
        dlg.add_button("OK", Gtk.ResponseType.OK)
        dlg.set_default_response(Gtk.ResponseType.OK)
        box = dlg.get_content_area()
        box.set_spacing(8)
        box.set_border_width(14)
        conf = self.sidebar.conf
        box.pack_start(Gtk.Label(label="Your city:", xalign=0), False, False, 0)
        entry = Gtk.Entry(text=conf.get("CITY", ""), activates_default=True)
        entry.set_placeholder_text("e.g. London or Springfield, Illinois")
        box.pack_start(entry, False, False, 0)
        f = Gtk.RadioButton.new_with_label(None, "Fahrenheit (°F)")
        c = Gtk.RadioButton.new_with_label_from_widget(f, "Celsius (°C)")
        (f if conf.get("UNITS") == "F" else c).set_active(True)
        row = Gtk.Box(spacing=12)
        row.pack_start(c, False, False, 0)
        row.pack_start(f, False, False, 0)
        box.pack_start(row, False, False, 0)
        note = Gtk.Label(xalign=0, wrap=True, max_width_chars=40)
        note.set_markup("<small>Weather from Open-Meteo.com. Only the city's position is sent.</small>")
        box.pack_start(note, False, False, 0)
        status = Gtk.Label(xalign=0)
        box.pack_start(status, False, False, 0)
        dlg.show_all()
        while dlg.run() == Gtk.ResponseType.OK:
            name = entry.get_text().strip()
            conf["UNITS"] = "F" if f.get_active() else "C"
            if not name:
                conf.update(CITY="", LAT="", LON="")
                break
            if name == conf.get("CITY") and conf.get("LAT"):
                break
            status.set_text("Looking it up…")
            while Gtk.events_pending():
                Gtk.main_iteration()
            place = self.geocode(name)
            if place is None:
                status.set_text("Couldn't find that place (or you're offline). Try another name.")
                continue
            conf.update(CITY=place[0], LAT=str(place[1]), LON=str(place[2]))
            break
        dlg.destroy()
        save_conf(conf)
        self.fetch()
        return True

    @staticmethod
    def geocode(name):
        # "Springfield, Illinois": search the first part, prefer the region
        parts = [p.strip() for p in name.split(",")]
        try:
            res = fetch_json(OPEN_METEO_GEO + "/v1/search?" + urllib.parse.urlencode(
                {"name": parts[0], "count": 10, "language": "en", "format": "json"})).get("results") or []
        except Exception as e:  # noqa: BLE001
            print(f"gadgets: geocoding: {e}", file=sys.stderr)
            return None
        if not res:
            return None
        if len(parts) > 1:
            want = parts[1].lower()
            res = [r for r in res if want in (r.get("admin1", "") + " " + r.get("country", "")).lower()] or res
        r = res[0]
        label = r.get("name", parts[0])
        if r.get("admin1") and r.get("admin1") != label:
            label += ", " + r["admin1"]
        return label, r["latitude"], r["longitude"]


class SlideShow(Gadget):
    KEY, TITLE, ICON = "slideshow", "Slide Show", "image-x-generic"
    DESCRIPTION = "Pictures from your Pictures folder, one after another."
    HEIGHT, INTERVAL = 125, 10

    EXTS = (".jpg", ".jpeg", ".png", ".webp", ".bmp", ".gif")

    def __init__(self, sidebar):
        self.files = []
        self.current = None
        self.pixbuf = None
        super().__init__(sidebar)
        self.scan()
        self.next_picture()

    def folder(self):
        conf = self.sidebar.conf
        if conf.get("PICTURES"):
            return conf["PICTURES"]
        return GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_PICTURES) or os.path.expanduser("~/Pictures")

    def scan(self):
        files = []
        for top in (self.folder(), "/usr/share/backgrounds/firox"):
            for root, _dirs, names in os.walk(top):
                files += [os.path.join(root, n) for n in names if n.lower().endswith(self.EXTS)]
                if len(files) > 2000:
                    break
            if files:
                break
        self.files = files

    def tick(self):
        if random.random() < 0.05:
            self.scan()
        self.next_picture()
        return super().tick()

    def next_picture(self):
        if not self.files:
            self.pixbuf = None
            return
        choices = [f for f in self.files if f != self.current] or self.files
        self.current = random.choice(choices)
        try:
            self.pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(self.current, WIDTH - 20, self.HEIGHT - 20, True)
        except GLib.Error:
            self.pixbuf = None

    def draw(self, cr, w, h):
        glass(cr, 4, 4, w - 8, h - 8, top=(0.15, 0.15, 0.17), bottom=(0.02, 0.02, 0.03))
        if self.pixbuf is None:
            text(cr, "No pictures yet", w / 2, h / 2 - 4, 11, center=True)
            text(cr, "Add some to Pictures", w / 2, h / 2 + 12, 10, rgba=(0.8, 0.8, 0.85, 1), center=True)
            return
        pw, ph = self.pixbuf.get_width(), self.pixbuf.get_height()
        x, y = (w - pw) / 2, (h - ph) / 2
        Gdk.cairo_set_source_pixbuf(cr, self.pixbuf, x, y)
        cr.paint()
        cr.rectangle(x - 0.5, y - 0.5, pw + 1, ph + 1)
        cr.set_source_rgba(1, 1, 1, 0.6)
        cr.set_line_width(1)
        cr.stroke()

    def clicked(self):
        if self.current:
            try:
                Gio.AppInfo.launch_default_for_uri(Gio.File.new_for_path(self.current).get_uri(), None)
            except GLib.Error:
                pass
        return True

    def options(self):
        dlg = Gtk.FileChooserDialog(title="Show pictures from", action=Gtk.FileChooserAction.SELECT_FOLDER)
        dlg.add_button("Cancel", Gtk.ResponseType.CANCEL)
        dlg.add_button("Choose", Gtk.ResponseType.OK)
        dlg.set_current_folder(self.folder())
        if dlg.run() == Gtk.ResponseType.OK and dlg.get_filename():
            self.sidebar.conf["PICTURES"] = dlg.get_filename()
            save_conf(self.sidebar.conf)
            self.scan()
            self.next_picture()
            self.area.queue_draw()
        dlg.destroy()
        return True


class Notes(Gadget):
    KEY, TITLE, ICON = "notes", "Notes", "accessories-text-editor"
    DESCRIPTION = "A sticky note for reminders. Saved as you type."
    HEIGHT = 150

    def __init__(self, sidebar):
        super().__init__(sidebar)
        overlay = self.get_child()
        self.area.set_size_request(WIDTH, self.HEIGHT)
        self.view = Gtk.TextView(wrap_mode=Gtk.WrapMode.WORD_CHAR)
        self.view.get_style_context().add_class("gadget-note")
        self.view.set_left_margin(8)
        self.view.set_right_margin(8)
        self.view.set_top_margin(10)
        try:
            with open(NOTES) as fh:
                self.view.get_buffer().set_text(fh.read())
        except OSError:
            self.view.get_buffer().set_text("Click here to write a note.")
        self.view.set_margin_start(14)
        self.view.set_margin_end(14)
        self.view.set_margin_top(8)
        self.view.set_margin_bottom(8)
        overlay.add_overlay(self.view)
        overlay.reorder_overlay(self.close, -1)
        self.save_timer = None
        self.view.get_buffer().connect("changed", self.on_changed)

    def on_changed(self, _buf):
        if self.save_timer:
            GLib.source_remove(self.save_timer)
        self.save_timer = GLib.timeout_add(800, self.save)

    def save(self):
        self.save_timer = None
        buf = self.view.get_buffer()
        os.makedirs(CONFIG, exist_ok=True)
        with open(NOTES, "w") as fh:
            fh.write(buf.get_text(buf.get_start_iter(), buf.get_end_iter(), False))
        return False

    def draw(self, cr, w, h):
        import cairo
        x, y, pw, ph = 12, 6, w - 24, h - 12
        cr.set_source_rgba(0, 0, 0, 0.3)
        cr.rectangle(x + 3, y + 3, pw, ph)
        cr.fill()
        g = cairo.LinearGradient(0, y, 0, y + ph)
        g.add_color_stop_rgb(0, 1.0, 0.97, 0.62)
        g.add_color_stop_rgb(1, 0.98, 0.90, 0.45)
        cr.rectangle(x, y, pw, ph)
        cr.set_source(g)
        cr.fill()


# ------------------------------------------------------- more gadgets --

def icon_pixbuf(name, size):
    theme = Gtk.IconTheme.get_default()
    try:
        return theme.load_icon(name, size, Gtk.IconLookupFlags.FORCE_SIZE)
    except GLib.Error:
        return None


def paint_icon(cr, name, x, y, size, alpha=1.0):
    pb = icon_pixbuf(name, size)
    if pb is not None:
        Gdk.cairo_set_source_pixbuf(cr, pb, x, y)
        cr.paint_with_alpha(alpha)


def fit_text(cr, s, size, width, bold=False):
    """s shortened with … to fit width at that font size."""
    import cairo
    cr.select_font_face("Sans", cairo.FONT_SLANT_NORMAL,
                        cairo.FONT_WEIGHT_BOLD if bold else cairo.FONT_WEIGHT_NORMAL)
    cr.set_font_size(size)
    if cr.text_extents(s).x_advance <= width:
        return s
    while s and cr.text_extents(s + "…").x_advance > width:
        s = s[:-1]
    return s.rstrip() + "…"


def wrap_lines(cr, s, size, width, lines, bold=False):
    """Up to `lines` lines of s wrapped to width (the last one shortened)."""
    import cairo
    cr.select_font_face("Sans", cairo.FONT_SLANT_NORMAL,
                        cairo.FONT_WEIGHT_BOLD if bold else cairo.FONT_WEIGHT_NORMAL)
    cr.set_font_size(size)
    words, out, cur = s.split(), [], ""
    for word in words:
        test = (cur + " " + word).strip()
        if cr.text_extents(test).x_advance <= width or not cur:
            cur = test
        else:
            out.append(cur)
            cur = word
            if len(out) == lines:
                break
    if cur and len(out) < lines:
        out.append(cur)
    if len(out) == lines and " ".join(out) != " ".join(words):
        out[-1] = fit_text(cr, out[-1] + " …", size, width, bold)
    return out


def ask_value(title, label, value, hint=""):
    """A small dialog with one text box; the text, or None if cancelled."""
    dlg = Gtk.Dialog(title=title, modal=True)
    dlg.add_button("Cancel", Gtk.ResponseType.CANCEL)
    dlg.add_button("OK", Gtk.ResponseType.OK)
    dlg.set_default_response(Gtk.ResponseType.OK)
    box = dlg.get_content_area()
    box.set_spacing(8)
    box.set_border_width(14)
    box.pack_start(Gtk.Label(label=label, xalign=0), False, False, 0)
    entry = Gtk.Entry(text=value, activates_default=True)
    entry.set_width_chars(40)
    box.pack_start(entry, False, False, 0)
    if hint:
        note = Gtk.Label(xalign=0, wrap=True, max_width_chars=48)
        note.set_markup(f"<small>{hint}</small>")
        box.pack_start(note, False, False, 0)
    dlg.show_all()
    answer = entry.get_text().strip() if dlg.run() == Gtk.ResponseType.OK else None
    dlg.destroy()
    return answer


class NowPlaying(Gadget):
    """The song (or video) playing in any MPRIS player, with buttons."""
    KEY, TITLE, ICON = "nowplaying", "Now Playing", "multimedia-audio-player"
    DESCRIPTION = "What's playing in your music or video player, with play, pause, next and previous."
    HEIGHT, INTERVAL = 118, 2

    BUTTONS = {"prev": (34, 94), "play": (85, 94), "next": (136, 94)}

    def __init__(self, sidebar):
        self.player = None
        self.status = "Stopped"
        self.title = self.artist = ""
        self.art_url = ""
        self.art = None
        self.art_cache = {}
        try:
            self.bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        except GLib.Error:
            self.bus = None
        super().__init__(sidebar)
        self.tick()

    def call(self, name, path, iface, method, args=None, reply=None):
        return self.bus.call_sync(name, path, iface, method, args,
                                  GLib.VariantType.new(reply) if reply else None,
                                  Gio.DBusCallFlags.NONE, 1500, None)

    def players(self):
        try:
            names = self.call("org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus",
                              "ListNames", reply="(as)").unpack()[0]
        except (GLib.Error, AttributeError):
            return []
        return sorted(n for n in names if n.startswith("org.mpris.MediaPlayer2."))

    def prop(self, name, key):
        try:
            return self.call(name, "/org/mpris/MediaPlayer2", "org.freedesktop.DBus.Properties", "Get",
                             GLib.Variant("(ss)", ("org.mpris.MediaPlayer2.Player", key)),
                             reply="(v)").unpack()[0]
        except GLib.Error:
            return None

    def tick(self):
        if self.bus is None:
            return super().tick()
        found = None
        for name in self.players():
            status = self.prop(name, "PlaybackStatus") or "Stopped"
            if found is None or (status == "Playing" and found[1] != "Playing"):
                found = (name, status)
        if found is None:
            self.player, self.status, self.title, self.artist, self.art = None, "Stopped", "", "", None
            return super().tick()
        self.player, self.status = found
        meta = self.prop(self.player, "Metadata") or {}
        self.title = str(meta.get("xesam:title") or "")
        artist = meta.get("xesam:artist") or ""
        self.artist = ", ".join(artist) if isinstance(artist, list) else str(artist)
        if not self.title:
            url = str(meta.get("xesam:url") or "")
            self.title = urllib.parse.unquote(os.path.basename(url)) if url else "Playing"
        art = str(meta.get("mpris:artUrl") or "")
        if art != self.art_url:
            self.art_url = art
            self.load_art(art)
        return super().tick()

    def load_art(self, url):
        self.art = self.art_cache.get(url)
        if self.art is not None or not url:
            return

        def work():
            pix = None
            try:
                if url.startswith("file://"):
                    pix = GdkPixbuf.Pixbuf.new_from_file_at_scale(urllib.parse.unquote(url[7:]), 52, 52, True)
                elif url.startswith(("http://", "https://")):
                    req = urllib.request.Request(url, headers={"User-Agent": "firox-gadgets"})
                    with urllib.request.urlopen(req, timeout=10) as resp:
                        loader = GdkPixbuf.PixbufLoader()
                        loader.write(resp.read())
                        loader.close()
                        pix = loader.get_pixbuf().scale_simple(52, 52, GdkPixbuf.InterpType.BILINEAR)
            except Exception as e:  # noqa: BLE001
                print(f"gadgets: cover art: {e}", file=sys.stderr)
            GLib.idle_add(self.got_art, url, pix)
        threading.Thread(target=work, daemon=True).start()

    def got_art(self, url, pix):
        self.art_cache[url] = pix
        if url == self.art_url:
            self.art = pix
            self.area.queue_draw()
        return False

    def draw(self, cr, w, h):
        glass(cr, 4, 4, w - 8, h - 8, top=(0.30, 0.22, 0.42), bottom=(0.10, 0.06, 0.16))
        if self.player is None:
            paint_icon(cr, "multimedia-audio-player", w / 2 - 20, 18, 40, 0.8)
            text(cr, "Nothing playing", w / 2, 78, 11, center=True)
            text(cr, "Start some music", w / 2, 94, 9, rgba=(0.8, 0.8, 0.9, 1), center=True)
            return
        if self.art is not None:
            Gdk.cairo_set_source_pixbuf(cr, self.art, 12, 12)
            cr.paint()
        else:
            paint_icon(cr, "audio-x-generic", 12, 12, 52)
        x = 70
        lines = wrap_lines(cr, self.title, 11, w - x - 10, 2, bold=True)
        for i, line in enumerate(lines):
            text(cr, line, x, 28 + 15 * i, 11, bold=True)
        text(cr, fit_text(cr, self.artist, 10, w - x - 10), x, 28 + 15 * len(lines) + 2, 10,
             rgba=(0.82, 0.82, 0.95, 1))
        for key, (bx, by) in self.BUTTONS.items():
            icon = {"prev": "media-skip-backward", "next": "media-skip-forward",
                    "play": "media-playback-pause" if self.status == "Playing" else "media-playback-start"}[key]
            r = 15 if key == "play" else 12
            cr.new_path()
            cr.arc(bx, by, r, 0, 2 * math.pi)
            cr.set_source_rgba(1, 1, 1, 0.16 if key == "play" else 0.08)
            cr.fill()
            size = 20 if key == "play" else 16
            paint_icon(cr, icon, bx - size / 2, by - size / 2, size)

    def clicked_at(self, x, y):
        if self.player is None:
            return True
        for key, (bx, by) in self.BUTTONS.items():
            if (x - bx) ** 2 + (y - by) ** 2 <= 17 ** 2:
                method = {"prev": "Previous", "next": "Next", "play": "PlayPause"}[key]
                try:
                    self.call(self.player, "/org/mpris/MediaPlayer2", "org.mpris.MediaPlayer2.Player", method)
                except GLib.Error as err:
                    print(f"gadgets: {method}: {err.message}", file=sys.stderr)
                GLib.timeout_add(300, lambda: self.tick() and False)
                return True
        # Elsewhere: bring the player's window up
        try:
            self.call(self.player, "/org/mpris/MediaPlayer2", "org.mpris.MediaPlayer2", "Raise")
        except GLib.Error:
            pass
        return True


class NetworkMeter(Gadget):
    KEY, TITLE, ICON = "network", "Network Meter", "network-transmit-receive"
    DESCRIPTION = "How fast you're downloading and uploading right now."
    HEIGHT, INTERVAL = 112, 1

    def __init__(self, sidebar):
        self.last = None
        self.down = self.up = 0.0
        self.history = [(0.0, 0.0)] * 60
        super().__init__(sidebar)
        self.tick()

    @staticmethod
    def counters():
        rx = tx = 0
        try:
            with open("/proc/net/dev") as fh:
                for line in fh.readlines()[2:]:
                    name, data = line.split(":", 1)
                    name = name.strip()
                    if name == "lo" or name.startswith(("veth", "docker", "br-", "virbr", "waydroid")):
                        continue
                    f = data.split()
                    rx += int(f[0])
                    tx += int(f[8])
        except (OSError, ValueError, IndexError):
            pass
        return rx, tx, time.monotonic()

    def tick(self):
        now = self.counters()
        if self.last is not None and now[2] > self.last[2]:
            dt = now[2] - self.last[2]
            self.down = max(0, now[0] - self.last[0]) / dt
            self.up = max(0, now[1] - self.last[1]) / dt
            self.history = self.history[1:] + [(self.down, self.up)]
        self.last = now
        return super().tick()

    @staticmethod
    def speed(n):
        for unit in ("B/s", "KB/s", "MB/s", "GB/s"):
            if n < 1000 or unit == "GB/s":
                return f"{n:.0f} {unit}" if unit == "B/s" else f"{n:.1f} {unit}"
            n /= 1024

    def draw(self, cr, w, h):
        glass(cr, 4, 4, w - 8, h - 8, top=(0.16, 0.36, 0.34), bottom=(0.04, 0.12, 0.12))
        def arrow(x, y, down, rgb):
            cr.new_path()
            if down:
                cr.move_to(x, y - 9); cr.line_to(x + 10, y - 9); cr.line_to(x + 5, y)
            else:
                cr.move_to(x, y); cr.line_to(x + 10, y); cr.line_to(x + 5, y - 9)
            cr.close_path()
            cr.set_source_rgb(*rgb)
            cr.fill()
        arrow(14, 27, True, (0.45, 0.95, 0.55))
        text(cr, self.speed(self.down), 30, 27, 12, bold=True)
        arrow(14, 47, False, (0.45, 0.75, 1.0))
        text(cr, self.speed(self.up), 30, 47, 12, bold=True)
        # graph
        gx, gy, gw, gh = 12, 58, w - 24, h - 70
        cr.rectangle(gx, gy, gw, gh)
        cr.set_source_rgba(0, 0, 0, 0.35)
        cr.fill()
        peak = max(max(d, u) for d, u in self.history) or 1
        for idx, rgb in ((0, (0.45, 0.95, 0.55)), (1, (0.45, 0.75, 1.0))):
            cr.new_path()
            for i, sample in enumerate(self.history):
                x = gx + gw * i / (len(self.history) - 1)
                y = gy + gh - 2 - (gh - 4) * sample[idx] / peak
                cr.line_to(x, y)
            cr.set_source_rgb(*rgb)
            cr.set_line_width(1.5)
            cr.stroke()

    def clicked(self):
        spawn(["firox-network", "toggle"])
        return True


class Headlines(Gadget):
    KEY, TITLE, ICON = "headlines", "Feed Headlines", "application-rss+xml"
    DESCRIPTION = "Headlines from a news site or blog (any RSS or Atom feed). Click one to read it."
    HEIGHT = 200
    PER_PAGE = 4

    def __init__(self, sidebar):
        self.items = []          # [(title, link)]
        self.feed_title = ""
        self.error = ""
        self.page = 0
        self.rows = []           # [(y0, y1, link)] for clicks
        super().__init__(sidebar)
        self.fetch()
        self.timer = GLib.timeout_add_seconds(15, self.next_page)
        self.refresh_timer = GLib.timeout_add_seconds(1800, lambda: self.fetch() or True)
        self.connect("destroy", lambda *_: GLib.source_remove(self.refresh_timer))

    def next_page(self):
        pages = max(1, -(-len(self.items) // self.PER_PAGE))
        self.page = (self.page + 1) % pages
        self.area.queue_draw()
        return True

    def fetch(self):
        url = self.sidebar.conf.get("FEED") or ""
        if not url:
            return

        def work():
            items, title, err = [], "", ""
            try:
                import xml.etree.ElementTree as ET
                req = urllib.request.Request(url, headers={"User-Agent": "firox-gadgets"})
                with urllib.request.urlopen(req, timeout=15) as resp:
                    root = ET.fromstring(resp.read())

                def local(tag):
                    return tag.rsplit("}", 1)[-1]
                for el in root.iter():
                    if local(el.tag) == "title" and not title:
                        title = (el.text or "").strip()
                    if local(el.tag) in ("item", "entry"):
                        t, link = "", ""
                        for c in el:
                            if local(c.tag) == "title":
                                t = " ".join((c.text or "").split())
                            elif local(c.tag) == "link":
                                link = (c.text or "").strip() or c.get("href", "")
                        if t:
                            items.append((t, link))
            except Exception as e:  # noqa: BLE001 - offline, bad XML...
                err = "Can't get the headlines right now"
                print(f"gadgets: feed {url}: {e}", file=sys.stderr)
            GLib.idle_add(self.got, items[:24], title, err)
        threading.Thread(target=work, daemon=True).start()

    def got(self, items, title, err):
        if items or not self.items:
            self.items, self.feed_title, self.error = items, title, err
            self.page = 0
        self.area.queue_draw()
        return False

    def draw(self, cr, w, h):
        glass(cr, 4, 4, w - 8, h - 8, top=(0.80, 0.42, 0.12), bottom=(0.35, 0.14, 0.04))
        text(cr, fit_text(cr, self.feed_title or "Feed Headlines", 10, w - 24, True), 12, 21, 10, bold=True,
             rgba=(1, 0.95, 0.85, 1))
        self.rows = []
        if not self.items:
            text(cr, self.error or "Loading…", w / 2, h / 2 + 4, 11, center=True)
            return
        start = self.page * self.PER_PAGE
        y = 30
        for title, link in self.items[start:start + self.PER_PAGE]:
            lines = wrap_lines(cr, title, 10, w - 26, 3)
            if y + 13 * len(lines) + 7 > h - 24:
                break                       # no room above the page label
            y0 = y
            for line in lines:
                y += 13
                text(cr, line, 12, y, 10)
            y += 7
            self.rows.append((y0, y, link))
            cr.set_source_rgba(1, 1, 1, 0.18)
            cr.rectangle(12, y - 3, w - 24, 1)
            cr.fill()
        pages = max(1, -(-len(self.items) // self.PER_PAGE))
        text(cr, f"{self.page + 1} of {pages}", w / 2, h - 12, 9, rgba=(1, 0.92, 0.8, 1), center=True)

    def clicked_at(self, x, y):
        for y0, y1, link in self.rows:
            if y0 <= y <= y1 and link:
                try:
                    Gio.AppInfo.launch_default_for_uri(link, None)
                except GLib.Error as err:
                    print(f"gadgets: {err.message}", file=sys.stderr)
                return True
        if y > self.HEIGHT - 26:
            self.next_page()
        return True

    def options(self):
        conf = self.sidebar.conf
        url = ask_value("Feed Headlines Options", "Feed address (RSS or Atom):", conf.get("FEED", ""),
                        "News sites and blogs often have a feed: look for an RSS link, or try the site's "
                        "address followed by /feed or /rss.")
        if url is None:
            return True
        conf["FEED"] = url
        save_conf(conf)
        self.items, self.error = [], ""
        self.area.queue_draw()
        self.fetch()
        return True


class Timer(Gadget):
    KEY, TITLE, ICON = "timer", "Timer", "alarm-clock"
    DESCRIPTION = "Counts down and lets you know when the time is up. Click to start or pause."
    HEIGHT = 128

    def __init__(self, sidebar):
        self.sidebar = sidebar
        self.total = self.minutes() * 60
        self.left = float(self.total)
        self.running = False
        self.last = 0.0
        self.done = False
        super().__init__(sidebar)

    def minutes(self):
        try:
            return max(1, min(999, int(self.sidebar.conf.get("TIMER_MINUTES", "5"))))
        except ValueError:
            return 5

    def tick(self):
        if self.running:
            now = time.monotonic()
            self.left = max(0.0, self.left - (now - self.last))
            self.last = now
            if self.left <= 0:
                self.running = False
                self.done = True
                self.ring()
        self.area.queue_draw()
        if not self.running:
            self.timer = None           # this loop ends here
        return self.running

    def stop_loop(self):
        if self.timer is not None:
            GLib.source_remove(self.timer)
            self.timer = None

    def ring(self):
        spawn(["notify-send", "-a", "Timer", "-i", "alarm-clock", "-u", "critical",
               "Time's up", f"Your {self.minutes()}-minute timer has finished."])
        sound = "/usr/share/sounds/freedesktop/stereo/alarm-clock-elapsed.oga"
        if os.path.exists(sound):
            spawn(["paplay", sound])

    def start_pause(self):
        if self.done or self.left <= 0:
            self.reset()
        self.running = not self.running
        self.stop_loop()
        if self.running:
            self.last = time.monotonic()
            self.timer = GLib.timeout_add(250, self.tick)
        self.area.queue_draw()

    def reset(self):
        self.stop_loop()
        self.running = False
        self.done = False
        self.total = self.minutes() * 60
        self.left = float(self.total)
        self.area.queue_draw()

    def draw(self, cr, w, h):
        import cairo
        glass(cr, 4, 4, w - 8, h - 8, top=(0.70, 0.18, 0.16) if self.done else (0.28, 0.30, 0.36),
              bottom=(0.30, 0.04, 0.04) if self.done else (0.07, 0.08, 0.11))
        cx, cy, r = 46, h / 2, 32
        cr.new_path()
        cr.arc(cx, cy, r, 0, 2 * math.pi)
        cr.set_source_rgba(1, 1, 1, 0.12)
        cr.set_line_width(7)
        cr.stroke()
        frac = self.left / self.total if self.total else 0
        if frac > 0:
            cr.new_path()
            cr.arc(cx, cy, r, -math.pi / 2, -math.pi / 2 + 2 * math.pi * frac)
            cr.set_source_rgb(0.95, 0.62, 0.15) if self.running else cr.set_source_rgb(0.75, 0.78, 0.85)
            cr.set_line_cap(cairo.LINE_CAP_ROUND)
            cr.stroke()
        icon = "media-playback-pause" if self.running else "media-playback-start"
        paint_icon(cr, icon, cx - 10, cy - 10, 20)
        secs = int(math.ceil(self.left))
        hh, rest = divmod(secs, 3600)
        mm, ss = divmod(rest, 60)
        label = f"{hh}:{mm:02d}:{ss:02d}" if hh else f"{mm:02d}:{ss:02d}"
        text(cr, label, 122, cy + 2, 22 if not hh else 16, bold=True, center=True)
        state = "Time's up!" if self.done else ("Running" if self.running else
                                                 ("Paused" if self.left < self.total else "Click to start"))
        text(cr, state, 122, cy + 22, 9, rgba=(0.85, 0.88, 0.95, 1), center=True)
        text(cr, "Reset", 122, h - 14, 9, rgba=(0.75, 0.8, 0.9, 1), center=True)

    def clicked_at(self, x, y):
        if x > 95 and y > self.HEIGHT - 26:
            self.reset()
        else:
            self.start_pause()
        return True

    def options(self):
        conf = self.sidebar.conf
        val = ask_value("Timer Options", "Minutes to count down:", str(self.minutes()))
        if val is None:
            return True
        try:
            conf["TIMER_MINUTES"] = str(max(1, min(999, int(val))))
        except ValueError:
            return True
        save_conf(conf)
        self.reset()
        return True


class PicturePuzzle(Gadget):
    KEY, TITLE, ICON = "puzzle", "Picture Puzzle", "applications-games"
    DESCRIPTION = "Slide the tiles back into place to make the picture. Options… starts a new puzzle."
    HEIGHT = 178
    N = 4

    def __init__(self, sidebar):
        self.picture = None
        self.moves = 0
        self.tiles = list(range(self.N * self.N))   # position -> tile (last = the gap)
        super().__init__(sidebar)
        self.load_picture()
        self.shuffle()

    def pictures(self):
        """Colourful pictures to make puzzles from: your Pictures folder,
        then the Firox Classic and Glass wallpapers."""
        out = []
        folder = GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_PICTURES) or ""
        try:
            for name in sorted(os.listdir(folder)):
                if name.lower().endswith((".jpg", ".jpeg", ".png", ".webp", ".svg")):
                    out.append(os.path.join(folder, name))
        except OSError:
            pass
        for path in ("/usr/share/backgrounds/firox/default.svg", "/usr/share/backgrounds/firox/glass.svg"):
            if os.path.exists(path):
                out.append(path)
        return out

    def load_picture(self):
        size = WIDTH - 24
        self.picture = None
        choices = self.pictures()
        random.shuffle(choices)
        for path in choices:
            try:
                pix = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, 600, 600, True)
            except GLib.Error:
                continue
            side = min(pix.get_width(), pix.get_height())
            pix = pix.new_subpixbuf((pix.get_width() - side) // 2, (pix.get_height() - side) // 2, side, side)
            self.picture = pix.scale_simple(size, size, GdkPixbuf.InterpType.BILINEAR)
            return

    def shuffle(self):
        n = self.N
        self.tiles = list(range(n * n))
        gap = n * n - 1
        prev = None
        for _ in range(200):          # random legal moves: always solvable
            r, c = divmod(gap, n)
            options = [p for p, ok in ((gap - n, r > 0), (gap + n, r < n - 1), (gap - 1, c > 0),
                                       (gap + 1, c < n - 1)) if ok and p != prev]
            p = random.choice(options)
            self.tiles[gap], self.tiles[p] = self.tiles[p], self.tiles[gap]
            prev, gap = gap, p
        self.moves = 0
        self.area.queue_draw()

    def solved(self):
        return self.tiles == list(range(self.N * self.N))

    def draw(self, cr, w, h):
        glass(cr, 4, 4, w - 8, h - 8)
        n, size = self.N, WIDTH - 24
        ox, oy, t = 12, 10, size / self.N
        done = self.solved()
        for pos, tile in enumerate(self.tiles):
            if tile == n * n - 1 and not done:
                continue
            pr, pc = divmod(pos, n)
            tr, tc = divmod(tile, n)
            x, y = ox + pc * t, oy + pr * t
            cr.save()
            cr.rectangle(x + 0.5, y + 0.5, t - 1, t - 1)
            cr.clip()
            if self.picture is not None:
                Gdk.cairo_set_source_pixbuf(cr, self.picture, x - tc * t, y - tr * t)
                cr.paint()
            else:
                hue = tile / (n * n)
                cr.set_source_rgb(0.25 + 0.5 * hue, 0.45, 0.85 - 0.5 * hue)
                cr.paint()
                text(cr, str(tile + 1), x + t / 2, y + t / 2 + 6, 16, bold=True, center=True)
            cr.restore()
            if not done:
                cr.rectangle(x + 0.5, y + 0.5, t - 1, t - 1)
                cr.set_source_rgba(1, 1, 1, 0.35)
                cr.set_line_width(1)
                cr.stroke()
        label = f"Solved in {self.moves} moves!" if done and self.moves else f"Moves: {self.moves}"
        text(cr, label, w / 2, h - 10, 10, center=True)

    def clicked_at(self, x, y):
        n, t = self.N, (WIDTH - 24) / self.N
        c, r = int((x - 12) // t), int((y - 10) // t)
        if not (0 <= c < n and 0 <= r < n) or self.solved():
            return True
        pos = r * n + c
        gap = self.tiles.index(n * n - 1)
        gr, gc = divmod(gap, n)
        if (abs(gr - r) + abs(gc - c)) == 1:
            self.tiles[gap], self.tiles[pos] = self.tiles[pos], self.tiles[gap]
            self.moves += 1
            self.area.queue_draw()
        return True

    def options(self):
        self.load_picture()
        self.shuffle()
        return True


# Exchange rates from the European Central Bank, via frankfurter.app (no account)
FRANKFURTER = os.environ.get("FIROX_FRANKFURTER", "https://api.frankfurter.app").rstrip("/")


class Currency(Gadget):
    KEY, TITLE, ICON = "currency", "Currency", "accessories-calculator"
    DESCRIPTION = "Convert between currencies with today's exchange rates (European Central Bank)."
    HEIGHT = 108

    def __init__(self, sidebar):
        self.rate = None
        self.date = ""
        self.error = ""
        super().__init__(sidebar)
        self.fetch()
        self.timer = GLib.timeout_add_seconds(6 * 3600, lambda: self.fetch() or True)

    def pair(self):
        conf = self.sidebar.conf
        return conf.get("CURRENCY_FROM", "USD").upper(), conf.get("CURRENCY_TO", "EUR").upper()

    def amount(self):
        try:
            return float(self.sidebar.conf.get("CURRENCY_AMOUNT", "1"))
        except ValueError:
            return 1.0

    def fetch(self):
        src, dst = self.pair()
        if src == dst:
            self.rate, self.date, self.error = 1.0, "", ""
            self.area.queue_draw()
            return

        def work():
            try:
                data = fetch_json(f"{FRANKFURTER}/latest?" + urllib.parse.urlencode({"from": src, "to": dst}))
                rate, date, err = float(data["rates"][dst]), data.get("date", ""), ""
            except Exception as e:  # noqa: BLE001
                rate, date, err = None, "", "Can't get rates right now"
                print(f"gadgets: currency: {e}", file=sys.stderr)
            GLib.idle_add(self.got, rate, date, err)
        threading.Thread(target=work, daemon=True).start()

    def got(self, rate, date, err):
        if rate is not None or self.rate is None:
            self.rate, self.date, self.error = rate, date, err
        self.area.queue_draw()
        return False

    def draw(self, cr, w, h):
        glass(cr, 4, 4, w - 8, h - 8, top=(0.20, 0.50, 0.28), bottom=(0.05, 0.18, 0.08))
        src, dst = self.pair()
        amt = self.amount()
        text(cr, f"{amt:g} {src} =", w / 2, 30, 12, rgba=(0.88, 1, 0.9, 1), center=True)
        if self.rate is None:
            text(cr, self.error or "Loading…", w / 2, 62, 11, center=True)
        else:
            value = amt * self.rate
            shown = f"{value:,.2f}" if value >= 0.01 else f"{value:.6f}"
            text(cr, fit_text(cr, f"{shown} {dst}", 20, w - 20, True), w / 2, 64, 20, bold=True, center=True)
        if self.date:
            text(cr, f"Rate of {self.date}", w / 2, h - 14, 9, rgba=(0.8, 0.92, 0.82, 1), center=True)

    def clicked(self):
        return self.options()

    def options(self):
        conf = self.sidebar.conf
        dlg = Gtk.Dialog(title="Currency Options", modal=True)
        dlg.add_button("Cancel", Gtk.ResponseType.CANCEL)
        dlg.add_button("OK", Gtk.ResponseType.OK)
        dlg.set_default_response(Gtk.ResponseType.OK)
        box = dlg.get_content_area()
        box.set_spacing(8)
        box.set_border_width(14)
        grid = Gtk.Grid(column_spacing=10, row_spacing=8)
        amount = Gtk.Entry(text=conf.get("CURRENCY_AMOUNT", "1"), activates_default=True, width_chars=10)
        src = Gtk.Entry(text=self.pair()[0], activates_default=True, width_chars=6, max_length=3)
        dst = Gtk.Entry(text=self.pair()[1], activates_default=True, width_chars=6, max_length=3)
        for i, (label, widget) in enumerate((("Amount:", amount), ("From:", src), ("To:", dst))):
            grid.attach(Gtk.Label(label=label, xalign=0), 0, i, 1, 1)
            grid.attach(widget, 1, i, 1, 1)
        box.pack_start(grid, False, False, 0)
        note = Gtk.Label(xalign=0, wrap=True, max_width_chars=44)
        note.set_markup("<small>Three-letter codes such as USD, EUR, GBP, JPY, CAD, AUD, CHF, CNY, INR. "
                        "Rates from the European Central Bank, updated on working days.</small>")
        box.pack_start(note, False, False, 0)
        dlg.show_all()
        if dlg.run() == Gtk.ResponseType.OK:
            try:
                conf["CURRENCY_AMOUNT"] = f"{float(amount.get_text().replace(',', '.')):g}"
            except ValueError:
                pass
            a, b = src.get_text().strip().upper(), dst.get_text().strip().upper()
            if len(a) == 3 and a.isalpha():
                conf["CURRENCY_FROM"] = a
            if len(b) == 3 and b.isalpha():
                conf["CURRENCY_TO"] = b
            save_conf(conf)
            self.rate, self.error = None, ""
            self.fetch()
        dlg.destroy()
        return True


class DiskSpace(Gadget):
    KEY, TITLE, ICON = "disks", "Disk Space", "drive-harddisk"
    DESCRIPTION = "How full your home drive and any plugged-in drives are."
    INTERVAL = 30

    def __init__(self, sidebar):
        self.drives = []
        self.refresh()
        super().__init__(sidebar)
        self.area.set_size_request(WIDTH, self.height())

    def height(self):
        return 34 + 34 * max(1, len(self.drives))

    def refresh(self):
        home = os.path.expanduser("~")
        drives = [("Home", home)]
        user = os.environ.get("USER", "")
        for base in (f"/run/media/{user}", "/media"):
            try:
                for name in sorted(os.listdir(base)):
                    path = os.path.join(base, name)
                    if os.path.ismount(path):
                        drives.append((name, path))
            except OSError:
                pass
        out = []
        for label, path in drives[:5]:
            try:
                st = os.statvfs(path)
            except OSError:
                continue
            total = st.f_blocks * st.f_frsize
            free = st.f_bavail * st.f_frsize
            if total:
                out.append((label, path, total, free))
        self.drives = out

    def tick(self):
        before = len(self.drives)
        self.refresh()
        if len(self.drives) != before:
            self.area.set_size_request(WIDTH, self.height())
        return super().tick()

    @staticmethod
    def size(n):
        for unit in ("B", "KB", "MB", "GB", "TB"):
            if n < 1024 or unit == "TB":
                return f"{n:.0f} {unit}" if unit in ("B", "KB") else f"{n:.1f} {unit}"
            n /= 1024

    def draw(self, cr, w, h):
        h = self.height()
        glass(cr, 4, 4, w - 8, h - 8)
        text(cr, "Disk Space", 12, 22, 10, bold=True, rgba=(0.9, 0.93, 1, 1))
        y = 30
        for label, _path, total, free in self.drives:
            used = 1 - free / total
            text(cr, fit_text(cr, label, 10, 70), 12, y + 12, 10)
            text(cr, f"{self.size(free)} free", w - 12 - 70, y + 12, 9, rgba=(0.8, 0.85, 0.95, 1))
            bx, by, bw, bh = 12, y + 17, w - 24, 9
            rounded(cr, bx, by, bw, bh, 3)
            cr.set_source_rgba(0, 0, 0, 0.4)
            cr.fill()
            rgb = (0.85, 0.25, 0.2) if used > 0.9 else ((0.95, 0.65, 0.15) if used > 0.75 else (0.3, 0.6, 0.95))
            rounded(cr, bx, by, max(6, bw * used), bh, 3)
            cr.set_source_rgb(*rgb)
            cr.fill()
            y += 34

    def clicked(self):
        spawn(["firox-open", "computer"])
        return True


GADGETS = [Clock, Calendar, CpuMeter, Weather, SlideShow, Notes, NowPlaying, NetworkMeter,
           Headlines, Timer, PicturePuzzle, Currency, DiskSpace]
BY_KEY = {g.KEY: g for g in GADGETS}


def spawn(argv):
    try:
        GLib.spawn_async(argv, flags=GLib.SpawnFlags.SEARCH_PATH)
    except GLib.Error as err:
        print(f"gadgets: {err.message}", file=sys.stderr)


CSS = b"""
window#sidebar { background-color: transparent; }
#sidebar-column {
    background-image: linear-gradient(to right, rgba(20, 24, 32, 0.10), rgba(20, 24, 32, 0.45));
    border-left: 1px solid rgba(255, 255, 255, 0.10);
    padding: 10px 0;
}
button.gadget-close {
    all: unset;
    min-width: 18px; min-height: 18px;
    margin: 2px 8px 0 0;
    border-radius: 9px;
    font-weight: bold;
    color: #ffffff;
    background-color: rgba(0, 0, 0, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.5);
}
button.gadget-close:hover { background-color: #c42b1c; }
textview.gadget-note, textview.gadget-note text {
    background-color: transparent;
    color: #3d3510;
    font-family: "Comic Neue", "Segoe Print", cursive, sans-serif;
    font-size: 12px;
}
#add-button {
    all: unset;
    margin: 6px 10px;
    padding: 4px 8px;
    border-radius: 4px;
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.10);
}
#add-button:hover { background-color: rgba(255, 255, 255, 0.22); }
"""


# ---------------------------------------------------------------- sidebar --

class Sidebar(Gtk.Window):
    def __init__(self, app):
        super().__init__(application=app, title="Desktop Gadgets")
        self.set_name("sidebar")
        self.conf = load_conf()
        self.set_decorated(False)
        screen = self.get_screen()
        visual = screen.get_rgba_visual()
        if visual is not None:
            self.set_visual(visual)
        self.set_app_paintable(True)
        prov = Gtk.CssProvider()
        prov.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(screen, prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        if GtkLayerShell and GtkLayerShell.is_supported():
            GtkLayerShell.init_for_window(self)
            GtkLayerShell.set_namespace(self, "firox-gadgets")
            GtkLayerShell.set_layer(self, GtkLayerShell.Layer.BOTTOM)     # on the desktop, under windows
            for edge in (GtkLayerShell.Edge.TOP, GtkLayerShell.Edge.RIGHT, GtkLayerShell.Edge.BOTTOM):
                GtkLayerShell.set_anchor(self, edge, True)
            GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.ON_DEMAND)
            # On the main display (Settings > Display), following it when it
            # or the monitors change
            self.place_timer = None
            self.place()
            screen.connect("monitors-changed", lambda _s: self.schedule_place())
            self.main_mon = Gio.File.new_for_path(firox_monitors.CONF).monitor_file(
                Gio.FileMonitorFlags.NONE, None)
            self.main_mon.connect("changed", lambda *_: self.schedule_place())
        self.set_size_request(SIDEBAR, -1)

        outer = Gtk.EventBox()
        outer.set_name("sidebar-column")
        outer.connect("button-press-event", self.on_empty_press)
        self.add(outer)
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        outer.add(col)
        top = Gtk.Box()
        add = Gtk.Button(label="+  Gadgets")
        add.set_name("add-button")
        add.set_tooltip_text("Add Gadgets")
        add.connect("clicked", lambda _b: self.gallery())
        top.pack_end(add, False, False, 0)
        col.pack_start(top, False, False, 0)
        self.column = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        self.column.set_halign(Gtk.Align.CENTER)
        # More gadgets than fit: scroll with the mouse wheel (no scrollbar, like Vista)
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.EXTERNAL)
        scroll.add(self.column)
        col.pack_start(scroll, True, True, 0)
        self.fill()
        self.show_all()

    def place(self):
        self.place_timer = None
        mon = firox_monitors.main_gdk_monitor(Gdk.Display.get_default())
        if mon is not None and mon != getattr(self, "placed_on", None):
            self.placed_on = mon
            GtkLayerShell.set_monitor(self, mon)
        return False

    def schedule_place(self):
        if self.place_timer is not None:
            GLib.source_remove(self.place_timer)
        self.place_timer = GLib.timeout_add(400, self.place)

    def keys(self):
        return [k for k in self.conf.get("GADGETS", "").split(",") if k in BY_KEY]

    def fill(self):
        for child in self.column.get_children():
            child.destroy()
        for key in self.keys():
            g = BY_KEY[key](self)
            self.column.pack_start(g, False, False, 0)
            g.show_all()
            g.close.hide()

    def save_keys(self, keys):
        self.conf["GADGETS"] = ",".join(keys)
        save_conf(self.conf)

    def add_gadget(self, key):
        keys = self.keys()
        if key in keys:
            return
        keys.append(key)
        self.save_keys(keys)
        g = BY_KEY[key](self)
        self.column.pack_start(g, False, False, 0)
        g.show_all()
        g.close.hide()

    def remove_gadget(self, gadget):
        keys = [k for k in self.keys() if k != gadget.KEY]
        self.save_keys(keys)
        gadget.destroy()

    def gadget_menu(self, gadget, event):
        menu = Gtk.Menu()

        def item(label, cb, sensitive=True):
            it = Gtk.MenuItem.new_with_mnemonic(label)
            it.set_sensitive(sensitive)
            it.connect("activate", lambda _i: cb())
            menu.append(it)
        has_options = type(gadget).options is not Gadget.options
        item("_Options…", gadget.options, has_options)
        keys = self.keys()
        i = keys.index(gadget.KEY) if gadget.KEY in keys else -1
        item("Move _up", lambda: self.move(gadget, -1), i > 0)
        item("Move _down", lambda: self.move(gadget, 1), 0 <= i < len(keys) - 1)
        menu.append(Gtk.SeparatorMenuItem())
        item("_Close gadget", lambda: self.remove_gadget(gadget))
        menu.append(Gtk.SeparatorMenuItem())
        item("_Add Gadgets…", self.gallery)
        item("_Hide the Sidebar", self.hide_sidebar)
        self.popup(menu, event)

    def move(self, gadget, delta):
        keys = self.keys()
        i = keys.index(gadget.KEY)
        j = max(0, min(len(keys) - 1, i + delta))
        keys[i], keys[j] = keys[j], keys[i]
        self.save_keys(keys)
        self.column.reorder_child(gadget, j)

    def on_empty_press(self, _w, event):
        if event.type != Gdk.EventType.BUTTON_PRESS or event.button != 3:
            return False
        menu = Gtk.Menu()
        for label, cb in (("_Add Gadgets…", self.gallery), ("_Hide the Sidebar", self.hide_sidebar)):
            it = Gtk.MenuItem.new_with_mnemonic(label)
            it.connect("activate", lambda _i, cb=cb: cb())
            menu.append(it)
        self.popup(menu, event)
        return True

    def popup(self, menu, event):
        menu.show_all()
        self._menu = menu
        menu.popup_at_pointer(event)

    def hide_sidebar(self):
        self.get_application().quit()

    # -------------------------------------------------------- gallery --
    def gallery(self):
        dlg = Gtk.Dialog(title="Add Gadgets")
        dlg.set_icon_name("view-grid")
        dlg.add_button("Close", Gtk.ResponseType.CLOSE)
        dlg.set_default_size(520, 330)
        area = dlg.get_content_area()
        area.set_border_width(12)
        area.set_spacing(8)
        area.pack_start(Gtk.Label(label="Double-click a gadget to add it to the Sidebar.", xalign=0),
                        False, False, 0)
        flow = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.SINGLE, activate_on_single_click=False,
                           max_children_per_line=6, homogeneous=True, column_spacing=8, row_spacing=8)
        for cls in GADGETS:
            tile = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            tile.set_border_width(6)
            tile.firox_key = cls.KEY
            img = Gtk.Image.new_from_icon_name(cls.ICON, Gtk.IconSize.DIALOG)
            img.set_pixel_size(56)
            tile.pack_start(img, False, False, 0)
            lab = Gtk.Label(label=cls.TITLE)
            tile.pack_start(lab, False, False, 0)
            if cls.KEY in self.keys():
                lab.set_markup(f"{GLib.markup_escape_text(cls.TITLE)}\n<small>(added)</small>")
                lab.set_justify(Gtk.Justification.CENTER)
            tile.set_tooltip_text(cls.DESCRIPTION)
            flow.add(tile)
        detail = Gtk.Label(xalign=0, wrap=True)
        detail.get_style_context().add_class("dim-label")

        def selected(fb):
            kids = fb.get_selected_children()
            if kids:
                detail.set_text(BY_KEY[kids[0].get_child().firox_key].DESCRIPTION)

        def activated(_fb, child):
            self.add_gadget(child.get_child().firox_key)
            dlg.destroy()
        flow.connect("selected-children-changed", selected)
        flow.connect("child-activated", activated)
        area.pack_start(flow, True, True, 0)
        area.pack_start(detail, False, False, 0)
        add = Gtk.Button(label="Add")
        add.connect("clicked", lambda _b: [activated(flow, k) for k in flow.get_selected_children()[:1]])
        area.pack_start(add, False, False, 0)
        add.set_halign(Gtk.Align.END)
        dlg.connect("response", lambda d, _r: d.destroy())
        dlg.show_all()
        dlg.present()


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.firox.Gadgets", flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.win = None

    def do_command_line(self, cmdline):
        args = cmdline.get_arguments()[1:]
        cmd = args[0] if args else ""
        conf = load_conf()
        if cmd in ("off", "on"):
            conf["ENABLED"] = "1" if cmd == "on" else "0"
            save_conf(conf)
            if cmd == "off":
                self.quit()
                return 0
            cmd = ""
        if cmd == "hide":
            self.quit()
            return 0
        if cmd == "start" and conf.get("ENABLED", "1") == "0":
            if self.win is None:
                self.quit()
            return 0
        if self.win is None:
            self.win = Sidebar(self)
            if cmd == "add":
                self.win.gallery()
        elif cmd in ("", "add"):
            self.win.gallery()
        return 0


if __name__ == "__main__":
    sys.exit(App().run(sys.argv))
