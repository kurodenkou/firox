#add-button:hover { background-color: rgba(255, 255, 255, 0.22); }
"""


# ---------------------------------------------------------------- sidebar --

class Sidebar(Gtk.Window):
    def __init__(self, app):
        super().__init__(application=app, title="Desktop Gadgets")
        self.set_name("sidebar")
        self.conf = load_conf()
        self.set_decorated(False)
        screen = self.get_screen()
        visual = screen.get_rgba_visual()
        if visual is not None:
            self.set_visual(visual)
        self.set_app_paintable(True)
        prov = Gtk.CssProvider()
        prov.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(screen, prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        if GtkLayerShell and GtkLayerShell.is_supported():
            GtkLayerShell.init_for_window(self)
            GtkLayerShell.set_namespace(self, "firox-gadgets")
            GtkLayerShell.set_layer(self, GtkLayerShell.Layer.BOTTOM)     # on the desktop, under windows
            for edge in (GtkLayerShell.Edge.TOP, GtkLayerShell.Edge.RIGHT, GtkLayerShell.Edge.BOTTOM):
                GtkLayerShell.set_anchor(self, edge, True)
            GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.ON_DEMAND)
            # On the main display (Settings > Display), following it when it
            # or the monitors change
            self.place_timer = None
            self.place()
            screen.connect("monitors-changed", lambda _s: self.schedule_place())
            self.main_mon = Gio.File.new_for_path(firox_monitors.CONF).monitor_file(
                Gio.FileMonitorFlags.NONE, None)
            self.main_mon.connect("changed", lambda *_: self.schedule_place())
        self.set_size_request(SIDEBAR, -1)

        outer = Gtk.EventBox()
        outer.set_name("sidebar-column")
        outer.connect("button-press-event", self.on_empty_press)
        self.add(outer)
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        outer.add(col)
        top = Gtk.Box()
        add = Gtk.Button(label="+  Gadgets")
        add.set_name("add-button")
        add.set_tooltip_text("Add Gadgets")
        add.connect("clicked", lambda _b: self.gallery())
        top.pack_end(add, False, False, 0)
        col.pack_start(top, False, False, 0)
        self.column = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        self.column.set_halign(Gtk.Align.CENTER)
        # More gadgets than fit: scroll with the mouse wheel (no scrollbar, like Vista)
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.EXTERNAL)
        scroll.add(self.column)
        col.pack_start(scroll, True, True, 0)
        self.fill()
        self.show_all()

    def place(self):
        self.place_timer = None
        mon = firox_monitors.main_gdk_monitor(Gdk.Display.get_default())
        if mon is not None and mon != getattr(self, "placed_on", None):
            self.placed_on = mon
            GtkLayerShell.set_monitor(self, mon)
        return False

    def schedule_place(self):
        if self.place_timer is not None:
            GLib.source_remove(self.place_timer)
        self.place_timer = GLib.timeout_add(400, self.place)

    def keys(self):
        return [k for k in self.conf.get("GADGETS", "").split(",") if k in BY_KEY]

    def fill(self):
        for child in self.column.get_children():
            child.destroy()
        for key in self.keys():
            g = BY_KEY[key](self)
            self.column.pack_start(g, False, False, 0)
            g.show_all()
            g.close.hide()

    def save_keys(self, keys):
        self.conf["GADGETS"] = ",".join(keys)
        save_conf(self.conf)

    def add_gadget(self, key):
        keys = self.keys()
        if key in keys:
            return
        keys.append(key)
        self.save_keys(keys)
        g = BY_KEY[key](self)
        self.column.pack_start(g, False, False, 0)
        g.show_all()
        g.close.hide()

    def remove_gadget(self, gadget):
        keys = [k for k in self.keys() if k != gadget.KEY]
        self.save_keys(keys)
        gadget.destroy()

    def gadget_menu(self, gadget, event):
        menu = Gtk.Menu()

        def item(label, cb, sensitive=True):
            it = Gtk.MenuItem.new_with_mnemonic(label)
            it.set_sensitive(sensitive)
            it.connect("activate", lambda _i: cb())
            menu.append(it)
        has_options = type(gadget).options is not Gadget.options
        item("_Options…", gadget.options, has_options)
        keys = self.keys()
        i = keys.index(gadget.KEY) if gadget.KEY in keys else -1
        item("Move _up", lambda: self.move(gadget, -1), i > 0)
        item("Move _down", lambda: self.move(gadget, 1), 0 <= i < len(keys) - 1)
        menu.append(Gtk.SeparatorMenuItem())
        item("_Close gadget", lambda: self.remove_gadget(gadget))
        menu.append(Gtk.SeparatorMenuItem())
        item("_Add Gadgets…", self.gallery)
        item("_Hide the Sidebar", self.hide_sidebar)
        self.popup(menu, event)

    def move(self, gadget, delta):
        keys = self.keys()
        i = keys.index(gadget.KEY)
        j = max(0, min(len(keys) - 1, i + delta))
        keys[i], keys[j] = keys[j], keys[i]
        self.save_keys(keys)
        self.column.reorder_child(gadget, j)

    def on_empty_press(self, _w, event):
        if event.type != Gdk.EventType.BUTTON_PRESS or event.button != 3:
            return False
        menu = Gtk.Menu()
        for label, cb in (("_Add Gadgets…", self.gallery), ("_Hide the Sidebar", self.hide_sidebar)):
            it = Gtk.MenuItem.new_with_mnemonic(label)
            it.connect("activate", lambda _i, cb=cb: cb())
            menu.append(it)
        self.popup(menu, event)
        return True

    def popup(self, menu, event):
        menu.show_all()
        self._menu = menu
        menu.popup_at_pointer(event)

    def hide_sidebar(self):
        self.get_application().quit()

    # -------------------------------------------------------- gallery --
    def gallery(self):
        dlg = Gtk.Dialog(title="Add Gadgets")
        dlg.set_icon_name("view-grid")
        dlg.add_button("Close", Gtk.ResponseType.CLOSE)
        dlg.set_default_size(520, 330)
        area = dlg.get_content_area()
        area.set_border_width(12)
        area.set_spacing(8)
        area.pack_start(Gtk.Label(label="Double-click a gadget to add it to the Sidebar.", xalign=0),
                        False, False, 0)
        flow = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.SINGLE, activate_on_single_click=False,
                           max_children_per_line=6, homogeneous=True, column_spacing=8, row_spacing=8)
        for cls in GADGETS:
            tile = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            tile.set_border_width(6)
            tile.firox_key = cls.KEY
            img = Gtk.Image.new_from_icon_name(cls.ICON, Gtk.IconSize.DIALOG)
            img.set_pixel_size(56)
            tile.pack_start(img, False, False, 0)
            lab = Gtk.Label(label=cls.TITLE)
            tile.pack_start(lab, False, False, 0)
            if cls.KEY in self.keys():
                lab.set_markup(f"{GLib.markup_escape_text(cls.TITLE)}\n<small>(added)</small>")
                lab.set_justify(Gtk.Justification.CENTER)
            tile.set_tooltip_text(cls.DESCRIPTION)
            flow.add(tile)
        detail = Gtk.Label(xalign=0, wrap=True)
        detail.get_style_context().add_class("dim-label")

        def selected(fb):
            kids = fb.get_selected_children()
            if kids:
                detail.set_text(BY_KEY[kids[0].get_child().firox_key].DESCRIPTION)

        def activated(_fb, child):
            self.add_gadget(child.get_child().firox_key)
            dlg.destroy()
        flow.connect("selected-children-changed", selected)
        flow.connect("child-activated", activated)
        area.pack_start(flow, True, True, 0)
        area.pack_start(detail, False, False, 0)
        add = Gtk.Button(label="Add")
        add.connect("clicked", lambda _b: [activated(flow, k) for k in flow.get_selected_children()[:1]])
        area.pack_start(add, False, False, 0)
        add.set_halign(Gtk.Align.END)
        dlg.connect("response", lambda d, _r: d.destroy())
        dlg.show_all()
        dlg.present()


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.firox.Gadgets", flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.win = None

    def do_command_line(self, cmdline):
        args = cmdline.get_arguments()[1:]
        cmd = args[0] if args else ""
        conf = load_conf()
        if cmd in ("off", "on"):
            conf["ENABLED"] = "1" if cmd == "on" else "0"
            save_conf(conf)
            if cmd == "off":
                self.quit()
                return 0
            cmd = ""
        if cmd == "hide":
            self.quit()
            return 0
        if cmd == "start" and conf.get("ENABLED", "1") == "0":
            if self.win is None:
                self.quit()
            return 0
        if self.win is None:
            self.win = Sidebar(self)
            if cmd == "add":
                self.win.gallery()
        elif cmd in ("", "add"):
            self.win.gallery()
        return 0


if __name__ == "__main__":
    sys.exit(App().run(sys.argv))
