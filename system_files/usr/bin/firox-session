#!/usr/bin/bash
# Entry point for the "Firox Linux" Wayland session (launched by greetd).
# labwc reads /etc/xdg/labwc/{environment,rc.xml,menu.xml,autostart}, then
# the same files from ~/.config/labwc/ if the user has created them.

export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=Firox
export XDG_CURRENT_DESKTOP=labwc:wlroots

CFG="${XDG_CONFIG_HOME:-$HOME/.config}"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}"
DATA="${XDG_DATA_HOME:-$HOME/.local/share}"
# Firox Explorer replaced pcmanfm-qt: drop the preview add-on's Start menu
# entry, and a folder default that still names the removed pcmanfm-qt
if grep -qs 'Firox Explorer (preview)' "$DATA/applications/firox-explorer.desktop"; then
    rm -f "$DATA/applications/firox-explorer.desktop"
fi
if grep -qs '^inode/directory=pcmanfm-qt.desktop' "$CFG/mimeapps.list"; then
    sed -i 's/^inode\/directory=pcmanfm-qt.desktop.*/inode\/directory=firox-explorer.desktop/' "$CFG/mimeapps.list"
fi
# xfce4-terminal is gone (the Command Prompt is firox-terminal): move a
# Quick Launch pin and the Start menu's history over to it
for f in "$CFG/firox/quicklaunch" "$STATE/firox/startmenu.json"; do
    if grep -qs 'xfce4-terminal\.desktop' "$f"; then
        sed -i 's/xfce4-terminal\.desktop/firox-terminal.desktop/g' "$f"
    fi
done
# Mouse, touchpad and keyboard settings (Settings > Mouse / Keyboard):
# firox-input writes labwc config with them into a folder that labwc checks
# after ~/.config/labwc and before /etc/xdg/labwc
export XDG_CONFIG_DIRS="$DATA/firox/xdg:${XDG_CONFIG_DIRS:-/etc/xdg}"
firox-input apply --no-reload

# Show the account picture on the login screen (if it changed)
/usr/libexec/firox/account-picture >/dev/null 2>&1 &

# Point the "Firox" window theme at the user's Classic/Modern choice
# before labwc loads it
firox-theme sync

exec labwc "$@"
