#!/usr/bin/python3
"""
firox-panel: the Firox Linux taskbar.

    firox-panel             run the taskbar (started at login)

One bar along the bottom of every monitor:

    start button | Quick Launch | window buttons | notification area | clock

With several monitors, the main display (Settings > Display, see
firox-displays and firox_monitors) has the full bar; the others get the start
button, their own window buttons and the clock. ALL_DISPLAYS=0 shows a bar
on the main display only, with every window on it.

Window buttons are grouped: when an app has two or more windows open they
share one button ("3  Firefox ▴"); click it to pick a window. Right-click a
button for Restore / Minimize / Maximize / Close, Minimize/Close group, or Pin
to Quick Launch. Drag buttons and Quick Launch icons to rearrange them.
Right-click an empty part of the taskbar for its settings.

The notification area holds app icons (StatusNotifierItem), keep the screen
on, network (firox-network), Bluetooth (firox-bluetooth), volume, battery,
a waiting update, the notification bell and the clock.

Styled by the theme's panel.css (/usr/share/firox/themes/NAME/panel.css),
reloaded when the theme changes; add your own rules in
~/.config/firox/panel.css. Settings (Settings > Taskbar, applied straight
away): ~/.config/firox/panel.conf with GROUP, AUTOHIDE, QUICKLAUNCH,
SECONDS and ALL_DISPLAYS (1 or 0). Quick Launch: ~/.config/firox/quicklaunch (see
firox-quicklaunch).

Exits with status 3 if it can't run here (no layer-shell or window list
support, or a missing library); the session then starts waybar instead.
"""

import glob
import json
import os
import re
import subprocess
import sys
import time

sys.path.insert(0, "/usr/lib/firox/python")

CANT_RUN = 3


def cant_run(why):
    print(f"firox-panel: {why}", file=sys.stderr)
    sys.exit(CANT_RUN)


try:
    import gi
    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    gi.require_version("GdkPixbuf", "2.0")
    gi.require_version("GtkLayerShell", "0.1")
    from gi.repository import Gdk, GdkPixbuf, Gio, GLib, Gtk, GtkLayerShell  # noqa: E402
    import firox_toplevels  # noqa: E402
    import firox_monitors  # noqa: E402
    from firox_toplevels import Toplevels  # noqa: E402
except (ImportError, ValueError) as err:
    cant_run(f"missing library: {err}")

THEMES = "/usr/share/firox/themes"
CONFIG = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "firox")
STATE = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "firox")
SETTINGS = os.path.join(CONFIG, "panel.conf")
AWAKE = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp", "firox-stay-awake")
HEIGHT = 30
ICON = 16

# Font Awesome glyphs (the same ones the theme's fonts provide for waybar)
FA_EYE, FA_EYE_SLASH = "", ""
FA_VOLUME = ("", "", "")
FA_MUTED = ""
FA_BATTERY = ("", "", "", "", "")
FA_CHARGING = ""
FA_BELL, FA_BELL_OFF = "", ""

QUICK_LAUNCH = os.path.join(CONFIG, "quicklaunch")
QL_DEFAULTS = ["firox:show-desktop", "org.mozilla.firefox.desktop", "firox:computer"]
QL_BUILTIN = {
    # id: (icon, command, tooltip)
    "firox:show-desktop": ("show-desktop", ["firox-open", "show-desktop"], "Show the desktop"),
    "firox:computer": ("system-file-manager", ["firox-open", "computer"], "Computer"),
}
SETTING_DEFAULTS = {"GROUP": "1", "AUTOHIDE": "0", "QUICKLAUNCH": "1", "SECONDS": "0",
                    "ALL_DISPLAYS": "1"}


# --------------------------------------------------------------- helpers --

def spawn(argv):
    """Start a program. GLib closes our open files in the child, so nothing
    it keeps running can hold on to the taskbar's pipes."""
    try:
        GLib.spawn_async(argv, flags=GLib.SpawnFlags.SEARCH_PATH)
    except GLib.Error as err:
        print(f"firox-panel: can't run {argv[0]}: {err.message}", file=sys.stderr)


def read(path):
    try:
        with open(path) as fh:
            return fh.read().strip()
    except OSError:
        return ""


def theme_name():
    return read(os.path.join(CONFIG, "theme")) or read("/etc/firox/theme") or "classic"


def theme_css():
    path = os.path.join(THEMES, theme_name(), "panel.css")
    return path if os.path.exists(path) else os.path.join(THEMES, "classic", "panel.css")


def theme_setting(key):
    """KEY from the current theme's theme.conf."""
    for line in read(os.path.join(THEMES, theme_name(), "theme.conf")).splitlines():
        if line.startswith(key + "="):
            return line.split("=", 1)[1].strip()
    return ""


DESKTOP_CONF = os.path.join(os.path.dirname(CONFIG), "pcmanfm-qt", "firox", "settings.conf")


class GlassBackdrop:
    """The Glass look's taskbar: the wallpaper behind the bar, blurred and
    slightly magnified at the top and bottom edges like a strip of glass.
    Windows never go behind the taskbar (it reserves its space), so what's
    behind it is always the wallpaper: drawing it ourselves gives real
    frosted glass without the compositor blurring anything. The theme's
    panel.css adds the frost and the bright rims on top.
    Used when the theme's theme.conf has GLASS=1."""

    PAD = 48            # rows above the bar that bleed into the blur

    def __init__(self, changed):
        self.changed = changed
        self.cache = {}
        self.enabled = theme_setting("GLASS") == "1"
        folder = os.path.dirname(DESKTOP_CONF)
        try:
            os.makedirs(folder, exist_ok=True)
            self.mon = Gio.File.new_for_path(folder).monitor_directory(Gio.FileMonitorFlags.NONE, None)
            self.mon.connect("changed", self._desktop_changed)
        except (OSError, GLib.Error):
            self.mon = None

    def _desktop_changed(self, _m, f, _o, event):
        if f.get_basename() == "settings.conf" and event in (
                Gio.FileMonitorEvent.CHANGES_DONE_HINT, Gio.FileMonitorEvent.CREATED,
                Gio.FileMonitorEvent.MOVED_IN):
            self.reset()

    def reset(self):
        self.enabled = theme_setting("GLASS") == "1"
        self.cache.clear()
        self.changed()

    @staticmethod
    def desktop():
        """(wallpaper, mode, background colour) from the desktop's settings."""
        conf = {}
        for path in (DESKTOP_CONF, "/etc/xdg/pcmanfm-qt/firox/settings.conf"):
            text = read(path)
            if not text:
                continue
            section = ""
            for line in text.splitlines():
                line = line.strip()
                if line.startswith("["):
                    section = line
                elif section == "[Desktop]" and "=" in line:
                    k, v = line.split("=", 1)
                    conf[k] = v
            break
        return conf.get("Wallpaper", ""), conf.get("WallpaperMode", "zoom"), conf.get("BgColor", "#3a3c3f")

    def strip(self, width, height, mon_w, mon_h):
        """A cairo surface (width x height) for the bar at the bottom of a
        mon_w x mon_h monitor, or None (no wallpaper: plain CSS look)."""
        if not self.enabled or width <= 0 or height <= 0:
            return None
        path, mode, color = self.desktop()
        try:
            mtime = os.stat(path).st_mtime
        except OSError:
            return None
        key = (path, mtime, mode, color, width, height, mon_w, mon_h)
        if key not in self.cache:
            self.cache.clear()
            try:
                self.cache[key] = self._render(path, mode, color, width, height, mon_w, mon_h)
            except (GLib.Error, ValueError, MemoryError) as err:
                print(f"firox-panel: glass: {err}", file=sys.stderr)
                self.cache[key] = None
        return self.cache[key]

    def _render(self, path, mode, color, width, height, mon_w, mon_h):
        import cairo
        band_h = height + self.PAD
        band = cairo.ImageSurface(cairo.FORMAT_RGB24, width, band_h)
        cr = cairo.Context(band)
        rgba = Gdk.RGBA()
        if not rgba.parse(color):
            rgba.parse("#3a3c3f")
        cr.set_source_rgb(rgba.red, rgba.green, rgba.blue)
        cr.paint()
        top = mon_h - band_h                  # the band's row on the monitor
        _fmt, pw, ph = GdkPixbuf.Pixbuf.get_file_info(path)
        if not pw or not ph:
            raise ValueError(f"can't read {path}")
        sx = width / mon_w                    # bar width may differ from the monitor's
        if mode == "stretch":
            w, h = mon_w, mon_h
        elif mode == "fit":
            k = min(mon_w / pw, mon_h / ph)
            w, h = pw * k, ph * k
        elif mode in ("center", "tile"):
            w, h = pw, ph
        else:                                 # zoom (cover)
            k = max(mon_w / pw, mon_h / ph)
            w, h = pw * k, ph * k
        w, h = max(1, round(w)), max(1, round(h))
        pix = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, w, h, False)
        if mode == "tile":
            for x0 in range(0, mon_w, w):
                for y0 in range(0, mon_h, h):
                    if y0 + h > top:
                        Gdk.cairo_set_source_pixbuf(cr, pix, x0 * sx, y0 - top)
                        cr.paint()
        else:
            cr.save()
            cr.scale(sx, 1)
            Gdk.cairo_set_source_pixbuf(cr, pix, (mon_w - w) / 2, (mon_h - h) / 2 - top)
            cr.paint()
            cr.restore()

        blurred = self._blur(band, width, band_h)

        out = cairo.ImageSurface(cairo.FORMAT_RGB24, width, height)
        cr = cairo.Context(out)
        cr.set_source_surface(blurred, 0, -self.PAD)
        cr.paint()
        # Lens edges: the glass bends light at its rims, so the strip just
        # inside each edge shows the background slightly magnified
        for edge_y, origin in ((0, 0), (height, height)):
            depth = min(9, height / 3)
            grad = cairo.LinearGradient(0, edge_y, 0, edge_y + (depth if origin == 0 else -depth))
            grad.add_color_stop_rgba(0, 0, 0, 0, 0.9)
            grad.add_color_stop_rgba(1, 0, 0, 0, 0)
            cr.save()
            cr.translate(0, origin)
            cr.scale(1, 1.6)
            cr.translate(0, -origin)
            cr.set_source_surface(blurred, 0, -self.PAD)
            cr.restore()
            cr.mask(grad)
        return out

    @staticmethod
    def _blur(src, width, height):
        """A wide, smooth blur: shrink a lot, then scale back up, twice."""
        import cairo
        cur = src
        for factor in (10, 4):
            sw, sh = max(1, width // factor), max(1, height // factor)
            small = cairo.ImageSurface(cairo.FORMAT_RGB24, sw, sh)
            c = cairo.Context(small)
            c.scale(sw / width, sh / height)
            c.set_source_surface(cur, 0, 0)
            c.get_source().set_filter(cairo.FILTER_GOOD)
            c.get_source().set_extend(cairo.EXTEND_PAD)
            c.paint()
            big = cairo.ImageSurface(cairo.FORMAT_RGB24, width, height)
            c = cairo.Context(big)
            c.scale(width / sw, height / sh)
            c.set_source_surface(small, 0, 0)
            c.get_source().set_filter(cairo.FILTER_BILINEAR)
            c.get_source().set_extend(cairo.EXTEND_PAD)
            c.paint()
            cur = big
        return cur


def load_settings():
    out = dict(SETTING_DEFAULTS)
    for line in read(SETTINGS).splitlines():
        if "=" in line and not line.lstrip().startswith("#"):
            k, v = line.split("=", 1)
            out[k.strip()] = v.strip()
    return out


def save_setting(key, value):
    s = load_settings()
    s[key] = value
    os.makedirs(CONFIG, exist_ok=True)
    with open(SETTINGS, "w") as fh:
        fh.write("# firox-panel settings\n")
        for k, v in s.items():
            fh.write(f"{k}={v}\n")


def setting(key):
    return load_settings().get(key, SETTING_DEFAULTS.get(key, "0")) != "0"


def ql_load():
    try:
        with open(QUICK_LAUNCH) as fh:
            return [l.strip() for l in fh if l.strip() and not l.lstrip().startswith("#")]
    except OSError:
        return list(QL_DEFAULTS)


def ql_save(items):
    os.makedirs(CONFIG, exist_ok=True)
    tmp = QUICK_LAUNCH + ".tmp"
    with open(tmp, "w") as fh:
        fh.write("# Quick Launch (firox-quicklaunch): .desktop ids, firox:show-desktop, firox:computer\n")
        for i in items:
            fh.write(i + "\n")
    os.replace(tmp, QUICK_LAUNCH)


def ql_pin(ident, pin=True):
    items = [i for i in ql_load() if i != ident]
    if pin:
        items.append(ident)
    ql_save(items)


def desktop_info(ident):
    try:
        return Gio.DesktopAppInfo.new(ident)
    except TypeError:
        return None


def launch(info):
    try:
        ctx = Gdk.Display.get_default().get_app_launch_context()
        info.launch([], ctx)
    except GLib.Error as err:
        print(f"firox-panel: can't start {info.get_id()}: {err.message}", file=sys.stderr)


class Reorder:
    """Drag buttons along a Gtk.Box to rearrange them (press, move, let go).
    `done(children)` gets the new order; a drag doesn't count as a click."""

    THRESHOLD = 8

    def __init__(self, box, done):
        self.box = box
        self.done = done
        self.btn = None
        self.start = 0
        self.dragging = False

    def attach(self, btn):
        btn.add_events(Gdk.EventMask.BUTTON1_MOTION_MASK)
        btn.connect("button-press-event", self.on_press)
        btn.connect("motion-notify-event", self.on_motion)
        btn.connect("button-release-event", self.on_release)

    def on_press(self, btn, event):
        if event.button == 1 and event.type == Gdk.EventType.BUTTON_PRESS:
            self.btn, self.dragging = btn, False
            self.start = btn.translate_coordinates(self.box, int(event.x), int(event.y))[0]
        return False

    def on_motion(self, btn, event):
        if btn is not self.btn:
            return False
        x = btn.translate_coordinates(self.box, int(event.x), int(event.y))[0]
        if not self.dragging and abs(x - self.start) < self.THRESHOLD:
            return False
        if not self.dragging:
            self.dragging = True
            btn.get_style_context().add_class("dragging")
        kids = [c for c in self.box.get_children() if c.get_visible()]
        target = len(kids) - 1
        for i, c in enumerate(kids):
            cx = c.translate_coordinates(self.box, 0, 0)[0]
            if x < cx + c.get_allocated_width() // 2:
                target = i
                break
        if kids.index(btn) != target:
            self.box.reorder_child(btn, target)
        return True

    def on_release(self, btn, event):
        if btn is not self.btn or event.button != 1:
            return False
        self.btn = None
        if self.dragging:
            self.dragging = False
            btn.get_style_context().remove_class("dragging")
            btn.firox_dragged = True      # swallow the "clicked" that follows
            self.done([c for c in self.box.get_children()])
        return False


def was_dragged(btn):
    if getattr(btn, "firox_dragged", False):
        btn.firox_dragged = False
        return True
    return False


def popup_menu(menu, widget, event):
    """Open a menu above a taskbar widget."""
    menu.show_all()
    menu.attach_to_widget(widget, None)
    menu.popup_at_widget(widget, Gdk.Gravity.NORTH_WEST, Gdk.Gravity.SOUTH_WEST, event)


def menu_item(label, callback=None, sensitive=True, icon=None, bold=False):
    item = Gtk.MenuItem()
    box = Gtk.Box(spacing=8)
    if icon is not None:
        box.pack_start(icon, False, False, 0)
    lab = Gtk.Label(xalign=0)
    lab.set_max_width_chars(48)
    lab.set_ellipsize(3)
    if bold:
        lab.set_markup(f"<b>{GLib.markup_escape_text(label)}</b>")
    else:
        lab.set_text_with_mnemonic(label) if "_" in label else lab.set_text(label)
    box.pack_start(lab, True, True, 0)
    item.add(box)
    item.set_sensitive(sensitive)
    if callback is not None:
        item.connect("activate", lambda _i: callback())
    return item


# ------------------------------------------------------------- app icons --

class Apps:
    """app_id -> (name, GIcon), from the installed .desktop files."""

    def __init__(self):
        self.cache = {}
        self.all = None
        Gio.AppInfoMonitor.get().connect("changed", self.reset)

    def reset(self, *_a):
        self.cache.clear()
        self.all = None

    def find(self, app_id):
        if not app_id:
            return None
        for cand in (app_id, app_id.lower()):
            try:
                info = Gio.DesktopAppInfo.new(cand + ".desktop")
            except TypeError:
                info = None
            if info is not None:
                return info
        low = app_id.lower()
        if self.all is None:
            self.all = [a for a in Gio.AppInfo.get_all() if isinstance(a, Gio.DesktopAppInfo)]
        for a in self.all:
            wm = (a.get_startup_wm_class() or "").lower()
            did = (a.get_id() or "")[:-len(".desktop")].lower()
            exe = os.path.basename((a.get_executable() or "")).lower()
            if low in (wm, did, exe) or did.endswith("." + low):
                return a
        return None

    def lookup(self, app_id):
        if app_id in self.cache:
            return self.cache[app_id]
        info = self.find(app_id)
        name = info.get_name() if info else ""
        gicon = info.get_icon() if info else None
        if gicon is None:
            theme = Gtk.IconTheme.get_default()
            guess = (app_id or "").lower()
            gicon = Gio.ThemedIcon.new(guess if guess and theme.has_icon(guess)
                                       else "application-x-executable")
        out = (name or app_id or "Program", gicon)
        self.cache[app_id] = out
        return out

    def image(self, app_id, size=ICON):
        img = Gtk.Image.new_from_gicon(self.lookup(app_id)[1], Gtk.IconSize.MENU)
        img.set_pixel_size(size)
        return img


APPS = None


# ------------------------------------------------------ window buttons --

class TaskButton(Gtk.Button):
    """One window, or a group of an app's windows."""

    def __init__(self, panel, key):
        super().__init__()
        self.panel = panel
        self.key = key
        self.windows = []
        self.set_relief(Gtk.ReliefStyle.NONE)
        self.set_focus_on_click(False)
        self.add_events(Gdk.EventMask.SCROLL_MASK)
        box = Gtk.Box(spacing=5)
        self.icon = Gtk.Image()
        box.pack_start(self.icon, False, False, 0)
        self.count = Gtk.Label()
        self.count.get_style_context().add_class("count")
        box.pack_start(self.count, False, False, 0)
        self.label = Gtk.Label(xalign=0)
        self.label.set_ellipsize(3)            # END
        # The taskbar sets every button's width (Taskbar.fit); the title
        # just fills it
        self.label.set_width_chars(1)
        self.label.set_max_width_chars(1)
        box.pack_start(self.label, True, True, 0)
        self.arrow = Gtk.Label(label="▴")  # ▴
        self.arrow.get_style_context().add_class("arrow")
        box.pack_end(self.arrow, False, False, 0)
        self.add(box)
        self.show_all()
        self.connect("clicked", self.on_click)
        self.connect("button-press-event", self.on_press)
        self.app_id = None

    @property
    def group(self):
        return len(self.windows) > 1

    def update(self, windows):
        self.windows = windows
        first = windows[0]
        if first.app_id != self.app_id or not self.icon.get_gicon():
            self.app_id = first.app_id
            self.icon.set_from_gicon(APPS.lookup(first.app_id)[1], Gtk.IconSize.MENU)
            self.icon.set_pixel_size(ICON)
        ctx = self.get_style_context()
        if self.group:
            name = APPS.lookup(first.app_id)[0]
            self.count.set_text(str(len(windows)))
            self.label.set_text(name)
            self.set_tooltip_text(f"{name}: {len(windows)} windows\nClick to choose one")
            ctx.add_class("group")
        else:
            self.count.set_text("")
            self.label.set_text(first.label)
            self.set_tooltip_text(first.label)
            ctx.remove_class("group")
        self.count.set_visible(self.group)
        self.arrow.set_visible(self.group)
        active = any(w.active and not w.minimized for w in windows)
        for cls, on in (("active", active), ("minimized", all(w.minimized for w in windows))):
            (ctx.add_class if on else ctx.remove_class)(cls)

    # clicks
    def on_click(self, _b):
        if was_dragged(self):
            return
        tl = self.panel.toplevels
        if self.group:
            menu = Gtk.Menu()
            menu.get_style_context().add_class("firox-taskbar-menu")
            for w in self.windows:
                menu.append(menu_item(w.label, lambda w=w: tl.activate(w),
                                      icon=APPS.image(w.app_id), bold=w.active and not w.minimized))
            self.panel.keep(menu)
            popup_menu(menu, self, Gtk.get_current_event())
            return
        w = self.windows[0]
        if w.active and not w.minimized:
            tl.minimize(w)
        else:
            tl.activate(w)

    def on_press(self, _b, event):
        if event.type != Gdk.EventType.BUTTON_PRESS:
            return False
        tl = self.panel.toplevels
        if event.button == 2:                     # middle: close
            if not self.group:
                tl.close(self.windows[0])
            return True
        if event.button != 3:
            return False
        menu = Gtk.Menu()
        if self.group:
            ws = list(self.windows)
            menu.append(menu_item("_Restore all", lambda: [tl.activate(w) for w in ws if w.minimized]
                                  or None, sensitive=any(w.minimized for w in ws)))
            menu.append(menu_item("Mi_nimize group", lambda: [tl.minimize(w) for w in ws] and None,
                                  sensitive=not all(w.minimized for w in ws)))
            menu.append(Gtk.SeparatorMenuItem())
            self.pin_item(menu)
            menu.append(menu_item(f"_Close group ({len(ws)} windows)",
                                  lambda: [tl.close(w) for w in ws] and None))
        else:
            w = self.windows[0]
            menu.append(menu_item("_Restore", lambda: tl.restore(w), sensitive=w.minimized or w.maximized))
            menu.append(menu_item("Mi_nimize", lambda: tl.minimize(w), sensitive=not w.minimized))
            menu.append(menu_item("Ma_ximize", lambda: tl.maximize(w), sensitive=not w.maximized))
            menu.append(Gtk.SeparatorMenuItem())
            self.pin_item(menu)
            menu.append(menu_item("_Close", lambda: tl.close(w)))
        self.panel.keep(menu)
        popup_menu(menu, self, event)
        return True

    def pin_item(self, menu):
        """Pin/Unpin to Quick Launch, for apps with a Start menu entry."""
        info = APPS.find(self.windows[0].app_id)
        if info is None or not info.get_id():
            return
        ident = info.get_id()
        if ident in ql_load():
            menu.append(menu_item("Unpin from _Quick Launch", lambda: ql_pin(ident, False)))
        else:
            menu.append(menu_item("Pin to _Quick Launch", lambda: ql_pin(ident)))
        menu.append(Gtk.SeparatorMenuItem())


class Taskbar(Gtk.Box):
    WIDEST, NARROWEST = 170, 44     # button width, like XP: equal, shrinking to fit

    def __init__(self, panel, bar):
        super().__init__(spacing=0)
        self.set_name("taskbar")
        self.panel = panel
        self.bar = bar
        self.buttons = {}
        self.order = []          # keys, as you've arranged them (this session)
        self.width = 0
        self.per = 0
        self.reorder = Reorder(self, self.on_reordered)
        self.connect("size-allocate", self.on_allocate)

    def on_reordered(self, children):
        self.order = [c.key for c in children if isinstance(c, TaskButton)]

    def on_allocate(self, _w, alloc):
        if alloc.width != self.width:
            self.width = alloc.width
            GLib.idle_add(self.fit)

    def fit(self):
        n = len(self.buttons)
        if not n:
            return False
        # margins between buttons come from the theme (about 2px each)
        per = max(self.NARROWEST, min(self.WIDEST, self.width // n - 2))
        if per != self.per or any(b.get_size_request()[0] != per for b in self.buttons.values()):
            self.per = per
            for b in self.buttons.values():
                b.set_size_request(per, -1)
        return False

    def refresh(self, windows, grouping):
        groups = {}      # key -> [windows], in the order the first window opened
        for w in windows:
            key = ("g", w.app_id) if grouping and w.app_id else ("w", w.seq)
            groups.setdefault(key, []).append(w)
        # A "group" of one is shown as that window's own button
        wanted = []
        for key, ws in groups.items():
            wanted.append((key if len(ws) > 1 else ("w", ws[0].seq), ws))
        keys = {k for k, _ws in wanted}
        for key in list(self.buttons):
            if key not in keys:
                self.buttons.pop(key).destroy()
        # Your arrangement first; new buttons go on the end
        self.order = [k for k in self.order if k in keys] + [k for k, _ws in wanted if k not in self.order]
        rank = {k: i for i, k in enumerate(self.order)}
        wanted.sort(key=lambda kw: rank[kw[0]])
        for pos, (key, ws) in enumerate(wanted):
            btn = self.buttons.get(key)
            if btn is None:
                btn = TaskButton(self.panel, key)
                self.buttons[key] = btn
                self.reorder.attach(btn)
                self.pack_start(btn, False, False, 0)
            btn.update(ws)
            self.reorder_child(btn, pos)
        self.fit()
        if os.environ.get("FIROX_PANEL_DEBUG"):
            geo = self.bar.monitor.get_geometry()
            print(f"bar@{geo.x},{geo.y}: " + ", ".join(
                f"{w.title}[{','.join(str(self.panel.toplevels.outputs.get(o)) for o in w.outputs)}]"
                for w in windows), file=sys.stderr)


# ------------------------------------------------- notification area: apps --

WATCHER_XML = """
<node>
  <interface name="org.kde.StatusNotifierWatcher">
    <method name="RegisterStatusNotifierItem"><arg type="s" direction="in"/></method>
    <method name="RegisterStatusNotifierHost"><arg type="s" direction="in"/></method>
    <property name="RegisteredStatusNotifierItems" type="as" access="read"/>
    <property name="IsStatusNotifierHostRegistered" type="b" access="read"/>
    <property name="ProtocolVersion" type="i" access="read"/>
    <signal name="StatusNotifierItemRegistered"><arg type="s"/></signal>
    <signal name="StatusNotifierItemUnregistered"><arg type="s"/></signal>
    <signal name="StatusNotifierHostRegistered"/>
    <signal name="StatusNotifierHostUnregistered"/>
  </interface>
</node>
"""
SNI = "org.kde.StatusNotifierItem"
WATCHER = "org.kde.StatusNotifierWatcher"


class TrayItem:
    def __init__(self, tray, bus, path):
        self.tray = tray
        self.bus = bus
        self.path = path
        self.props = {}
        self.refetching = False
        self.sub = tray.conn.signal_subscribe(bus, SNI, None, path, None, Gio.DBusSignalFlags.NONE,
                                              lambda *_a: self.refetch())
        self.refetch()

    @property
    def key(self):
        return self.bus + self.path

    def refetch(self):
        if self.refetching:
            return
        self.refetching = True
        GLib.timeout_add(50, self._fetch)

    def _fetch(self):
        self.tray.conn.call(self.bus, self.path, "org.freedesktop.DBus.Properties", "GetAll",
                            GLib.Variant("(s)", (SNI,)), GLib.VariantType("(a{sv})"),
                            Gio.DBusCallFlags.NONE, 3000, None, self._got)
        return False

    def _got(self, conn, res):
        self.refetching = False
        try:
            (self.props,) = conn.call_finish(res).unpack()
        except GLib.Error:
            return
        self.tray.item_changed(self)

    def drop(self):
        self.tray.conn.signal_unsubscribe(self.sub)

    # what to show
    def pixbuf(self, size):
        p = self.props
        attention = p.get("Status") == "NeedsAttention"
        name = (attention and p.get("AttentionIconName")) or p.get("IconName") or ""
        if name:
            pb = self._named(name, p.get("IconThemePath") or "", size)
            if pb is not None:
                return pb
        pixmaps = (attention and p.get("AttentionIconPixmap")) or p.get("IconPixmap") or []
        return self._pixmap(pixmaps, size)

    @staticmethod
    def _named(name, theme_path, size):
        try:
            if name.startswith("/") and os.path.exists(name):
                return GdkPixbuf.Pixbuf.new_from_file_at_size(name, size, size)
            if theme_path:
                for ext in ("svg", "png", "xpm"):
                    hits = glob.glob(os.path.join(theme_path, "**", f"{name}.{ext}"), recursive=True)
                    if hits:
                        return GdkPixbuf.Pixbuf.new_from_file_at_size(sorted(hits)[-1], size, size)
            theme = Gtk.IconTheme.get_default()
            if theme.has_icon(name):
                return theme.load_icon(name, size, Gtk.IconLookupFlags.FORCE_SIZE)
        except GLib.Error:
            pass
        return None

    @staticmethod
    def _pixmap(pixmaps, size):
        best = None
        for w, h, data in pixmaps:
            if w <= 0 or h <= 0 or len(data) < w * h * 4:
                continue
            if best is None or (best[0] < size and w > best[0]) or (size <= w < best[0]):
                best = (w, h, data)
        if best is None:
            return None
        w, h, data = best
        argb = bytes(data[:w * h * 4])
        rgba = bytearray(len(argb))
        rgba[0::4], rgba[1::4], rgba[2::4], rgba[3::4] = argb[1::4], argb[2::4], argb[3::4], argb[0::4]
        pb = GdkPixbuf.Pixbuf.new_from_bytes(GLib.Bytes.new(bytes(rgba)), GdkPixbuf.Colorspace.RGB,
                                             True, 8, w, h, w * 4)
        return pb if (w, h) == (size, size) else pb.scale_simple(size, size, GdkPixbuf.InterpType.BILINEAR)

    def tooltip(self):
        tip = self.props.get("ToolTip")
        if tip and len(tip) >= 4 and (tip[2] or tip[3]):
            text = "\n".join(x for x in (tip[2], tip[3]) if x)
        else:
            text = self.props.get("Title") or ""
        return re.sub(r"<[^>]*>", "", text)

    def hidden(self):
        return self.props.get("Status") == "Passive"

    # clicks
    def call(self, method, args, on_error=None):
        def done(conn, res):
            try:
                conn.call_finish(res)
            except GLib.Error:
                if on_error:
                    on_error()
        self.tray.conn.call(self.bus, self.path, SNI, method, args, None,
                            Gio.DBusCallFlags.NONE, 3000, None, done)

    def show_menu(self, widget, event):
        menu_path = self.props.get("Menu")
        if not menu_path or menu_path == "/":
            self.call("ContextMenu", GLib.Variant("(ii)", (int(event.x_root), int(event.y_root))))
            return
        DBusMenu(self.tray, self.bus, menu_path).open(widget, event)


class DBusMenu:
    """A com.canonical.dbusmenu menu (what tray apps use) as a Gtk.Menu."""

    IFACE = "com.canonical.dbusmenu"

    def __init__(self, tray, bus, path):
        self.tray = tray
        self.bus = bus
        self.path = path

    def open(self, widget, event):
        conn = self.tray.conn
        event = event.copy()       # the menu opens after the reply; GTK frees the original
        conn.call(self.bus, self.path, self.IFACE, "AboutToShow", GLib.Variant("(i)", (0,)),
                  None, Gio.DBusCallFlags.NONE, 1000, None, None)

        def got(c, res):
            try:
                _rev, layout = c.call_finish(res).unpack()
            except GLib.Error as err:
                print(f"firox-panel: tray menu: {err.message}", file=sys.stderr)
                return
            menu = self.build(layout)
            self.tray.panel.keep(menu)
            popup_menu(menu, widget, event)
        conn.call(self.bus, self.path, self.IFACE, "GetLayout",
                  GLib.Variant("(iias)", (0, -1, [])), GLib.VariantType("(u(ia{sv}av))"),
                  Gio.DBusCallFlags.NONE, 3000, None, got)

    def build(self, layout):
        menu = Gtk.Menu()
        _id, _props, children = layout
        group = None
        for child in children:
            cid, props, sub = child
            if not props.get("visible", True):
                continue
            if props.get("type") == "separator":
                menu.append(Gtk.SeparatorMenuItem())
                group = None
                continue
            label = props.get("label", "")
            toggle = props.get("toggle-type", "")
            if toggle in ("checkmark", "radio"):
                item = Gtk.CheckMenuItem.new_with_mnemonic(label)
                item.set_draw_as_radio(toggle == "radio")
                item.set_active(props.get("toggle-state", 0) == 1)
            else:
                item = Gtk.MenuItem.new_with_mnemonic(label)
                group = None
            item.set_sensitive(props.get("enabled", True))
            if sub or props.get("children-display") == "submenu":
                item.set_submenu(self.build(child))
            else:
                item.connect("activate", lambda _i, cid=cid: self.clicked(cid))
            menu.append(item)
        return menu

    def clicked(self, cid):
        self.tray.conn.call(self.bus, self.path, self.IFACE, "Event",
                            GLib.Variant("(isvu)", (cid, "clicked", GLib.Variant("i", 0), int(time.time()))),
                            None, Gio.DBusCallFlags.NONE, 3000, None, None)


class Tray:
    """StatusNotifierWatcher + host: the icons apps put in the notification
    area. If something else already is the watcher, use that one."""

    def __init__(self, panel):
        self.panel = panel
        self.items = {}            # key -> TrayItem
        self.watches = {}          # bus -> watch id
        self.views = []
        self.conn = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        self.node = Gio.DBusNodeInfo.new_for_xml(WATCHER_XML)
        self.reg_id = None
        self.remote_subs = []
        Gio.bus_own_name_on_connection(self.conn, f"org.kde.StatusNotifierHost-{os.getpid()}",
                                       Gio.BusNameOwnerFlags.NONE, None, None)
        Gio.bus_own_name_on_connection(self.conn, WATCHER, Gio.BusNameOwnerFlags.NONE,
                                       self.on_acquired, self.on_lost)

    # we are the watcher
    def on_acquired(self, conn, _name):
        for sub in self.remote_subs:
            conn.signal_unsubscribe(sub)
        self.remote_subs = []
        if self.reg_id is None:
            self.reg_id = conn.register_object("/StatusNotifierWatcher", self.node.interfaces[0],
                                               self.on_method, self.on_get, None)
        conn.emit_signal(None, "/StatusNotifierWatcher", WATCHER, "StatusNotifierHostRegistered", None)

    def on_method(self, _conn, sender, _path, _iface, method, params, invocation):
        if method == "RegisterStatusNotifierItem":
            (service,) = params.unpack()
            if service.startswith("/"):
                bus, path = sender, service
            else:
                bus, path = service, "/StatusNotifierItem"
            self.add(bus, path)
            invocation.return_value(None)
        elif method == "RegisterStatusNotifierHost":
            invocation.return_value(None)
        else:
            invocation.return_dbus_error("org.freedesktop.DBus.Error.UnknownMethod", method)

    def on_get(self, _conn, _sender, _path, _iface, prop):
        if prop == "RegisteredStatusNotifierItems":
            return GLib.Variant("as", list(self.items))
        if prop == "IsStatusNotifierHostRegistered":
            return GLib.Variant("b", True)
        if prop == "ProtocolVersion":
            return GLib.Variant("i", 0)
        return None

    # someone else is the watcher: be a host of theirs
    def on_lost(self, conn, _name):
        if self.reg_id is not None or self.remote_subs:
            return
        self.remote_subs = [
            conn.signal_subscribe(None, WATCHER, "StatusNotifierItemRegistered", "/StatusNotifierWatcher",
                                  None, Gio.DBusSignalFlags.NONE,
                                  lambda c, s, p, i, n, params: self.add_id(params.unpack()[0])),
        ]
        conn.call(WATCHER, "/StatusNotifierWatcher", WATCHER, "RegisterStatusNotifierHost",
                  GLib.Variant("(s)", (f"org.kde.StatusNotifierHost-{os.getpid()}",)),
                  None, Gio.DBusCallFlags.NONE, 3000, None, None)

        def got(c, res):
            try:
                (val,) = c.call_finish(res).unpack()
            except GLib.Error:
                return
            for ident in val:
                self.add_id(ident)
        conn.call(WATCHER, "/StatusNotifierWatcher", "org.freedesktop.DBus.Properties", "Get",
                  GLib.Variant("(ss)", (WATCHER, "RegisteredStatusNotifierItems")),
                  GLib.VariantType("(v)"), Gio.DBusCallFlags.NONE, 3000, None, got)

    def add_id(self, ident):
        i = ident.find("/")
        if i <= 0:
            self.add(ident, "/StatusNotifierItem")
        else:
            self.add(ident[:i], ident[i:])

    # items
    def add(self, bus, path):
        key = bus + path
        if key in self.items:
            return
        item = TrayItem(self, bus, path)
        self.items[key] = item
        if bus not in self.watches:
            self.watches[bus] = Gio.bus_watch_name_on_connection(
                self.conn, bus, Gio.BusNameWatcherFlags.NONE, None, self.on_vanished)
        if self.reg_id is not None:
            self.conn.emit_signal(None, "/StatusNotifierWatcher", WATCHER, "StatusNotifierItemRegistered",
                                  GLib.Variant("(s)", (key,)))

    def on_vanished(self, _conn, bus):
        watch = self.watches.pop(bus, None)
        if watch is not None:
            Gio.bus_unwatch_name(watch)
        for key in [k for k, it in self.items.items() if it.bus == bus]:
            self.items.pop(key).drop()
            if self.reg_id is not None:
                self.conn.emit_signal(None, "/StatusNotifierWatcher", WATCHER,
                                      "StatusNotifierItemUnregistered", GLib.Variant("(s)", (key,)))
        for v in self.views:
            v.refresh()

    def item_changed(self, _item):
        for v in self.views:
            v.refresh()


class TrayView(Gtk.Box):
    def __init__(self, tray):
        super().__init__(spacing=2)
        self.set_name("tray")
        self.set_no_show_all(True)
        self.tray = tray
        self.icons = {}
        tray.views.append(self)
        self.connect("destroy", lambda _w: tray.views.remove(self))
        self.refresh()

    def refresh(self):
        items = self.tray.items
        for key in list(self.icons):
            if key not in items:
                self.icons.pop(key).destroy()
        for key, item in items.items():
            btn = self.icons.get(key)
            if btn is None:
                btn = Gtk.Button()
                btn.set_no_show_all(True)
                btn.set_relief(Gtk.ReliefStyle.NONE)
                btn.set_focus_on_click(False)
                btn.add(Gtk.Image())
                btn.add_events(Gdk.EventMask.SCROLL_MASK)
                btn.connect("button-press-event", self.on_press, key)
                btn.connect("scroll-event", self.on_scroll, key)
                self.icons[key] = btn
                self.pack_start(btn, False, False, 0)
            pb = item.pixbuf(ICON * btn.get_scale_factor())
            img = btn.get_child()
            if pb is not None:
                if btn.get_scale_factor() > 1:
                    surf = Gdk.cairo_surface_create_from_pixbuf(pb, btn.get_scale_factor(), None)
                    img.set_from_surface(surf)
                else:
                    img.set_from_pixbuf(pb)
            else:
                img.set_from_icon_name("image-missing", Gtk.IconSize.MENU)
            btn.set_tooltip_text(item.tooltip() or None)
            btn.set_visible(not item.hidden())
            img.show()
        self.set_visible(any(not it.hidden() for it in items.values()))

    def on_press(self, btn, event, key):
        item = self.tray.items.get(key)
        if item is None or event.type != Gdk.EventType.BUTTON_PRESS:
            return True
        pos = GLib.Variant("(ii)", (int(event.x_root), int(event.y_root)))
        if event.button == 1:
            if item.props.get("ItemIsMenu"):
                item.show_menu(btn, event)
            else:
                ev = event.copy()
                item.call("Activate", pos, on_error=lambda: item.show_menu(btn, ev))
        elif event.button == 2:
            item.call("SecondaryActivate", pos)
        elif event.button == 3:
            item.show_menu(btn, event)
        return True

    def on_scroll(self, _btn, event, key):
        item = self.tray.items.get(key)
        if item is None:
            return True
        delta = {Gdk.ScrollDirection.UP: -1, Gdk.ScrollDirection.DOWN: 1}.get(event.direction)
        if delta is not None:
            item.call("Scroll", GLib.Variant("(is)", (delta * 120, "vertical")))
        return True


# ---------------------------------------- notification area: indicators --

class Indicator:
    """A glyph in the notification area, shown on every bar."""

    def __init__(self, name):
        self.name = name
        self.text = ""
        self.icon = None          # a symbolic icon name, shown instead of / before the text
        self.tip = ""
        self.classes = set()
        self.visible = True
        self.views = []

    def make(self):
        btn = Gtk.Button()
        btn.set_name(self.name)
        btn.set_relief(Gtk.ReliefStyle.NONE)
        btn.set_focus_on_click(False)
        box = Gtk.Box(spacing=3)
        btn.firox_image = Gtk.Image()
        btn.firox_image.set_no_show_all(True)
        btn.firox_label = Gtk.Label()
        btn.firox_label.set_no_show_all(True)
        box.pack_start(btn.firox_image, False, False, 0)
        box.pack_start(btn.firox_label, False, False, 0)
        box.show()
        btn.add(box)
        btn.add_events(Gdk.EventMask.SCROLL_MASK)
        btn.connect("button-press-event", lambda b, e: self.on_press(b, e) if e.type == Gdk.EventType.BUTTON_PRESS else True)
        btn.connect("scroll-event", lambda b, e: self.on_scroll(e) or True)
        self.views.append(btn)
        btn.connect("destroy", lambda b: self.views.remove(b))
        self.paint(btn)
        return btn

    def set(self, text=None, tip=None, classes=None, visible=None, icon=None):
        if icon is not None:
            self.icon = icon or None
        if text is not None:
            self.text = text
        if tip is not None:
            self.tip = tip
        if classes is not None:
            self.classes = set(classes)
        if visible is not None:
            self.visible = visible
        for b in self.views:
            self.paint(b)

    def paint(self, btn):
        btn.firox_label.set_text(self.text)
        btn.firox_label.set_visible(bool(self.text))
        if self.icon:
            btn.firox_image.set_from_icon_name(self.icon, Gtk.IconSize.MENU)
            btn.firox_image.set_pixel_size(16)
        btn.firox_image.set_visible(bool(self.icon))
        btn.set_tooltip_text(self.tip or None)
        ctx = btn.get_style_context()
        for cls in getattr(btn, "firox_classes", set()) - self.classes:
            ctx.remove_class(cls)
        for cls in self.classes:
            ctx.add_class(cls)
        btn.firox_classes = set(self.classes)
        btn.set_no_show_all(True)
        btn.set_visible(self.visible)

    def on_press(self, _btn, event):
        cmd = {1: self.left, 2: self.middle, 3: self.right}.get(event.button)
        if cmd:
            cmd()
        return True

    def left(self):
        pass

    middle = right = left

    def on_scroll(self, _event):
        pass


class Awake(Indicator):
    """Keep the screen on (what waybar called the idle inhibitor)."""

    def __init__(self):
        super().__init__("idle_inhibitor")
        self.update()

    def update(self):
        on = os.path.exists(AWAKE)
        self.set(FA_EYE if on else FA_EYE_SLASH,
                 "Keeping the screen on: the screen saver, screen off and sleep timers are paused\n"
                 "Click to turn this off" if on else
                 "Click to keep the screen on (pause the screen saver and sleep timers)",
                 ["activated" if on else "deactivated"])

    def left(self):
        subprocess.run(["firox-power", "awake", "toggle"], stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL, timeout=10)
        self.update()


class Volume(Indicator):
    def __init__(self):
        super().__init__("pulseaudio")
        self.pending = False
        self.update()
        self.watch()

    def watch(self):
        """pactl subscribe tells us about changes made anywhere."""
        try:
            proc = Gio.Subprocess.new(["pactl", "subscribe"], Gio.SubprocessFlags.STDOUT_PIPE
                                      | Gio.SubprocessFlags.STDERR_SILENCE)
        except GLib.Error:
            GLib.timeout_add_seconds(3, lambda: self.update() or True)
            return
        stream = Gio.DataInputStream.new(proc.get_stdout_pipe())

        def line(s, res):
            try:
                text, _len = s.read_line_finish_utf8(res)
            except GLib.Error:
                text = None
            if text is None:                 # pactl ended (sound server restarted)
                GLib.timeout_add_seconds(3, lambda: self.watch() or False)
                return
            if "sink" in text or "server" in text:
                self.soon()
            s.read_line_async(GLib.PRIORITY_DEFAULT, None, line)
        stream.read_line_async(GLib.PRIORITY_DEFAULT, None, line)

    def soon(self):
        if not self.pending:
            self.pending = True
            GLib.timeout_add(100, self.update)

    def update(self):
        self.pending = False
        try:
            out = subprocess.run(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"], capture_output=True,
                                 text=True, timeout=3).stdout
        except (OSError, subprocess.SubprocessError):
            out = ""
        m = re.search(r"Volume:\s*([\d.]+)", out)
        if not m:
            self.set(FA_MUTED, "No sound device\nClick for the volume control", ["muted"])
            return False
        pct = round(float(m.group(1)) * 100)
        muted = "MUTED" in out
        glyph = FA_MUTED if muted else FA_VOLUME[min(2, pct * 3 // 101)]
        self.set(glyph, f"Volume: {pct}%{' (muted)' if muted else ''}\n"
                        "Click for the volume control. Right-click to mute.",
                 ["muted"] if muted else [])
        return False

    def left(self):
        spawn(["firox-volume", "toggle"])

    def right(self):
        spawn(["firox-osd", "volume", "mute"])

    def on_scroll(self, event):
        step = {Gdk.ScrollDirection.UP: "5%+", Gdk.ScrollDirection.DOWN: "5%-"}.get(event.direction)
        if step is None and event.direction == Gdk.ScrollDirection.SMOOTH:
            ok, _dx, dy = event.get_scroll_deltas()
            step = "5%-" if ok and dy > 0 else "5%+" if ok and dy < 0 else None
        if step:
            subprocess.run(["wpctl", "set-volume", "-l", "1.0", "@DEFAULT_AUDIO_SINK@", step], timeout=3)
            self.update()


class Battery(Indicator):
    PS = os.environ.get("FIROX_POWER_SUPPLY", "/sys/class/power_supply")

    def __init__(self):
        super().__init__("battery")
        self.update()
        GLib.timeout_add_seconds(30, lambda: self.update() or True)

    def update(self):
        bats, mains = [], False
        for d in glob.glob(os.path.join(self.PS, "*")):
            kind = read(os.path.join(d, "type"))
            if kind == "Battery" and read(os.path.join(d, "scope")) != "Device":
                bats.append(d)
            elif kind == "Mains" and read(os.path.join(d, "online")) == "1":
                mains = True
        if not bats:
            self.set(visible=False)
            return
        caps = [int(read(os.path.join(d, "capacity")) or 0) for d in bats]
        pct = sum(caps) // len(caps)
        status = {read(os.path.join(d, "status")) for d in bats}
        charging = "Charging" in status
        plugged = mains or charging or status <= {"Full", "Not charging"}
        left = self.time_left(bats, charging)
        if charging:
            tip = f"{pct}% charging" + (f" ({left} until full)" if left else "")
        elif plugged:
            tip = f"{pct}%, plugged in"
        else:
            tip = f"{pct}% remaining" + (f" ({left})" if left else "")
        cls = ["critical"] if pct <= 10 and not plugged else ["warning"] if pct <= 20 and not plugged else []
        glyph = FA_CHARGING if charging else FA_BATTERY[min(4, pct * 5 // 101)]
        self.set(glyph, tip + "\nClick for battery, brightness and power mode",
                 cls + (["charging"] if charging else []), True)

    def time_left(self, bats, charging):
        now = full = rate = 0
        for d in bats:
            n = read(os.path.join(d, "energy_now")) or read(os.path.join(d, "charge_now"))
            f = read(os.path.join(d, "energy_full")) or read(os.path.join(d, "charge_full"))
            r = read(os.path.join(d, "power_now")) or read(os.path.join(d, "current_now"))
            try:
                now, full, rate = now + int(n), full + int(f), rate + abs(int(r))
            except ValueError:
                return ""
        if rate <= 0:
            return ""
        hours = (full - now) / rate if charging else now / rate
        if hours <= 0 or hours > 48:
            return ""
        h, m = divmod(int(hours * 60), 60)
        return f"{h} h {m:02d} min" if h else f"{m} min"

    def left(self):
        spawn(["firox-battery", "toggle"])

    def right(self):
        spawn(["firox-control-panel", "power"])


class Network(Indicator):
    """Wi-Fi / wired status from NetworkManager (libnm); click for firox-network."""

    def __init__(self):
        super().__init__("network")
        self.client = None
        self.pending = False
        self.watched = set()
        try:
            gi.require_version("NM", "1.0")
            from gi.repository import NM
            self.NM = NM
            self.client = NM.Client.new(None)
        except (ValueError, ImportError, GLib.Error) as err:
            print(f"panel: no network status: {err}", file=sys.stderr)
            self.set(visible=False)
            return
        for sig in ("notify::primary-connection", "notify::active-connections", "notify::state",
                    "notify::wireless-enabled", "notify::networking-enabled", "notify::nm-running",
                    "device-added", "device-removed"):
            self.client.connect(sig, lambda *_: self.soon())
        GLib.timeout_add_seconds(15, lambda: self.update() or True)   # signal strength
        self.update()

    def soon(self):
        if not self.pending:
            self.pending = True
            GLib.timeout_add(200, self.update)

    def update(self):
        self.pending = False
        NM = self.NM
        c = self.client
        if c is None or not c.get_nm_running():
            self.set(visible=False)
            return False
        devs = [d for d in c.get_devices() if d.get_state() != NM.DeviceState.UNMANAGED]
        wifi = [d for d in devs if isinstance(d, NM.DeviceWifi)]
        for d in wifi:
            if d.get_path() not in self.watched:
                self.watched.add(d.get_path())
                d.connect("notify::active-access-point", lambda *_: self.soon())
        airplane = wifi and not c.wireless_get_enabled() and not any(
            isinstance(d, NM.DeviceEthernet) and d.get_state() == NM.DeviceState.ACTIVATED for d in devs)
        primary = c.get_primary_connection()
        activating = c.get_activating_connection()
        vpn = any(ac.get_vpn() or ac.get_connection_type() == "wireguard"
                  for ac in c.get_active_connections()
                  if ac.get_state() == NM.ActiveConnectionState.ACTIVATED)
        tip_vpn = "\nVPN on" if vpn else ""
        tail = "\nClick for networks"
        if primary is not None and primary.get_state() == NM.ActiveConnectionState.ACTIVATED:
            kind = primary.get_connection_type()
            dev = (primary.get_devices() or [None])[0]
            if kind == "802-11-wireless" and isinstance(dev, NM.DeviceWifi) and dev.get_active_access_point():
                ap = dev.get_active_access_point()
                strength = ap.get_strength()
                level = next(n for lim, n in ((75, "excellent"), (50, "good"), (25, "ok"), (1, "weak"),
                                              (-1, "none")) if strength >= lim)
                self.set("", f"Connected to {primary.get_id()} (signal {strength}%){tip_vpn}{tail}",
                         ["connected"], True, f"network-wireless-signal-{level}-symbolic")
            elif kind in ("vpn", "wireguard"):
                self.set("", f"Connected ({primary.get_id()}){tip_vpn}{tail}", ["connected"], True,
                         "network-vpn-symbolic")
            else:
                self.set("", f"Connected to {primary.get_id()}{tip_vpn}{tail}", ["connected"], True,
                         "network-wired-symbolic")
        elif activating is not None:
            wl = activating.get_connection_type() == "802-11-wireless"
            self.set("", f"Connecting to {activating.get_id()}…{tail}", ["connecting"], True,
                     "network-wireless-acquiring-symbolic" if wl else "network-wired-acquiring-symbolic")
        elif airplane:
            self.set("", f"Wi-Fi is off{tail}", ["disconnected"], True, "network-wireless-disabled-symbolic")
        elif wifi:
            self.set("", f"Not connected{tail}", ["disconnected"], True, "network-wireless-offline-symbolic")
        elif devs:
            self.set("", f"Not connected{tail}", ["disconnected"], True, "network-wired-disconnected-symbolic")
        else:
            self.set(visible=False)
        return False

    def left(self):
        spawn(["firox-network", "toggle"])

    def right(self):
        spawn(["nm-connection-editor"])


class Bluetooth(Indicator):
    """Shown when the computer has Bluetooth; click for firox-bluetooth."""

    def __init__(self):
        super().__init__("bluetooth")
        self.pending = False
        self.manager = None
        self.set(visible=False)
        try:
            self.manager = Gio.DBusObjectManagerClient.new_for_bus_sync(
                Gio.BusType.SYSTEM, Gio.DBusObjectManagerClientFlags.NONE, "org.bluez", "/",
                None, None, None)
        except GLib.Error as err:
            print(f"panel: no Bluetooth status: {err.message}", file=sys.stderr)
            return
        for sig in ("object-added", "object-removed", "interface-added", "interface-removed",
                    "interface-proxy-properties-changed", "notify::name-owner"):
            self.manager.connect(sig, lambda *_: self.soon())
        self.update()

    def soon(self):
        if not self.pending:
            self.pending = True
            GLib.timeout_add(200, self.update)

    def update(self):
        self.pending = False
        m = self.manager
        if m is None or m.get_name_owner() is None:
            self.set(visible=False)
            return False
        adapters, connected = [], []
        for obj in m.get_objects():
            a = obj.get_interface("org.bluez.Adapter1")
            if a is not None:
                adapters.append(a)
            d = obj.get_interface("org.bluez.Device1")
            if d is not None:
                v = d.get_cached_property("Connected")
                if v is not None and v.unpack():
                    name = d.get_cached_property("Alias")
                    connected.append(name.unpack() if name else "a device")
        if not adapters:
            self.set(visible=False)
            return False
        pw = adapters[0].get_cached_property("Powered")
        on = bool(pw and pw.unpack())
        if not on:
            self.set("", "Bluetooth is off\nClick to turn it on or pair a device", ["off"], True,
                     "bluetooth-disabled-symbolic")
        elif connected:
            self.set("", "Connected to " + ", ".join(connected) + "\nClick for Bluetooth devices",
                     ["connected"], True, "bluetooth-active-symbolic")
        else:
            self.set("", "Bluetooth is on\nClick to connect or pair a device", ["on"], True,
                     "bluetooth-active-symbolic")
        return False

    def left(self):
        spawn(["firox-bluetooth", "toggle"])

    def right(self):
        spawn(["blueman-manager"])


class Updates(Indicator):
    def __init__(self):
        super().__init__("custom-updates")
        self.set(visible=False)
        GLib.timeout_add_seconds(5, lambda: self.update() and False)
        GLib.timeout_add_seconds(900, lambda: self.update() or True)

    def update(self):
        try:
            proc = Gio.Subprocess.new(["firox-updates", "status"], Gio.SubprocessFlags.STDOUT_PIPE
                                      | Gio.SubprocessFlags.STDERR_SILENCE)
        except GLib.Error:
            return False

        def done(p, res):
            try:
                _ok, out, _err = p.communicate_utf8_finish(res)
                data = json.loads(out or "{}")
            except (GLib.Error, ValueError):
                return
            text = data.get("text", "")
            self.set(text, data.get("tooltip", ""), [data.get("class", "")], bool(text))
        proc.communicate_utf8_async(None, None, done)
        return False

    def left(self):
        spawn(["firox-updates", "restart"])

    def right(self):
        spawn(["firox-updates", "whatsnew"])


class Bell(Indicator):
    def __init__(self):
        super().__init__("custom-notifications")
        os.makedirs(STATE, exist_ok=True)
        self.mon = Gio.File.new_for_path(STATE).monitor_directory(Gio.FileMonitorFlags.NONE, None)
        self.mon.connect("changed", lambda *_a: self.update())
        self.update()

    def update(self):
        dnd = os.path.exists(os.path.join(STATE, "do-not-disturb"))
        self.set(FA_BELL_OFF if dnd else FA_BELL,
                 ("Do Not Disturb is on" if dnd else "Notifications")
                 + "\nClick to open. Right-click for Do Not Disturb.",
                 ["dnd"] if dnd else ["read"])

    def left(self):
        spawn(["firox-notifications", "toggle"])

    def right(self):
        spawn(["firox-notifications", "dnd", "toggle"])


class Clock(Indicator):
    def __init__(self, seconds=False):
        super().__init__("clock")
        self.seconds = seconds
        self.timer = None
        self.tick()

    def set_seconds(self, on):
        if on != self.seconds:
            self.seconds = on
            if self.timer is not None:
                GLib.source_remove(self.timer)
            self.tick()

    def tick(self):
        now = time.localtime()
        fmt = "%I:%M:%S %p" if self.seconds else "%I:%M %p"
        self.set(time.strftime(fmt, now).lstrip("0"),
                 time.strftime("%A, ", now) + time.strftime("%B ", now) + str(now.tm_mday)
                 + time.strftime(", %Y", now) + "\nClick for the calendar")
        if self.seconds:
            self.timer = GLib.timeout_add(1000 - int(time.time() * 1000) % 1000 + 5, self.tick)
        else:
            self.timer = GLib.timeout_add_seconds(60 - now.tm_sec, self.tick)
        return False

    def left(self):
        spawn(["firox-calendar", "toggle"])

    def right(self):
        spawn(["firox-control-panel", "datetime"])


# -------------------------------------------------------------------- bar --

class Bar(Gtk.Window):
    def on_draw_glass(self, _w, cr):
        """Glass look: the blurred wallpaper strip first; the CSS frost,
        rims and buttons are drawn over it."""
        glass = self.panel.glass
        if glass is None or not glass.enabled:
            return False
        alloc = self.get_allocation()
        geo = self.monitor.get_geometry()
        surf = glass.strip(alloc.width, alloc.height, geo.width, geo.height)
        if surf is not None:
            cr.set_source_surface(surf, 0, 0)
            cr.paint()
        return False

    def __init__(self, panel, monitor, main=True):
        super().__init__()
        self.panel = panel
        self.monitor = monitor
        self.main = main                  # main display: the full bar
        self.set_name("panel")
        if not main:
            self.get_style_context().add_class("extended")
        self.set_title("Taskbar")
        self.set_decorated(False)
        GtkLayerShell.init_for_window(self)
        GtkLayerShell.set_namespace(self, "firox-panel")
        GtkLayerShell.set_layer(self, GtkLayerShell.Layer.TOP)
        GtkLayerShell.set_monitor(self, monitor)
        for edge in (GtkLayerShell.Edge.BOTTOM, GtkLayerShell.Edge.LEFT, GtkLayerShell.Edge.RIGHT):
            GtkLayerShell.set_anchor(self, edge, True)
        GtkLayerShell.auto_exclusive_zone_enable(self)
        self.set_size_request(-1, HEIGHT)
        self.connect("draw", self.on_draw_glass)

        catcher = Gtk.EventBox()          # right-click on an empty part
        catcher.connect("button-press-event", self.on_empty_press)
        catcher.add_events(Gdk.EventMask.ENTER_NOTIFY_MASK | Gdk.EventMask.LEAVE_NOTIFY_MASK)
        catcher.connect("enter-notify-event", self.on_enter)
        catcher.connect("leave-notify-event", self.on_leave)
        self.add(catcher)
        row = Gtk.Box()
        row.set_name("row")
        self.row = row
        catcher.add(row)
        self.autohide = False
        self.hidden = False
        self.hide_timer = None

        start = Gtk.Button(label="firox")
        start.set_name("custom-start")
        start.set_relief(Gtk.ReliefStyle.NONE)
        start.set_focus_on_click(False)
        start.set_tooltip_text("Click here to begin.")
        start.connect("clicked", lambda _b: spawn(["firox-startmenu"]))
        row.pack_start(start, False, False, 0)

        self.ql = Gtk.Box(spacing=0)
        self.ql.set_name("quick-launch")
        self.ql.set_no_show_all(True)
        self.ql_reorder = Reorder(self.ql, self.on_ql_reordered)
        row.pack_start(self.ql, False, False, 0)
        self.ql_sep = Gtk.Separator(orientation=Gtk.Orientation.VERTICAL)
        self.ql_sep.set_name("custom-ql-sep")
        self.ql_sep.set_no_show_all(True)
        row.pack_start(self.ql_sep, False, False, 0)
        self.fill_ql()

        self.taskbar = Taskbar(panel, self)
        row.pack_start(self.taskbar, True, True, 0)

        area = Gtk.EventBox()             # the notification area's background
        area.set_name("notification-area")
        tray_row = Gtk.Box()
        area.add(tray_row)
        # Other monitors: just the clock (tray icons live on the main display)
        indicators = panel.indicators if main else [panel.clock]
        if main:
            tray_row.pack_start(TrayView(panel.tray), False, False, 0)
        for ind in indicators:
            tray_row.pack_start(ind.make(), False, False, 0)
        row.pack_end(area, False, False, 0)
        self.show_all()
        for ind in indicators:
            ind.set()
        self.apply_settings()

    # ---- Quick Launch
    def fill_ql(self):
        for child in self.ql.get_children():
            child.destroy()
        for ident in ql_load():
            if ident in QL_BUILTIN:
                icon, cmd, tip = QL_BUILTIN[ident]
                image, run = self.ql_icon(icon), (lambda c=cmd: spawn(c))
            else:
                info = desktop_info(ident)
                if info is None:
                    continue                  # uninstalled since it was pinned
                tip = info.get_display_name()
                image = Gtk.Image.new_from_gicon(info.get_icon() or Gio.ThemedIcon.new("application-x-executable"),
                                                 Gtk.IconSize.MENU)
                image.set_pixel_size(18)
                run = (lambda i=info: launch(i))
            b = Gtk.Button()
            b.firox_id = ident
            b.get_style_context().add_class("quick-launch")
            b.set_relief(Gtk.ReliefStyle.NONE)
            b.set_focus_on_click(False)
            b.set_tooltip_text(tip)
            b.add(image)
            b.connect("clicked", lambda btn, r=run: None if was_dragged(btn) else r())
            b.connect("button-press-event", self.on_ql_press, run)
            self.ql_reorder.attach(b)
            self.ql.pack_start(b, False, False, 0)
            b.show_all()
        self.show_ql()

    def show_ql(self):
        on = (self.main and self.panel.settings.get("QUICKLAUNCH", "1") != "0"
              and bool(self.ql.get_children()))
        self.ql.set_visible(on)
        self.ql_sep.set_visible(on)

    def on_ql_press(self, btn, event, run):
        if event.type != Gdk.EventType.BUTTON_PRESS or event.button != 3:
            return False
        menu = Gtk.Menu()
        menu.append(menu_item("_Open", run))
        menu.append(Gtk.SeparatorMenuItem())
        menu.append(menu_item("_Remove from Quick Launch", lambda: ql_pin(btn.firox_id, False)))
        self.panel.keep(menu)
        popup_menu(menu, btn, event)
        return True

    def on_ql_reordered(self, children):
        ql_save([c.firox_id for c in children])

    # ---- settings
    def apply_settings(self):
        st = self.panel.settings
        self.show_ql()
        autohide = st.get("AUTOHIDE", "0") != "0"
        if autohide != self.autohide:
            self.autohide = autohide
            if autohide:
                GtkLayerShell.set_exclusive_zone(self, 0)   # windows use the whole screen
                self.schedule_hide(1500)
            else:
                GtkLayerShell.auto_exclusive_zone_enable(self)
                self.reveal()

    # ---- auto-hide: a thin strip until the pointer touches the bottom edge
    def reveal(self):
        if self.hide_timer is not None:
            GLib.source_remove(self.hide_timer)
            self.hide_timer = None
        if self.hidden:
            self.hidden = False
            self.get_style_context().remove_class("hidden")
            self.set_size_request(-1, HEIGHT)
            self.row.show()

    def schedule_hide(self, delay=700):
        if self.hide_timer is not None:
            GLib.source_remove(self.hide_timer)
        self.hide_timer = GLib.timeout_add(delay, self.try_hide)

    def try_hide(self):
        self.hide_timer = None
        if not self.autohide or self.hidden:
            return False
        if self.panel.menus or self.pointer_inside():
            self.schedule_hide()            # a menu is open, or you're still here
            return False
        self.hidden = True
        self.get_style_context().add_class("hidden")
        self.row.hide()
        self.set_size_request(-1, 2)
        self.resize(1, 2)
        return False

    def pointer_inside(self):
        seat = Gdk.Display.get_default().get_default_seat()
        pointer = seat.get_pointer() if seat else None
        if pointer is None:
            return False
        win, _x, _y = pointer.get_window_at_position()
        return win is not None and win.get_toplevel() == self.get_window()

    def on_enter(self, _w, _event):
        if self.autohide:
            self.reveal()
        return False

    def on_leave(self, _w, event):
        if self.autohide and event.detail != Gdk.NotifyType.INFERIOR:
            self.schedule_hide()
        return False

    @staticmethod
    def ql_icon(name):
        for path in (f"/usr/share/icons/Papirus/24x24/apps/{name}.svg",):
            if os.path.exists(path):
                try:
                    return Gtk.Image.new_from_pixbuf(GdkPixbuf.Pixbuf.new_from_file_at_size(path, 18, 18))
                except GLib.Error:
                    pass
        img = Gtk.Image.new_from_icon_name(name, Gtk.IconSize.MENU)
        img.set_pixel_size(18)
        return img

    def on_empty_press(self, _w, event):
        if event.type != Gdk.EventType.BUTTON_PRESS or event.button != 3:
            return False
        p = self.panel
        menu = Gtk.Menu()
        group = Gtk.CheckMenuItem.new_with_mnemonic("_Group similar windows")
        group.set_active(p.grouping)
        group.connect("toggled", lambda i: p.set_grouping(i.get_active()))
        menu.append(group)
        menu.append(Gtk.SeparatorMenuItem())
        menu.append(menu_item("_Show the desktop", lambda: spawn(["firox-open", "show-desktop"])))
        menu.append(menu_item("Task _Manager", lambda: spawn(["firox-open", "task-manager"])))
        menu.append(Gtk.SeparatorMenuItem())
        menu.append(menu_item("Taskbar _settings…", lambda: spawn(["firox-control-panel", "taskbar"])))
        p.keep(menu)
        menu.show_all()
        menu.popup_at_pointer(event)
        return True

    def matches(self, w, all_bars):
        """Is window w on this bar's monitor? Windows we can't place go on
        every bar."""
        if len(all_bars) <= 1 or not w.outputs:
            return True
        geo = self.monitor.get_geometry()
        mine = set(self.panel.toplevels.output_at(geo.x, geo.y))
        if w.outputs & mine:
            return True
        # Not on any bar's monitor as far as we can tell: show it everywhere
        for bar in all_bars:
            g = bar.monitor.get_geometry()
            if w.outputs & set(self.panel.toplevels.output_at(g.x, g.y)):
                return False
        return True


# ------------------------------------------------------------------ panel --

class Panel:
    def __init__(self):
        global APPS
        APPS = Apps()
        self.menus = []
        self.bars = {}
        self.settings = load_settings()
        self.grouping = self.settings.get("GROUP", "1") != "0"
        if not GtkLayerShell.is_supported():
            cant_run("the compositor doesn't support layer-shell")
        firox_toplevels.NAME_FOR = lambda app_id: APPS.lookup(app_id)[0]
        try:
            self.toplevels = Toplevels(self.refresh)
        except firox_toplevels.Unavailable as err:
            cant_run(str(err))
        self.tray = Tray(self)
        self.clock = Clock(self.settings.get("SECONDS", "0") != "0")
        self.indicators = [Awake(), Network(), Bluetooth(), Volume(), Battery(), Updates(), Bell(),
                           self.clock]

        self.glass = None
        self.glass = GlassBackdrop(lambda: [b.queue_draw() for b in self.bars.values()])

        self.provider = Gtk.CssProvider()
        self.user_provider = Gtk.CssProvider()
        screen = Gdk.Screen.get_default()
        Gtk.StyleContext.add_provider_for_screen(screen, self.provider,
                                                 Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        Gtk.StyleContext.add_provider_for_screen(screen, self.user_provider,
                                                 Gtk.STYLE_PROVIDER_PRIORITY_USER)
        self.load_css()
        os.makedirs(CONFIG, exist_ok=True)
        self.theme_mon = Gio.File.new_for_path(CONFIG).monitor_directory(Gio.FileMonitorFlags.NONE, None)
        self.theme_mon.connect("changed", self.on_config_changed)

        display = Gdk.Display.get_default()
        self.sync_timer = None
        self.main_name = None
        display.connect("monitor-added", lambda _d, m: self.schedule_sync())
        display.connect("monitor-removed", lambda _d, m: self.remove_bar(m))
        # Monitors moved, resized or got their details (kanshi, Settings > Display)
        Gdk.Screen.get_default().connect("monitors-changed", lambda _s: self.schedule_sync())
        self.sync_bars()

    def load_css(self):
        if getattr(self, "glass", None) is not None:
            self.glass.reset()
        try:
            self.provider.load_from_path(theme_css())
        except GLib.Error as err:
            print(f"firox-panel: {err.message}", file=sys.stderr)
        user = os.path.join(CONFIG, "panel.css")
        try:
            self.user_provider.load_from_data(open(user, "rb").read() if os.path.exists(user) else b"")
        except (GLib.Error, OSError) as err:
            print(f"firox-panel: {user}: {err}", file=sys.stderr)

    def on_config_changed(self, _mon, f, _other, event):
        if event not in (Gio.FileMonitorEvent.CHANGES_DONE_HINT, Gio.FileMonitorEvent.CREATED,
                         Gio.FileMonitorEvent.DELETED, Gio.FileMonitorEvent.MOVED_IN):
            return
        name = f.get_basename()
        if name in ("theme", "panel.css"):
            self.load_css()
        elif name == "panel.conf":
            self.settings = load_settings()
            grouping = self.settings.get("GROUP", "1") != "0"
            if grouping != self.grouping:
                self.grouping = grouping
                self.refresh()
            self.clock.set_seconds(self.settings.get("SECONDS", "0") != "0")
            for bar in self.bars.values():
                bar.apply_settings()
            self.schedule_sync()            # ALL_DISPLAYS
        elif name == "quicklaunch":
            for bar in self.bars.values():
                bar.fill_ql()
        elif name == "main-display":
            self.schedule_sync()

    # ---- one bar per monitor: the full one on the main display
    def wanted_bars(self):
        """{GdkMonitor: is_main} for the bars there should be."""
        display = Gdk.Display.get_default()
        outs = firox_monitors.outputs()
        main = firox_monitors.main_gdk_monitor(display, outs)
        name = firox_monitors.main_name(outs)
        if name != self.main_name:
            self.main_name = name
            # Notifications follow the main display
            spawn(["firox-displays", "apply-main"])
        everywhere = self.settings.get("ALL_DISPLAYS", "1") != "0"
        return {m: m == main for m in firox_monitors.gdk_monitors(display)
                if everywhere or m == main}

    def sync_bars(self):
        self.sync_timer = None
        want = self.wanted_bars()
        changed = False
        for monitor, bar in list(self.bars.items()):
            if want.get(monitor) != bar.main:
                del self.bars[monitor]        # before destroy: see on_bar_gone
                bar.destroy()
                changed = True
        for monitor, main in want.items():
            if monitor not in self.bars:
                bar = Bar(self, monitor, main)
                self.bars[monitor] = bar
                bar.connect("destroy", lambda b, m=monitor: self.on_bar_gone(m, b))
                changed = True
        if changed:
            self.refresh()
        return False

    def schedule_sync(self, delay=300):
        """Re-check the bars soon: a new monitor's size and position arrive
        a moment after it does."""
        if self.sync_timer is not None:
            GLib.source_remove(self.sync_timer)
        self.sync_timer = GLib.timeout_add(delay, self.sync_bars)

    def add_bar(self, monitor):
        self.sync_bars()

    def remove_bar(self, monitor):
        bar = self.bars.pop(monitor, None)
        if bar is not None:
            bar.destroy()
            self.refresh()
        self.schedule_sync()

    def on_bar_gone(self, monitor, bar):
        """A bar closed without its monitor going away (the compositor can
        close it when a monitor sleeps or wakes up): put a new one there."""
        if self.bars.get(monitor) is not bar:
            return                      # removed with its monitor, or replaced
        del self.bars[monitor]
        print("firox-panel: a taskbar was closed; putting it back", file=sys.stderr)

        GLib.timeout_add(500, self.sync_bars)

    def refresh(self):
        windows = self.toplevels.ordered()
        bars = list(self.bars.values())
        for bar in bars:
            bar.taskbar.refresh([w for w in windows if bar.matches(w, bars)], self.grouping)

    def set_grouping(self, on):
        self.grouping = on
        save_setting("GROUP", "1" if on else "0")
        self.refresh()

    def menu_closed(self):
        for bar in self.bars.values():
            if bar.autohide:
                bar.schedule_hide()

    def keep(self, menu):
        """Hold a reference to an open menu until it closes."""
        self.menus.append(menu)
        menu.connect("deactivate", lambda m: GLib.idle_add(lambda: self._drop(m)))

    def _drop(self, menu):
        if menu in self.menus:
            self.menus.remove(menu)
        menu.destroy()
        self.menu_closed()
        return False


def main():
    # One taskbar per session
    me = os.getpid()
    try:
        out = subprocess.run(["pgrep", "-u", str(os.getuid()), "-x", "firox-panel"],
                             capture_output=True, text=True, timeout=5).stdout.split()
    except (OSError, subprocess.SubprocessError):
        out = []
    for pid in out:
        if int(pid) != me:
            try:
                os.kill(int(pid), 15)
            except OSError:
                pass
    if Gdk.Display.get_default() is None:
        cant_run("no display")
    Panel()
    Gtk.main()


if __name__ == "__main__":
    main()
