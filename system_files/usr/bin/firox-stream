#!/usr/bin/python3
"""
firox-stream: play another Firox computer's games and desktop from this one.

    firox-stream                  open Firox Stream (pick a computer to stream)
    firox-stream connect ADDRESS  stream that computer (ADDRESS[:PORT])
    firox-stream daemon           at login, when streaming is on: let paired
                                  computers stream this one
    firox-stream on|off           let other computers stream this one, or not
    firox-stream ssh-keys on|off|list
                                  let computers with your SSH keys connect
                                  without a PIN (keys from
                                  ~/.config/firox/stream-keys and
                                  ~/.ssh/authorized_keys), or not
    firox-stream web on|off       let web browsers stream it too (phones,
                                  tablets, any computer): open the address
                                  it prints, https://THIS-COMPUTER:48301/
    firox-stream kick             disconnect everyone streaming this one now
    firox-stream unpair           forget every computer paired with this one
    firox-stream forget NAME|ADDRESS
                                  forget a computer this one has streamed
                                  (the next connection asks for its PIN)
    firox-stream status           print whether it's on and what's paired

The computer being streamed (the host) captures its main display through the
desktop portal (screen sharing), encodes it as H.264 with GStreamer (the
graphics card's encoder when there is one, x264 otherwise) and its sound as
Opus, and sends both to the other computer over one TLS connection (TCP port
48300). The other computer plays them and sends its keyboard, mouse and game
controllers back; the host types and clicks them through virtual devices
(uinput), and each controller becomes a virtual Xbox 360 controller there,
rumble included.

Computers on the network that allow streaming announce themselves with Avahi
as _firox-stream._tcp. The first time, pairing takes a 4-digit PIN shown on
the host: whoever connects must be able to see the host's screen. Both sides
then remember each other, the host by a token, the other computer by the
host's certificate.

While streaming, click in the picture to capture the mouse (for games: it
stays in the window and moves the other computer's mouse by relative
motion).
    Ctrl+Alt+Shift+Z  release the mouse     Ctrl+Alt+Shift+M  capture on click on/off
    Ctrl+Alt+Shift+F  full screen           Ctrl+Alt+Shift+Q  stop
    Ctrl+Alt+Shift+U  unlock it (its password)  Ctrl+Alt+Shift+W  wake its screen

Game controllers plugged into this computer (Xbox, PlayStation, Switch Pro,
8BitDo and most others, through SDL's controller database) work on the other
computer while the stream window is in front, up to four at a time.

Connecting wakes the other computer's screen (monitors back on, screen saver
off), and its screen saver, lock, monitor-off and sleep timers wait while
it's being streamed.

With "ssh-keys on", a computer that holds one of your SSH keys (in its
ssh-agent, or a key file without a passphrase) connects without a PIN: this
computer sends a random challenge, the other signs it with the key
(ssh-keygen -Y sign, over this computer's certificate too, so it can't be
passed on), and this one checks the signature (ssh-keygen -Y verify). The
keys accepted are those in ~/.config/firox/stream-keys, and those in
~/.ssh/authorized_keys that carry no options (a key limited to one command
or one address there isn't taken as permission to stream). Removing a key,
or turning the option off, stops the computers that connected with it.

A web browser streams it from the page this computer serves on port 48301
(HTTPS, with this computer's own certificate: the browser warns about it
the first time). It pairs with the same PIN, gets the picture and sound over
WebRTC (UDP ports 48302-48399), and sends its keyboard, mouse, touches and
game controllers back. Local network only.

Settings: ~/.config/firox/stream.json (host: on/off, bitrate, sound, paired
computers) and ~/.config/firox/stream-hosts.json (the computers this one has
streamed). Host log: ~/.local/state/firox/stream.log
"""

import base64
import collections
import errno
import hashlib
import hmac
import json
import os
import pwd
import queue
import random
import re
import secrets
import select
import shutil
import socket
import ssl
import struct
import subprocess
import tempfile
import sys
import threading
import time

sys.path.insert(0, "/usr/lib/firox/python")

CONFIG = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "firox")
STATE_DIR = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "firox")
CONF = os.path.join(CONFIG, "stream.json")
HOSTS = os.path.join(CONFIG, "stream-hosts.json")
CERT_DIR = os.path.join(CONFIG, "stream")
LOG = os.path.join(STATE_DIR, "stream.log")
# Read by /usr/libexec/firox/screencast-chooser: which monitor to share
CHOOSER_HINT = os.path.join(STATE_DIR, "screencast-output")
PORT = 48300
# Web browsers (`firox-stream web on`): the page and its WebSocket on
# WEB_PORT (HTTPS), the picture and sound over WebRTC (UDP, ICE_PORTS)
WEB_PORT = 48301
ICE_PORTS = (48302, 48399)
WEB_DIR = os.environ.get("FIROX_STREAM_WEB") or "/usr/share/firox/stream-web"
SERVICE = "_firox-stream._tcp"
MAX_MESSAGE = 32 << 20
BACKLOG_LIMIT = 6 << 20         # bytes queued for a slow network before frames are skipped


def log(*args):
    print(time.strftime("%H:%M:%S"), *args, file=sys.stderr, flush=True)


# ----------------------------------------------------------------- config --

def _load(path, default):
    try:
        with open(path) as fh:
            data = json.load(fh)
        if isinstance(data, dict):
            default.update(data)
    except (OSError, ValueError):
        pass
    return default


def _save(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)     # holds tokens
    with os.fdopen(fd, "w") as fh:
        json.dump(data, fh, indent=1)
    os.replace(tmp, path)


def load_conf():
    return _load(CONF, {"enabled": False, "port": PORT, "bitrate": 20000, "fps": 60,
                        "audio": True, "encoder": "auto", "clients": {},
                        "web": False, "web_port": WEB_PORT, "ssh_keys": False})


def save_conf(conf):
    _save(CONF, conf)


def load_hosts():
    """Computers this one has paired with, by certificate fingerprint."""
    return _load(HOSTS, {})


def save_hosts(hosts):
    _save(HOSTS, hosts)


def computer_name():
    try:
        pretty = subprocess.run(["hostnamectl", "--pretty"], capture_output=True, text=True,
                                timeout=5).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        pretty = ""
    user = os.environ.get("USER", "")
    host = pretty or socket.gethostname().split(".")[0]
    return f"{user} on {host}" if user else host


def proof(pin, fingerprint, name):
    """What a computer sends to show it typed the PIN. It covers the host's
    certificate as the computer saw it, so a PIN typed into a go-between
    doesn't work on the real host."""
    return hmac.new(pin.encode(), f"firox-stream|{fingerprint}|{name}".encode(),
                    hashlib.sha256).hexdigest()


def token_key(token):
    return hashlib.sha256(token.encode()).hexdigest()


# ---------------------------------------------------------------- SSH keys --

SSH_NAMESPACE = "firox-stream"
SSH_TYPES = ("ssh-ed25519", "ssh-rsa", "ecdsa-sha2-nistp256", "ecdsa-sha2-nistp384", "ecdsa-sha2-nistp521",
             "sk-ssh-ed25519@openssh.com", "sk-ecdsa-sha2-nistp256@openssh.com")
HOME = pwd.getpwuid(os.getuid()).pw_dir
SSH_KEY_FILES = (os.path.join(HOME, ".config", "firox", "stream-keys"),     # Firox Stream's own
                 os.path.join(HOME, ".ssh", "authorized_keys"))              # (lines without options)


def ssh_key_of(line):
    """"TYPE BASE64" from a public key line, or None. With options in front
    (command=, from=, restrict...) it's None: that key was given limited use."""
    parts = line.strip().split()
    if len(parts) >= 2 and parts[0] in SSH_TYPES and re.fullmatch(r"[A-Za-z0-9+/]+={0,3}", parts[1]):
        return f"{parts[0]} {parts[1]}"
    return None


def accepted_ssh_keys():
    """The SSH public keys that may connect without a PIN."""
    keys = []
    for path in SSH_KEY_FILES:
        try:
            with open(path) as fh:
                for line in fh:
                    key = ssh_key_of(line)
                    if key and key not in keys:
                        keys.append(key)
        except OSError:
            pass
    return keys


def ssh_key_label(key):
    """A key as ssh-keygen -l shows it (SHA256:...)."""
    try:
        blob = base64.b64decode(key.split()[1])
        return "SHA256:" + base64.b64encode(hashlib.sha256(blob).digest()).decode().rstrip("=")
    except (ValueError, IndexError):
        return key[:24]


def ssh_message(fingerprint, name, nonce):
    """What a computer signs: this host's certificate, its own name and the
    challenge, so a signature only works once, here, for that name."""
    return f"firox-stream ssh-auth|{fingerprint}|{name}|{nonce}".encode()


def ssh_verify(key, signature, message):
    """True if signature (ssh-keygen -Y sign, armored) is key's over message."""
    if not shutil.which("ssh-keygen") or not isinstance(signature, str) or len(signature) > 16384:
        return False
    with tempfile.TemporaryDirectory() as tmp:
        signers, sig = os.path.join(tmp, "allowed"), os.path.join(tmp, "sig")
        with open(signers, "w") as fh:
            fh.write(f"firox {key}\n")
        with open(sig, "w") as fh:
            fh.write(signature)
        try:
            r = subprocess.run(["ssh-keygen", "-Y", "verify", "-f", signers, "-I", "firox", "-n", SSH_NAMESPACE,
                                "-s", sig], input=message, capture_output=True, timeout=15)
        except (OSError, subprocess.SubprocessError):
            return False
    return r.returncode == 0


def ssh_signatures(message, limit=6):
    """This computer's SSH keys' signatures over message: [{"key", "sig"}].
    Keys in ssh-agent first, then key files that need no passphrase (nothing
    here asks for one: a GUI connection has nobody at a terminal)."""
    if not shutil.which("ssh-keygen"):
        return []
    env = dict(os.environ, SSH_ASKPASS_REQUIRE="never")
    candidates = []                         # (public key line, -f argument)
    tmp = tempfile.mkdtemp()
    try:
        try:
            agent = subprocess.run(["ssh-add", "-L"], capture_output=True, text=True, timeout=5, env=env).stdout
        except (OSError, subprocess.SubprocessError):
            agent = ""
        for i, line in enumerate(agent.splitlines()):
            if ssh_key_of(line):
                pub = os.path.join(tmp, f"agent{i}.pub")
                with open(pub, "w") as fh:
                    fh.write(line + "\n")
                candidates.append((line, pub))      # a public key: ssh-keygen signs through the agent
        ssh_dir = os.path.join(HOME, ".ssh")
        for base in ("id_ed25519", "id_ecdsa", "id_rsa", "id_ed25519_sk", "id_ecdsa_sk"):
            priv, pub = os.path.join(ssh_dir, base), os.path.join(ssh_dir, base + ".pub")
            try:
                with open(pub) as fh:
                    line = fh.readline().strip()
            except OSError:
                continue
            if os.path.exists(priv) and ssh_key_of(line):
                candidates.append((line, priv))
        out, seen = [], set()
        for line, keyfile in candidates:
            key = ssh_key_of(line)
            if key in seen or len(out) >= limit:
                continue
            seen.add(key)
            try:
                r = subprocess.run(["ssh-keygen", "-Y", "sign", "-q", "-f", keyfile, "-n", SSH_NAMESPACE],
                                   input=message, capture_output=True, timeout=20, env=env,
                                   start_new_session=True)      # (no terminal to ask a passphrase on)
            except (OSError, subprocess.SubprocessError):
                continue
            if r.returncode == 0 and b"BEGIN SSH SIGNATURE" in r.stdout:
                out.append({"key": key, "sig": r.stdout.decode()})
        return out
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def split_address(text):
    text = text.strip()
    if text.count(":") == 1:
        host, _, port = text.partition(":")
        if port.isdigit():
            return host, int(port)
    if text.startswith("[") and "]:" in text:                     # [IPv6]:port
        host, _, port = text[1:].partition("]:")
        if port.isdigit():
            return host, int(port)
    return text.strip("[]"), PORT


def discover(timeout=5):
    """Computers on the network that allow streaming: [{name, address, port}]."""
    try:
        out = subprocess.run(["avahi-browse", "-p", "-r", "-t", SERVICE], capture_output=True, text=True,
                             timeout=timeout + 4).stdout
    except (OSError, subprocess.SubprocessError):
        return []
    found = {}
    for line in out.splitlines():
        parts = line.split(";")
        if not parts or parts[0] != "=" or len(parts) < 9 or parts[2] != "IPv4":
            continue
        name = parts[3].replace("\\032", " ")
        found[(parts[7], parts[8])] = {"name": name, "address": parts[7], "port": int(parts[8] or PORT)}
    return sorted(found.values(), key=lambda f: f["name"].lower())


# ---------------------------------------------------------------- network --

def keepalive(sock):
    """Notice within about 25 seconds that the other computer went away."""
    sock.setsockopt(socket.SOL_SOCKET, socket.SO_KEEPALIVE, 1)
    for opt, val in (("TCP_KEEPIDLE", 10), ("TCP_KEEPINTVL", 5), ("TCP_KEEPCNT", 3)):
        if hasattr(socket, opt):
            sock.setsockopt(socket.IPPROTO_TCP, getattr(socket, opt), val)
    sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)


def frame(kind, payload=b""):
    if isinstance(payload, (dict, list)):
        payload = json.dumps(payload).encode()
    return kind.encode() + struct.pack(">I", len(payload)) + payload


def recv_exact(sock, n):
    buf = bytearray()
    while len(buf) < n:
        chunk = sock.recv(n - len(buf))
        if not chunk:
            raise EOFError("connection closed")
        buf += chunk
    return bytes(buf)


def recv_message(sock):
    """One message, on a blocking socket (the handshake): (kind, payload)."""
    head = recv_exact(sock, 5)
    n = struct.unpack(">I", head[1:])[0]
    if n > 65536:
        raise ValueError("message too long")
    return chr(head[0]), recv_exact(sock, n)


def recv_json(sock):
    kind, payload = recv_message(sock)
    try:
        return kind, json.loads(payload or b"{}")
    except ValueError:
        raise ValueError("bad message") from None


class Channel:
    """Messages both ways over one TLS connection, from a single thread: an
    SSL connection mustn't be read and written by two threads at once.
    send() can be called from any thread."""

    def __init__(self, sock, on_message, on_close=None):
        self.sock = sock
        self.on_message = on_message
        self.on_close = on_close
        self.lock = threading.Lock()
        self.out = collections.deque()
        self.queued = 0
        self.cur = b""
        self.inbuf = bytearray()
        self.closed = False
        self.reason = ""
        self.wake_r, self.wake_w = os.pipe()
        os.set_blocking(self.wake_r, False)
        os.set_blocking(self.wake_w, False)

    def backlog(self):
        return self.queued

    def discard(self):
        """Never run (the stream couldn't start): let go of what it holds."""
        self.closed = True
        for fd in (self.wake_r, self.wake_w):
            try:
                os.close(fd)
            except OSError:
                pass

    def _wake(self):
        try:
            os.write(self.wake_w, b"x")
        except OSError:
            pass

    def send(self, kind, payload=b""):
        data = frame(kind, payload)
        with self.lock:
            if self.closed:
                return False
            self.out.append(data)
            self.queued += len(data)
        self._wake()
        return True

    def close(self, reason=""):
        with self.lock:
            if not self.reason:
                self.reason = reason
            self.closed = True
        self._wake()

    def run(self):
        self.sock.setblocking(False)
        stalled_since = None
        try:
            while True:
                with self.lock:
                    if self.closed:
                        break
                    want_write = bool(self.cur) or bool(self.out)
                if self.sock.pending():
                    self._read()
                r, w, _ = select.select([self.sock, self.wake_r], [self.sock] if want_write else [], [], 5)
                if self.wake_r in r:
                    try:
                        os.read(self.wake_r, 4096)
                    except BlockingIOError:
                        pass
                if self.sock in r:
                    self._read()
                if want_write:
                    before = self.queued
                    if self.sock in w:
                        self._write()
                    if self.queued < before or not (self.cur or self.out):
                        stalled_since = None
                    elif stalled_since is None:
                        stalled_since = time.monotonic()
                    elif time.monotonic() - stalled_since > 20:
                        raise OSError("the other computer stopped answering")
        except EOFError:
            self.close("disconnected")
        except (OSError, ValueError) as e:
            self.close(str(e) or e.__class__.__name__)
        finally:
            with self.lock:
                self.closed = True
            for fd in (self.wake_r, self.wake_w):
                try:
                    os.close(fd)
                except OSError:
                    pass
            try:
                self.sock.close()
            except OSError:
                pass
            if self.on_close:
                self.on_close(self.reason)

    def _read(self):
        # (TLS may already hold decrypted bytes that select() can't see)
        while True:
            try:
                data = self.sock.recv(262144)
            except (ssl.SSLWantReadError, ssl.SSLWantWriteError, BlockingIOError):
                break
            if not data:
                raise EOFError
            self.inbuf += data
        while len(self.inbuf) >= 5:
            n = struct.unpack(">I", self.inbuf[1:5])[0]
            if n > MAX_MESSAGE:
                raise ValueError("message too long")
            if len(self.inbuf) < 5 + n:
                break
            kind = chr(self.inbuf[0])
            payload = bytes(self.inbuf[5:5 + n])
            del self.inbuf[:5 + n]
            self.on_message(kind, payload)

    def _write(self):
        while True:
            if not self.cur:
                with self.lock:
                    if not self.out:
                        return
                    parts, size = [], 0
                    while self.out and size < 262144:
                        part = self.out.popleft()
                        parts.append(part)
                        size += len(part)
                self.cur = memoryview(b"".join(parts))
            try:
                n = self.sock.send(self.cur)
            except (ssl.SSLWantWriteError, ssl.SSLWantReadError, BlockingIOError):
                return
            with self.lock:
                self.queued -= n
            self.cur = self.cur[n:]


# ---------------------------------------------------------- web browsers --
#
# A browser opens https://THIS-COMPUTER:48301/ (the page in WEB_DIR). The
# page talks to the host over a WebSocket on the same address: the same
# messages as the apps' connection, as JSON ({"k": kind, "d": payload}),
# so pairing (the PIN), joining or taking over, input, controllers,
# unlocking and the status messages all work the same way. Only the picture
# and sound go another way: WebRTC, which browsers can play. The host offers
# them (H.264 and Opus, the same encoded stream everyone else gets), the page
# answers, and they find each other on the network (ICE: no STUN or TURN
# servers, so it's the local network only).

WS_GUID = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"


def ws_frame(op, payload):
    """One WebSocket frame from the host (servers don't mask)."""
    n = len(payload)
    if n < 126:
        head = struct.pack(">BB", 0x80 | op, n)
    elif n < 65536:
        head = struct.pack(">BBH", 0x80 | op, 126, n)
    else:
        head = struct.pack(">BBQ", 0x80 | op, 127, n)
    return head + payload


def ws_parse(buf):
    """Take one whole frame off the front of buf: (fin, opcode, data), or
    None if it isn't all there yet. A browser always masks its frames."""
    if len(buf) < 2:
        return None
    b0, b1 = buf[0], buf[1]
    n, at = b1 & 0x7F, 2
    if n == 126:
        if len(buf) < 4:
            return None
        n, at = struct.unpack(">H", bytes(buf[2:4]))[0], 4
    elif n == 127:
        if len(buf) < 10:
            return None
        n, at = struct.unpack(">Q", bytes(buf[2:10]))[0], 10
    if not b1 & 0x80:
        raise ValueError("an unmasked WebSocket frame")
    if n > 1 << 20:
        raise ValueError("message too long")
    if len(buf) < at + 4 + n:
        return None
    mask = bytes(buf[at:at + 4])
    raw = bytes(buf[at + 4:at + 4 + n])
    del buf[:at + 4 + n]
    key = (mask * (n // 4 + 1))[:n]
    data = (int.from_bytes(raw, "big") ^ int.from_bytes(key, "big")).to_bytes(n, "big")
    return bool(b0 & 0x80), b0 & 0x0F, data


def ws_accept(key):
    # SHA-1 is what the WebSocket protocol uses here (RFC 6455): it only shows
    # the server understood the request, it protects nothing
    digest = hashlib.sha1((key + WS_GUID).encode(), usedforsecurity=False).digest()
    return base64.b64encode(digest).decode()


class WebHandshake:
    """The WebSocket during pairing and joining, which Host.handshake and
    choose_mode read and write like an app's connection (blocking, one
    thread): messages are turned into the apps' frames and back."""

    def __init__(self, sock, rest, fingerprint):
        self.sock = sock
        self.raw = bytearray(rest)          # WebSocket bytes not handled yet
        self.frames = bytearray()           # incoming messages as the apps' frames
        self.fingerprint = fingerprint
        self.parts = []

    # (the host writes)
    def sendall(self, data):
        while data:
            kind, n = chr(data[0]), struct.unpack(">I", data[1:5])[0]
            payload, data = data[5:5 + n], data[5 + n:]
            try:
                obj = json.loads(payload or b"{}")
            except ValueError:
                obj = {}
            if kind == "N" and isinstance(obj, dict):
                # The page works out the PIN's proof as the apps do, over the
                # certificate the host has (it can't see it itself)
                obj["fingerprint"] = self.fingerprint
            self.sock.sendall(ws_frame(1, json.dumps({"k": kind, "d": obj}).encode()))

    # (the host reads)
    def recv(self, n):
        while not self.frames:
            self._next()
        out = bytes(self.frames[:n])
        del self.frames[:n]
        return out

    def _next(self):
        while True:
            got = ws_parse(self.raw)
            if got is None:
                chunk = self.sock.recv(65536)
                if not chunk:
                    raise EOFError("connection closed")
                self.raw += chunk
                continue
            fin, op, data = got
            if op == 8:
                raise EOFError("the page closed")
            if op == 9:
                self.sock.sendall(ws_frame(10, data))
                continue
            if op not in (0, 1, 2):
                continue
            self.parts.append(data)
            if not fin:
                continue
            text, self.parts = b"".join(self.parts), []
            try:
                msg = json.loads(text)
                kind = str(msg["k"])
            except (ValueError, KeyError, TypeError):
                raise ValueError("bad message") from None
            if len(kind) != 1:
                continue                    # (signalling comes later)
            self.frames += frame(kind, msg.get("d") if msg.get("d") is not None else {})
            return

    def settimeout(self, t):
        self.sock.settimeout(t)

    def shutdown(self, how):
        self.sock.shutdown(how)

    def fileno(self):
        return self.sock.fileno()

    def close(self):
        try:
            self.sock.sendall(ws_frame(8, b""))
        except OSError:
            pass
        self.sock.close()


class WebViewer(Channel):
    """A web browser watching. To Session it's a Channel like an app's:
    send() takes the same messages. The picture and sound go into a WebRTC
    sender (webrtcbin); everything else is JSON on the page's WebSocket,
    which this runs like Channel runs an app's connection (one thread)."""

    VIDEO_PT, AUDIO_PT = 96, 97
    INPUT = set("IGFWUQ")                   # what a page may send once it's watching

    def __init__(self, sock, rest=b""):
        super().__init__(sock, None, self._closed)
        import gi
        gi.require_version("Gst", "1.0")
        gi.require_version("GstWebRTC", "1.0")
        gi.require_version("GstSdp", "1.0")
        gi.require_version("GstVideo", "1.0")
        from gi.repository import Gst, GstSdp, GstVideo, GstWebRTC
        Gst.init(None)
        self.Gst, self.GstSdp, self.GstWebRTC, self.GstVideo = Gst, GstSdp, GstWebRTC, GstVideo
        self.inbuf += rest
        self.parts = []
        self.connected = False
        self.audio_pts = None
        self.offered = False
        self.caps_set = set()
        self.pipeline = None
        try:
            self._build()
        except (RuntimeError, AttributeError) as e:
            raise RuntimeError(f"web browsers can't be streamed here: {e}") from None

    def _build(self):
        Gst, GstWebRTC = self.Gst, self.GstWebRTC
        if Gst.ElementFactory.find("webrtcbin") is None or Gst.ElementFactory.find("nicesrc") is None:
            raise RuntimeError("GStreamer's WebRTC support (webrtcbin, libnice) is missing")
        p = self.pipeline = Gst.Pipeline.new("web")
        rtc = self.webrtc = make_element("webrtcbin", {"bundle-policy": "max-bundle", "latency": 0}, "webrtc")
        ice = rtc.get_property("ice-agent")
        if ice is not None:
            keep_ref(ice)
            for prop, port in (("min-rtp-port", ICE_PORTS[0]), ("max-rtp-port", ICE_PORTS[1])):
                if ice.find_property(prop) is not None:
                    ice.set_property(prop, port)      # the ports the firewall lets in
            del ice
        p.add(rtc)
        # (before the transceivers: adding them can ask for the offer straight away)
        rtc.connect("on-negotiation-needed", self._on_negotiation_needed)
        rtc.connect("on-ice-candidate", self._on_ice_candidate)
        rtc.connect("notify::connection-state", self._on_connection_state)
        sendonly = GstWebRTC.WebRTCRTPTransceiverDirection.SENDONLY
        self.src = {}
        for kind, rtp, pt, pay in (
                # (no profile-level-id: it's whatever the encoder makes, and
                # browsers decode any profile they're sent)
                ("video", "application/x-rtp,media=video,encoding-name=H264,clock-rate=90000,"
                          "packetization-mode=(string)1", self.VIDEO_PT,
                 ("rtph264pay", {"config-interval": -1, "aggregate-mode": "zero-latency", "mtu": 1200})),
                ("audio", "application/x-rtp,media=audio,encoding-name=OPUS,clock-rate=48000,"
                          "encoding-params=(string)2,stereo=(string)1,sprop-stereo=(string)1", self.AUDIO_PT,
                 ("rtpopuspay", {"mtu": 1200}))):
            rtp_caps = Gst.Caps.from_string(f"{rtp},payload={pt}")
            # The picture is stamped as it arrives. The sound is stamped by
            # its length instead (send()): stamped on arrival, packets that
            # come in bursts look like jitter to the browser, which then
            # fills the gaps with made-up sound (crackling)
            src = make_element("appsrc", {"is-live": True, "format": "time", "do-timestamp": kind == "video",
                                          "max-bytes": 8 << 20, "block": False}, kind)
            payloader = make_element(pay[0], dict(pay[1], pt=pt))
            capsf = make_element("capsfilter", {})
            capsf.set_property("caps", rtp_caps)
            queue_ = make_element("queue", {"max-size-time": 0, "max-size-bytes": 0, "max-size-buffers": 200})
            for el in (src, payloader, capsf, queue_):
                p.add(el)
            src.link(payloader)
            payloader.link(capsf)
            capsf.link(queue_)
            # Its own sender, offered with these codecs: the offer needn't
            # wait for the first frames (they only flow once it's connected)
            pad = rtc.request_pad_simple("sink_%u")
            queue_.get_static_pad("src").link(pad)
            # Separate streams for the browser, so it doesn't hold the sound
            # back to keep it in step with the picture (it was 70 ms behind)
            pad.set_property("msid", f"firox-{kind}")
            sender = pad.get_property("transceiver")
            sender.set_property("direction", sendonly)
            sender.set_property("codec-preferences", rtp_caps)
            self.src[kind] = src
        # The browser asks for a key frame (a new decoder, or a lost packet)
        self.src["video"].get_static_pad("src").add_probe(Gst.PadProbeType.EVENT_UPSTREAM, self._on_upstream)
        p.get_bus().set_sync_handler(self._on_bus)
        p.set_state(Gst.State.PLAYING)

    # -- WebRTC
    def _on_negotiation_needed(self, rtc):
        with self.lock:
            if self.offered:
                return                      # (once: the codecs don't change)
            self.offered = True
        promise = self.Gst.Promise.new_with_change_func(self._on_offer, rtc)
        rtc.emit("create-offer", None, promise)

    def _on_offer(self, promise, rtc):
        if promise.wait() != self.Gst.PromiseResult.REPLIED:
            self.close("the stream couldn't be offered to the browser")
            return
        # (the reply has to outlive the offer taken from it, or the offer
        # points at freed memory)
        reply = promise.get_reply()
        offer = reply.get_value("offer")
        text = offer.sdp.as_text()
        rtc.emit("set-local-description", offer, self.Gst.Promise.new())
        self._json("offer", {"sdp": text})
        del offer, reply

    def _on_ice_candidate(self, _rtc, mline, candidate):
        self._json("ice", {"m": int(mline), "c": candidate})

    def _on_connection_state(self, rtc, _pspec):
        state = rtc.get_property("connection-state")
        states = self.GstWebRTC.WebRTCPeerConnectionState
        if state == states.CONNECTED and not self.connected:
            self.connected = True
            log("browser connected (WebRTC)")
            if self.on_message:
                self.on_message("F", b"")           # a key frame to start from
        elif state in (states.FAILED, states.CLOSED):
            self.close("the browser couldn't be reached (WebRTC)" if not self.connected
                       else "the browser's connection was lost")

    def _on_upstream(self, _pad, info):
        event = info.get_event()
        if event is not None and self.GstVideo.video_event_is_force_key_unit(event) and self.on_message:
            self.on_message("F", b"")
        return self.Gst.PadProbeReturn.OK

    def _on_bus(self, _bus, msg):
        if msg.type == self.Gst.MessageType.ERROR:
            err, debug = msg.parse_error()
            log(f"web stream error from {msg.src.get_name()}: {err.message} ({debug})")
            self.close(f"the web stream stopped: {err.message}")
        return self.Gst.BusSyncReply.DROP

    def _signal(self, kind, msg):
        """Signalling from the page: its answer, and where it can be reached."""
        GstSdp, GstWebRTC = self.GstSdp, self.GstWebRTC
        if kind == "answer":
            ok, sdp = GstSdp.SDPMessage.new_from_text(str(msg.get("sdp", "")))
            if ok != GstSdp.SDPResult.OK:
                raise ValueError("bad answer")
            answer = GstWebRTC.WebRTCSessionDescription.new(GstWebRTC.WebRTCSDPType.ANSWER, sdp)
            self.webrtc.emit("set-remote-description", answer, self.Gst.Promise.new())
        elif kind == "ice":
            candidate = str(msg.get("c") or "")
            if candidate:
                self.webrtc.emit("add-ice-candidate", int(msg.get("m") or 0), candidate)

    # -- what Session sends
    def send(self, kind, payload=b""):
        if kind in ("V", "A"):
            src = self.src["video" if kind == "V" else "audio"]
            if not self.connected or self.closed or src.get_name() not in self.caps_set:
                return True
            buf = self.Gst.Buffer.new_wrapped(bytes(payload))
            if kind == "A":
                self._stamp_audio(buf, payload)
            src.emit("push-buffer", buf)
            return True
        if kind == "K":
            info = payload if isinstance(payload, dict) else json.loads(payload)
            src = self.src.get(info.get("kind"))
            if src is not None:
                src.set_property("caps", self.Gst.Caps.from_string(info["caps"]))
                self.caps_set.add(src.get_name())
            return True
        if isinstance(payload, (bytes, bytearray)):
            try:
                payload = json.loads(payload or b"{}")
            except ValueError:
                payload = {}
        return self._json(kind, payload)

    def _stamp_audio(self, buf, packet):
        """Each Opus packet starts where the last one ended, so the browser
        gets evenly spaced sound. If that drifts more than a quarter of a
        second from the clock (the capture was restarted, or paused), start
        again from now."""
        Gst = self.Gst
        clock = self.pipeline.get_clock() if self.pipeline else None
        now = clock.get_time() - self.pipeline.get_base_time() if clock else 0
        if self.audio_pts is None or abs(self.audio_pts - now) > Gst.SECOND // 4:
            self.audio_pts = now
        length = opus_duration(packet) or 10 * Gst.MSECOND
        buf.pts, buf.duration = self.audio_pts, length
        self.audio_pts += length

    def _json(self, kind, obj):
        data = ws_frame(1, json.dumps({"k": kind, "d": obj}).encode())
        with self.lock:
            if self.closed:
                return False
            self.out.append(data)
            self.queued += len(data)
        self._wake()
        return True

    def backlog(self):
        try:
            return int(self.src["video"].get_property("current-level-bytes"))
        except (KeyError, TypeError):
            return 0

    # -- what the page sends (Channel's loop calls this)
    def _read(self):
        while True:
            try:
                data = self.sock.recv(262144)
            except (ssl.SSLWantReadError, ssl.SSLWantWriteError, BlockingIOError):
                break
            if not data:
                raise EOFError
            self.inbuf += data
        while True:
            got = ws_parse(self.inbuf)
            if got is None:
                return
            fin, op, data = got
            if op == 8:
                raise EOFError
            if op == 9:
                with self.lock:
                    self.out.append(ws_frame(10, data))
                continue
            if op not in (0, 1, 2):
                continue
            self.parts.append(data)
            if not fin:
                continue
            text, self.parts = b"".join(self.parts), []
            try:
                msg = json.loads(text)
                kind, body = str(msg["k"]), msg.get("d")
            except (ValueError, KeyError, TypeError):
                raise ValueError("bad message") from None
            if kind in ("answer", "ice"):
                self._signal(kind, body if isinstance(body, dict) else {})
            elif kind in self.INPUT and self.on_message:
                self.on_message(kind, json.dumps(body if body is not None else {}).encode())

    def discard(self):
        super().discard()
        self._closed("")

    def _closed(self, _reason):
        if self.pipeline is not None:
            self.pipeline.set_state(self.Gst.State.NULL)
            self.pipeline = None


def opus_duration(packet):
    """How long an Opus packet plays, in nanoseconds (RFC 6716 3.1), or 0."""
    if not packet:
        return 0
    toc = packet[0]
    config, code = toc >> 3, toc & 3
    if config < 12:                                 # SILK: 10, 20, 40, 60 ms
        frame = (10_000_000, 20_000_000, 40_000_000, 60_000_000)[config % 4]
    elif config < 16:                               # hybrid: 10, 20 ms
        frame = (10_000_000, 20_000_000)[config % 2]
    else:                                           # CELT: 2.5, 5, 10, 20 ms
        frame = (2_500_000, 5_000_000, 10_000_000, 20_000_000)[config % 4]
    if code == 0:
        frames = 1
    elif code in (1, 2):
        frames = 2
    else:
        frames = packet[1] & 0x3F if len(packet) > 1 else 0
    return frame * frames


def keep_ref(obj):
    """webrtcbin's "ice-agent" hands over its own reference when Python
    reads it (GStreamer 1.28), so the agent would go when Python lets go of
    it. Give it back one: only when Python holds the only one, so it isn't
    leaked once that's fixed."""
    if getattr(obj, "__grefcount__", 2) != 1:
        return
    import ctypes
    get = ctypes.pythonapi.PyCapsule_GetPointer
    get.restype, get.argtypes = ctypes.c_void_p, [ctypes.py_object, ctypes.c_char_p]
    gobject = ctypes.CDLL("libgobject-2.0.so.0")
    gobject.g_object_ref.restype, gobject.g_object_ref.argtypes = ctypes.c_void_p, [ctypes.c_void_p]
    gobject.g_object_ref(get(obj.__gpointer__, None))


def read_http_request(sock, limit=16384):
    """(method, path, headers, the bytes after them) of one HTTP request."""
    buf = b""
    while b"\r\n\r\n" not in buf:
        chunk = sock.recv(4096)
        if not chunk:
            raise EOFError("connection closed")
        buf += chunk
        if len(buf) > limit:
            raise ValueError("request too long")
    head, _, rest = buf.partition(b"\r\n\r\n")
    lines = head.decode("latin-1").split("\r\n")
    parts = lines[0].split(" ")
    if len(parts) != 3:
        raise ValueError("bad request")
    headers = {}
    for line in lines[1:]:
        k, _, v = line.partition(":")
        headers[k.strip().lower()] = v.strip()
    return parts[0], parts[1].split("?")[0], headers, rest


WEB_FILES = {
    "/": ("index.html", "text/html; charset=utf-8"),
    "/index.html": ("index.html", "text/html; charset=utf-8"),
    "/app.js": ("app.js", "text/javascript; charset=utf-8"),
    "/style.css": ("style.css", "text/css; charset=utf-8"),
    "/icon.svg": ("/usr/share/firox/icons/start-orb.svg", "image/svg+xml"),
}


def http_reply(sock, status, body=b"", ctype="text/plain; charset=utf-8", extra=""):
    head = (f"HTTP/1.1 {status}\r\nContent-Type: {ctype}\r\nContent-Length: {len(body)}\r\n"
            "Cache-Control: no-store\r\nX-Content-Type-Options: nosniff\r\nReferrer-Policy: no-referrer\r\n"
            "X-Frame-Options: DENY\r\n"
            "Content-Security-Policy: default-src 'self'; img-src 'self' data:; media-src 'self' blob:; "
            "connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'\r\n"
            f"{extra}Connection: close\r\n\r\n")
    sock.sendall(head.encode() + body)


# ------------------------------------------------------------------- host --

def ensure_cert():
    """This computer's streaming certificate (made the first time)."""
    cert, key = os.path.join(CERT_DIR, "cert.pem"), os.path.join(CERT_DIR, "key.pem")
    if not (os.path.exists(cert) and os.path.exists(key)):
        os.makedirs(CERT_DIR, mode=0o700, exist_ok=True)
        subprocess.run(["openssl", "req", "-x509", "-newkey", "ec", "-pkeyopt", "ec_paramgen_curve:prime256v1",
                        "-nodes", "-days", "36500", "-subj", "/CN=Firox Stream", "-keyout", key, "-out", cert],
                       check=True, capture_output=True)
        os.chmod(key, 0o600)
    with open(cert) as fh:
        der = ssl.PEM_cert_to_DER_cert(fh.read())
    return cert, key, hashlib.sha256(der).hexdigest()


class PortalError(Exception):
    pass


def reset_portal():
    """Let systemd start xdg-desktop-portal-wlr again after it has stopped a
    few times in a row (start-limit-hit), which otherwise fails every
    screen-sharing request with CreateSession until the next login."""
    try:
        subprocess.run(["systemctl", "--user", "reset-failed", "xdg-desktop-portal-wlr.service"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
    except (OSError, subprocess.SubprocessError):
        pass


class ScreenCast:
    """A screen-sharing session through xdg-desktop-portal. The portal's
    answers arrive as D-Bus signals on the main loop (the daemon runs
    Gtk.main), so these calls are made from a connection's own thread."""

    def __init__(self):
        from gi.repository import Gio
        self.Gio = Gio
        self.bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        self.sender = self.bus.get_unique_name()[1:].replace(".", "_")
        self.session = None

    def _call(self, method, signature, args, reply="(o)", fds=False):
        from gi.repository import GLib
        params = GLib.Variant(signature, args)
        if fds:
            return self.bus.call_with_unix_fd_list_sync(
                "org.freedesktop.portal.Desktop", "/org/freedesktop/portal/desktop",
                "org.freedesktop.portal.ScreenCast", method, params, GLib.VariantType(reply),
                self.Gio.DBusCallFlags.NONE, 30000, None, None)
        return self.bus.call_sync(
            "org.freedesktop.portal.Desktop", "/org/freedesktop/portal/desktop",
            "org.freedesktop.portal.ScreenCast", method, params, GLib.VariantType(reply),
            self.Gio.DBusCallFlags.NONE, 30000, None)

    def _request(self, method, signature, make_args, timeout=90):
        from gi.repository import GLib
        token = "firox" + secrets.token_hex(6)
        path = f"/org/freedesktop/portal/desktop/request/{self.sender}/{token}"
        done, result = threading.Event(), {}

        def on_response(_conn, _sender, _path, _iface, _signal, params, _data):
            result["code"], result["results"] = params.unpack()
            done.set()

        sub = self.bus.signal_subscribe("org.freedesktop.portal.Desktop", "org.freedesktop.portal.Request",
                                        "Response", path, None, self.Gio.DBusSignalFlags.NONE,
                                        on_response, None)
        try:
            self._call(method, signature, make_args({"handle_token": GLib.Variant("s", token)}))
            if not done.wait(timeout):
                raise PortalError(f"the screen-sharing portal didn't answer ({method})")
        finally:
            self.bus.signal_unsubscribe(sub)
        if result["code"] != 0:
            raise PortalError("screen sharing was cancelled" if result["code"] == 1
                              else f"screen sharing failed ({method})")
        return result["results"]

    def cursor_modes(self):
        from gi.repository import GLib
        try:
            out = self.bus.call_sync("org.freedesktop.portal.Desktop", "/org/freedesktop/portal/desktop",
                                     "org.freedesktop.DBus.Properties", "Get",
                                     GLib.Variant("(ss)", ("org.freedesktop.portal.ScreenCast",
                                                           "AvailableCursorModes")),
                                     GLib.VariantType("(v)"), self.Gio.DBusCallFlags.NONE, 5000, None)
            return out.unpack()[0]
        except GLib.Error:
            return 0

    def start(self, cursor=True):
        """Share one monitor. Returns (pipewire fd, node id, cursor shown)."""
        from gi.repository import GLib
        res = self._request("CreateSession", "(a{sv})", lambda o: (dict(
            o, session_handle_token=GLib.Variant("s", "firox" + secrets.token_hex(6))),))
        self.session = res["session_handle"]
        embedded = cursor and bool(self.cursor_modes() & 2)
        opts = {"types": GLib.Variant("u", 1), "multiple": GLib.Variant("b", False)}
        if embedded:
            opts["cursor_mode"] = GLib.Variant("u", 2)
        self._request("SelectSources", "(oa{sv})", lambda o: (self.session, dict(o, **opts)))
        res = self._request("Start", "(osa{sv})", lambda o: (self.session, "", o), timeout=300)
        streams = res.get("streams") or []
        if not streams:
            raise PortalError("no screen was shared")
        node = streams[0][0]
        out, fdlist = self._call("OpenPipeWireRemote", "(oa{sv})", (self.session, {}), reply="(h)", fds=True)
        fd = fdlist.get(out.unpack()[0])
        return fd, node, embedded

    def close(self):
        if self.session:
            from gi.repository import GLib
            try:
                self.bus.call_sync("org.freedesktop.portal.Desktop", self.session,
                                   "org.freedesktop.portal.Session", "Close", None, None,
                                   self.Gio.DBusCallFlags.NONE, 5000, None)
            except GLib.Error:
                pass
            self.session = None


class Injector:
    """Types and clicks what the other computer sends, through a virtual
    keyboard and an absolute mouse (like a tablet: it puts the pointer where
    the other computer's pointer is on the picture)."""

    BUTTONS = (0x110, 0x111, 0x112, 0x113, 0x114)          # left, right, middle, side, extra

    def __init__(self, output):
        from evdev import AbsInfo, UInput
        from evdev import ecodes as e
        self.e = e
        self.kb = UInput({e.EV_KEY: list(range(1, 249))}, name="Firox Stream Keyboard")
        self.mouse = UInput({
            e.EV_KEY: list(self.BUTTONS),
            e.EV_ABS: [(e.ABS_X, AbsInfo(0, 0, 65535, 0, 0, 0)), (e.ABS_Y, AbsInfo(0, 0, 65535, 0, 0, 0))],
            e.EV_REL: [e.REL_WHEEL, e.REL_HWHEEL, e.REL_WHEEL_HI_RES, e.REL_HWHEEL_HI_RES],
        }, name="Firox Stream Mouse")
        # For a captured mouse (games): movement, not a position
        self.rel_mouse = UInput({e.EV_KEY: list(self.BUTTONS), e.EV_REL: [e.REL_X, e.REL_Y]},
                                name="Firox Stream Mouse (relative)")
        self.down_keys, self.down_buttons = set(), set()
        self.wheel = [0.0, 0.0]
        self.rel = [0.0, 0.0]
        self.geometry(output)

    def geometry(self, output):
        """Where the shared monitor sits in the desktop: the virtual mouse's
        range covers every monitor, as the compositor lays them out."""
        import firox_monitors
        outs = [o for o in firox_monitors.outputs() if o["enabled"] and o["width"]]
        self.map = (0.0, 0.0, 1.0, 1.0)
        if not outs:
            return
        x0 = min(o["x"] for o in outs)
        y0 = min(o["y"] for o in outs)
        bw = max(o["x"] + o["width"] for o in outs) - x0
        bh = max(o["y"] + o["height"] for o in outs) - y0
        o = next((o for o in outs if o["name"] == output), outs[0])
        self.map = ((o["x"] - x0) / bw, (o["y"] - y0) / bh, o["width"] / bw, o["height"] / bh)

    def handle(self, ev):
        e = self.e
        kind = ev[0]
        if kind == "m":
            u = min(max(float(ev[1]), 0.0), 0.9999)
            v = min(max(float(ev[2]), 0.0), 0.9999)
            mx, my, mw, mh = self.map
            self.mouse.write(e.EV_ABS, e.ABS_X, int((mx + u * mw) * 65535))
            self.mouse.write(e.EV_ABS, e.ABS_Y, int((my + v * mh) * 65535))
            self.mouse.syn()
        elif kind == "d":
            # Captured mouse: movement in the other computer's mouse units
            for i, axis in ((0, e.REL_X), (1, e.REL_Y)):
                self.rel[i] += max(min(float(ev[1 + i]), 10000.0), -10000.0)
                whole = int(self.rel[i])
                if whole:
                    self.rel_mouse.write(e.EV_REL, axis, whole)
                    self.rel[i] -= whole
            self.rel_mouse.syn()
        elif kind == "b":
            code, down = int(ev[1]), bool(ev[2])
            if code in self.BUTTONS and (down != (code in self.down_buttons)):
                (self.down_buttons.add if down else self.down_buttons.discard)(code)
                self.mouse.write(e.EV_KEY, code, int(down))
                self.mouse.syn()
        elif kind == "k":
            code, down = int(ev[1]), bool(ev[2])
            # The host repeats held keys itself, so the other side's repeats are dropped
            if 1 <= code <= 248 and (down != (code in self.down_keys)):
                (self.down_keys.add if down else self.down_keys.discard)(code)
                self.kb.write(e.EV_KEY, code, int(down))
                self.kb.syn()
        elif kind == "s":
            # Wheel turns (1.0 = one notch); the other side's y grows downwards
            for i, (delta, hires, lores) in enumerate(((float(ev[1]), e.REL_HWHEEL_HI_RES, e.REL_HWHEEL),
                                                       (-float(ev[2]), e.REL_WHEEL_HI_RES, e.REL_WHEEL))):
                if not delta:
                    continue
                units = int(round(delta * 120))
                self.mouse.write(e.EV_REL, hires, units)
                self.wheel[i] += units
                notches = int(self.wheel[i] / 120)
                if notches:
                    self.mouse.write(e.EV_REL, lores, notches)
                    self.wheel[i] -= notches * 120
            self.mouse.syn()
        elif kind == "r":
            self.release_all()

    def release_all(self):
        e = self.e
        for code in list(self.down_keys):
            self.kb.write(e.EV_KEY, code, 0)
        self.kb.syn()
        for code in list(self.down_buttons):
            self.mouse.write(e.EV_KEY, code, 0)
        self.mouse.syn()
        self.down_keys.clear()
        self.down_buttons.clear()

    def close(self):
        try:
            self.release_all()
        finally:
            self.kb.close()
            self.mouse.close()
            self.rel_mouse.close()


def video_encoders(kbps, fps):
    """H.264 encoders to try, best first: (element, [(factory, properties)]).
    Hardware encoders only appear when the graphics card has one."""
    gop = fps * 5
    nv12 = ("capsfilter", {"caps": "video/x-raw,format=NV12"})
    i420 = ("capsfilter", {"caps": "video/x-raw,format=I420"})
    va = [("vapostproc", {}), ("capsfilter", {"caps": "video/x-raw(memory:VAMemory),format=NV12"})]
    va_props = {"bitrate": kbps, "key-int-max": gop, "b-frames": 0, "rate-control": "cbr", "target-usage": 6}
    return [
        ("nvh264enc", [("videoconvert", {}), nv12,
                       ("nvh264enc", {"bitrate": kbps, "gop-size": gop, "bframes": 0, "rc-mode": "cbr",
                                      "zerolatency": True, "preset": "low-latency-hq"})]),
        ("vah264lpenc", va + [("vah264lpenc", va_props)]),
        ("vah264enc", va + [("vah264enc", va_props)]),
        ("qsvh264enc", [("videoconvert", {}), nv12,
                        ("qsvh264enc", {"bitrate": kbps, "gop-size": gop, "b-frames": 0,
                                        "rate-control": "cbr", "low-latency": True})]),
        ("x264enc", [("videoconvert", {"n-threads": 0}), i420,
                     ("x264enc", {"tune": "zerolatency", "speed-preset": "superfast", "bitrate": kbps,
                                  "key-int-max": gop, "threads": 0})]),
        ("openh264enc", [("videoconvert", {"n-threads": 0}), i420,
                         ("openh264enc", {"bitrate": kbps * 1000, "gop-size": gop, "complexity": "low",
                                          "rate-control": "bitrate"})]),
    ]


def make_element(factory, props, name=None):
    from gi.repository import Gst
    el = Gst.ElementFactory.make(factory, name)
    if el is None:
        raise RuntimeError(f"GStreamer element {factory} is missing")
    for key, value in props.items():
        if el.find_property(key) is None:
            continue
        try:
            if key == "caps":
                el.set_property(key, Gst.Caps.from_string(value))
            elif isinstance(value, str):
                Gst.util_set_object_arg(el, key, value)
            else:
                el.set_property(key, value)
        except (TypeError, ValueError):
            log(f"{factory}: couldn't set {key}={value}")
    return el


def chain(pipeline, elements):
    for el in elements:
        pipeline.add(el)
    for a, b in zip(elements, elements[1:]):
        if not a.link(b):
            raise RuntimeError(f"couldn't link {a.get_name()} to {b.get_name()}")


class Capture:
    """The host's GStreamer pipelines: the shared screen (and the sound),
    out to everyone watching through `out` (a Session)."""

    def __init__(self, conf, out, source=None):
        import gi
        gi.require_version("Gst", "1.0")
        gi.require_version("GstVideo", "1.0")
        from gi.repository import Gst, GstVideo
        Gst.init(None)
        self.Gst, self.GstVideo = Gst, GstVideo
        self.conf = conf
        self.out = out
        self.source = source            # (pipewire fd, node) or None for a test picture
        self.video = self.audio = None
        self.caps = {}
        self.key_asked = 0.0
        self.first = threading.Event()
        self.broken = threading.Event()     # the video stopped (any time)
        self.failed = None
        self.encoder = None

    # video
    _encoder = {}                       # the setting -> the encoder that worked (tried once per daemon)
    # The portal offers no ordinary memory: go through OpenGL (found out on
    # the first try; FIROX_STREAM_GPU=1 starts that way)
    _gpu_buffers = os.environ.get("FIROX_STREAM_GPU") == "1"

    def pick_encoder(self, kbps, fps):
        """The first encoder that encodes a few frames of a test picture.
        Trying them on the shared screen itself isn't safe: a second
        capture of the same portal stream can upset the portal."""
        Gst = self.Gst
        wanted = self.conf.get("encoder") or "auto"
        key = (wanted, Capture._gpu_buffers)
        if key in Capture._encoder:
            return Capture._encoder[key]
        # Through OpenGL (NVIDIA), VA-API is another chip's, or none: on the
        # first NVIDIA computer it garbled the colours and stopped after a frame
        candidates = [c for c in video_encoders(kbps, fps)
                      if wanted in ("auto", c[0]) and Gst.ElementFactory.find(c[0])
                      and not (Capture._gpu_buffers and wanted == "auto" and c[0].startswith("va"))]
        for name, elements in candidates:
            pipeline = Gst.Pipeline.new("probe")
            try:
                src = make_element("videotestsrc", {"num-buffers": 5})
                caps = make_element("capsfilter", {"caps": "video/x-raw,format=BGRx,width=640,height=360,framerate=30/1"})
                parse = make_element("h264parse", {})
                sink = make_element("fakesink", {"sync": False})
                chain(pipeline, [src, caps] + [make_element(f, dict(p)) for f, p in elements] + [parse, sink])
            except RuntimeError as e:
                log(f"{name}: {e}")
                continue
            pipeline.set_state(Gst.State.PLAYING)
            msg = pipeline.get_bus().timed_pop_filtered(10 * Gst.SECOND, Gst.MessageType.EOS | Gst.MessageType.ERROR)
            pipeline.set_state(Gst.State.NULL)
            if msg is not None and msg.type == Gst.MessageType.EOS:
                Capture._encoder[key] = (name, elements)
                return name, elements
            log(f"{name}: " + (msg.parse_error()[0].message if msg is not None else "no picture after 10 seconds"))
        raise RuntimeError("no H.264 encoder works on this computer" if wanted == "auto"
                           else f"the {wanted} encoder isn't available")

    def start_video(self):
        Gst = self.Gst
        kbps, fps = int(self.conf.get("bitrate") or 20000), int(self.conf.get("fps") or 60)
        name, elements = self.pick_encoder(kbps, fps)
        self.video = self._video_pipeline(elements, fps)
        self.video.set_state(Gst.State.PLAYING)
        if not self.first.wait(8) or self.failed:
            reason = self.failed or "no picture from the screen after 8 seconds"
            self.stop()
            raise RuntimeError(reason)
        self.encoder = name
        log(f"video: {name}, {kbps} kbit/s")
        return name

    def _video_pipeline(self, encoder, fps):
        Gst = self.Gst
        pipeline = Gst.Pipeline.new("video")
        if self.source:
            fd, node = self.source
            # Only ever the screen the portal shared. If PipeWire can't find
            # that stream (or it goes away, a monitor unplugged), it would
            # otherwise link the default video source: the webcam.
            screen_only = {"fd": os.dup(fd), "path": str(node), "do-timestamp": True, "keepalive-time": 1000,
                           "stream-properties": "props,node.dont-fallback=(string)true,node.dont-reconnect=(string)true"}
            if Capture._gpu_buffers:
                # The portal only hands out GPU buffers (DMA-BUFs; NVIDIA does
                # this): OpenGL imports them and copies the picture out
                src = [make_element("pipewiresrc", screen_only),
                       make_element("glupload", {}), make_element("glcolorconvert", {}),
                       make_element("gldownload", {}), make_element("capsfilter", {"caps": "video/x-raw"})]
            else:
                src = [make_element("pipewiresrc", dict(screen_only, **{"always-copy": True})),
                       # Ordinary memory. Otherwise pipewiresrc offers the portal
                       # only the GPU buffer layouts the encoder takes (VA-API's,
                       # behind vapostproc). The encoder uploads the frames itself.
                       make_element("capsfilter", {"caps": "video/x-raw"})]
        else:
            src = [make_element("videotestsrc", {"is-live": True, "pattern": "ball"}),
                   make_element("capsfilter", {"caps": f"video/x-raw,width=1280,height=720,framerate={fps}/1"})]
        # A frame the encoder can't keep up with is skipped before encoding
        # (skipping encoded frames would spoil the picture until the next key frame)
        leak = make_element("queue", {"leaky": "downstream", "max-size-buffers": 1,
                                      "max-size-bytes": 0, "max-size-time": 0})
        enc = [make_element(f, dict(p)) for f, p in encoder]
        parse = make_element("h264parse", {"config-interval": -1})
        caps = make_element("capsfilter", {"caps": "video/x-h264,stream-format=byte-stream,alignment=au"})
        sink = make_element("appsink", {"emit-signals": True, "sync": False, "max-buffers": 8}, "sink")
        chain(pipeline, src + [leak] + enc + [parse, caps, sink])
        sink.connect("new-sample", self._on_video)
        pipeline.get_bus().set_sync_handler(self._on_bus, "video")
        return pipeline

    def _on_bus(self, _bus, msg, which):
        Gst = self.Gst
        if msg.type == Gst.MessageType.ERROR:
            err, debug = msg.parse_error()
            log(f"{which} error from {msg.src.get_name()}: {err.message} ({debug})")
            if which == "video":
                message = err.message
                if "target not found" in message:
                    # node.dont-fallback: the shared screen's stream wasn't
                    # there, and nothing else (a webcam) is taken instead
                    message = "the shared screen's picture wasn't available"
                self.failed = self.failed or message
                self.first.set()
                self.broken.set()
            else:
                log("sound off for this stream")
        return Gst.BusSyncReply.DROP

    def _send_caps(self, kind, sample):
        caps = sample.get_caps().to_string()
        if self.caps.get(kind) != caps:
            self.caps[kind] = caps
            self.out.send_caps(kind, caps)

    def request_key(self):
        """Make the next frame a key frame (with the stream headers): someone
        has a new decoder, which can't use frames that build on earlier ones."""
        if self.video is None:
            return
        sink = self.video.get_by_name("sink")
        self.key_asked = time.monotonic()
        sink.send_event(self.GstVideo.video_event_new_upstream_force_key_unit(self.Gst.CLOCK_TIME_NONE, True, 0))

    def _on_video(self, sink):
        Gst = self.Gst
        sample = sink.emit("pull-sample")
        if sample is None:
            return Gst.FlowReturn.EOS
        buf = sample.get_buffer()
        self.first.set()
        if self.failed:
            return Gst.FlowReturn.OK
        delta = buf.has_flags(Gst.BufferFlags.DELTA_UNIT)
        ok, info = buf.map(Gst.MapFlags.READ)
        if not ok:
            return Gst.FlowReturn.OK
        data = bytes(info.data)
        buf.unmap(info)
        self._send_caps("video", sample)
        # Someone is waiting for a key frame (new, or behind on the network)
        if self.out.send_video(data, delta) and time.monotonic() - self.key_asked > 1:
            self.key_asked = time.monotonic()
            sink.send_event(self.GstVideo.video_event_new_upstream_force_key_unit(Gst.CLOCK_TIME_NONE, True, 0))
        return Gst.FlowReturn.OK

    # sound
    def start_audio(self):
        Gst = self.Gst
        if not self.conf.get("audio", True) or not Gst.ElementFactory.find("opusenc"):
            return False
        try:
            pipeline = Gst.Pipeline.new("audio")
            if self.source:
                src = make_element("pulsesrc", {"device": "@DEFAULT_MONITOR@", "buffer-time": 40000,
                                                "latency-time": 10000, "do-timestamp": True})
            else:
                src = make_element("audiotestsrc", {"is-live": True, "wave": "ticks"})
            caps = make_element("capsfilter", {"caps": "audio/x-raw,rate=48000,channels=2"})
            enc = make_element("opusenc", {"bitrate": 128000, "frame-size": 10,
                                           "audio-type": "restricted-lowdelay"})
            sink = make_element("appsink", {"emit-signals": True, "sync": False, "max-buffers": 50}, "sink")
            chain(pipeline, [src, make_element("audioconvert", {}), make_element("audioresample", {}),
                             caps, enc, sink])
        except RuntimeError as e:
            log(f"sound: {e}")
            return False
        sink.connect("new-sample", self._on_audio)
        pipeline.get_bus().set_sync_handler(self._on_bus, "audio")
        self.audio = pipeline
        pipeline.set_state(Gst.State.PLAYING)
        return True

    def _on_audio(self, sink):
        Gst = self.Gst
        sample = sink.emit("pull-sample")
        if sample is None:
            return Gst.FlowReturn.EOS
        buf = sample.get_buffer()
        ok, info = buf.map(Gst.MapFlags.READ)
        if ok:
            data = bytes(info.data)
            buf.unmap(info)
            self._send_caps("audio", sample)
            self.out.send_audio(data)
        return Gst.FlowReturn.OK

    def stop(self):
        for p in (self.video, self.audio):
            if p is not None:
                p.set_state(self.Gst.State.NULL)
        self.video = self.audio = None


class Gamepad:
    """One virtual Xbox 360 controller on this computer (uinput), driven by
    a controller on the other computer. It looks like the real thing to
    games, Steam and SDL (same name and USB IDs, the xpad driver's buttons
    and axes), and takes rumble, which goes back to the real controller."""

    # The wire format (Pads on the other side): SDL's button numbers
    A, B, X, Y, BACK, GUIDE, START, LSTICK, RSTICK, LB, RB, UP, DOWN, LEFT, RIGHT = range(15)

    def __init__(self):
        from evdev import AbsInfo, UInput
        from evdev import ecodes as e
        self.e = e
        # xpad's codes: X is BTN_X (= BTN_NORTH) and Y is BTN_Y (= BTN_WEST)
        self.keys = {self.A: e.BTN_SOUTH, self.B: e.BTN_EAST, self.X: e.BTN_NORTH, self.Y: e.BTN_WEST,
                     self.LB: e.BTN_TL, self.RB: e.BTN_TR, self.BACK: e.BTN_SELECT,
                     self.START: e.BTN_START, self.GUIDE: e.BTN_MODE,
                     self.LSTICK: e.BTN_THUMBL, self.RSTICK: e.BTN_THUMBR}
        stick = AbsInfo(0, -32768, 32767, 16, 128, 0)
        trigger = AbsInfo(0, 0, 255, 0, 0, 0)
        hat = AbsInfo(0, -1, 1, 0, 0, 0)
        self.ui = UInput({
            e.EV_KEY: sorted(self.keys.values()),
            e.EV_ABS: [(e.ABS_X, stick), (e.ABS_Y, stick), (e.ABS_RX, stick), (e.ABS_RY, stick),
                       (e.ABS_Z, trigger), (e.ABS_RZ, trigger), (e.ABS_HAT0X, hat), (e.ABS_HAT0Y, hat)],
            e.EV_FF: [e.FF_RUMBLE, e.FF_PERIODIC, e.FF_SQUARE, e.FF_TRIANGLE, e.FF_SINE, e.FF_GAIN],
        }, name="Microsoft X-Box 360 pad", vendor=0x045E, product=0x028E, version=0x0114,
            bustype=e.BUS_USB, max_effects=16)
        self.buttons = 0
        self.axes = [0, 0, 0, 0, 0, 0, 0, 0]       # LX LY RX RY LT RT hatX hatY
        self.effects = {}                           # id -> (strong, weak, ms)
        self.gain = 1.0

    def set(self, state):
        """state: [buttons, lx, ly, rx, ry, lt, rt] (sticks -32768..32767,
        y down; triggers 0..32767)."""
        e = self.e
        buttons = int(state[0]) & 0x7FFF
        clamp = lambda v, lo, hi: max(lo, min(hi, int(v)))
        axes = [clamp(state[1], -32768, 32767), clamp(state[2], -32768, 32767),
                clamp(state[3], -32768, 32767), clamp(state[4], -32768, 32767),
                clamp(state[5], 0, 32767) * 255 // 32767, clamp(state[6], 0, 32767) * 255 // 32767,
                ((buttons >> self.RIGHT) & 1) - ((buttons >> self.LEFT) & 1),
                ((buttons >> self.DOWN) & 1) - ((buttons >> self.UP) & 1)]
        changed = False
        for bit, code in self.keys.items():
            now = (buttons >> bit) & 1
            if now != (self.buttons >> bit) & 1:
                self.ui.write(e.EV_KEY, code, now)
                changed = True
        codes = (e.ABS_X, e.ABS_Y, e.ABS_RX, e.ABS_RY, e.ABS_Z, e.ABS_RZ, e.ABS_HAT0X, e.ABS_HAT0Y)
        for i, code in enumerate(codes):
            if axes[i] != self.axes[i]:
                self.ui.write(e.EV_ABS, code, axes[i])
                changed = True
        self.buttons, self.axes = buttons, axes
        if changed:
            self.ui.syn()

    def neutral(self):
        self.set([0, 0, 0, 0, 0, 0, 0])

    def rumble_events(self):
        """Rumble the game asked for since last time: [(strong, weak, ms)],
        (0, 0, 0) meaning stop."""
        e = self.e
        out = []
        while True:
            try:
                ev = self.ui.read_one()
            except (BlockingIOError, OSError):
                break
            if ev is None:
                break
            if ev.type == e.EV_UINPUT and ev.code == e.UI_FF_UPLOAD:
                up = self.ui.begin_upload(ev.value)
                eff = up.effect
                if eff.type == e.FF_RUMBLE:
                    r = eff.u.ff_rumble_effect
                    strong, weak = r.strong_magnitude, r.weak_magnitude
                elif eff.type == e.FF_PERIODIC:
                    strong = weak = min(abs(eff.u.ff_periodic_effect.magnitude) * 2, 0xFFFF)
                else:
                    strong = weak = 0
                self.effects[eff.id] = (strong, weak, eff.ff_replay.length)
                up.retval = 0
                self.ui.end_upload(up)
            elif ev.type == e.EV_UINPUT and ev.code == e.UI_FF_ERASE:
                er = self.ui.begin_erase(ev.value)
                self.effects.pop(er.effect_id, None)
                er.retval = 0
                self.ui.end_erase(er)
            elif ev.type == e.EV_FF and ev.code == e.FF_GAIN:
                self.gain = max(0, min(ev.value, 0xFFFF)) / 0xFFFF
            elif ev.type == e.EV_FF and ev.code in self.effects:
                strong, weak, ms = self.effects[ev.code]
                if ev.value:
                    out.append((int(strong * self.gain), int(weak * self.gain), ms or 5000))
                else:
                    out.append((0, 0, 0))
        return out

    def close(self):
        try:
            self.neutral()
        finally:
            self.ui.close()


class Gamepads:
    """The virtual controllers of everyone watching: each viewer's
    controllers get their own (up to four), made when one first sends its
    state and removed when it's unplugged or the viewer leaves. A thread
    passes rumble back to the controller it belongs to."""

    PER_VIEWER = 4

    def __init__(self, send):
        self.send = send                    # send(channel, kind, payload)
        self.lock = threading.Lock()
        self.pads = {}                      # (channel, slot) -> Gamepad
        self.broken = False
        self.running = True
        threading.Thread(target=self._rumble_loop, daemon=True).start()

    def handle(self, channel, msg):
        slot = int(msg.get("p", -1))
        if not 0 <= slot < self.PER_VIEWER or self.broken:
            return
        key = (channel, slot)
        if msg.get("gone"):
            with self.lock:
                pad = self.pads.pop(key, None)
            if pad:
                pad.close()
                log(f"controller {slot + 1} unplugged")
            return
        state = msg.get("s")
        if not isinstance(state, list) or len(state) != 7:
            return
        with self.lock:
            pad = self.pads.get(key)
        if pad is None:
            try:
                pad = Gamepad()
            except Exception as e:          # no /dev/uinput access
                log(f"game controllers unavailable: {e}")
                self.broken = True
                return
            with self.lock:
                self.pads[key] = pad
            log(f"controller {slot + 1} connected: {msg.get('name') or 'a controller'}")
        pad.set(state)

    def neutral(self, channel=None):
        """Let go of everything (a viewer's window went to the background)."""
        with self.lock:
            pads = [p for (ch, _s), p in self.pads.items() if channel is None or ch is channel]
        for p in pads:
            try:
                p.neutral()
            except OSError:
                pass

    def drop(self, channel=None):
        with self.lock:
            keys = [k for k in self.pads if channel is None or k[0] is channel]
            pads = [self.pads.pop(k) for k in keys]
        for p in pads:
            try:
                p.close()
            except OSError:
                pass

    def close(self):
        self.running = False
        self.drop()

    def _rumble_loop(self):
        while self.running:
            with self.lock:
                pads = list(self.pads.items())
            if not pads:
                time.sleep(0.2)
                continue
            fds = {p.ui.fd: (k, p) for k, p in pads}
            try:
                ready, _w, _x = select.select(list(fds), [], [], 0.2)
            except (OSError, ValueError):
                time.sleep(0.05)
                continue
            for fd in ready:
                (channel, slot), pad = fds[fd]
                try:
                    events = pad.rumble_events()
                except OSError:
                    continue
                for strong, weak, ms in events:
                    self.send(channel, "R", {"p": slot, "lo": strong, "hi": weak, "ms": ms})


class Session:
    """What everyone watching this computer shares: one screen capture (and
    sound), the virtual keyboard and mice, and the idle-timer hold. Each
    viewer's channel gets the picture on its own terms: one that falls
    behind on the network skips to the next key frame without holding the
    others back. Ends when the last viewer leaves."""

    def __init__(self, host):
        self.host = host
        self.lock = threading.Lock()
        self.viewers = {}                   # Channel -> {"name", "need_key"}
        self.capture = self.cast = self.injector = None
        self.pads = None
        self.cursor = self.audio = False
        self.locked = False
        self.ended = False
        self.output = None

    @property
    def closed(self):                       # (open_capture gives up when it is)
        return self.ended

    def names(self):
        with self.lock:
            return [v["name"] for ch, v in self.viewers.items() if not ch.closed]

    def info(self):
        return {"name": self.host.name, "input": self.injector is not None,
                "gamepads": self.injector is not None, "cursor": self.cursor,
                "audio": self.audio, "encoder": self.capture.encoder if self.capture else None,
                "locked": self.locked, "viewers": self.names()}

    # -- starting and stopping
    def start(self, conf):
        import firox_monitors
        self.conf = conf
        self.locked = screen_locked()
        keep_awake(True)
        wake_screen()
        time.sleep(0.5)                     # monitors coming back on
        self.output = firox_monitors.main_name()
        self.capture, self.cast, self.cursor = self.host.open_capture(conf, self, self.output)
        try:
            self.injector = Injector(self.output)
        except Exception as e:              # no /dev/uinput access: the picture only
            log(f"keyboard and mouse unavailable: {e}")
        if self.injector is not None:
            self.pads = Gamepads(lambda ch, kind, payload: ch.send(kind, payload))
        self.audio = self.capture.start_audio()
        threading.Thread(target=self.supervise, daemon=True).start()

    def stop(self):
        self.ended = True
        self.host.close_capture(self.capture, self.cast)
        self.capture = self.cast = None
        if self.pads:
            self.pads.close()
            self.pads = None
        if self.injector:
            self.injector.close()
            self.injector = None
        keep_awake(False)
        try:
            os.unlink(CHOOSER_HINT)
        except OSError:
            pass

    def add(self, channel, name):
        with self.lock:
            others = [v["name"] for ch, v in self.viewers.items() if not ch.closed]
            self.viewers[channel] = {"name": name, "need_key": True}
        # The newcomer's decoder needs the stream headers and a key frame
        for kind, caps in (self.capture.caps if self.capture else {}).items():
            channel.send("K", {"kind": kind, "caps": caps})
        if self.capture:
            self.capture.request_key()
        if others:
            self.broadcast("S", {"viewers": self.names(), "joined": name})

    def remove(self, channel):
        """Returns how many are still watching."""
        with self.lock:
            v = self.viewers.pop(channel, None)
            left = sum(1 for ch in self.viewers if not ch.closed)
        if self.injector:
            try:
                self.injector.release_all()     # nothing stays held down
            except OSError:
                pass
        if self.pads:
            self.pads.drop(channel)             # their controllers are unplugged
        if v and left:
            self.broadcast("S", {"viewers": self.names(), "left": v["name"]})
        return left

    def kick(self, reason):
        with self.lock:
            channels = list(self.viewers)
            self.viewers.clear()            # gone from the list now; their connections close shortly
        if self.injector:
            try:
                self.injector.release_all()
            except OSError:
                pass
        if self.pads:
            self.pads.drop()
        for ch in channels:
            ch.send("E", {"error": reason})
            threading.Timer(1.0, ch.close, args=("disconnected by this computer",)).start()

    # -- out to everyone (called from GStreamer's threads)
    def channels(self):
        with self.lock:
            return [(ch, v) for ch, v in self.viewers.items() if not ch.closed]

    def broadcast(self, kind, payload=b""):
        for ch, _v in self.channels():
            ch.send(kind, payload)

    def send_caps(self, kind, caps):
        self.broadcast("K", {"kind": kind, "caps": caps})

    def send_video(self, data, delta):
        """Returns True when someone waits for a key frame."""
        want_key = False
        for ch, v in self.channels():
            if ch.backlog() > BACKLOG_LIMIT:
                v["need_key"] = True        # behind on the network: skip to a key frame
            if v["need_key"]:
                if delta or ch.backlog() > BACKLOG_LIMIT:
                    want_key = True
                    continue
                v["need_key"] = False
            ch.send("V", data)
        return want_key

    def send_audio(self, data):
        for ch, _v in self.channels():
            if ch.backlog() <= BACKLOG_LIMIT:
                ch.send("A", data)

    # -- from a viewer
    def on_message(self, channel, client, kind, payload):
        if kind == "I" and self.injector is not None:
            try:
                for ev in json.loads(payload):
                    self.injector.handle(ev)
            except (ValueError, TypeError, IndexError, OSError) as e:
                log(f"input: {e}")
        elif kind == "G" and self.pads is not None:
            try:
                msg = json.loads(payload)
                if msg.get("idle"):
                    self.pads.neutral(channel)
                else:
                    self.pads.handle(channel, msg)
            except (ValueError, TypeError, AttributeError, OSError) as e:
                log(f"controller: {e}")
        elif kind == "F":
            with self.lock:
                if channel in self.viewers:
                    self.viewers[channel]["need_key"] = True
            if self.capture is not None:
                self.capture.request_key()
        elif kind == "W":
            threading.Thread(target=wake_screen, daemon=True).start()
        elif kind == "U":
            try:
                password = str(json.loads(payload).get("password", ""))
            except (ValueError, AttributeError):
                password = ""

            def try_unlock():
                ok, message = unlock_screen(password) if password else (False, "No password given.")
                log(f"remote unlock from {client}: {'unlocked' if ok else 'not unlocked'}")
                channel.send("u", {"ok": ok, "message": message})
                if ok:
                    self.locked = False
                    self.broadcast("L", {"locked": False})
            threading.Thread(target=try_unlock, daemon=True).start()
        elif kind == "Q":
            channel.close("stopped")

    def supervise(self):
        """Tell viewers when this computer locks or unlocks, and start the
        capture again when it stops in the middle (viewers get a fresh key
        frame and carry on)."""
        restarts = collections.deque()
        checked = time.monotonic()
        while not self.ended:
            if time.monotonic() - checked > 2:
                checked = time.monotonic()
                locked = screen_locked()
                if locked != self.locked:
                    self.locked = locked
                    self.broadcast("L", {"locked": locked})
            capture = self.capture
            if capture is None or not capture.broken.wait(1) or self.ended:
                continue
            now = time.monotonic()
            while restarts and now - restarts[0] > 60:
                restarts.popleft()
            reason = capture.failed or "the screen capture stopped"
            self.host.close_capture(capture, self.cast)
            self.capture = self.cast = None
            if len(restarts) >= 5:
                self.kick(f"The screen capture keeps stopping: {reason}")
                return
            restarts.append(now)
            log(f"capture stopped ({reason}); starting it again")
            try:
                self.capture, self.cast, _c = self.host.open_capture(self.conf, self, self.output)
                self.capture.start_audio()
                with self.lock:
                    for v in self.viewers.values():
                        v["need_key"] = True
            except Exception as e:
                self.kick(f"The screen capture stopped: {e}")
                return


class Host:
    """`firox-stream daemon`: answers computers that want to stream this one."""

    def __init__(self):
        import gi
        gi.require_version("Gtk", "3.0")
        from gi.repository import GLib, Gtk
        self.GLib, self.Gtk = GLib, Gtk
        self.conf = load_conf()
        self.port = int(os.environ.get("FIROX_STREAM_PORT") or self.conf.get("port") or PORT)
        cert, key, self.fingerprint = ensure_cert()
        self.tls = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
        self.tls.minimum_version = ssl.TLSVersion.TLSv1_2
        self.tls.load_cert_chain(cert, key)
        self.server = socket.create_server(("", self.port), family=socket.AF_INET6, dualstack_ipv6=True) \
            if socket.has_dualstack_ipv6() else socket.create_server(("0.0.0.0", self.port))
        self.session = None                 # everyone watching shares one Session
        self.session_lock = threading.RLock()
        self.pin_dialog = None
        self.publisher = None
        self.name = computer_name()
        threading.Thread(target=self.accept_loop, daemon=True).start()
        threading.Thread(target=self.serve_control, daemon=True).start()
        self.web_server = None
        if self.conf.get("web"):
            web_port = int(os.environ.get("FIROX_STREAM_WEB_PORT") or self.conf.get("web_port") or WEB_PORT)
            try:
                self.web_server = socket.create_server(("", web_port), family=socket.AF_INET6,
                                                       dualstack_ipv6=True) \
                    if socket.has_dualstack_ipv6() else socket.create_server(("0.0.0.0", web_port))
                threading.Thread(target=self.web_loop, daemon=True).start()
                log(f"web browsers: https://{socket.gethostname()}.local:{web_port}/")
            except OSError as e:
                log(f"web browsers: couldn't listen on port {web_port}: {e}")
        self.publish()
        GLib.timeout_add_seconds(30, self.watchdog)
        log(f"listening on port {self.port}")
        # (No firewall check here: asking firewalld needs the password,
        # which mustn't pop up at every login. Turning streaming on checks.)

    def publish(self):
        try:
            self.publisher = subprocess.Popen(["avahi-publish-service", self.name, SERVICE, str(self.port), "v=1"],
                                              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError:
            self.publisher = None

    def watchdog(self):
        if self.publisher is not None and self.publisher.poll() is not None:
            self.publish()
        return True

    def accept_loop(self):
        while True:
            try:
                raw, addr = self.server.accept()
            except OSError:
                time.sleep(1)
                continue
            threading.Thread(target=self.serve, args=(raw, addr[0]), daemon=True).start()

    # -- one connection
    def serve(self, raw, address):
        if address.startswith("::ffff:"):
            address = address[7:]
        try:
            raw.settimeout(15)
            keepalive(raw)
            sock = self.tls.wrap_socket(raw, server_side=True)
        except (OSError, ssl.SSLError) as e:
            log(f"{address}: TLS failed: {e}")
            raw.close()
            return
        try:
            client = self.handshake(sock, address)
            mode = self.choose_mode(sock, client) if client else None
        except (OSError, ValueError, EOFError) as e:
            log(f"{address}: {e}")
            client = mode = None
        if client is None or mode is None:
            sock.close()
            return
        self.stream(sock, client, address, mode)

    def web_loop(self):
        while True:
            try:
                raw, addr = self.web_server.accept()
            except OSError:
                time.sleep(1)
                continue
            threading.Thread(target=self.serve_web, args=(raw, addr[0]), daemon=True).start()

    def serve_web(self, raw, address):
        """A web browser: the page (GET /), or the page's WebSocket (/ws),
        which pairs and joins like an app and then watches over WebRTC."""
        if address.startswith("::ffff:"):
            address = address[7:]
        try:
            raw.settimeout(15)
            keepalive(raw)
            sock = self.tls.wrap_socket(raw, server_side=True)
        except (OSError, ssl.SSLError) as e:
            # (a browser that hasn't accepted the certificate yet hangs up here)
            log(f"{address}: web TLS failed: {e}")
            raw.close()
            return
        try:
            method, path, headers, rest = read_http_request(sock)
            if not load_conf().get("web"):
                http_reply(sock, "403 Forbidden", b"Web browsers can't stream this computer.\n")
                sock.close()
                return
            if path == "/ws" and headers.get("upgrade", "").lower() == "websocket":
                # Only the page this computer serves may open it (not another
                # web site the browser has open)
                origin, host = headers.get("origin", ""), headers.get("host", "")
                if not host or origin != f"https://{host}":
                    http_reply(sock, "403 Forbidden", b"Wrong origin.\n")
                    sock.close()
                    return
                key = headers.get("sec-websocket-key", "")
                sock.sendall(("HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n"
                              f"Sec-WebSocket-Accept: {ws_accept(key)}\r\n\r\n").encode())
                self.serve_page_socket(sock, rest, address)
                return
            entry = WEB_FILES.get(path) if method in ("GET", "HEAD") else None
            if entry is None:
                http_reply(sock, "404 Not Found", b"Not found.\n")
            else:
                name, ctype = entry
                with open(name if name.startswith("/") else os.path.join(WEB_DIR, name), "rb") as fh:
                    body = fh.read()
                http_reply(sock, "200 OK", b"" if method == "HEAD" else body, ctype)
        except (OSError, ValueError, EOFError) as e:
            log(f"{address}: web: {e}")
        try:
            sock.close()
        except OSError:
            pass

    def serve_page_socket(self, sock, rest, address):
        ws = WebHandshake(sock, rest, self.fingerprint)
        try:
            client = self.handshake(ws, address)
            mode = self.choose_mode(ws, client) if client else None
        except (OSError, ValueError, EOFError) as e:
            log(f"{address}: {e}")
            client = mode = None
        if client is None or mode is None:
            ws.close()
            return
        try:
            viewer = WebViewer(sock, bytes(ws.raw))
        except RuntimeError as e:
            log(f"{address}: {e}")
            self._refuse(ws, f"This computer can't stream to web browsers: {e}")
            return
        self.stream(ws, f"{client} (web browser)", address, mode, channel=viewer)

    def choose_mode(self, sock, client):
        """Someone is streaming already: ask whether to watch with them or
        take over. "join", "takeover", or None (they went away)."""
        with self.session_lock:
            session = self.session if self.session and not self.session.ended else None
            names = session.names() if session else []
        if not names:
            return "join"
        sock.sendall(frame("B", {"viewers": names}))
        sock.settimeout(180)
        kind, msg = recv_json(sock)
        sock.settimeout(15)
        mode = msg.get("mode") if kind == "J" and isinstance(msg, dict) else None
        return mode if mode in ("join", "takeover") else None

    def _refuse(self, sock, text):
        try:
            sock.sendall(frame("E", {"error": text}))
        except OSError:
            pass
        sock.close()

    def handshake(self, sock, address):
        kind, hello = recv_json(sock)
        if kind != "H" or not isinstance(hello, dict):
            raise ValueError("not a Firox Stream client")
        name = str(hello.get("name") or address)[:60]
        self.conf = load_conf()
        if not self.conf.get("enabled"):
            self._refuse(sock, "Streaming is turned off on that computer.")
            return None
        token = str(hello.get("token") or "")
        known = self.conf.get("clients", {}).get(token_key(token)) if token else None
        if known and known.get("ssh_key") and not (self.conf.get("ssh_keys")
                                                    and known["ssh_key"] in accepted_ssh_keys()):
            known = None                    # paired by a key that's no longer accepted
        if known:
            return name                     # its name now (it may have been renamed)
        # An SSH key of yours instead of a PIN
        if hello.get("ssh") and self.conf.get("ssh_keys"):
            key = self.ssh_challenge(sock, name)
            if key:
                return self.issue_token(sock, name, address, ssh_key=key)
        # Pairing: a PIN on this screen, which the other computer's user types
        pin = f"{random.SystemRandom().randrange(10000):04d}"
        cancelled = threading.Event()
        self.GLib.idle_add(self._show_pin, name, pin, cancelled, sock)
        sock.sendall(frame("N", {"name": self.name}))
        sock.settimeout(180)
        try:
            for tries_left in (2, 1, 0):
                kind, msg = recv_json(sock)
                if cancelled.is_set():
                    self._refuse(sock, "Pairing was cancelled on that computer.")
                    return None
                if kind != "P":
                    return None
                if hmac.compare_digest(proof(pin, self.fingerprint, name), str(msg.get("proof", ""))):
                    break
                if not tries_left:
                    self._refuse(sock, "Wrong PIN. Start again to get a new one.")
                    return None
                sock.sendall(frame("W", {"left": tries_left}))
        finally:
            self.GLib.idle_add(self._hide_pin)
        if sock.fileno() < 0:
            return None
        sock.settimeout(15)
        return self.issue_token(sock, name, address)

    def issue_token(self, sock, name, address, ssh_key=None):
        token = secrets.token_hex(32)
        self.conf = load_conf()
        record = {"name": name, "paired": time.time()}
        if ssh_key:
            record["ssh_key"] = ssh_key     # (it stops working if the key is taken away)
        self.conf.setdefault("clients", {})[token_key(token)] = record
        save_conf(self.conf)
        log(f"paired with {name} ({address})" + (f" by its SSH key {ssh_key_label(ssh_key)}" if ssh_key else ""))
        sock.sendall(frame("T", {"token": token}))
        return name

    def ssh_challenge(self, sock, name):
        """Ask the other computer to sign a challenge with its SSH keys: the
        accepted key that did, or None (then it's the PIN)."""
        accepted = accepted_ssh_keys()
        if not accepted:
            return None
        nonce = secrets.token_hex(16)
        sock.sendall(frame("C", {"nonce": nonce, "namespace": SSH_NAMESPACE}))
        sock.settimeout(60)
        kind, msg = recv_json(sock)
        sock.settimeout(15)
        if kind != "S" or not isinstance(msg, dict) or not isinstance(msg.get("sigs"), list):
            return None
        message = ssh_message(self.fingerprint, name, nonce)
        for item in msg["sigs"][:8]:
            key = ssh_key_of(str(item.get("key", ""))) if isinstance(item, dict) else None
            if key in accepted and ssh_verify(key, item.get("sig"), message):
                return key
        log(f"{name}: no accepted SSH key signed the challenge; asking for the PIN")
        return None

    def open_capture(self, conf, channel, output):
        """Share the screen and start encoding it: (capture, portal session,
        cursor drawn in). xdg-desktop-portal-wlr sometimes drops a capture
        as it starts (it asks the compositor for a second frame while one is
        still out, and is disconnected); it comes straight back, so this
        tries a new screen-sharing session a few times."""
        test = os.environ.get("FIROX_STREAM_SOURCE") == "test"
        if not test:
            reset_portal()
        for attempt in range(1, 6):
            cast = source = capture = None
            cursor = False
            try:
                if not test:
                    cast = ScreenCast()
                    if output:
                        os.makedirs(STATE_DIR, exist_ok=True)
                        with open(CHOOSER_HINT, "w") as fh:
                            fh.write(output + "\n")
                    fd, node, cursor = cast.start()
                    source = (fd, node)
                capture = Capture(conf, channel, source)
                capture.start_video()
                # the portal's slip comes in the first moments
                if capture.broken.wait(2):
                    raise RuntimeError(capture.failed or "the screen capture stopped")
                return capture, cast, cursor
            except (RuntimeError, PortalError) as e:
                if capture:
                    capture.stop()
                if cast:
                    cast.close()
                if source:
                    os.close(source[0])
                # Some failures happen the same way every time: don't keep
                # knocking the portal over (systemd stops restarting it)
                formats = "no more input formats" in str(e)
                if formats and not Capture._gpu_buffers and not test:
                    import gi
                    gi.require_version("Gst", "1.0")
                    from gi.repository import Gst
                    if Gst.ElementFactory.find("glupload"):
                        Capture._gpu_buffers = True
                        log("the portal offers no ordinary memory: capturing through OpenGL instead")
                        formats = False
                final = ("encoder" in str(e) or formats or "cancelled" in str(e)
                         or "no screen was shared" in str(e))
                if attempt == 5 or final or channel.closed:
                    raise
                log(f"capture attempt {attempt} failed ({e}); trying again")
                reset_portal()
                time.sleep(3)

    @staticmethod
    def close_capture(capture, cast):
        if capture:
            capture.stop()
            if capture.source:
                os.close(capture.source[0])
        if cast:
            cast.close()

    def stream(self, sock, client, address, mode="join", channel=None):
        conf = load_conf()
        channel = channel or Channel(sock, None)
        with self.session_lock:
            session = self.session
            if mode == "takeover" and session is not None and not session.ended:
                log(f"{client} ({address}) takes over from {', '.join(session.names())}")
                session.kick(f"{client} took over the stream.")
            if session is None or session.ended:
                session = Session(self)
                try:
                    session.start(conf)
                except Exception as e:
                    log(f"couldn't start: {e}")
                    session.stop()
                    channel.discard()
                    self._refuse(sock, f"That computer couldn't share its screen: {e}")
                    return
                self.session = session
            try:
                sock.sendall(frame("O", session.info()))
            except OSError:
                channel.discard()
                if not session.viewers:
                    session.stop()
                    self.session = None
                return
            session.add(channel, client)
        log(f"{client} ({address}) connected; watching: {', '.join(session.names())}")
        notify(f"{client} is streaming this computer",
               "Firox Stream shows who's connected and can disconnect them.")
        channel.on_message = lambda kind, payload: session.on_message(channel, client, kind, payload)
        channel.run()
        log(f"{client} disconnected: {channel.reason}")
        with self.session_lock:
            if session.remove(channel) == 0:
                session.stop()
                if self.session is session:
                    self.session = None
        notify(f"{client} stopped streaming this computer", "")

    def viewers(self):
        with self.session_lock:
            return self.session.names() if self.session and not self.session.ended else []

    def kick_all(self, reason="This computer ended the stream."):
        with self.session_lock:
            if self.session and not self.session.ended:
                log(f"disconnecting {', '.join(self.session.names())}")
                self.session.kick(reason)

    # -- `firox-stream kick` and `status`, and the Firox Stream window
    def serve_control(self):
        try:
            os.unlink(CONTROL)
        except OSError:
            pass
        server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        old = os.umask(0o177)
        try:
            server.bind(CONTROL)
        finally:
            os.umask(old)
        server.listen(4)
        while True:
            try:
                conn, _ = server.accept()
            except OSError:
                return
            with conn:
                try:
                    creds = conn.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12)
                    if int.from_bytes(creds[4:8], sys.byteorder) != os.getuid():
                        continue
                    conn.settimeout(5)
                    cmd = conn.recv(256).decode(errors="replace").strip()
                    if cmd == "kick":
                        self.kick_all()
                    conn.sendall(json.dumps({"viewers": self.viewers()}).encode())
                except OSError:
                    pass

    # -- the PIN window
    def _show_pin(self, name, pin, cancelled, sock):
        Gtk = self.Gtk
        self._hide_pin()
        dlg = Gtk.MessageDialog(message_type=Gtk.MessageType.INFO, buttons=Gtk.ButtonsType.CANCEL,
                                text=f"{name} wants to stream this computer")
        dlg.set_title("Firox Stream")
        dlg.format_secondary_markup(
            "It will see this screen and use its keyboard and mouse. To allow it, type this PIN on "
            f"that computer:\n\n<span size='xx-large' font_family='monospace' weight='bold'>{pin}</span>"
            "\n\nIf you didn't start this, click Cancel.")
        def cancel(d, _r):
            cancelled.set()
            d.destroy()
            self.pin_dialog = None
            try:
                sock.shutdown(socket.SHUT_RDWR)     # the other computer stops waiting for a PIN
            except OSError:
                pass
        dlg.connect("response", cancel)
        dlg.set_keep_above(True)
        dlg.show_all()
        self.pin_dialog = dlg
        return False

    def _hide_pin(self):
        if self.pin_dialog is not None:
            try:
                self.pin_dialog.destroy()
            except Exception:
                pass
            self.pin_dialog = None
        return False


RUNTIME = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
STREAM_AWAKE = os.path.join(RUNTIME, "firox-stream-awake")      # read by firox-power
LOCK_SOCKET = os.path.join(RUNTIME, "firox-lock.sock")          # served by firox-lock
CONTROL = os.path.join(RUNTIME, "firox-stream.sock")            # the daemon: status, kick


def keep_awake(on):
    """Hold this computer's idle timers (screen saver, lock, monitor off,
    sleep) while it's being streamed: firox-power skips them while the file
    exists."""
    try:
        if on:
            open(STREAM_AWAKE, "w").close()
        else:
            os.unlink(STREAM_AWAKE)
    except OSError:
        pass
    try:
        subprocess.Popen(["firox-power", "start"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass


def wake_screen():
    """Monitors on and the screen saver gone, before capturing them."""
    for cmd in (["wlopm", "--on", "*"], ["firox-screensaver", "stop"]):
        try:
            subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
        except (OSError, subprocess.SubprocessError):
            pass


def screen_locked():
    """Is firox-lock up (and able to take a password)?"""
    if not os.path.exists(LOCK_SOCKET):
        return False
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(2)
            s.connect(LOCK_SOCKET)
        return True                 # (an empty connection is ignored)
    except OSError:
        return False


def unlock_screen(password):
    """Give firox-lock the password: (unlocked, message)."""
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(30)
            s.connect(LOCK_SOCKET)
            s.sendall(password.encode() + b"\n")
            answer = s.recv(64).decode(errors="replace").strip()
    except OSError:
        return False, "That computer isn't locked (or its lock screen can't be unlocked this way)."
    if answer == "ok":
        return True, "Unlocked"
    if answer == "busy":
        return False, "That computer's lock screen is busy checking a password. Try again in a moment."
    return False, "The password is incorrect."


def control(cmd="status"):
    """Ask the running daemon: {"viewers": [...]} (after kicking, for
    "kick"), or None when it isn't running."""
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(5)
            s.connect(CONTROL)
            s.sendall(cmd.encode() + b"\n")
            data = b""
            while True:
                chunk = s.recv(4096)
                if not chunk:
                    break
                data += chunk
        return json.loads(data or b"{}")
    except (OSError, ValueError):
        return None


def notify(summary, body):
    try:
        subprocess.Popen(["notify-send", "-a", "Firox Stream", "-i", "preferences-desktop-remote-desktop",
                          summary, body], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass


def policy_forbids():
    """A policy (firox-policy) doesn't allow streaming this computer."""
    try:
        with open("/var/lib/firox/policy/managed.json") as fh:
            settings = json.load(fh).get("settings") or {}
        return settings.get("stream.allowed") is False
    except (OSError, ValueError, AttributeError):
        return False


def run_daemon():
    if policy_forbids():
        return 0
    if not load_conf().get("enabled") and os.environ.get("FIROX_STREAM_FORCE") != "1":
        return 0
    os.makedirs(STATE_DIR, exist_ok=True)
    logfh = open(LOG, "w", buffering=1)
    os.dup2(logfh.fileno(), 2)
    try:
        Host()
    except OSError as e:
        log(f"couldn't start: {e}")          # most likely already running
        return 1
    if os.path.exists(STREAM_AWAKE):        # left by a daemon that didn't finish
        keep_awake(False)

    def warm_up():
        # GStreamer scans its plugins the first time (seconds, more after an
        # update): do it now rather than while someone waits to connect
        import gi
        gi.require_version("Gst", "1.0")
        from gi.repository import Gst
        Gst.init(None)
    threading.Thread(target=warm_up, daemon=True).start()
    from gi.repository import Gtk
    Gtk.main()
    return 0


# Run as root by open_firewall: let the port in on every active zone that
# doesn't already (zones whose target is ACCEPT, like trusted, let
# everything in). Asking firewalld anything needs the password, so it's one
# script, asked for once.
FIREWALL_SCRIPT = r"""
zones=$(firewall-cmd --get-active-zones 2>/dev/null | grep -v '^[[:space:]]' | cut -d' ' -f1)
[ -n "$zones" ] || zones=$(firewall-cmd --get-default-zone)
for z in $zones; do
    [ "$(firewall-cmd --permanent --zone="$z" --get-target 2>/dev/null)" = ACCEPT ] && continue
    for spec in "$@"; do        # PORT/tcp, or FIRST-LAST/udp
        if ! firewall-cmd --permanent --zone="$z" --query-port="$spec" >/dev/null 2>&1; then
            firewall-cmd --permanent --zone="$z" --add-port="$spec" >/dev/null || exit 3
        fi
        if ! firewall-cmd --zone="$z" --query-port="$spec" >/dev/null 2>&1; then
            firewall-cmd --zone="$z" --add-port="$spec" >/dev/null || exit 3
        fi
    done
done
"""


def firewall_ports(conf):
    """What other computers (and browsers) need to reach."""
    ports = [f"{int(conf.get('port') or PORT)}/tcp"]
    if conf.get("web"):
        ports += [f"{int(conf.get('web_port') or WEB_PORT)}/tcp", f"{ICE_PORTS[0]}-{ICE_PORTS[1]}/udp"]
    return ports


def open_firewall(ports):
    """Let other computers reach the port: one password prompt (when
    streaming is turned on). An image update doesn't bring the port to a
    zone whose settings were changed on this computer (by an old Sunshine
    install, for example), so it's done here. True when it's open (or
    there's no firewall running)."""
    try:
        running = subprocess.run(["systemctl", "is-active", "--quiet", "firewalld"], timeout=10).returncode == 0
    except (OSError, subprocess.SubprocessError):
        running = False
    if not running:
        return True
    try:
        return subprocess.run(["pkexec", "sh", "-c", FIREWALL_SCRIPT, "firox-stream", *ports],
                              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=300).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def set_enabled(on):
    if on and policy_forbids():
        print("Your organization's policy doesn't allow streaming this computer.", file=sys.stderr)
        return False
    conf = load_conf()
    conf["enabled"] = bool(on)
    save_conf(conf)
    reachable = True
    if on and not open_firewall(firewall_ports(conf)):
        reachable = False
        print(f"The firewall still blocks {', '.join(firewall_ports(conf))}: other computers can't connect.",
              file=sys.stderr)
    subprocess.run(["pkill", "-u", str(os.getuid()), "-f", "firox-stream daemon"],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if on:
        time.sleep(0.3)
        subprocess.Popen([sys.argv[0], "daemon"], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return reachable


def set_web(on):
    """Let web browsers stream this computer too (streaming has to be on).
    Returns whether they can reach it."""
    conf = load_conf()
    conf["web"] = bool(on)
    save_conf(conf)
    if conf.get("enabled"):
        return set_enabled(True)            # the firewall, and the daemon again
    return True


def web_addresses(conf=None):
    """Where a browser on the network finds this computer."""
    conf = conf or load_conf()
    port = int(conf.get("web_port") or WEB_PORT)
    out = [f"https://{socket.gethostname().split('.')[0]}.local:{port}/"]
    try:
        ips = subprocess.run(["hostname", "-I"], capture_output=True, text=True, timeout=5).stdout.split()
    except (OSError, subprocess.SubprocessError):
        ips = []
    out += [f"https://{ip}:{port}/" for ip in ips if ip.count(".") == 3][:2]
    return out


def daemon_running():
    return subprocess.run(["pgrep", "-u", str(os.getuid()), "-f", "firox-stream daemon"],
                          stdout=subprocess.DEVNULL).returncode == 0


# ----------------------------------------------------------------- client --

class PointerLock:
    """Mouse capture for games, as in VMware, Parsec or Moonlight: the
    pointer stays locked in the window and its movement goes to the host as
    relative motion (what mouse-look needs). GTK 3 doesn't offer this, so it
    speaks the compositor's pointer-constraints and relative-pointer
    protocols itself (labwc has both), on GTK's own Wayland connection.

    on_motion(dx, dy) gets unaccelerated movement while locked; on_unlocked()
    runs when the compositor ends the lock (the window lost focus)."""

    def __init__(self, gtk_window, on_motion, on_unlocked):
        import ctypes as C
        self.C = C
        self.on_motion, self.on_unlocked = on_motion, on_unlocked
        self.locked_pointer = None
        self.active = False
        gdk = C.CDLL("libgdk-3.so.0")
        wl = self.wl = C.CDLL("libwayland-client.so.0")
        display = gtk_window.get_display()
        if type(display).__name__ != "GdkWaylandDisplay":
            raise RuntimeError("not a Wayland session")

        def ptr(obj):
            get = C.pythonapi.PyCapsule_GetPointer
            get.restype, get.argtypes = C.c_void_p, [C.py_object, C.c_char_p]
            return get(obj.__gpointer__, None)

        for name in ("gdk_wayland_display_get_wl_display", "gdk_wayland_window_get_wl_surface",
                     "gdk_wayland_device_get_wl_pointer"):
            getattr(gdk, name).restype = C.c_void_p
            getattr(gdk, name).argtypes = [C.c_void_p]
        self.display = gdk.gdk_wayland_display_get_wl_display(ptr(display))
        self.surface = gdk.gdk_wayland_window_get_wl_surface(ptr(gtk_window.get_window()))
        self.pointer = gdk.gdk_wayland_device_get_wl_pointer(ptr(display.get_default_seat().get_pointer()))
        if not (self.display and self.surface and self.pointer):
            raise RuntimeError("no Wayland surface or pointer")
        for name, res in (("wl_proxy_marshal_flags", C.c_void_p), ("wl_proxy_add_listener", C.c_int),
                          ("wl_proxy_get_version", C.c_uint32), ("wl_display_create_queue", C.c_void_p),
                          ("wl_proxy_create_wrapper", C.c_void_p), ("wl_display_roundtrip_queue", C.c_int)):
            getattr(wl, name).restype = res
        wl.wl_proxy_destroy.argtypes = [C.c_void_p]
        wl.wl_proxy_wrapper_destroy.argtypes = [C.c_void_p]
        wl.wl_proxy_set_queue.argtypes = [C.c_void_p, C.c_void_p]
        wl.wl_proxy_get_version.argtypes = [C.c_void_p]
        wl.wl_display_create_queue.argtypes = [C.c_void_p]
        wl.wl_display_roundtrip_queue.argtypes = [C.c_void_p, C.c_void_p]
        wl.wl_event_queue_destroy.argtypes = [C.c_void_p]
        wl.wl_proxy_create_wrapper.argtypes = [C.c_void_p]
        wl.wl_proxy_add_listener.argtypes = [C.c_void_p, C.c_void_p, C.c_void_p]
        self._define_interfaces()

        # Find the two managers on a private queue, so GTK's own event
        # handling never sees these replies
        found = {}
        queue = wl.wl_display_create_queue(self.display)
        wrapper = wl.wl_proxy_create_wrapper(self.display)
        wl.wl_proxy_set_queue(wrapper, queue)
        registry = self._marshal(wrapper, 1, self.registry_iface, (), new=True)    # wl_display.get_registry
        wl.wl_proxy_wrapper_destroy(wrapper)
        GLOBAL = C.CFUNCTYPE(None, C.c_void_p, C.c_void_p, C.c_uint32, C.c_char_p, C.c_uint32)
        REMOVE = C.CFUNCTYPE(None, C.c_void_p, C.c_void_p, C.c_uint32)

        def on_global(_data, _reg, name, iface, version):
            found[iface.decode()] = name

        self._keep = [GLOBAL(on_global), REMOVE(lambda *a: None)]      # (callbacks must stay alive)
        self._registry_listener = (C.c_void_p * 2)(*(C.cast(f, C.c_void_p).value for f in self._keep))
        wl.wl_proxy_add_listener(registry, self._registry_listener, None)
        wl.wl_display_roundtrip_queue(self.display, queue)
        if "zwp_pointer_constraints_v1" not in found or "zwp_relative_pointer_manager_v1" not in found:
            wl.wl_proxy_destroy(registry)
            wl.wl_event_queue_destroy(queue)
            raise RuntimeError("this desktop can't lock the pointer")
        self.constraints = self._bind(registry, found["zwp_pointer_constraints_v1"], self.constraints_iface)
        relmgr = self._bind(registry, found["zwp_relative_pointer_manager_v1"], self.relmgr_iface)
        # Everything from here on is GTK's default queue: GTK dispatches it
        wl.wl_proxy_set_queue(self.constraints, None)
        wl.wl_proxy_set_queue(relmgr, None)
        wl.wl_proxy_destroy(registry)
        wl.wl_event_queue_destroy(queue)
        self.relptr = self._marshal(relmgr, 1, self.relptr_iface, (C.c_void_p(self.pointer),), new=True)
        MOTION = C.CFUNCTYPE(None, C.c_void_p, C.c_void_p, C.c_uint32, C.c_uint32,
                             C.c_int32, C.c_int32, C.c_int32, C.c_int32)

        def on_relative(_data, _obj, _hi, _lo, _dx, _dy, dx_unaccel, dy_unaccel):
            if self.active:
                self.on_motion(dx_unaccel / 256.0, dy_unaccel / 256.0)

        self._keep.append(MOTION(on_relative))
        self._rel_listener = (C.c_void_p * 1)(C.cast(self._keep[-1], C.c_void_p).value)
        wl.wl_proxy_add_listener(self.relptr, self._rel_listener, None)
        EVENT = C.CFUNCTYPE(None, C.c_void_p, C.c_void_p)

        def on_locked(_data, _obj):
            self.active = True

        def on_unlocked(_data, _obj):
            was = self.active
            self.active = False
            self._drop_lock()
            if was:
                self.on_unlocked()

        self._keep += [EVENT(on_locked), EVENT(on_unlocked)]
        self._lock_listener = (C.c_void_p * 2)(C.cast(self._keep[-2], C.c_void_p).value,
                                               C.cast(self._keep[-1], C.c_void_p).value)

    def _define_interfaces(self):
        C = self.C

        class Message(C.Structure):
            _fields_ = [("name", C.c_char_p), ("signature", C.c_char_p), ("types", C.c_void_p)]

        class Interface(C.Structure):
            _fields_ = [("name", C.c_char_p), ("version", C.c_int), ("method_count", C.c_int),
                        ("methods", C.c_void_p), ("event_count", C.c_int), ("events", C.c_void_p)]

        keep = self._defs = []

        def types(*ifaces):
            arr = (C.c_void_p * max(len(ifaces), 1))(*[C.addressof(i) if i is not None else None
                                                        for i in ifaces])
            keep.append(arr)
            return C.cast(arr, C.c_void_p).value

        def messages(*msgs):
            arr = (Message * max(len(msgs), 1))(*[Message(n.encode(), sig.encode(), t) for n, sig, t in msgs])
            keep.append(arr)
            return C.cast(arr, C.c_void_p).value

        def interface(iface, name, version, methods, events):
            keep.append(name.encode())
            iface.name, iface.version = keep[-1], version
            iface.method_count, iface.methods = len(methods), messages(*methods) if methods else None
            iface.event_count, iface.events = len(events), messages(*events) if events else None

        ext = lambda n: Interface.in_dll(self.wl, n)            # libwayland-client's own
        wl_surface, wl_pointer, wl_region = ext("wl_surface_interface"), ext("wl_pointer_interface"), \
            ext("wl_region_interface")
        self.registry_iface = ext("wl_registry_interface")
        relptr, relmgr, locked, confined, constraints = (Interface() for _ in range(5))
        keep += [relptr, relmgr, locked, confined, constraints]
        nulls = types(None, None, None, None, None, None)
        interface(relptr, "zwp_relative_pointer_v1", 1, [("destroy", "", nulls)],
                  [("relative_motion", "uuffff", nulls)])
        interface(relmgr, "zwp_relative_pointer_manager_v1", 1,
                  [("destroy", "", nulls), ("get_relative_pointer", "no", types(relptr, wl_pointer))], [])
        interface(locked, "zwp_locked_pointer_v1", 1,
                  [("destroy", "", nulls), ("set_cursor_position_hint", "ff", nulls),
                   ("set_region", "?o", types(wl_region))],
                  [("locked", "", nulls), ("unlocked", "", nulls)])
        interface(confined, "zwp_confined_pointer_v1", 1,
                  [("destroy", "", nulls), ("set_region", "?o", types(wl_region))],
                  [("confined", "", nulls), ("unconfined", "", nulls)])
        lock_types = types(locked, wl_surface, wl_pointer, wl_region, None)
        interface(constraints, "zwp_pointer_constraints_v1", 1,
                  [("destroy", "", nulls), ("lock_pointer", "noo?ou", lock_types),
                   ("confine_pointer", "noo?ou", types(confined, wl_surface, wl_pointer, wl_region, None))], [])
        self.relptr_iface, self.relmgr_iface, self.locked_iface, self.constraints_iface = \
            relptr, relmgr, locked, constraints

    def _marshal(self, proxy, opcode, iface, args, new=False):
        C = self.C
        version = self.wl.wl_proxy_get_version(C.c_void_p(proxy))
        head = [C.c_void_p(proxy), C.c_uint32(opcode),
                C.c_void_p(C.addressof(iface)) if new else C.c_void_p(None), C.c_uint32(version),
                C.c_uint32(0)]
        tail = ([C.c_void_p(None)] if new else []) + list(args)
        return self.wl.wl_proxy_marshal_flags(*head, *tail)

    def _bind(self, registry, name, iface):
        C = self.C
        return self.wl.wl_proxy_marshal_flags(C.c_void_p(registry), C.c_uint32(0), C.c_void_p(C.addressof(iface)),
                                              C.c_uint32(1), C.c_uint32(0), C.c_uint32(name), iface.name,
                                              C.c_uint32(1), C.c_void_p(None))

    def lock(self):
        if self.locked_pointer:
            return
        C = self.C
        # lock_pointer(id, surface, pointer, region = none, lifetime = oneshot)
        self.locked_pointer = self.wl.wl_proxy_marshal_flags(
            C.c_void_p(self.constraints), C.c_uint32(1), C.c_void_p(C.addressof(self.locked_iface)),
            C.c_uint32(1), C.c_uint32(0), C.c_void_p(None), C.c_void_p(self.surface),
            C.c_void_p(self.pointer), C.c_void_p(None), C.c_uint32(1))
        self.wl.wl_proxy_add_listener(self.locked_pointer, self._lock_listener, None)

    def _drop_lock(self):
        if self.locked_pointer:
            C = self.C
            self.wl.wl_proxy_marshal_flags(C.c_void_p(self.locked_pointer), C.c_uint32(0), C.c_void_p(None),
                                           C.c_uint32(1), C.c_uint32(1))     # destroy (flag: destroy proxy)
            self.locked_pointer = None

    def unlock(self):
        self.active = False
        self._drop_lock()


# GTK's mouse buttons to the host's (left, middle, right, back, forward)
GDK_BUTTONS = {1: 0x110, 2: 0x112, 3: 0x111, 8: 0x113, 9: 0x114}


class Pads:
    """The game controllers plugged into this computer, read through SDL's
    game controller API, which maps almost any controller to one Xbox
    layout. Runs in its own thread (SDL is only used from there); sends each
    controller's state when it changes, while active (the stream window in
    front), and plays the rumble the other computer sends back."""

    ADDED, REMOVED = 0x653, 0x654               # SDL_CONTROLLERDEVICEADDED / REMOVED
    BUTTONS, AXES = 15, 6

    def __init__(self, send, on_change=None):
        self.send = send                        # send(dict): one "G" message
        self.on_change = on_change              # on_change(text): a controller came or went
        self.active = True
        self.running = True
        self.rumbles = queue.Queue()
        self.thread = threading.Thread(target=self.run, daemon=True)
        self.thread.start()

    def set_active(self, on):
        if on != self.active:
            self.active = on
            if not on:
                self.send({"idle": 1})          # let go of everything over there

    def rumble(self, slot, low, high, ms):
        self.rumbles.put((slot, low, high, ms))

    def stop(self):
        self.running = False

    def run(self):
        import ctypes
        try:
            sdl = ctypes.CDLL("libSDL2-2.0.so.0")
        except OSError as e:
            log(f"game controllers: no SDL ({e})")
            return
        sdl.SDL_SetHint.argtypes = [ctypes.c_char_p, ctypes.c_char_p]
        sdl.SDL_GameControllerOpen.restype = ctypes.c_void_p
        sdl.SDL_GameControllerClose.argtypes = [ctypes.c_void_p]
        sdl.SDL_GameControllerGetJoystick.argtypes = [ctypes.c_void_p]
        sdl.SDL_GameControllerGetJoystick.restype = ctypes.c_void_p
        sdl.SDL_JoystickInstanceID.argtypes = [ctypes.c_void_p]
        sdl.SDL_GameControllerName.argtypes = [ctypes.c_void_p]
        sdl.SDL_GameControllerName.restype = ctypes.c_char_p
        sdl.SDL_GameControllerGetButton.argtypes = [ctypes.c_void_p, ctypes.c_int]
        sdl.SDL_GameControllerGetButton.restype = ctypes.c_uint8
        sdl.SDL_GameControllerGetAxis.argtypes = [ctypes.c_void_p, ctypes.c_int]
        sdl.SDL_GameControllerGetAxis.restype = ctypes.c_int16
        sdl.SDL_GameControllerRumble.argtypes = [ctypes.c_void_p, ctypes.c_uint16, ctypes.c_uint16,
                                                 ctypes.c_uint32]
        sdl.SDL_GetError.restype = ctypes.c_char_p
        # The stream window has the focus, not SDL (it has no window): read anyway
        sdl.SDL_SetHint(b"SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS", b"1")
        sdl.SDL_SetHint(b"SDL_NO_SIGNAL_HANDLERS", b"1")
        if sdl.SDL_Init(0x2000 | 0x4000) != 0:   # GAMECONTROLLER | EVENTS
            log(f"game controllers: {sdl.SDL_GetError().decode(errors='replace')}")
            return
        pads = {}                               # instance id -> [handle, slot, last state, name]
        event = (ctypes.c_uint8 * 64)()
        try:
            while self.running:
                while sdl.SDL_PollEvent(ctypes.byref(event)):
                    kind = int.from_bytes(bytes(event[0:4]), "little")
                    which = int.from_bytes(bytes(event[8:12]), "little", signed=True)
                    if kind == self.ADDED:
                        handle = sdl.SDL_GameControllerOpen(which)
                        if not handle:
                            continue
                        iid = sdl.SDL_JoystickInstanceID(sdl.SDL_GameControllerGetJoystick(handle))
                        used = {p[1] for p in pads.values()}
                        slot = next((i for i in range(4) if i not in used), None)
                        if iid in pads or slot is None:
                            sdl.SDL_GameControllerClose(handle)
                            continue
                        name = (sdl.SDL_GameControllerName(handle) or b"Controller").decode(errors="replace")
                        pads[iid] = [handle, slot, None, name]
                        if self.on_change:
                            self.on_change(f"Controller {slot + 1} connected: {name}")
                    elif kind == self.REMOVED and which in pads:
                        handle, slot, _last, name = pads.pop(which)
                        sdl.SDL_GameControllerClose(handle)
                        self.send({"p": slot, "gone": 1})
                        if self.on_change:
                            self.on_change(f"Controller {slot + 1} unplugged")
                while True:
                    try:
                        slot, low, high, ms = self.rumbles.get_nowait()
                    except queue.Empty:
                        break
                    for handle, s, _last, _name in pads.values():
                        if s == slot:
                            sdl.SDL_GameControllerRumble(handle, low, high, ms)
                if self.active:
                    for pad in pads.values():
                        handle, slot, last, name = pad
                        buttons = 0
                        for b in range(self.BUTTONS):
                            if sdl.SDL_GameControllerGetButton(handle, b):
                                buttons |= 1 << b
                        state = [buttons] + [sdl.SDL_GameControllerGetAxis(handle, a) for a in range(self.AXES)]
                        if state != last:
                            pad[2] = state
                            msg = {"p": slot, "s": state}
                            if last is None:
                                msg["name"] = name
                            self.send(msg)
                else:
                    for pad in pads.values():
                        pad[2] = None           # send everything again when active
                time.sleep(0.004)
        finally:
            for handle, _slot, _last, _name in pads.values():
                sdl.SDL_GameControllerClose(handle)
            sdl.SDL_Quit()


class IdentityChanged(ConnectionError):
    """A paired computer answered with a different certificate."""

    def __init__(self, name, expected, actual):
        self.name, self.expected, self.actual = name, expected, actual
        super().__init__(
            f"{name}'s identity has changed since this computer paired with it, so nothing was sent to it. "
            "If it was reinstalled or its Firox Stream settings were reset, forget it (in Run: "
            f"firox-stream forget {name}) and pair again with the PIN it shows. Otherwise something on "
            f"the network may be pretending to be it: don't pair.\n\nPaired: {expected[:16]}…\nNow: {actual[:16]}…")


def connect(address, ask_pin, ask_busy=None):
    """Connect and pair if needed (blocking; call from a thread). Returns
    (TLS socket, host info). ask_pin(host name, note) -> PIN or None.
    ask_busy(names already streaming it) -> "join", "takeover" or None."""
    host, port = split_address(address)
    raw = socket.create_connection((host, port), timeout=10)
    keepalive(raw)
    ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
    ctx.minimum_version = ssl.TLSVersion.TLSv1_2
    ctx.check_hostname = False
    ctx.verify_mode = ssl.CERT_NONE         # self-signed: pinned by fingerprint below
    sock = ctx.wrap_socket(raw)
    try:
        fingerprint = hashlib.sha256(sock.getpeercert(binary_form=True)).hexdigest()
        hosts = load_hosts()
        # A computer paired at this address must still have the same certificate;
        # otherwise nothing is sent to it (it could be something pretending to be it)
        for fp, h in hosts.items():
            if fp != fingerprint and h.get("address") and split_address(h["address"]) == (host, port):
                raise IdentityChanged(h.get("name") or address, fp, fingerprint)
        known = hosts.get(fingerprint, {})
        name = computer_name()
        sock.sendall(frame("H", {"v": 1, "name": name, "token": known.get("token", ""),
                                 "ssh": bool(shutil.which("ssh-keygen"))}))
        # Starting the capture can take a while (GStreamer's first plugin
        # scan after an update, the portal's retries)
        sock.settimeout(90)
        note = ""
        while True:
            kind, msg = recv_json(sock)
            if kind == "E":
                raise ConnectionError(msg.get("error") or "The other computer refused.")
            if kind in ("N", "W"):
                if kind == "W":
                    note = f"Wrong PIN. {msg.get('left')} {'try' if msg.get('left') == 1 else 'tries'} left."
                host_name = msg.get("name") or known.get("name") or host
                sock.settimeout(None)
                pin = ask_pin(host_name if kind == "N" else known.get("name", host_name), note)
                sock.settimeout(90)
                if not pin:
                    raise ConnectionError("")
                known["name"] = host_name
                sock.sendall(frame("P", {"proof": proof(pin.strip(), fingerprint, name)}))
            elif kind == "C":
                # It takes our SSH keys instead of a PIN: sign its challenge
                nonce = str(msg.get("nonce", ""))[:64]
                sigs = ssh_signatures(ssh_message(fingerprint, name, nonce)) if nonce else []
                sock.sendall(frame("S", {"sigs": sigs}))
            elif kind == "B":
                sock.settimeout(None)
                mode = ask_busy(msg.get("viewers") or []) if ask_busy else "join"
                sock.settimeout(90)
                if not mode:
                    raise ConnectionError("")
                sock.sendall(frame("J", {"mode": mode}))
            elif kind == "T":
                known["token"] = msg.get("token", "")
                hosts = load_hosts()
                hosts[fingerprint] = dict(known, address=address, paired=time.time())
                save_hosts(hosts)
            elif kind == "O":
                hosts = load_hosts()
                if fingerprint in hosts:
                    hosts[fingerprint].update(address=address, name=msg.get("name") or hosts[fingerprint].get("name"),
                                              last=time.time())
                    save_hosts(hosts)
                return sock, msg
            else:
                raise ConnectionError("The other computer answered something unexpected.")
    except BaseException:
        sock.close()
        raise


def explain(e):
    """A connection error in words."""
    if e.errno == errno.EHOSTUNREACH:
        return ("Its firewall turned the connection away, or it's switched off or asleep. On that computer, "
                "open Firox Stream and untick and tick \u201cLet other computers stream this one\u201d: that "
                f"opens Firox Stream's port (TCP {PORT}) in its firewall.")
    if e.errno == errno.ECONNREFUSED:
        return ("Nothing answered there. Streaming may be off on that computer: open Firox Stream on it and tick "
                "\u201cLet other computers stream this one\u201d.")
    if isinstance(e, socket.timeout) or e.errno == errno.ETIMEDOUT:
        return "That computer didn't answer. Check that it's on, awake and on the same network."
    if isinstance(e, socket.gaierror):
        return "There's no computer by that name on the network. Try its IP address."
    return str(e)


def client_ui(address=None):
    import gi
    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    gi.require_version("Gst", "1.0")
    from gi.repository import Gdk, Gio, GLib, Gst, Gtk
    Gst.init(None)

    def ask_busy_dialog(parent, address, names):
        who = ", ".join(names) or "Another computer"
        dlg = Gtk.MessageDialog(transient_for=parent, modal=True, message_type=Gtk.MessageType.QUESTION,
                                buttons=Gtk.ButtonsType.NONE, text=f"{who} {'is' if len(names) < 2 else 'are'} "
                                                                  "streaming that computer")
        dlg.set_title("Firox Stream")
        dlg.format_secondary_text("Watch it together (everyone can use the keyboard and mouse), or take over: "
                                  "that disconnects them. Taking over also clears a stream left open on "
                                  "another device.")
        dlg.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Take Over", 2, "Join", 1)
        dlg.set_default_response(1)
        answer = dlg.run()
        dlg.destroy()
        return {1: "join", 2: "takeover"}.get(answer)

    def ask_pin_dialog(parent, host_name, note):
        dlg = Gtk.Dialog(title="Firox Stream", transient_for=parent, modal=True)
        dlg.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Pair", Gtk.ResponseType.OK)
        dlg.set_default_response(Gtk.ResponseType.OK)
        box = dlg.get_content_area()
        box.set_spacing(8)
        for side in ("start", "end", "top", "bottom"):
            getattr(box, f"set_margin_{side}")(14)
        lbl = Gtk.Label(xalign=0, wrap=True, max_width_chars=44)
        lbl.set_markup(f"<b>Pair with {GLib.markup_escape_text(host_name)}</b>\n\n"
                       "A PIN is showing on that computer's screen. Type it here:"
                       + (f"\n\n<span foreground='#c01c28'>{GLib.markup_escape_text(note)}</span>" if note else ""))
        entry = Gtk.Entry(activates_default=True, max_length=8, width_chars=8, input_purpose=Gtk.InputPurpose.DIGITS)
        entry.set_halign(Gtk.Align.START)
        box.add(lbl)
        box.add(entry)
        dlg.show_all()
        pin = entry.get_text() if dlg.run() == Gtk.ResponseType.OK else None
        dlg.destroy()
        return pin

    def error(parent, text, secondary=""):
        dlg = Gtk.MessageDialog(transient_for=parent, modal=True, message_type=Gtk.MessageType.ERROR,
                                buttons=Gtk.ButtonsType.OK, text=text)
        if secondary:
            dlg.format_secondary_text(secondary)
        dlg.set_title("Firox Stream")
        dlg.run()
        dlg.destroy()

    class StreamWindow(Gtk.Window):
        """Plays the host's screen and sound; sends keyboard and mouse back."""

        def __init__(self, app, sock, info, address):
            super().__init__(application=app, title=f"{info.get('name') or address} – Firox Stream")
            self.set_default_size(1280, 760)
            self.set_icon_name("preferences-desktop-remote-desktop")
            self.info = info
            self.vsize = None
            self.fullscreened = False
            self.down_keys, self.down_buttons = set(), set()
            self.captured = False               # the mouse is locked in the window (games)
            self.capture_on_click = True
            self.swallow_release = False
            self.lock = None
            self.rel = [0.0, 0.0]
            self.rel_pending = False
            self.stopping = False
            self.ended = False
            self.pads = None                    # game controllers (Pads), once connected
            self.overlay = Gtk.Overlay()
            self.add(self.overlay)
            self.area = Gtk.EventBox(can_focus=True)
            css = Gtk.CssProvider()
            css.load_from_data(b"eventbox { background-color: black; }")
            self.area.get_style_context().add_provider(css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
            self.overlay.add(self.area)
            hint = "Ctrl+Alt+Shift+F full screen · Ctrl+Alt+Shift+Q stop"
            if info.get("input"):
                hint = "Click to capture the mouse, Ctrl+Alt+Shift+Z to release it · " + hint
            if not info.get("input"):
                hint = "View only: that computer can't use this keyboard and mouse · " + hint
            self.hint = Gtk.Label(label=hint, halign=Gtk.Align.CENTER, valign=Gtk.Align.START)
            self.hint.get_style_context().add_class("osd")
            self.hint.set_margin_top(10)
            for side in ("start", "end"):
                getattr(self.hint, f"set_margin_{side}")(12)
            self.overlay.add_overlay(self.hint)
            self.hint_timer = GLib.timeout_add_seconds(6, self.hide_hint)
            self.build_video(os.environ.get("FIROX_STREAM_SINK") or
                             ("gtkglsink" if Gst.ElementFactory.find("gtkglsink") else "gtksink"))
            self.build_audio()
            self.area.add_events(Gdk.EventMask.POINTER_MOTION_MASK | Gdk.EventMask.BUTTON_PRESS_MASK |
                                 Gdk.EventMask.BUTTON_RELEASE_MASK | Gdk.EventMask.SCROLL_MASK |
                                 Gdk.EventMask.SMOOTH_SCROLL_MASK)
            self.area.connect("motion-notify-event", self.on_motion)
            self.area.connect("button-press-event", self.on_button, True)
            self.area.connect("button-release-event", self.on_button, False)
            self.area.connect("scroll-event", self.on_scroll)
            self.area.connect("realize", self.on_realize)
            self.connect("key-press-event", self.on_key, True)
            self.connect("key-release-event", self.on_key, False)
            self.connect("focus-out-event", lambda *_a: (self.release_mouse(), self.release_all(),
                                                         self.pads and self.pads.set_active(False)))
            self.connect("focus-in-event", lambda *_a: self.pads and self.pads.set_active(True))
            self.connect("delete-event", lambda *_a: self.stop() or False)
            self.channel = Channel(sock, self.on_message, self.on_closed)
            threading.Thread(target=self.channel.run, daemon=True).start()
            # Game controllers, if that computer takes them
            if info.get("gamepads"):
                self.pads = Pads(lambda msg: self.channel.send("G", msg),
                                 lambda text: GLib.idle_add(lambda: self.show_hint(text, 3) or False))
            self.locked = False
            self.show_all()
            self.area.grab_focus()
            others = [n for n in info.get("viewers") or []]
            if others and not info.get("locked"):
                GLib.timeout_add(1500, lambda: self.show_hint("Also watching: " + ", ".join(others), 5) or False)
            if info.get("locked"):
                GLib.timeout_add(1500, lambda: self.set_locked(True) or False)

        # -- playing
        def build_video(self, sink_name):
            pipeline = Gst.Pipeline.new("video")
            self.vsrc = make_element("appsrc", {"is-live": True, "format": "time", "do-timestamp": True,
                                                "max-bytes": 64 << 20})
            parse = make_element("h264parse", {})
            if Gst.ElementFactory.find("vah264dec"):
                dec = [make_element("vah264dec", {})]
            elif Gst.ElementFactory.find("avdec_h264"):
                # threads on slices, not frames: frame threads hold frames back
                dec = [make_element("avdec_h264", {"thread-type": "slice"})]
            else:
                dec = [make_element("openh264dec", {})]
            if sink_name == "gtkglsink":
                gl = make_element("gtkglsink", {"sync": False})
                sink = make_element("glsinkbin", {"sync": False})
                sink.set_property("sink", gl)
                widget = gl.get_property("widget")
                tail = [sink]
            else:
                sink = make_element("gtksink", {"sync": False})
                widget = sink.get_property("widget")
                tail = [make_element("videoconvert", {}), sink]
            chain(pipeline, [self.vsrc, parse] + dec + tail)
            bus = pipeline.get_bus()
            bus.add_signal_watch()
            bus.connect("message::error", self.on_video_error, sink_name)
            child = self.area.get_child()
            if child:
                self.area.remove(child)
            self.area.add(widget)
            widget.show()
            self.sink_name = sink_name
            self.video = pipeline
            pipeline.set_state(Gst.State.PLAYING)

        def on_video_error(self, _bus, msg, sink_name):
            err, debug = msg.parse_error()
            print(f"firox-stream: video: {err.message} ({debug})", file=sys.stderr)
            if sink_name == "gtkglsink" and self.sink_name == "gtkglsink":
                # No OpenGL here: draw it the plain way. The host sends a key
                # frame when asked, so the picture comes straight back
                old, caps = self.video, self.vsrc.get_property("caps")
                old.set_state(Gst.State.NULL)
                self.build_video("gtksink")
                if caps:
                    self.vsrc.set_property("caps", caps)
                self.channel.send("F")              # the new decoder needs a key frame

        def build_audio(self):
            self.asrc = self.audio = None
            if not self.info.get("audio"):
                return
            try:
                pipeline = Gst.Pipeline.new("audio")
                self.asrc = make_element("appsrc", {"is-live": True, "format": "time", "do-timestamp": True})
                out = make_element("pulsesink", {"sync": False, "buffer-time": 60000, "latency-time": 10000}) \
                    if Gst.ElementFactory.find("pulsesink") else make_element("autoaudiosink", {"sync": False})
                chain(pipeline, [self.asrc, make_element("opusdec", {}), make_element("audioconvert", {}),
                                 make_element("audioresample", {}), out])
                pipeline.set_state(Gst.State.PLAYING)
                self.audio = pipeline
            except RuntimeError as e:
                print(f"firox-stream: no sound: {e}", file=sys.stderr)
                self.asrc = None

        def on_message(self, kind, payload):
            # (the channel's thread)
            if kind == "V":
                self.vsrc.emit("push-buffer", Gst.Buffer.new_wrapped(payload))
            elif kind == "A":
                if self.asrc is not None:
                    self.asrc.emit("push-buffer", Gst.Buffer.new_wrapped(payload))
            elif kind == "K":
                msg = json.loads(payload)
                caps = Gst.Caps.from_string(msg.get("caps", ""))
                if msg.get("kind") == "video":
                    self.vsrc.set_property("caps", caps)
                    s = caps.get_structure(0)
                    ok_w, w = s.get_int("width")
                    ok_h, h = s.get_int("height")
                    if ok_w and ok_h:
                        GLib.idle_add(self.set_video_size, w, h)
                elif msg.get("kind") == "audio" and self.asrc is not None:
                    self.asrc.set_property("caps", caps)
            elif kind == "S":
                msg = json.loads(payload)
                if msg.get("joined"):
                    text = f"{msg['joined']} joined"
                elif msg.get("left"):
                    text = f"{msg['left']} left"
                else:
                    text = ""
                if text and not self.locked:
                    GLib.idle_add(lambda t=text: self.show_hint(t, 4) or False)
            elif kind == "L":
                GLib.idle_add(self.set_locked, bool(json.loads(payload).get("locked")))
            elif kind == "u":
                msg = json.loads(payload)
                GLib.idle_add(self.unlock_answer, bool(msg.get("ok")), str(msg.get("message", "")))
            elif kind == "R" and self.pads is not None:
                msg = json.loads(payload)
                self.pads.rumble(int(msg.get("p", 0)), int(msg.get("lo", 0)) & 0xFFFF,
                                 int(msg.get("hi", 0)) & 0xFFFF, max(0, int(msg.get("ms", 0))))
            elif kind == "E":
                self.channel.close(json.loads(payload).get("error", ""))

        def set_video_size(self, w, h):
            self.vsize = (w, h)
            return False

        def on_closed(self, reason):
            GLib.idle_add(self.closed, reason)

        def closed(self, reason):
            if self.pads is not None:
                self.pads.stop()
            for p in (self.video, self.audio):
                if p is not None:
                    p.set_state(Gst.State.NULL)
            if not self.ended:
                self.ended = True
                if not self.stopping and reason not in ("", "stopped"):
                    error(self, "The stream ended", reason[:1].upper() + reason[1:])
                self.destroy()
            return False

        def stop(self):
            if self.stopping:
                return
            self.stopping = True
            self.release_all()
            self.channel.send("Q")
            GLib.timeout_add(300, lambda: self.channel.close("stopped") or False)

        # -- keyboard and mouse
        def on_realize(self, area):
            self.set_local_cursor()

        def set_local_cursor(self):
            """No pointer of our own while captured, or while that computer
            draws its pointer into the picture."""
            win = self.area.get_window()
            if win is None:
                return
            hide = self.captured or (self.info.get("cursor") and self.info.get("input"))
            win.set_cursor(Gdk.Cursor.new_for_display(self.area.get_display(), Gdk.CursorType.BLANK_CURSOR)
                           if hide else None)

        def show_hint(self, text, seconds=4):
            """A note over the picture; seconds=0 keeps it up."""
            self.hint.set_text(text)
            self.hint.show()
            if self.hint_timer:
                GLib.source_remove(self.hint_timer)
            self.hint_timer = GLib.timeout_add_seconds(seconds, self.hide_hint) if seconds else 0

        # -- that computer's lock screen
        LOCKED_NOTE = ("That computer is locked \u00b7 Ctrl+Alt+Shift+U to unlock it with its password "
                       "(or type the password into its lock screen)")

        def set_locked(self, locked):
            was, self.locked = self.locked, locked
            if locked and not was:
                self.release_mouse()
                self.show_hint(self.LOCKED_NOTE, 0)
            elif was and not locked:
                self.show_hint("Unlocked", 3)
            return False

        def ask_unlock(self):
            if not self.info.get("input"):
                return
            self.release_mouse()
            self.release_all()
            dlg = Gtk.Dialog(title="Unlock", transient_for=self, modal=True)
            dlg.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Unlock", Gtk.ResponseType.OK)
            dlg.set_default_response(Gtk.ResponseType.OK)
            box = dlg.get_content_area()
            box.set_spacing(8)
            for side in ("start", "end", "top", "bottom"):
                getattr(box, f"set_margin_{side}")(14)
            name = GLib.markup_escape_text(self.info.get("name") or "that computer")
            lbl = Gtk.Label(xalign=0, wrap=True, max_width_chars=44)
            lbl.set_markup(f"<b>Unlock {name}</b>\n\nType the password of the account that's locked there. "
                           "It's checked by that computer's lock screen, exactly as if typed there.")
            entry = Gtk.Entry(visibility=False, activates_default=True, input_purpose=Gtk.InputPurpose.PASSWORD)
            box.add(lbl)
            box.add(entry)
            dlg.show_all()
            password = entry.get_text() if dlg.run() == Gtk.ResponseType.OK else ""
            entry.set_text("")
            dlg.destroy()
            self.area.grab_focus()
            if password:
                self.show_hint("Checking the password\u2026", 0)
                self.channel.send("U", {"password": password})

        def unlock_answer(self, ok, message):
            if ok:
                self.locked = False
                self.show_hint("Unlocked", 3)
            else:
                self.show_hint(message + (" \u00b7 Ctrl+Alt+Shift+U to try again" if self.locked else ""), 6)
            return False

        def hide_hint(self):
            self.hint.hide()
            self.hint_timer = 0
            return False

        def capture_mouse(self):
            if self.captured or not self.info.get("input"):
                return
            if self.lock is None:
                try:
                    self.lock = PointerLock(self, self.on_relative, self.on_unlocked)
                except (OSError, RuntimeError, AttributeError) as e:
                    print(f"firox-stream: can't capture the mouse: {e}", file=sys.stderr)
                    self.capture_on_click = False
                    self.show_hint(f"This desktop can't capture the mouse ({e})", 6)
                    return
            self.lock.lock()
            self.captured = True
            self.set_local_cursor()
            self.show_hint("Mouse captured \u00b7 Ctrl+Alt+Shift+Z releases it", 3)

        def release_mouse(self, hint=False):
            if not self.captured:
                return
            self.captured = False
            if self.lock is not None:
                self.lock.unlock()
            self.set_local_cursor()
            if hint:
                self.show_hint("Mouse released \u00b7 click in the picture to capture it again", 3)

        def on_unlocked(self):
            # The desktop ended the capture (the window lost focus)
            self.captured = False
            self.set_local_cursor()

        def on_relative(self, dx, dy):
            # Movement arrives at the mouse's rate (up to 1000 a second);
            # send it in batches, once per main-loop turn
            self.rel[0] += dx
            self.rel[1] += dy
            if not self.rel_pending:
                self.rel_pending = True
                GLib.idle_add(self.flush_relative)

        def flush_relative(self):
            self.rel_pending = False
            dx, dy = self.rel
            self.rel = [0.0, 0.0]
            if self.captured and (dx or dy):
                self.send("d", round(dx, 2), round(dy, 2))
            return False

        def send(self, *ev):
            if self.info.get("input"):
                self.channel.send("I", [list(ev)])

        def to_video(self, x, y):
            a = self.area.get_allocation()
            vw, vh = self.vsize or (a.width, a.height)
            if not (a.width and a.height and vw and vh):
                return 0.0, 0.0
            s = min(a.width / vw, a.height / vh)
            w, h = vw * s, vh * s
            return (min(max((x - (a.width - w) / 2) / w, 0.0), 1.0),
                    min(max((y - (a.height - h) / 2) / h, 0.0), 1.0))

        def on_motion(self, _w, ev):
            if self.captured:
                return True                     # movement goes as relative motion
            u, v = self.to_video(ev.x, ev.y)
            self.send("m", round(u, 5), round(v, 5))
            return True

        def on_button(self, _w, ev, down):
            if ev.type in (Gdk.EventType._2BUTTON_PRESS, Gdk.EventType._3BUTTON_PRESS):
                return True                     # GTK's extra events for double clicks
            self.area.grab_focus()
            if down and ev.button == 1 and not self.captured and self.capture_on_click \
                    and self.info.get("input"):
                self.capture_mouse()            # this click only captures, as in VMware
                if self.captured:
                    self.swallow_release = True
                    return True
            if not down and ev.button == 1 and self.swallow_release:
                self.swallow_release = False
                return True
            code = GDK_BUTTONS.get(ev.button)
            if code:
                if not self.captured:
                    u, v = self.to_video(ev.x, ev.y)
                    self.send("m", round(u, 5), round(v, 5))
                (self.down_buttons.add if down else self.down_buttons.discard)(code)
                self.send("b", code, down)
            return True

        def on_scroll(self, _w, ev):
            if ev.direction == Gdk.ScrollDirection.SMOOTH:
                ok, dx, dy = ev.get_scroll_deltas()
            else:
                dx, dy = {Gdk.ScrollDirection.UP: (0, -1), Gdk.ScrollDirection.DOWN: (0, 1),
                          Gdk.ScrollDirection.LEFT: (-1, 0), Gdk.ScrollDirection.RIGHT: (1, 0)}.get(
                    ev.direction, (0, 0))
            if dx or dy:
                self.send("s", round(dx, 3), round(dy, 3))
            return True

        def on_key(self, _w, ev, down):
            mods = ev.state & (Gdk.ModifierType.CONTROL_MASK | Gdk.ModifierType.MOD1_MASK |
                               Gdk.ModifierType.SHIFT_MASK)
            if down and mods == (Gdk.ModifierType.CONTROL_MASK | Gdk.ModifierType.MOD1_MASK |
                                 Gdk.ModifierType.SHIFT_MASK):
                key = Gdk.keyval_to_lower(ev.keyval)
                if key == Gdk.KEY_q:
                    self.stop()
                    return True
                if key == Gdk.KEY_u:
                    self.ask_unlock()
                    return True
                if key == Gdk.KEY_w:
                    self.channel.send("W")          # wake its screen (monitors off, screen saver)
                    self.show_hint("Waking that computer's screen", 2)
                    return True
                if key == Gdk.KEY_z:
                    self.release_all()
                    self.release_mouse(hint=True)
                    return True
                if key == Gdk.KEY_m:
                    self.capture_on_click = not self.capture_on_click
                    if not self.capture_on_click:
                        self.release_mouse()
                    self.show_hint("Clicking captures the mouse" if self.capture_on_click else
                                   "Clicking no longer captures the mouse (Ctrl+Alt+Shift+M turns it back on)", 4)
                    return True
                if key == Gdk.KEY_f:
                    self.release_all()
                    (self.unfullscreen if self.fullscreened else self.fullscreen)()
                    self.fullscreened = not self.fullscreened
                    return True
            code = ev.hardware_keycode - 8          # evdev's numbering, as the host's virtual keyboard
            if 1 <= code <= 248:
                if down and code in self.down_keys:
                    return True                     # a repeat: the host repeats it itself
                (self.down_keys.add if down else self.down_keys.discard)(code)
                self.send("k", code, down)
            return True

        def release_all(self):
            for code in list(self.down_keys):
                self.send("k", code, False)
            for code in list(self.down_buttons):
                self.send("b", code, False)
            self.down_keys.clear()
            self.down_buttons.clear()

    class Chooser(Gtk.ApplicationWindow):
        """Pick a computer to stream, and whether others may stream this one."""

        def __init__(self, app):
            super().__init__(application=app, title="Firox Stream")
            self.set_default_size(460, 480)
            self.set_icon_name("preferences-desktop-remote-desktop")
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            for side in ("start", "end", "top", "bottom"):
                getattr(box, f"set_margin_{side}")(14)
            self.add(box)
            intro = Gtk.Label(xalign=0, wrap=True, max_width_chars=50)
            intro.set_markup("<b>Play another computer here</b>\nPick a Firox computer on your network to see "
                             "its screen, hear its sound and use it with this keyboard and mouse.")
            box.add(intro)
            self.store = Gtk.ListStore(str, str, str)      # label, address, markup
            self.view = Gtk.TreeView(model=self.store, headers_visible=False)
            icon = Gtk.CellRendererPixbuf(icon_name="computer", stock_size=Gtk.IconSize.DND)
            col = Gtk.TreeViewColumn()
            col.pack_start(icon, False)
            text = Gtk.CellRendererText(ypad=4)
            col.pack_start(text, True)
            col.add_attribute(text, "markup", 2)
            self.view.append_column(col)
            self.view.connect("row-activated", lambda *_a: self.connect_selected())
            scroll = Gtk.ScrolledWindow(vexpand=True, shadow_type=Gtk.ShadowType.IN)
            scroll.add(self.view)
            box.add(scroll)
            row = Gtk.Box(spacing=6)
            row.add(Gtk.Label(label="Address:"))
            self.entry = Gtk.Entry(hexpand=True, placeholder_text="name or IP address", activates_default=True)
            self.entry.connect("activate", lambda *_a: self.connect_to(self.entry.get_text()))
            row.add(self.entry)
            refresh = Gtk.Button.new_from_icon_name("view-refresh-symbolic", Gtk.IconSize.BUTTON)
            refresh.set_tooltip_text("Look for computers again")
            refresh.connect("clicked", lambda *_a: self.refresh())
            row.add(refresh)
            self.go = Gtk.Button(label="Connect")
            self.go.get_style_context().add_class("suggested-action")
            self.go.connect("clicked", lambda *_a: self.connect_selected())
            row.add(self.go)
            box.add(row)
            self.status = Gtk.Label(xalign=0, wrap=True)
            box.add(self.status)
            box.add(Gtk.Separator(margin_top=6, margin_bottom=6))
            self.allow = Gtk.CheckButton(label="Let other computers stream this one")
            self.allow.set_active(bool(load_conf().get("enabled")) and not policy_forbids())
            self.allow.set_sensitive(not policy_forbids())
            self.allow.connect("toggled", self.on_allow)
            box.add(self.allow)
            self.web = Gtk.CheckButton(label="Let web browsers stream it too (phones, tablets, any computer)")
            self.web.set_active(bool(load_conf().get("web")))
            self.web.set_margin_start(24)
            self.web.connect("toggled", self.on_web)
            box.add(self.web)
            self.sshkeys = Gtk.CheckButton(label="Let computers with my SSH keys connect without a PIN")
            self.sshkeys.set_active(bool(load_conf().get("ssh_keys")))
            self.sshkeys.set_margin_start(24)
            self.sshkeys.set_tooltip_text("Keys in ~/.config/firox/stream-keys, and in ~/.ssh/authorized_keys "
                                          "(those without options). The other computer proves it holds one; "
                                          "removing the key stops it.")
            self.sshkeys.connect("toggled", self.on_sshkeys)
            box.add(self.sshkeys)
            self.allow_note = Gtk.Label(xalign=0, wrap=True, max_width_chars=50)
            self.allow_note.get_style_context().add_class("dim-label")
            box.add(self.allow_note)
            self.watching = Gtk.Label(xalign=0, wrap=True, max_width_chars=50)
            box.add(self.watching)
            buttons = Gtk.Box(spacing=6)
            self.kick = Gtk.Button(label="Disconnect Everyone")
            self.kick.set_tooltip_text("End every stream of this computer that's open now")
            self.kick.connect("clicked", self.on_kick)
            buttons.add(self.kick)
            unpair = Gtk.Button(label="Forget Paired Computers")
            unpair.connect("clicked", self.on_unpair)
            buttons.add(unpair)
            box.add(buttons)
            self.update_note()
            self.refresh()
            self.update_watching()
            GLib.timeout_add_seconds(3, self.update_watching)

        def update_watching(self):
            if not self.get_visible() and self.get_realized():
                return True
            viewers = (control() or {}).get("viewers") or []
            self.watching.set_markup(
                "<b>Streaming this computer now:</b> " + GLib.markup_escape_text(", ".join(viewers))
                if viewers else "")
            self.watching.set_visible(bool(viewers))
            self.kick.set_sensitive(bool(viewers))
            return True

        def on_kick(self, _b):
            control("kick")
            self.status.set_text("Disconnected everyone streaming this computer.")
            GLib.timeout_add(1500, lambda: self.update_watching() and False)

        def update_note(self):
            conf = load_conf()
            n = len(conf.get("clients", {}))
            self.web.set_sensitive(bool(conf.get("enabled")) and not policy_forbids())
            self.sshkeys.set_sensitive(bool(conf.get("enabled")) and not policy_forbids())
            if policy_forbids():
                self.allow_note.set_text("Your organization's policy doesn't allow other computers to stream "
                                         "this one.")
            elif conf.get("enabled"):
                web = ""
                if conf.get("web"):
                    web = ("\n\nIn a web browser, open " + " or ".join(web_addresses(conf)) +
                           ". The browser warns about this computer's certificate the first time: "
                           "it's this computer's own, so allow it.")
                keys = ""
                if conf.get("ssh_keys"):
                    count = len(accepted_ssh_keys())
                    keys = (f"\n\nSSH keys accepted instead of a PIN: {count}." if count else
                            "\n\nNo SSH keys to accept yet: add public keys to ~/.config/firox/stream-keys "
                            "(or ~/.ssh/authorized_keys).")
                self.allow_note.set_text(
                    "Computers you've paired can stream this one whenever you're logged in. "
                    f"Paired: {n}. A new one needs the PIN this computer shows." + keys + web)
            else:
                self.allow_note.set_text("Nobody can stream this computer.")

        def on_allow(self, button):
            reachable = set_enabled(button.get_active())
            self.update_note()
            if not reachable:
                self.status.set_text(f"The firewall still blocks Firox Stream's ports "
                                     f"({', '.join(firewall_ports(load_conf()))}), so other "
                                     "computers can't connect. Untick and tick the box to try again.")

        def on_web(self, button):
            reachable = set_web(button.get_active())
            self.update_note()
            if not reachable:
                self.status.set_text("The firewall still blocks the ports web browsers need (TCP "
                                     f"{WEB_PORT}, UDP {ICE_PORTS[0]}–{ICE_PORTS[1]}). Untick and tick the "
                                     "box to try again.")

        def on_sshkeys(self, button):
            conf = load_conf()
            conf["ssh_keys"] = button.get_active()
            save_conf(conf)
            self.update_note()

        def on_unpair(self, _b):
            conf = load_conf()
            conf["clients"] = {}
            save_conf(conf)
            self.update_note()
            self.status.set_text("Computers will need a PIN again to stream this one.")

        def refresh(self):
            self.status.set_text("Looking for computers…")
            threading.Thread(target=lambda: GLib.idle_add(self.fill, discover()), daemon=True).start()

        def fill(self, found):
            self.store.clear()
            seen = set()
            paired = {h.get("address"): h for h in load_hosts().values()}
            for f in found:
                addr = f["address"] if f["port"] == PORT else f"{f['address']}:{f['port']}"
                seen.add(addr)
                tag = "paired" if addr in paired else "on the network"
                self.store.append([f["name"], addr, f"<b>{GLib.markup_escape_text(f['name'])}</b>\n"
                                                    f"<small>{addr} · {tag}</small>"])
            for addr, h in paired.items():
                if addr and addr not in seen:
                    name = h.get("name") or addr
                    self.store.append([name, addr, f"<b>{GLib.markup_escape_text(name)}</b>\n"
                                                   f"<small>{GLib.markup_escape_text(addr)} · paired, "
                                                   "not seen on the network</small>"])
            self.status.set_text("" if len(self.store) else
                                 "No computers found. On the computer you want to stream, open Firox Stream and "
                                 "tick “Let other computers stream this one”, or type its address.")
            if len(self.store):
                self.view.get_selection().select_path(Gtk.TreePath(0))
            return False

        def connect_selected(self):
            text = self.entry.get_text().strip()
            if text:
                return self.connect_to(text)
            model, it = self.view.get_selection().get_selected()
            if it is not None:
                self.connect_to(model[it][1])

        def connect_to(self, address):
            address = address.strip()
            if not address:
                return
            self.go.set_sensitive(False)
            self.status.set_text(f"Connecting to {address}…")
            open_stream(self, address, done=self.connected)

        def connected(self, ok):
            self.go.set_sensitive(True)
            self.status.set_text("")
            if ok:
                self.hide()

    def open_stream(parent, address, done=None):
        app = parent.get_application() if parent else App.instance

        def ask_busy(names):
            answer = queue.Queue()
            GLib.idle_add(lambda: answer.put(ask_busy_dialog(parent, address, names)) or False)
            return answer.get()

        def ask_pin(host_name, note):
            answer = queue.Queue()
            GLib.idle_add(lambda: answer.put(ask_pin_dialog(parent, host_name, note)) or False)
            return answer.get()

        def work():
            try:
                sock, info = connect(address, ask_pin, ask_busy)
            except EOFError:
                GLib.idle_add(failed, "That computer closed the connection. If it was showing a PIN, "
                                      "pairing was cancelled there.")
                return
            except OSError as e:
                GLib.idle_add(failed, explain(e))
                return
            except (ValueError, ConnectionError, ssl.SSLError) as e:
                GLib.idle_add(failed, str(e))
                return
            GLib.idle_add(started, sock, info)

        def failed(text):
            if text:
                error(parent, f"Couldn't stream {address}", text)
            if done:
                done(False)
            elif parent is None or not parent.get_visible():
                app.quit()
            return False

        def started(sock, info):
            win = StreamWindow(app, sock, info, address)
            win.connect("destroy", lambda *_a: stream_closed())
            if done:
                done(True)
            return False

        def stream_closed():
            chooser = next((w for w in app.get_windows() if isinstance(w, Chooser)), None)
            if chooser is not None:
                chooser.show_all()
                chooser.present()

        threading.Thread(target=work, daemon=True).start()

    class App(Gtk.Application):
        instance = None

        def __init__(self):
            super().__init__(application_id="org.firox.Stream",
                             flags=Gio.ApplicationFlags.NON_UNIQUE if address else Gio.ApplicationFlags.FLAGS_NONE)
            App.instance = self

        def do_activate(self):
            if address:
                self.hold()
                # A window to own the PIN dialog and errors; streams open on their own
                open_stream(None, address, done=lambda ok: self.release())
                return
            win = self.get_active_window() or Chooser(self)
            win.show_all()
            win.present()

    return App().run([sys.argv[0]])


def main(argv):
    cmd = argv[1] if len(argv) > 1 else ""
    if cmd == "daemon":
        return run_daemon()
    if cmd in ("on", "off"):
        if cmd == "on" and policy_forbids():
            print("Your organization's policy doesn't allow streaming this computer.", file=sys.stderr)
            return 1
        set_enabled(cmd == "on")
        print(f"Streaming this computer is {cmd}.")
        return 0
    if cmd == "ssh-keys" and len(argv) > 2 and argv[2] in ("on", "off", "list"):
        conf = load_conf()
        if argv[2] != "list":
            conf["ssh_keys"] = argv[2] == "on"
            save_conf(conf)                 # (the daemon reads it at every connection)
        keys = accepted_ssh_keys()
        print(f"SSH keys instead of a PIN: {'on' if conf.get('ssh_keys') else 'off'}")
        if not keys:
            print("No keys yet: put public keys (one per line) in ~/.config/firox/stream-keys,")
            print("or in ~/.ssh/authorized_keys.")
        for key in keys:
            print(f"  {key.split()[0]} {ssh_key_label(key)}")
        return 0
    if cmd == "web" and len(argv) > 2 and argv[2] in ("on", "off"):
        if argv[2] == "on" and policy_forbids():
            print("Your organization's policy doesn't allow streaming this computer.", file=sys.stderr)
            return 1
        set_web(argv[2] == "on")
        if argv[2] == "off":
            print("Web browsers can't stream this computer.")
        elif not load_conf().get("enabled"):
            print("Web browsers will be able to stream this computer once streaming is on "
                  "(firox-stream on).")
        else:
            print("Web browsers can stream this computer. Open one of these in a browser on the network:")
            for a in web_addresses():
                print(f"  {a}")
        return 0
    if cmd == "kick":
        answer = control("kick")
        if answer is None:
            print("Streaming this computer isn't running.")
        elif answer.get("viewers"):
            print("Disconnected: " + ", ".join(answer["viewers"]))
        else:
            print("Nobody was streaming this computer.")
        return 0
    if cmd == "unpair":
        conf = load_conf()
        conf["clients"] = {}
        save_conf(conf)
        print("Forgot every paired computer.")
        return 0
    if cmd == "forget" and len(argv) > 2:
        target = " ".join(argv[2:]).strip()
        hosts = load_hosts()
        gone = {fp: h for fp, h in hosts.items()
                if target in (h.get("name"), h.get("address"))
                or (h.get("address") and split_address(h["address"]) == split_address(target))}
        for fp in gone:
            del hosts[fp]
        save_hosts(hosts)
        print("Forgot " + ", ".join(h.get("name") or h.get("address") for h in gone.values()) if gone
              else f"No computer called {target} has been streamed from here.")
        return 0 if gone else 1
    if cmd == "status":
        conf = load_conf()
        print(f"streaming this computer: {'on' if conf.get('enabled') else 'off'}"
              f"{' (running)' if daemon_running() else ''}; port {conf.get('port', PORT)}")
        if conf.get("web"):
            print(f"web browsers: on, {' or '.join(web_addresses(conf))}")
        for name in (control() or {}).get("viewers") or []:
            print(f"streaming it now: {name}")
        for c in conf.get("clients", {}).values():
            print(f"paired: {c.get('name')} (since {time.strftime('%m/%d/%Y', time.localtime(c.get('paired', 0)))})")
        for h in load_hosts().values():
            print(f"streamed: {h.get('name')} at {h.get('address')}")
        return 0
    if cmd == "connect" and len(argv) > 2:
        return client_ui(argv[2])
    if cmd == "":
        return client_ui()
    print(__doc__.strip(), file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
