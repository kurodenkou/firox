#!/usr/bin/bash
# firox-power: monitor power saving, screen lock and sleep timers.
#
#   firox-power                     show the current settings
#   firox-power get KEY             print one setting
#   firox-power set KEY=VALUE...    change settings and apply them now
#   firox-power reset               go back to the system defaults
#   firox-power start               (re)start the idle watcher (used at login)
#   firox-power battery             battery level and state
#   firox-power battery-watch       low-battery warnings (runs from login)
#   firox-power awake [on|off|toggle]
#                                   keep the screen on: pause the timers
#                                   below until turned off or you log off
#
# Keys (minutes, 0 = never):
#   MONITOR_AC  MONITOR_BATTERY     turn the screen off when idle
#   LOCK                            lock the screen when idle
#   SLEEP_AC    SLEEP_BATTERY       put the computer to sleep when idle
#   LOCK_ON_WAKE=1|0                lock before sleeping
#   SCREENSAVER_WAIT                start the screen saver (see
#                                   firox-screensaver; it picks which one)
# Battery (percent, 0 = off):
#   BATTERY_LOW                     warn that the battery is low
#   BATTERY_CRITICAL                warn again, urgently
#   BATTERY_ACTION                  then do BATTERY_ACTION_KIND:
#   BATTERY_ACTION_KIND             0 nothing, 1 sleep, 2 hibernate, 3 shut down
# Settings live in ~/.config/firox/power.conf (defaults: /etc/firox/power.conf).
# Apps that play video or are full screen keep the screen on (idle inhibit),
# and so does another computer streaming this one (Firox Stream).
set -u

SYS_CONF=/etc/firox/power.conf
USER_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/firox/power.conf"
KEYS="MONITOR_AC MONITOR_BATTERY LOCK SLEEP_AC SLEEP_BATTERY LOCK_ON_WAKE SCREENSAVER_WAIT BATTERY_LOW BATTERY_CRITICAL BATTERY_ACTION BATTERY_ACTION_KIND"
PS="${FIROX_POWER_SUPPLY:-/sys/class/power_supply}"
AWAKE="${XDG_RUNTIME_DIR:-/tmp}/firox-stay-awake"
# Firox Stream holds the timers while another computer streams this one
STREAM_AWAKE="${XDG_RUNTIME_DIR:-/tmp}/firox-stream-awake"

get() {
    local v=""
    [ -f "$USER_CONF" ] && v="$(sed -n "s/^$1=//p" "$USER_CONF" | tail -n1)"
    [ -n "$v" ] || v="$(sed -n "s/^$1=//p" "$SYS_CONF" 2>/dev/null | tail -n1)"
    case "$v" in ''|*[!0-9]*) v=0 ;; esac
    echo "$v"
}

# The computer's own batteries (not a wireless mouse's: those have scope=Device)
batteries() {
    local d
    for d in "$PS"/*; do
        [ "$(cat "$d/type" 2>/dev/null)" = Battery ] || continue
        [ "$(cat "$d/scope" 2>/dev/null)" = Device ] && continue
        echo "$d"
    done
}

has_battery() { [ -n "$(batteries)" ]; }

on_mains() {
    local d
    for d in "$PS"/*; do
        case "$(cat "$d/type" 2>/dev/null)" in
            Mains|USB|USB_C|USB_PD) [ "$(cat "$d/online" 2>/dev/null)" = 1 ] && return 0 ;;
        esac
    done
    return 1
}

# "ac" or "battery"
power_source() {
    has_battery || { echo ac; return; }
    on_mains && echo ac || echo battery
}

# "PERCENT STATE": overall charge of all batteries, STATE discharging|charging|full
battery_level() {
    local d now=0 full=0 n f pct=0 count=0 sum=0 state=full st
    for d in $(batteries); do
        for f in energy charge; do
            if [ -r "$d/${f}_now" ] && [ -r "$d/${f}_full" ]; then
                n="$(cat "$d/${f}_now")"; now=$((now + n))
                n="$(cat "$d/${f}_full")"; full=$((full + n))
                break
            fi
        done
        sum=$((sum + $(cat "$d/capacity" 2>/dev/null || echo 0))); count=$((count + 1))
        st="$(cat "$d/status" 2>/dev/null)"
        case "$st" in
            Discharging) state=discharging ;;
            Charging) [ "$state" = discharging ] || state=charging ;;
        esac
    done
    if [ "$full" -gt 0 ]; then pct=$((now * 100 / full))
    elif [ "$count" -gt 0 ]; then pct=$((sum / count))
    fi
    # "Not charging" on battery power counts as discharging
    [ "$state" != discharging ] && ! on_mains && [ "$count" -gt 0 ] && state=discharging
    echo "$pct $state"
}

battery_notify() { # URGENCY SUMMARY BODY ICON
    notify-send -a Battery -u "$1" -i "$4" -h string:x-canonical-private-synchronous:firox-battery \
        "$2" "$3" 2>/dev/null
}

battery_action() {
    case "$(get BATTERY_ACTION_KIND)" in
        1) systemctl suspend ;;
        2) systemctl hibernate || systemctl suspend ;;
        3) systemctl poweroff ;;
    esac
}

battery_watch() {
    has_battery || exit 0
    local warned=none acted=0 pct state low crit act kind
    while :; do
        read -r pct state <<<"$(battery_level)"
        low="$(get BATTERY_LOW)"; crit="$(get BATTERY_CRITICAL)"
        act="$(get BATTERY_ACTION)"; kind="$(get BATTERY_ACTION_KIND)"
        if [ "$state" != discharging ]; then
            warned=none; acted=0
        elif [ "$act" -gt 0 ] && [ "$kind" -gt 0 ] && [ "$pct" -le "$act" ] && [ "$acted" = 0 ]; then
            local what
            case "$kind" in 1) what="go to sleep" ;; 2) what="hibernate" ;; *) what="shut down" ;; esac
            battery_notify critical "Battery nearly empty" \
                "$pct% left. The computer will $what in 15 seconds unless you plug it in." battery-empty
            sleep 15
            read -r pct state <<<"$(battery_level)"
            if [ "$state" = discharging ]; then
                acted=1
                battery_action
            fi
            continue
        elif [ "$crit" -gt 0 ] && [ "$pct" -le "$crit" ] && [ "$warned" != critical ]; then
            local then_=""
            [ "$act" -gt 0 ] && [ "$kind" -gt 0 ] && then_=" At $act% the computer will $(case "$kind" in 1) echo go to sleep ;; 2) echo hibernate ;; *) echo shut down ;; esac) to protect your work."
            battery_notify critical "Battery critically low" "$pct% left. Plug in your computer now.$then_" battery-caution
            warned=critical
        elif [ "$low" -gt 0 ] && [ "$pct" -le "$low" ] && [ "$warned" = none ]; then
            battery_notify normal "Battery low" "$pct% left. Plug in your computer soon." battery-low
            warned=low
        fi
        sleep "${FIROX_BATTERY_INTERVAL:-30}"
    done
}

start() {
    pkill -u "$USER" -x swayidle
    # "Keep the screen on" (taskbar), or a stream (firox-stream): no timers
    # until it's turned off
    if [ -e "$AWAKE" ] || [ -e "$STREAM_AWAKE" ]; then return 0; fi
    local args=(-w) m src
    m="$(get SCREENSAVER_WAIT)"
    if [ "$m" -gt 0 ] && [ "$(firox-screensaver current)" != none ]; then
        args+=(timeout $((m * 60)) 'firox-screensaver start' resume 'firox-screensaver stop')
    fi
    m="$(get LOCK)"
    [ "$m" -gt 0 ] && args+=(timeout $((m * 60)) 'firox-open lock')
    for src in ac battery; do
        [ "$src" = battery ] && ! has_battery && continue
        m="$(get "MONITOR_${src^^}")"
        [ "$m" -gt 0 ] && args+=(timeout $((m * 60)) "firox-power idle monitor $src" resume 'wlopm --on \*')
        m="$(get "SLEEP_${src^^}")"
        [ "$m" -gt 0 ] && args+=(timeout $((m * 60)) "firox-power idle sleep $src")
    done
    [ "$(get LOCK_ON_WAKE)" = 1 ] && args+=(before-sleep 'firox-open lock')
    # Turn the screens back on after waking up, whatever happened before
    args+=(after-resume 'wlopm --on \*')
    setsid -f swayidle "${args[@]}" >/dev/null 2>&1
}

case "${1:-show}" in
    get)
        get "${2:?usage: firox-power get KEY}"
        ;;
    show)
        for k in $KEYS; do echo "$k=$(get "$k")"; done
        echo "# power source: $(power_source)"
        ;;
    set)
        shift
        [ $# -gt 0 ] || { echo "usage: firox-power set KEY=MINUTES..." >&2; exit 2; }
        mkdir -p "$(dirname "$USER_CONF")"
        touch "$USER_CONF"
        for kv in "$@"; do
            k="${kv%%=*}" v="${kv#*=}"
            case " $KEYS " in *" $k "*) ;; *) echo "firox-power: unknown setting $k" >&2; exit 2 ;; esac
            case "$v" in ''|*[!0-9]*) echo "firox-power: $k needs a number of minutes (0 = never)" >&2; exit 2 ;; esac
            sed -i "/^$k=/d" "$USER_CONF"
            echo "$k=$v" >> "$USER_CONF"
        done
        start
        ;;
    reset)
        rm -f "$USER_CONF"
        start
        ;;
    start) start ;;
    awake)
        case "${2:-status}" in
            on)     touch "$AWAKE"; start ;;
            off)    rm -f "$AWAKE"; start ;;
            toggle) if [ -e "$AWAKE" ]; then rm -f "$AWAKE"; else touch "$AWAKE"; fi; start ;;
            status) [ -e "$AWAKE" ] && echo on || echo off ;;
            *)      echo "usage: firox-power awake [on|off|toggle]" >&2; exit 2 ;;
        esac
        ;;
    battery)
        has_battery || { echo "no battery"; exit 1; }
        battery_level
        ;;
    battery-watch)
        # Only one watcher (e.g. after logging out and back in)
        for pid in $(pgrep -u "$USER" -f "firox-power battery-watch"); do
            [ "$pid" != $$ ] && kill "$pid" 2>/dev/null
        done
        battery_watch
        ;;
    idle)
        # Run by swayidle: only act if we're on the matching power source
        [ "$(power_source)" = "${3:-ac}" ] || exit 0
        case "${2:-}" in
            monitor) firox-screensaver stop; exec wlopm --off '*' ;;
            sleep)   firox-screensaver stop; exec systemctl suspend ;;
        esac
        ;;
    *)
        sed -n '2,30s/^# \{0,1\}//p' "$0" >&2
        exit 2
        ;;
esac
