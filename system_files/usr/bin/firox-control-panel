THEMES_DIR = "/usr/share/firox/themes"
BAZAAR_ID = "io.github.kolunmi.Bazaar"


def bazaar_icon():
    """Bazaar's own icon once it's installed (from its Flatpak), else a generic one."""
    for base in (os.path.expanduser("~/.local/share/flatpak/exports/share/icons/hicolor"),
                 "/var/lib/flatpak/exports/share/icons/hicolor"):
        for sub, ext in (("scalable", "svg"), ("256x256", "png"), ("128x128", "png"), ("64x64", "png")):
            path = os.path.join(base, sub, "apps", f"{BAZAAR_ID}.{ext}")
            if os.path.exists(path):
                return path
    if Gtk.IconTheme.get_default().has_icon(BAZAAR_ID):
        return BAZAAR_ID
    return "system-software-install"


def current_theme():
    for path in (os.path.join(GLib.get_user_config_dir(), "firox", "theme"), "/etc/firox/theme"):
        try:
            with open(path) as fh:
                name = fh.read().strip()
        except OSError:
            continue
        if name and os.path.isdir(os.path.join(THEMES_DIR, name)):
            return name
    return "classic"


def theme_file(theme, filename):
    path = os.path.join(THEMES_DIR, theme, filename)
    return path if os.path.exists(path) else os.path.join(THEMES_DIR, "classic", filename)


def read_theme_conf(theme):
    conf = {}
    try:
        with open(os.path.join(THEMES_DIR, theme, "theme.conf")) as fh:
            for line in fh:
                if "=" in line:
                    k, v = line.rstrip("\n").split("=", 1)
                    conf[k] = v
    except OSError:
        pass
    return conf


def spawn(argv):
    try:
        GLib.spawn_async(argv, flags=GLib.SpawnFlags.SEARCH_PATH)
    except GLib.Error as err:
        dlg = Gtk.MessageDialog(message_type=Gtk.MessageType.ERROR, buttons=Gtk.ButtonsType.OK,
                                text=f"Could not start {argv[0]}")
        dlg.format_secondary_text(err.message)
        dlg.run()
        dlg.destroy()


def read_os_release():
    info = {}
    for path in ("/etc/os-release", "/usr/lib/os-release"):
        try:
            with open(path) as fh:
                for line in fh:
                    if "=" in line:
                        k, v = line.rstrip("\n").split("=", 1)
                        info[k] = v.strip('"')
            break
        except OSError:
            continue
    return info


def meminfo_gb():
    try:
        with open("/proc/meminfo") as fh:
            for line in fh:
                if line.startswith("MemTotal:"):
                    return int(line.split()[1]) / 1024 / 1024
    except OSError:
        pass
    return 0


def cpu_name():
    try:
        with open("/proc/cpuinfo") as fh:
            for line in fh:
                if line.startswith("model name"):
                    return line.split(":", 1)[1].strip()
    except OSError:
        pass
    return platform.processor() or platform.machine()


def run_text(argv):
    try:
        return subprocess.run(argv, capture_output=True, text=True, timeout=5).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return ""


class SystemDialog(Gtk.Dialog):
    def __init__(self, parent):
        super().__init__(title="System Properties", transient_for=parent, modal=True)
        self.add_button("OK", Gtk.ResponseType.OK)
        self.set_default_size(440, 300)
        box = self.get_content_area()
        box.set_spacing(8)
        box.set_border_width(16)

        osr = read_os_release()
        image = ""
        try:
            status = json.loads(run_text(["rpm-ostree", "status", "--booted", "--json"]) or "{}")
            image = status["deployments"][0].get("container-image-reference", "")
        except (ValueError, KeyError, IndexError):
            pass
        rows = [
            ("System:", osr.get("PRETTY_NAME", "Firox Linux")),
            ("Image:", image or "unknown"),
            ("Kernel:", platform.release()),
            ("Computer:", cpu_name()),
            ("Memory:", f"{meminfo_gb():.1f} GB RAM"),
            ("Computer name:", GLib.get_host_name()),
        ]
        top = Gtk.Box(spacing=16)
        top.pack_start(Gtk.Image.new_from_icon_name("computer", Gtk.IconSize.DIALOG), False, False, 0)
        grid = Gtk.Grid(column_spacing=12, row_spacing=6)
        for i, (k, v) in enumerate(rows):
            kl = Gtk.Label(label=k, xalign=1)
            kl.get_style_context().add_class("dim-label")
            vl = Gtk.Label(label=v, xalign=0, selectable=True, wrap=True)
            grid.attach(kl, 0, i, 1, 1)
            grid.attach(vl, 1, i, 1, 1)
        top.pack_start(grid, True, True, 0)
        box.pack_start(top, True, True, 0)
        more = Gtk.Button.new_with_mnemonic("System _Information…")
        more.set_tooltip_text("Everything about this computer: hardware, drivers, storage, network, software")
        more.connect("clicked", lambda *_: spawn(["firox-sysinfo"]))
        row = Gtk.Box()
        row.pack_end(more, False, False, 0)
        box.pack_start(row, False, False, 0)
        self.show_all()


class DateTimeDialog(Gtk.Dialog):
    def __init__(self, parent):
        super().__init__(title="Date and Time Properties", transient_for=parent, modal=True)
        self.add_button("Cancel", Gtk.ResponseType.CANCEL)
        self.add_button("Apply", Gtk.ResponseType.APPLY)
        self.set_default_size(420, 200)
        box = self.get_content_area()
        box.set_spacing(10)
        box.set_border_width(16)

        self.clock = Gtk.Label(xalign=0)
        self.clock.get_style_context().add_class("title")
        box.pack_start(self.clock, False, False, 0)
        self._tick()
        GLib.timeout_add_seconds(1, self._tick)

        current = run_text(["timedatectl", "show", "-p", "Timezone", "--value"])
        zones = run_text(["timedatectl", "list-timezones"]).splitlines()
        self.zone = Gtk.ComboBoxText.new_with_entry()
        for z in zones:
            self.zone.append_text(z)
        self.zone.get_child().set_text(current)
        row = Gtk.Box(spacing=8)
        row.pack_start(Gtk.Label(label="Time zone:"), False, False, 0)
        row.pack_start(self.zone, True, True, 0)
        box.pack_start(row, False, False, 0)

        ntp = run_text(["timedatectl", "show", "-p", "NTP", "--value"]) == "yes"
        self.ntp = Gtk.CheckButton(label="Automatically synchronize with an Internet time server")
        self.ntp.set_active(ntp)
        box.pack_start(self.ntp, False, False, 0)
        self.show_all()

    def _tick(self):
        self.clock.set_text(GLib.DateTime.new_now_local().format("%A, %B %d, %Y   %I:%M:%S %p"))
        return True

    def apply(self):
        zone = self.zone.get_child().get_text().strip()
        if zone:
            subprocess.run(["timedatectl", "set-timezone", zone])
        subprocess.run(["timedatectl", "set-ntp", "true" if self.ntp.get_active() else "false"])


class AppearanceDialog(Gtk.Dialog):
    """Pick the desktop theme; the layout stays the same, only the look changes."""

    def __init__(self, parent):
        super().__init__(title="Appearance", transient_for=parent, modal=True)
        self.add_button("Cancel", Gtk.ResponseType.CANCEL)
        self.add_button("Apply", Gtk.ResponseType.APPLY)
        self.set_default_size(380, -1)
        box = self.get_content_area()
        box.set_spacing(10)
        box.set_border_width(16)
        box.pack_start(Gtk.Label(label="Windows, taskbar and Start menu style:", xalign=0), False, False, 0)

        current = current_theme()
        self.choice = current
        group = None
        try:
            names = sorted(os.listdir(THEMES_DIR), key=lambda n: (n != "classic", n))
        except OSError:
            names = ["classic"]
        for name in names:
            conf = read_theme_conf(name)
            radio = Gtk.RadioButton.new_from_widget(group)
            group = group or radio
            label = Gtk.Label(xalign=0)
            label.set_markup(f"<b>{GLib.markup_escape_text(conf.get('NAME', name.title()))}</b>\n"
                             f"<small>{GLib.markup_escape_text(conf.get('DESCRIPTION', ''))}</small>")
            radio.add(label)
            radio.set_active(name == current)
            radio.connect("toggled", lambda r, n=name: r.get_active() and setattr(self, "choice", n))
            box.pack_start(radio, False, False, 0)

        box.pack_start(Gtk.Separator(), False, False, 4)
        box.pack_start(Gtk.Label(label="Programs (browser, files, settings and other apps):", xalign=0),
                       False, False, 0)
        self.apps = self.apps_before = run_text(["firox-theme", "apps"]) or "auto"
        row = Gtk.Box(spacing=16)
        group = None
        for mode, label in (("auto", "Match the look"), ("light", "Light"), ("dark", "Dark")):
            radio = Gtk.RadioButton.new_with_label_from_widget(group, label)
            group = group or radio
            radio.set_active(mode == self.apps)
            radio.connect("toggled", lambda r, m=mode: r.get_active() and setattr(self, "apps", m))
            row.pack_start(radio, False, False, 0)
        box.pack_start(row, False, False, 0)
        hint = Gtk.Label(xalign=0)
        hint.set_markup("<small>Match the look: dark with Modern, light with Classic and Glass.</small>")
        box.pack_start(hint, False, False, 0)
        self.theme_before = current
        self.show_all()

    def apply(self):
        if self.apps != self.apps_before:
            subprocess.run(["firox-theme", "apps", self.apps])
        if self.choice != self.theme_before:
            subprocess.run(["firox-theme", "set", self.choice])


POWER_CHOICES = [1, 2, 3, 5, 10, 15, 20, 25, 30, 45, 60, 120, 180, 300, 0]


def minutes_label(m):
    if m == 0:
        return "Never"
    if m < 60:
        return f"After {m} min" + ("s" if m > 1 else "")
    h = m // 60
    return f"After {h} hour" + ("s" if h > 1 else "")


def has_battery():
    """The computer's own battery (not a wireless mouse's: scope=Device)."""
    def read(path):
        try:
            with open(path) as fh:
                return fh.read().strip()
        except OSError:
            return ""
    return any(read(os.path.join(d, "type")) == "Battery" and read(os.path.join(d, "scope")) != "Device"
               for d in glob.glob("/sys/class/power_supply/*"))


class ScreenSaverDialog(Gtk.Dialog):
    """Pick a screen saver and how long to wait before it starts."""

    def __init__(self, parent):
        super().__init__(title="Screen Saver", transient_for=parent, modal=True)
        self.add_button("Cancel", Gtk.ResponseType.CANCEL)
        self.add_button("Apply", Gtk.ResponseType.APPLY)
        self.set_default_size(400, -1)
        box = self.get_content_area()
        box.set_spacing(10)
        box.set_border_width(16)
        header = Gtk.Box(spacing=12)
        header.pack_start(Gtk.Image.new_from_icon_name("preferences-desktop-screensaver",
                                                       Gtk.IconSize.DIALOG), False, False, 0)
        header.pack_start(Gtk.Label(xalign=0, wrap=True, max_width_chars=42,
                                    label="Show a screen saver when you haven't used the computer "
                                          "for a while. Move the mouse or press a key to stop it."),
                          True, True, 0)
        box.pack_start(header, False, False, 0)

        self.before_id = run_text(["firox-screensaver", "current"]) or "none"
        wait = run_text(["firox-power", "get", "SCREENSAVER_WAIT"])
        self.before_wait = int(wait) if wait.isdigit() and int(wait) > 0 else 5

        grid = Gtk.Grid(column_spacing=12, row_spacing=8)
        grid.attach(Gtk.Label(label="Screen saver:", xalign=0), 0, 0, 1, 1)
        row = Gtk.Box(spacing=6)
        self.saver = Gtk.ComboBoxText()
        self.saver.append("none", "(None)")
        for line in run_text(["firox-screensaver", "list"]).splitlines():
            sid, _tab, name = line.partition("\t")
            self.saver.append(sid, name or sid)
        self.saver.set_active_id(self.before_id)
        if self.saver.get_active_id() is None:
            self.saver.set_active_id("none")
        row.pack_start(self.saver, True, True, 0)
        self.preview = Gtk.Button(label="Preview")
        self.preview.connect("clicked", self.on_preview)
        row.pack_start(self.preview, False, False, 0)
        grid.attach(row, 1, 0, 1, 1)

        grid.attach(Gtk.Label(label="Wait:", xalign=0), 0, 1, 1, 1)
        self.wait = Gtk.ComboBoxText()
        choices = [m for m in POWER_CHOICES if m]
        if self.before_wait not in choices:
            choices = sorted(choices + [self.before_wait])
        for m in choices:
            self.wait.append(str(m), minutes_label(m))
        self.wait.set_active_id(str(self.before_wait))
        grid.attach(self.wait, 1, 1, 1, 1)
        box.pack_start(grid, False, False, 0)

        self.saver.connect("changed", lambda _c: self.sync())
        hint = Gtk.Label(xalign=0, wrap=True, max_width_chars=50)
        hint.set_markup("<small>Add your own: put a <tt>NAME.conf</tt> with <tt>NAME=</tt> and "
                        "<tt>COMMAND=</tt> lines in <tt>~/.local/share/firox/screensavers</tt>.</small>")
        box.pack_start(hint, False, False, 0)
        self.sync()
        self.show_all()

    def sync(self):
        on = self.saver.get_active_id() != "none"
        self.preview.set_sensitive(on)
        self.wait.set_sensitive(on)

    def on_preview(self, _btn):
        spawn(["firox-screensaver", "preview", self.saver.get_active_id()])

    def apply(self):
        sid = self.saver.get_active_id() or "none"
        wait = int(self.wait.get_active_id() or self.before_wait)
        if sid != self.before_id or wait != self.before_wait:
            subprocess.run(["firox-screensaver", "set", sid, str(wait)])


def input_settings():
    """Current firox-input settings as strings."""
    values = {}
    for line in run_text(["firox-input"]).splitlines():
        if "=" in line and not line.startswith("#"):
            k, v = line.split("=", 1)
            values[k] = v
    return values


def has_touchpad():
    try:
        with open("/proc/bus/input/devices") as fh:
            names = [l.lower() for l in fh if l.startswith("N: Name=")]
    except OSError:
        return False
    return any(w in n for n in names for w in ("touchpad", "trackpad", "glidepoint", "synaptics"))


class InputDialog(Gtk.Dialog):
    """Shared plumbing for the Mouse and Keyboard dialogs (firox-input)."""

    def __init__(self, parent, title, icon, intro):
        super().__init__(title=title, transient_for=parent, modal=True)
        self.add_button("Cancel", Gtk.ResponseType.CANCEL)
        self.add_button("Apply", Gtk.ResponseType.APPLY)
        self.set_default_size(460, -1)
        self.before = input_settings()
        self.values = dict(self.before)
        box = self.get_content_area()
        box.set_spacing(10)
        box.set_border_width(14)
        header = Gtk.Box(spacing=12)
        header.pack_start(Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.DIALOG), False, False, 0)
        header.pack_start(Gtk.Label(label=intro, xalign=0, wrap=True, max_width_chars=48), True, True, 0)
        box.pack_start(header, False, False, 0)
        self.notebook = Gtk.Notebook()
        box.pack_start(self.notebook, True, True, 0)
        mine = [p for p in (os.path.expanduser("~/.config/labwc/rc.xml"),
                            os.path.expanduser("~/.config/labwc/environment")) if os.path.exists(p)]
        if mine:
            warn = Gtk.Label(xalign=0, wrap=True, max_width_chars=56)
            warn.set_markup("<small>You have your own " + " and ".join(
                f"<tt>{GLib.markup_escape_text(p.replace(os.path.expanduser('~'), '~'))}</tt>" for p in mine)
                + ", which takes priority, so some of these settings won't apply. "
                  "<tt>ujust reset-desktop</tt> removes it (keeping a backup).</small>")
            box.pack_start(warn, False, False, 0)

    def page(self, title):
        grid = Gtk.Grid(column_spacing=12, row_spacing=10, border_width=12)
        grid.row = 0
        self.notebook.append_page(grid, Gtk.Label(label=title))
        return grid

    def add_row(self, grid, label, widget, hint=None):
        if label:
            grid.attach(Gtk.Label(label=label, xalign=0), 0, grid.row, 1, 1)
            grid.attach(widget, 1, grid.row, 1, 1)
        else:
            grid.attach(widget, 0, grid.row, 2, 1)
        widget.set_hexpand(True)
        grid.row += 1
        if hint:
            h = Gtk.Label(xalign=0, wrap=True, max_width_chars=56)
            h.set_markup(f"<small>{hint}</small>")
            grid.attach(h, 0, grid.row, 2, 1)
            grid.row += 1

    def check(self, key, label):
        b = Gtk.CheckButton(label=label)
        b.set_active(self.values.get(key) == "1")
        b.connect("toggled", lambda w: self.values.__setitem__(key, "1" if w.get_active() else "0"))
        return b

    def slider(self, key, lo, hi, step, left, right, digits=2):
        box = Gtk.Box(spacing=6)
        adj = Gtk.Adjustment(value=float(self.values.get(key, lo)), lower=lo, upper=hi,
                             step_increment=step, page_increment=step * 4)
        scale = Gtk.Scale(orientation=Gtk.Orientation.HORIZONTAL, adjustment=adj, draw_value=False)
        scale.set_size_request(200, -1)
        scale.connect("value-changed",
                      lambda w: self.values.__setitem__(key, f"{round(w.get_value(), digits):g}"))
        box.pack_start(Gtk.Label(label=left), False, False, 0)
        box.pack_start(scale, True, True, 0)
        box.pack_start(Gtk.Label(label=right), False, False, 0)
        return box

    def combo(self, key, options):
        c = Gtk.ComboBoxText()
        for value, label in options:
            c.append(value, label)
        c.set_active_id(self.values.get(key))
        if c.get_active_id() is None:
            c.set_active(0)
        c.connect("changed", lambda w: self.values.__setitem__(key, w.get_active_id()))
        return c

    def apply(self):
        changed = [f"{k}={v}" for k, v in self.values.items() if self.before.get(k) != v]
        if changed:
            subprocess.run(["firox-input", "set"] + changed)


class MouseDialog(InputDialog):
    def __init__(self, parent):
        super().__init__(parent, "Mouse", "input-mouse",
                         "Changes take effect as soon as you click Apply.")
        g = self.page("Buttons")
        self.add_row(g, None, self.check("LEFT_HANDED", "Switch primary and secondary buttons (left-handed)"))
        self.add_row(g, "Double-click speed:", self.slider("DOUBLE_CLICK", 200, 900, 50, "Fast", "Slow", 0),
                     "Double-click the folder below to test the setting.")
        test = Gtk.EventBox()
        self.folder = Gtk.Image.new_from_icon_name("folder", Gtk.IconSize.DIALOG)
        self.folder.set_pixel_size(48)
        test.add(self.folder)
        test.connect("button-press-event", self.on_test_click)
        self.add_row(g, None, test)

        g = self.page("Pointer")
        self.add_row(g, "Speed:", self.slider("MOUSE_SPEED", -1, 1, 0.1, "Slow", "Fast"))
        self.add_row(g, None, self.check("MOUSE_ACCEL", "Enhance pointer precision (acceleration)"))
        self.add_row(g, "Pointer size:", self.combo("CURSOR_SIZE", [("24", "Normal"), ("32", "Large"),
                                                                     ("48", "Extra large"), ("64", "Huge")]),
                     "Some apps use the new size after they're restarted.")

        g = self.page("Wheel")
        self.add_row(g, "Scrolling speed:", self.slider("SCROLL_SPEED", 0.25, 3, 0.25, "Slow", "Fast"))
        self.add_row(g, None, self.check("MOUSE_NATURAL", "Natural scrolling (content follows the wheel)"))

        g = self.page("Touchpad")
        if not has_touchpad():
            self.add_row(g, None, Gtk.Label(label="No touchpad was found; these settings apply when one is "
                                                  "connected.", xalign=0, wrap=True, max_width_chars=50))
        self.add_row(g, None, self.check("TOUCHPAD_TAP", "Tap to click"))
        self.add_row(g, "Speed:", self.slider("TOUCHPAD_SPEED", -1, 1, 0.1, "Slow", "Fast"))
        self.add_row(g, None, self.check("TOUCHPAD_NATURAL", "Natural scrolling"))
        self.add_row(g, "Scroll with:", self.combo("TOUCHPAD_SCROLL", [("twofinger", "Two fingers"),
                                                                       ("edge", "The edge of the touchpad")]))
        self.add_row(g, "Right-click:", self.combo("TOUCHPAD_CLICK", [
            ("auto", "Touchpad default"), ("clickfinger", "Click with two fingers"),
            ("buttonAreas", "Click the bottom-right corner")]))
        self.add_row(g, None, self.check("TOUCHPAD_DWT", "Ignore the touchpad while typing"))
        self.add_row(g, None, self.check("TOUCHPAD_OFF_WITH_MOUSE", "Turn off the touchpad when a mouse is plugged in"))
        self.show_all()

    def on_test_click(self, _w, event):
        if event.type == Gdk.EventType._2BUTTON_PRESS:
            name = "folder-open" if self.folder.get_icon_name()[0] == "folder" else "folder"
            self.folder.set_from_icon_name(name, Gtk.IconSize.DIALOG)
            self.folder.set_pixel_size(48)
        return False


class KeyboardDialog(InputDialog):
    def __init__(self, parent):
        super().__init__(parent, "Keyboard", "input-keyboard",
                         "Changes take effect as soon as you click Apply.")
        g = self.page("Speed")
        self.add_row(g, "Repeat delay:", self.slider("REPEAT_DELAY", 150, 1000, 50, "Short", "Long", 0))
        self.add_row(g, "Repeat rate:", self.slider("REPEAT_RATE", 5, 60, 1, "Slow", "Fast", 0))
        test = Gtk.Entry(placeholder_text="Click here and hold down a key to test the repeat rate")
        self.add_row(g, None, test, "The new speed applies after you click Apply.")
        self.add_row(g, None, self.check("NUMLOCK", "Turn on Num Lock when I log in"))

        g = self.page("Layouts")
        self.layout_names = dict(l.split("\t", 1) for l in run_text(["firox-input", "layouts"]).splitlines()
                                 if "\t" in l)
        layouts = [x for x in self.values.get("KB_LAYOUTS", "").split(",") if x]
        variants = self.values.get("KB_VARIANTS", "").split(",")
        self.store = Gtk.ListStore(str, str, str)  # code, variant, label
        for i, code in enumerate(layouts):
            var = variants[i] if i < len(variants) else ""
            self.store.append([code, var, self.label(code, var)])
        view = Gtk.TreeView(model=self.store, headers_visible=False)
        view.append_column(Gtk.TreeViewColumn("Layout", Gtk.CellRendererText(), text=2))
        self.selection = view.get_selection()
        scroll = Gtk.ScrolledWindow(min_content_height=110)
        scroll.set_shadow_type(Gtk.ShadowType.IN)
        scroll.add(view)
        self.empty_hint = ("The layout chosen when Firox Linux was installed is used. "
                           "Add layouts to use your own instead; the first one is the default.")
        self.add_row(g, None, scroll, self.empty_hint)

        buttons = Gtk.Box(spacing=6)
        for label, handler in (("Add…", self.on_add), ("Remove", self.on_remove),
                               ("Move up", self.on_up)):
            b = Gtk.Button(label=label)
            b.connect("clicked", handler)
            buttons.pack_start(b, False, False, 0)
        self.add_row(g, None, buttons)
        keys = [l.split("\t", 1) for l in run_text(["firox-input", "switch-keys"]).splitlines() if "\t" in l]
        common = ["grp:alt_shift_toggle", "grp:win_space_toggle", "grp:ctrl_shift_toggle",
                  "grp:caps_toggle", "grp:alt_space_toggle"]
        keys.sort(key=lambda kv: (common.index(kv[0]) if kv[0] in common else 99, kv[1]))
        self.add_row(g, "Switch layouts with:", self.combo("KB_SWITCH", keys or [("grp:alt_shift_toggle", "Alt+Shift")]))
        self.show_all()

    def label(self, code, variant):
        name = self.layout_names.get(code, code)
        if variant:
            for line in run_text(["firox-input", "variants", code]).splitlines():
                v, _t, vname = line.partition("\t")
                if v == variant:
                    return vname
            return f"{name} ({variant})"
        return name

    def sync_store(self):
        rows = [(r[0], r[1]) for r in self.store]
        self.values["KB_LAYOUTS"] = ",".join(c for c, _v in rows)
        self.values["KB_VARIANTS"] = ",".join(v for _c, v in rows) if any(v for _c, v in rows) else ""

    def on_add(self, _b):
        dlg = Gtk.Dialog(title="Add a keyboard layout", transient_for=self, modal=True)
        dlg.add_button("Cancel", Gtk.ResponseType.CANCEL)
        dlg.add_button("Add", Gtk.ResponseType.OK)
        dlg.set_default_size(380, 420)
        area = dlg.get_content_area()
        area.set_spacing(8)
        area.set_border_width(12)
        search = Gtk.SearchEntry(placeholder_text="Search layouts")
        area.pack_start(search, False, False, 0)
        store = Gtk.ListStore(str, str, str)  # code, variant, label
        for code, name in sorted(self.layout_names.items(), key=lambda kv: kv[1]):
            store.append([code, "", name])
        filt = store.filter_new()
        filt.set_visible_func(lambda m, it, _d: search.get_text().lower() in m[it][2].lower())
        search.connect("search-changed", lambda _s: filt.refilter())
        view = Gtk.TreeView(model=filt, headers_visible=False)
        view.append_column(Gtk.TreeViewColumn("Layout", Gtk.CellRendererText(), text=2))
        view.connect("row-activated", lambda *_: dlg.response(Gtk.ResponseType.OK))
        scroll = Gtk.ScrolledWindow(vexpand=True)
        scroll.add(view)
        area.pack_start(scroll, True, True, 0)
        variant = Gtk.ComboBoxText()
        area.pack_start(Gtk.Label(label="Variant:", xalign=0), False, False, 0)
        area.pack_start(variant, False, False, 0)

        def on_select(sel):
            model, it = sel.get_selected()
            variant.remove_all()
            variant.append("", "Standard")
            if it is not None:
                for line in run_text(["firox-input", "variants", model[it][0]]).splitlines():
                    v, _t, name = line.partition("\t")
                    variant.append(v, name)
            variant.set_active(0)
        view.get_selection().connect("changed", on_select)
        dlg.show_all()
        if dlg.run() == Gtk.ResponseType.OK:
            model, it = view.get_selection().get_selected()
            if it is not None:
                code, var = model[it][0], variant.get_active_id() or ""
                self.store.append([code, var, self.label(code, var)])
                self.sync_store()
        dlg.destroy()

    def on_remove(self, _b):
        model, it = self.selection.get_selected()
        if it is not None:
            model.remove(it)
            self.sync_store()

    def on_up(self, _b):
        model, it = self.selection.get_selected()
        if it is not None:
            prev = model.iter_previous(it)
            if prev is not None:
                model.swap(it, prev)
                self.sync_store()


class ClipboardDialog(Gtk.Dialog):
    """Clipboard history settings (firox-clipboard)."""

    def __init__(self, parent):
        super().__init__(title="Clipboard", transient_for=parent, modal=True)
        self.add_button("Cancel", Gtk.ResponseType.CANCEL)
        self.add_button("Apply", Gtk.ResponseType.APPLY)
        self.set_default_size(420, -1)
        box = self.get_content_area()
        box.set_spacing(10)
        box.set_border_width(16)
        header = Gtk.Box(spacing=12)
        header.pack_start(Gtk.Image.new_from_icon_name("org.kde.plasma.clipboard", Gtk.IconSize.DIALOG),
                          False, False, 0)
        intro = Gtk.Label(xalign=0, wrap=True, max_width_chars=44)
        intro.set_markup("Copy with <b>Ctrl+C</b> and paste with <b>Ctrl+V</b> "
                         "(<b>Ctrl+Shift+C</b> / <b>Ctrl+Shift+V</b> in the Command Prompt). "
                         "What you copy stays available after you close the app you copied it from.")
        header.pack_start(intro, True, True, 0)
        box.pack_start(header, False, False, 0)

        self.values = {}
        for line in run_text(["firox-clipboard"]).splitlines():
            if "=" in line and not line.startswith("#"):
                k, v = line.split("=", 1)
                self.values[k] = int(v) if v.isdigit() else 0
        self.before = dict(self.values)

        self.history = Gtk.CheckButton()
        self.history.add(Gtk.Label(xalign=0, wrap=True, max_width_chars=44,
                                   label="Remember what I copy, so I can paste it again later "
                                         "(press Super+V to choose)"))
        self.history.set_active(self.values.get("HISTORY", 1) == 1)
        box.pack_start(self.history, False, False, 0)

        row = Gtk.Box(spacing=8)
        row.set_margin_start(26)
        row.pack_start(Gtk.Label(label="Remember up to", xalign=0), False, False, 0)
        self.max_items = Gtk.SpinButton.new_with_range(5, 1000, 5)
        self.max_items.set_value(self.values.get("MAX_ITEMS", 100) or 100)
        row.pack_start(self.max_items, False, False, 0)
        row.pack_start(Gtk.Label(label="items"), False, False, 0)
        box.pack_start(row, False, False, 0)

        self.keep = Gtk.CheckButton(label="Keep the history after I log off or restart")
        self.keep.set_margin_start(26)
        self.keep.set_active(self.values.get("KEEP_AFTER_RESTART", 0) == 1)
        box.pack_start(self.keep, False, False, 0)

        clear = Gtk.Button(label="Clear clipboard history")
        clear.set_halign(Gtk.Align.START)
        clear.connect("clicked", self.on_clear)
        box.pack_start(clear, False, False, 4)

        self.history.connect("toggled", lambda _b: self.sync(row))
        self.sync(row)
        self.show_all()

    def sync(self, row):
        on = self.history.get_active()
        row.set_sensitive(on)
        self.keep.set_sensitive(on)

    def on_clear(self, btn):
        subprocess.run(["firox-clipboard", "clear"])
        btn.set_label("Cleared")
        btn.set_sensitive(False)

    def apply(self):
        new = {"HISTORY": int(self.history.get_active()),
               "MAX_ITEMS": int(self.max_items.get_value()),
               "KEEP_AFTER_RESTART": int(self.keep.get_active())}
        changed = [f"{k}={v}" for k, v in new.items() if self.before.get(k) != v]
        if changed:
            subprocess.run(["firox-clipboard", "set"] + changed)


PANEL_CONF = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"),
                          "firox", "panel.conf")


def read_panel_conf():
    out = {"GROUP": "1", "AUTOHIDE": "0", "QUICKLAUNCH": "1", "SECONDS": "0", "ALL_DISPLAYS": "1",
           "BATTERY_PERCENT": "1", "SECURITY": "1", "NIGHTLIGHT": "1"}
    try:
        with open(PANEL_CONF) as fh:
            for line in fh:
                if "=" in line and not line.lstrip().startswith("#"):
                    k, v = line.strip().split("=", 1)
                    out[k] = v
    except OSError:
        pass
    return out


class TaskbarDialog(Gtk.Dialog):
    """Taskbar settings (firox-panel picks changes up straight away)."""

    OPTIONS = [
        ("AUTOHIDE", "Auto-hide the taskbar",
         "It slides away when you're not using it; touch the bottom of the screen to bring it back."),
        ("GROUP", "Group similar windows",
         "Windows of the same program share one button that shows how many there are."),
        ("QUICKLAUNCH", "Show Quick Launch",
         "The small icons next to the start button. Right-click a program in the Start menu "
         "or on the taskbar to pin it there; drag them to rearrange."),
        ("SECONDS", "Show seconds on the clock", None),
        ("BATTERY_PERCENT", "Show the battery percentage", "~On laptops, next to the battery icon."),
        ("SECURITY", "Show the Security Center shield",
         "~Grey when everything's fine; yellow or red when something needs your attention."),
        ("NIGHTLIGHT", "Show the Night Light button", "~A moon that turns Night Light on or off."),
        ("ALL_DISPLAYS", "Show the taskbar on all displays",
         "With more than one monitor, the others get a taskbar with their own windows and the "
         "clock. Untick it for one taskbar, on the main display (Settings \u2192 Display), "
         "with every window."),
    ]

    def __init__(self, parent):
        super().__init__(title="Taskbar", transient_for=parent, modal=True)
        self.add_button("Cancel", Gtk.ResponseType.CANCEL)
        self.add_button("Apply", Gtk.ResponseType.APPLY)
        self.set_default_size(440, -1)
        box = self.get_content_area()
        box.set_spacing(10)
        box.set_border_width(16)
        header = Gtk.Box(spacing=12)
        header.pack_start(Gtk.Image.new_from_icon_name("preferences-desktop", Gtk.IconSize.DIALOG),
                          False, False, 0)
        intro = Gtk.Label(xalign=0, wrap=True, max_width_chars=46,
                          label="Drag window buttons to rearrange them. Right-click an empty part of "
                                "the taskbar to come back here.")
        header.pack_start(intro, True, True, 0)
        box.pack_start(header, False, False, 0)
        self.values = read_panel_conf()
        self.checks = {}
        # the options scroll if the screen is short, so Apply stays visible
        outer_box, box = box, Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        sw = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER, propagate_natural_height=True)
        screen_h = Gdk.Screen.get_default().get_height() if Gdk.Screen.get_default() else 768
        sw.set_max_content_height(max(300, screen_h - 300))
        sw.add(box)
        outer_box.pack_start(sw, True, True, 0)
        for key, title, help_text in self.OPTIONS:
            cb = Gtk.CheckButton(label=title)
            cb.set_active(self.values.get(key, "0") != "0")
            box.pack_start(cb, False, False, 0)
            if help_text and help_text.startswith("~"):
                cb.set_tooltip_text(help_text[1:])      # short ones: a tooltip
            elif help_text:
                lab = Gtk.Label(label=help_text, xalign=0, wrap=True, max_width_chars=46)
                lab.set_margin_start(26)
                lab.get_style_context().add_class("dim-label")
                box.pack_start(lab, False, False, 0)
            self.checks[key] = cb
        self.gadgets = Gtk.CheckButton(label="Show Desktop Gadgets (the Sidebar)")
        self.gadgets_before = self.gadgets_enabled()
        self.gadgets.set_active(self.gadgets_before)
        box.pack_start(self.gadgets, False, False, 0)
        lab = Gtk.Label(label="Clock, calendar, weather, CPU meter and more on the right of the desktop. "
                              "Click + Gadgets on it to add more.", xalign=0, wrap=True, max_width_chars=46)
        lab.set_margin_start(26)
        lab.get_style_context().add_class("dim-label")
        box.pack_start(lab, False, False, 0)
        reset = Gtk.Button(label="Reset Quick Launch to the defaults")
        reset.set_halign(Gtk.Align.START)
        reset.connect("clicked", self.on_reset)
        box.pack_start(reset, False, False, 4)
        self.show_all()

    @staticmethod
    def gadgets_enabled():
        path = os.path.join(os.path.dirname(PANEL_CONF), "gadgets.conf")
        try:
            with open(path) as fh:
                return not any(line.strip() == "ENABLED=0" for line in fh)
        except OSError:
            return True

    def on_reset(self, btn):
        subprocess.run(["firox-quicklaunch", "reset"])
        btn.set_label("Quick Launch was reset")
        btn.set_sensitive(False)

    def apply(self):
        for key, cb in self.checks.items():
            self.values[key] = "1" if cb.get_active() else "0"
        os.makedirs(os.path.dirname(PANEL_CONF), exist_ok=True)
        tmp = PANEL_CONF + ".tmp"
        with open(tmp, "w") as fh:
            fh.write("# firox-panel settings\n")
            for k, v in self.values.items():
                fh.write(f"{k}={v}\n")
        os.replace(tmp, PANEL_CONF)
        on = self.gadgets.get_active()
        if on != self.gadgets_before:
            spawn(["firox-gadgets", "on" if on else "off"])


class DefaultsDialog(Gtk.Dialog):
    """Which program opens web links, email, music, pictures..."""

    KINDS = [
        ("web-browser", "Web browser",
         ["x-scheme-handler/http", "x-scheme-handler/https", "text/html", "application/xhtml+xml"]),
        ("internet-mail", "Email", ["x-scheme-handler/mailto"]),
        ("system-file-manager", "Files and folders", ["inode/directory"]),
        ("audio-x-generic", "Music",
         ["audio/mpeg", "audio/flac", "audio/ogg", "audio/x-vorbis+ogg", "audio/mp4", "audio/x-wav"]),
        ("video-x-generic", "Videos",
         ["video/mp4", "video/x-matroska", "video/webm", "video/quicktime", "video/x-msvideo"]),
        ("image-x-generic", "Pictures",
         ["image/jpeg", "image/png", "image/gif", "image/webp", "image/bmp", "image/tiff"]),
        ("text-x-generic", "Text files", ["text/plain"]),
        ("application-pdf", "PDF documents", ["application/pdf"]),
    ]

    def __init__(self, parent):
        super().__init__(title="Default Programs", transient_for=parent, modal=True)
        self.add_button("Cancel", Gtk.ResponseType.CANCEL)
        self.add_button("Apply", Gtk.ResponseType.APPLY)
        self.set_default_size(520, -1)
        box = self.get_content_area()
        box.set_spacing(12)
        box.set_border_width(16)
        header = Gtk.Box(spacing=12)
        header.pack_start(Gtk.Image.new_from_icon_name("preferences-desktop-default-applications",
                                                       Gtk.IconSize.DIALOG), False, False, 0)
        header.pack_start(Gtk.Label(label="Choose the program that opens each kind of file or link.",
                                    xalign=0, wrap=True, max_width_chars=50), True, True, 0)
        box.pack_start(header, False, False, 0)
        grid = Gtk.Grid(column_spacing=12, row_spacing=8)
        box.pack_start(grid, False, False, 0)
        self.rows = []
        theme = Gtk.IconTheme.get_default()
        for r, (icon, title, mimes) in enumerate(self.KINDS):
            img = Gtk.Image.new_from_icon_name(icon if theme.has_icon(icon) else "application-x-executable",
                                               Gtk.IconSize.LARGE_TOOLBAR)
            grid.attach(img, 0, r, 1, 1)
            grid.attach(Gtk.Label(label=title, xalign=0), 1, r, 1, 1)
            combo, current = self.combo_for(mimes)
            combo.set_hexpand(True)
            grid.attach(combo, 2, r, 1, 1)
            self.rows.append((mimes, combo, current))
        self.show_all()

    @staticmethod
    def combo_for(mimes):
        apps, seen = [], set()
        for mime in mimes:
            for app in Gio.AppInfo.get_all_for_type(mime):
                if app.get_id() and app.get_id() not in seen and app.should_show():
                    seen.add(app.get_id())
                    apps.append(app)
        apps.sort(key=lambda a: a.get_display_name().lower())
        store = Gtk.ListStore(Gio.Icon, str, str)
        for app in apps:
            store.append([app.get_icon() or Gio.ThemedIcon.new("application-x-executable"),
                          app.get_display_name(), app.get_id()])
        combo = Gtk.ComboBox.new_with_model(store)
        pix = Gtk.CellRendererPixbuf()
        combo.pack_start(pix, False)
        combo.add_attribute(pix, "gicon", 0)
        text = Gtk.CellRendererText()
        combo.pack_start(text, True)
        combo.add_attribute(text, "text", 1)
        combo.set_id_column(2)
        default = Gio.AppInfo.get_default_for_type(mimes[0], False)
        current = default.get_id() if default else None
        if current and current in seen:
            combo.set_active_id(current)
        if not apps:
            store.append([Gio.ThemedIcon.new("dialog-information"), "No program installed for this", ""])
            combo.set_active(0)
            combo.set_sensitive(False)
        return combo, current

    def apply(self):
        for mimes, combo, current in self.rows:
            ident = combo.get_active_id()
            if not ident or ident == current:
                continue
            try:
                app = Gio.DesktopAppInfo.new(ident)
            except TypeError:
                app = None
            if app is None:
                continue
            for mime in mimes:
                try:
                    app.set_as_default_for_type(mime)
                except GLib.Error as err:
                    print(f"default programs: {mime}: {err.message}", file=sys.stderr)


def can_hibernate():
    out = run_text(["busctl", "call", "org.freedesktop.login1", "/org/freedesktop/login1",
                    "org.freedesktop.login1.Manager", "CanHibernate"])
    return '"yes"' in out


class DisplayDialog(Gtk.Dialog):
    """XP-style Display Properties: the monitors as numbered screens, which
    one is the main display, Identify, and the resolution/arrangement tool."""

    def __init__(self, parent):
        super().__init__(title="Display", transient_for=parent, modal=True)
        self.add_button("Cancel", Gtk.ResponseType.CANCEL)
        self.add_button("Apply", Gtk.ResponseType.APPLY)
        self.set_default_size(500, -1)
        box = self.get_content_area()
        box.set_spacing(10)
        box.set_border_width(16)
        header = Gtk.Box(spacing=12)
        header.pack_start(Gtk.Image.new_from_icon_name("preferences-desktop-display", Gtk.IconSize.DIALOG),
                          False, False, 0)
        intro = Gtk.Label(xalign=0, wrap=True, max_width_chars=50,
                          label="Click a monitor to choose it. The main display has the full "
                                "taskbar with its icons and clock, the Sidebar and notifications; "
                                "the others extend your desktop.")
        header.pack_start(intro, True, True, 0)
        box.pack_start(header, False, False, 0)

        self.area = Gtk.DrawingArea()
        self.area.set_size_request(-1, 190)
        self.area.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
        self.area.connect("draw", self.on_draw)
        self.area.connect("button-press-event", self.on_click)
        frame = Gtk.Frame()
        frame.add(self.area)
        box.pack_start(frame, False, False, 0)

        row = Gtk.Box(spacing=8)
        row.pack_start(Gtk.Label(label="Display:"), False, False, 0)
        self.combo = Gtk.ComboBoxText()
        self.combo.connect("changed", self.on_combo)
        row.pack_start(self.combo, True, True, 0)
        box.pack_start(row, False, False, 0)
        self.details = Gtk.Label(xalign=0)
        self.details.get_style_context().add_class("dim-label")
        box.pack_start(self.details, False, False, 0)

        self.main_check = Gtk.CheckButton(label="Make this my main display")
        self.main_check.connect("toggled", self.on_main_toggled)
        box.pack_start(self.main_check, False, False, 0)
        self.note = Gtk.Label(xalign=0, wrap=True, max_width_chars=50)
        self.note.set_margin_start(26)
        self.note.get_style_context().add_class("dim-label")
        box.pack_start(self.note, False, False, 0)

        buttons = Gtk.Box(spacing=8)
        ident = Gtk.Button(label="Identify")
        ident.set_tooltip_text("Show each monitor's number on it for a few seconds")
        ident.connect("clicked", lambda _b: self.identify())
        ident.set_sensitive(GtkLayerShell is not None)
        buttons.pack_start(ident, False, False, 0)
        more = Gtk.Button(label="Resolution and arrangement\u2026")
        more.set_tooltip_text("Resolution, refresh rate, scaling, rotation, turning monitors "
                              "on and off, and where they sit next to each other")
        more.connect("clicked", lambda _b: spawn(["firox-display"]))
        buttons.pack_end(more, False, False, 0)
        box.pack_start(buttons, False, False, 4)

        self.selected = None
        self.pending = None               # main display chosen here, not applied yet
        self.updating = False
        self.reload()
        # Follow changes made meanwhile (resolution tool, plugging in)
        self.sig = Gdk.Screen.get_default().connect("monitors-changed",
                                                    lambda _s: GLib.timeout_add(500, self.reload))
        self.connect("destroy", lambda _w: Gdk.Screen.get_default().disconnect(self.sig))
        self.show_all()

    def reload(self):
        self.outs = firox_monitors.outputs()
        self.main = firox_monitors.main_name(self.outs)
        if self.pending is None or not any(o["name"] == self.pending and o["enabled"]
                                           for o in self.outs):
            self.pending = self.main
        self.numbers = {o["name"]: n for n, o in firox_monitors.numbered(self.outs)}
        on = [o for o in self.outs if o["enabled"]]
        if self.selected not in self.numbers:
            self.selected = self.pending
        self.updating = True
        self.combo.remove_all()
        for o in sorted(on, key=lambda o: self.numbers[o["name"]]):
            self.combo.append(o["name"], f"{self.numbers[o['name']]}. {o['description']}")
        if self.selected:
            self.combo.set_active_id(self.selected)
        self.updating = False
        self.update_controls()
        self.area.queue_draw()
        return False

    def update_controls(self):
        o = next((o for o in self.outs if o["name"] == self.selected), None)
        many = sum(x["enabled"] for x in self.outs) > 1
        self.updating = True
        is_main = o is not None and o["name"] == self.pending
        self.main_check.set_active(is_main)
        # Like Windows: you choose a new main display rather than "un-main" one
        self.main_check.set_sensitive(many and not is_main)
        self.updating = False
        if o is None:
            self.details.set_text("No monitors found.")
            self.note.set_text("")
            return
        self.details.set_text(f"{o['name']}, {o['mode'] or 'unknown resolution'}")
        if not many:
            self.note.set_text("This is your only monitor. Connect another one to extend your desktop.")
        elif is_main:
            self.note.set_text("To use another monitor as the main display, select it and tick this.")
        else:
            self.note.set_text("It extends your desktop, with its own taskbar showing the "
                               "windows on it (Settings \u2192 Taskbar).")

    # ---- the picture of the monitors
    def layout(self):
        """[(output, x, y, w, h)] in widget coordinates."""
        on = [o for o in self.outs if o["enabled"] and o["width"] and o["height"]]
        if not on:
            return []
        alloc = self.area.get_allocation()
        x0 = min(o["x"] for o in on)
        y0 = min(o["y"] for o in on)
        x1 = max(o["x"] + o["width"] for o in on)
        y1 = max(o["y"] + o["height"] for o in on)
        pad = 18
        k = min((alloc.width - 2 * pad) / max(1, x1 - x0), (alloc.height - 2 * pad) / max(1, y1 - y0))
        ox = (alloc.width - (x1 - x0) * k) / 2
        oy = (alloc.height - (y1 - y0) * k) / 2
        return [(o, ox + (o["x"] - x0) * k, oy + (o["y"] - y0) * k, o["width"] * k, o["height"] * k)
                for o in on]

    def on_draw(self, widget, cr):
        ctx = widget.get_style_context()
        fg = ctx.get_color(Gtk.StateFlags.NORMAL)
        for o, x, y, w, h in self.layout():
            sel = o["name"] == self.selected
            cr.rectangle(x + 2, y + 2, w - 4, h - 4)
            if sel:
                cr.set_source_rgb(0.19, 0.42, 0.86)
            else:
                cr.set_source_rgb(0.42, 0.55, 0.75)
            cr.fill_preserve()
            cr.set_line_width(3 if sel else 1.5)
            cr.set_source_rgb(0.08, 0.12, 0.25)
            cr.stroke()
            # The main display's taskbar along the bottom
            if o["name"] == self.pending:
                cr.rectangle(x + 3, y + h - 3 - max(4, h * 0.07), w - 6, max(4, h * 0.07))
                cr.set_source_rgba(0.1, 0.1, 0.12, 0.85)
                cr.fill()
            num = str(self.numbers.get(o["name"], "?"))
            cr.set_source_rgb(1, 1, 1)
            cr.select_font_face("Sans", 0, 1)
            cr.set_font_size(max(14, min(w, h) * 0.38))
            ext = cr.text_extents(num)
            cr.move_to(x + (w - ext.width) / 2 - ext.x_bearing, y + (h - ext.height) / 2 - ext.y_bearing)
            cr.show_text(num)
        if not self.layout():
            cr.set_source_rgba(fg.red, fg.green, fg.blue, 0.6)
            cr.move_to(16, 30)
            cr.show_text("No monitors found")
        return False

    def on_click(self, _w, event):
        for o, x, y, w, h in self.layout():
            if x <= event.x <= x + w and y <= event.y <= y + h:
                self.selected = o["name"]
                self.updating = True
                self.combo.set_active_id(o["name"])
                self.updating = False
                self.update_controls()
                self.area.queue_draw()
                break
        return True

    def on_combo(self, combo):
        if self.updating:
            return
        self.selected = combo.get_active_id()
        self.update_controls()
        self.area.queue_draw()

    def on_main_toggled(self, check):
        if self.updating or not check.get_active() or not self.selected:
            return
        self.pending = self.selected
        self.update_controls()
        self.area.queue_draw()

    # ---- Identify: a big number on each monitor
    def identify(self):
        display = Gdk.Display.get_default()
        wins = []
        for o in self.outs:
            mon = firox_monitors.gdk_monitor_for(display, o) if o["enabled"] else None
            if mon is None:
                continue
            win = Gtk.Window()
            win.set_decorated(False)
            GtkLayerShell.init_for_window(win)
            GtkLayerShell.set_namespace(win, "firox-identify")
            GtkLayerShell.set_layer(win, GtkLayerShell.Layer.OVERLAY)
            GtkLayerShell.set_monitor(win, mon)
            GtkLayerShell.set_anchor(win, GtkLayerShell.Edge.TOP, True)
            GtkLayerShell.set_anchor(win, GtkLayerShell.Edge.LEFT, True)
            GtkLayerShell.set_margin(win, GtkLayerShell.Edge.TOP, 40)
            GtkLayerShell.set_margin(win, GtkLayerShell.Edge.LEFT, 40)
            lab = Gtk.Label()
            main = "  (main)" if o["name"] == self.main else ""
            lab.set_markup(f"<span size='72000' weight='bold'>{self.numbers.get(o['name'], '?')}</span>"
                           f"<span size='16000'>{GLib.markup_escape_text(main)}</span>")
            lab.set_margin_start(28)
            lab.set_margin_end(28)
            lab.set_margin_top(8)
            lab.set_margin_bottom(8)
            win.add(lab)
            win.show_all()
            wins.append(win)
        GLib.timeout_add(3000, lambda: [w.destroy() for w in wins] and False)

    def apply(self):
        if self.pending and self.pending != self.main:
            subprocess.run(["firox-displays", "main", self.pending], check=False)


THUMB_POOL = concurrent.futures.ThreadPoolExecutor(max_workers=3)


class BackgroundDialog(Gtk.Dialog):
    """XP-style Desktop tab: a preview monitor, the wallpapers, position,
    colour and which icons are on the desktop (firox-desktop)."""

    FOLDERS = ["/usr/share/backgrounds/firox", "/usr/share/backgrounds/fedora-workstation",
               "/usr/share/backgrounds/f44/default", "/usr/share/backgrounds/images"]
    NAMES = {"default.svg": "Firox Classic", "modern.svg": "Firox Modern", "glass.svg": "Firox Glass"}
    EXTS = (".svg", ".png", ".jpg", ".jpeg", ".webp", ".jxl", ".bmp", ".gif", ".tif", ".tiff")

    def __init__(self, parent):
        super().__init__(title="Desktop Background", transient_for=parent, modal=True)
        self.add_button("Cancel", Gtk.ResponseType.CANCEL)
        self.add_button("Apply", Gtk.ResponseType.APPLY)
        self.set_default_size(620, 640)
        self.settings = firox_wallpaper.read()
        self.cache = {}
        box = self.get_content_area()
        box.set_spacing(10)
        box.set_border_width(16)

        self.preview = Gtk.DrawingArea()
        self.preview.set_size_request(280, 180)
        self.preview.set_halign(Gtk.Align.CENTER)
        self.preview.connect("draw", self.on_preview)
        box.pack_start(self.preview, False, False, 0)

        box.pack_start(Gtk.Label(label="Background:", xalign=0), False, False, 0)
        self.flow = Gtk.FlowBox()
        self.flow.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.flow.set_max_children_per_line(6)
        self.flow.set_min_children_per_line(2)
        self.flow.set_homogeneous(True)
        self.flow.set_column_spacing(6)
        self.flow.set_row_spacing(6)
        self.flow.connect("child-activated", self.on_picked)
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.set_min_content_height(190)
        scroll.set_shadow_type(Gtk.ShadowType.IN)
        scroll.add(self.flow)
        box.pack_start(scroll, True, True, 0)

        row = Gtk.Box(spacing=8)
        browse = Gtk.Button(label="Browse\u2026")
        browse.connect("clicked", self.on_browse)
        row.pack_start(browse, False, False, 0)
        row.pack_start(Gtk.Label(label="Position:"), False, False, 6)
        self.mode = Gtk.ComboBoxText()
        for key, label in firox_wallpaper.MODES:
            self.mode.append(key, label)
        self.mode.set_active_id(self.settings.get("WallpaperMode") or "zoom")
        if self.mode.get_active_id() is None:
            self.mode.set_active_id("zoom")
        self.mode.connect("changed", lambda c: self.update(WallpaperMode=c.get_active_id()))
        row.pack_start(self.mode, False, False, 0)
        row.pack_start(Gtk.Label(label="Colour:"), False, False, 6)
        self.color = Gtk.ColorButton.new_with_rgba(firox_wallpaper.rgba(self.settings.get("BgColor")))
        self.color.set_tooltip_text("Shown around or instead of the picture")
        self.color.connect("color-set", self.on_color)
        row.pack_start(self.color, False, False, 0)
        box.pack_start(row, False, False, 0)

        box.pack_start(Gtk.Label(label="Desktop icons:", xalign=0), False, False, 4)
        icons = Gtk.Box(spacing=14)
        self.shortcuts = {}
        on = firox_wallpaper.shortcuts(self.settings)
        for key, label in firox_wallpaper.SHORTCUTS:
            cb = Gtk.CheckButton(label=label)
            cb.set_active(key in on)
            icons.pack_start(cb, False, False, 0)
            self.shortcuts[key] = cb
        box.pack_start(icons, False, False, 0)
        note = Gtk.Label(xalign=0, wrap=True, max_width_chars=70,
                         label="The wallpaper is on every monitor; the icons are on the main display "
                               "(Settings \u2192 Display). Files you put in your Desktop folder show up there too.")
        note.get_style_context().add_class("dim-label")
        box.pack_start(note, False, False, 0)

        self.fill()
        self.show_all()

    # ---- the list of pictures
    def pictures(self):
        seen, out = set(), []
        for folder in self.FOLDERS:
            try:
                names = sorted(os.listdir(folder))
            except OSError:
                continue
            for name in names:
                path = os.path.join(folder, name)
                if name.lower().endswith(self.EXTS) and os.path.isfile(path) and path not in seen:
                    seen.add(path)
                    out.append(path)
        cur = self.settings.get("Wallpaper") or ""
        if cur and cur not in seen and os.path.isfile(cur):
            out.insert(0, cur)
        return out

    def label_for(self, path):
        name = os.path.basename(path)
        if path.startswith("/usr/share/backgrounds/firox/") and name in self.NAMES:
            return self.NAMES[name]
        stem = os.path.splitext(name)[0].replace("_", " ").replace("-", " ")
        return stem[:1].upper() + stem[1:]

    def fill(self):
        cur = self.settings.get("Wallpaper") or ""
        entries = [(None, "(None)")] + [(p, self.label_for(p)) for p in self.pictures()]
        for path, label in entries:
            child = Gtk.FlowBoxChild()
            child.path = path
            col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
            img = Gtk.Image()
            img.set_size_request(120, 68)
            if path is None:
                img.set_from_icon_name("image-missing", Gtk.IconSize.DIALOG)
            else:
                self.load_thumb(img, path)
            col.pack_start(img, False, False, 0)
            lab = Gtk.Label(label=label, ellipsize=3, max_width_chars=16)
            col.pack_start(lab, False, False, 0)
            child.add(col)
            child.set_tooltip_text(path or "Just the colour")
            self.flow.add(child)
            if path == (cur or None):
                # After the window is up (the list would select its first item)
                GLib.idle_add(lambda c=child: self.flow.select_child(c) or c.grab_focus() or False)

    @staticmethod
    def load_thumb(img, path):
        """Thumbnails load in a background thread (some formats are slow to
        decode), so the window opens straight away and they fill in."""
        def work():
            try:
                pix = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, 120, 68, True)
            except GLib.Error:
                pix = None
            GLib.idle_add(show, pix)

        def show(pix):
            if pix is not None:
                img.set_from_pixbuf(pix)
            else:
                img.set_from_icon_name("image-x-generic", Gtk.IconSize.DIALOG)
            return False
        THUMB_POOL.submit(work)

    # ---- changes (shown in the preview, saved on Apply)
    def update(self, **kw):
        self.settings.update({k: v for k, v in kw.items() if v is not None})
        self.preview.queue_draw()

    def on_picked(self, _flow, child):
        self.update(Wallpaper=child.path or "")

    def on_color(self, btn):
        c = btn.get_rgba()
        self.update(BgColor="#%02x%02x%02x" % (round(c.red * 255), round(c.green * 255), round(c.blue * 255)))

    def on_browse(self, _btn):
        dlg = Gtk.FileChooserNative.new("Choose a picture", self, Gtk.FileChooserAction.OPEN, "_Open", "_Cancel")
        filt = Gtk.FileFilter()
        filt.set_name("Pictures")
        filt.add_pixbuf_formats()
        dlg.add_filter(filt)
        pictures = GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_PICTURES)
        if pictures and os.path.isdir(pictures):
            dlg.set_current_folder(pictures)
        if dlg.run() == Gtk.ResponseType.ACCEPT:
            path = dlg.get_filename()
            if path:
                self.update(Wallpaper=path)
                self.flow.unselect_all()
        dlg.destroy()

    def on_preview(self, widget, cr):
        a = widget.get_allocation()
        # A little monitor: bezel, then the screen in 16:9
        bw, bh = 260, 160
        x0, y0 = (a.width - bw) / 2, 4
        cr.set_source_rgb(0.16, 0.17, 0.2)
        cr.rectangle(x0, y0, bw, bh)
        cr.fill()
        cr.rectangle(x0 + bw / 2 - 30, y0 + bh, 60, 10)
        cr.fill()
        sx, sy, sw, sh = x0 + 8, y0 + 8, bw - 16, bh - 16
        cr.save()
        cr.rectangle(sx, sy, sw, sh)
        cr.clip()
        cr.translate(sx, sy)
        mon_w, mon_h = 1920, 1080
        cr.scale(sw / mon_w, sh / mon_h)
        firox_wallpaper.paint(cr, mon_w, mon_h, self.settings, self.cache)
        cr.restore()
        return False

    def apply(self):
        on = [key for key, _label in firox_wallpaper.SHORTCUTS if self.shortcuts[key].get_active()]
        firox_wallpaper.write({"Wallpaper": self.settings.get("Wallpaper") or "",
                               "WallpaperMode": self.settings.get("WallpaperMode") or "zoom",
                               "BgColor": self.settings.get("BgColor") or "#3a3c3f",
                               "DesktopShortcuts": ",".join(on)})


def nightlight_module():
    """firox-nightlight's functions (settings, sunrise and sunset)."""
    import importlib.machinery
    import importlib.util
    path = GLib.find_program_in_path("firox-nightlight") or "/usr/bin/firox-nightlight"
    loader = importlib.machinery.SourceFileLoader("firox_nightlight", path)
    spec = importlib.util.spec_from_loader("firox_nightlight", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


class NightLightDialog(Gtk.Dialog):
    """Night Light: warmer colours in the evening (firox-nightlight)."""

    WARMTH = (2500, 5500)          # kelvin: warmest, least warm

    def __init__(self, parent):
        super().__init__(title="Night Light", transient_for=parent, modal=True)
        self.add_button("Cancel", Gtk.ResponseType.CANCEL)
        self.add_button("Apply", Gtk.ResponseType.APPLY)
        self.set_default_size(440, -1)
        self.nl = nightlight_module()
        self.conf = self.nl.load_conf()
        box = self.get_content_area()
        box.set_spacing(10)
        box.set_border_width(16)
        header = Gtk.Box(spacing=12)
        header.pack_start(Gtk.Image.new_from_icon_name("redshift", Gtk.IconSize.DIALOG), False, False, 0)
        intro = Gtk.Label(xalign=0, wrap=True, max_width_chars=46,
                          label="Night Light makes the screen's colours warmer in the evening, which is "
                                "easier on your eyes at night. Click the moon on the taskbar to turn it "
                                "on or off at any time.")
        header.pack_start(intro, True, True, 0)
        box.pack_start(header, False, False, 0)

        self.now_button = Gtk.Button()
        self.now_button.set_halign(Gtk.Align.START)
        self.now_button.connect("clicked", self.on_now)
        box.pack_start(self.now_button, False, False, 0)
        self.sync_now()

        t = Gtk.Label(xalign=0)
        t.set_markup("<b>Schedule</b>")
        box.pack_start(t, False, False, 4)
        sched = self.conf.get("SCHEDULE", "manual")
        self.r_manual = Gtk.RadioButton.new_with_label(None, "Only when I turn it on")
        self.r_sun = Gtk.RadioButton.new_with_label_from_widget(self.r_manual, "From sunset to sunrise")
        self.r_times = Gtk.RadioButton.new_with_label_from_widget(self.r_manual, "At set times")
        box.pack_start(self.r_manual, False, False, 0)
        box.pack_start(self.r_sun, False, False, 0)
        self.sun_note = Gtk.Label(xalign=0, wrap=True, max_width_chars=46)
        self.sun_note.set_margin_start(26)
        self.sun_note.get_style_context().add_class("dim-label")
        self.sun_note.set_text(self.sun_text())
        box.pack_start(self.sun_note, False, False, 0)
        box.pack_start(self.r_times, False, False, 0)
        times = Gtk.Box(spacing=8)
        times.set_margin_start(26)
        self.c_from = self.time_combo(self.conf.get("FROM", "21:00"))
        self.c_to = self.time_combo(self.conf.get("TO", "07:00"))
        times.pack_start(Gtk.Label(label="From"), False, False, 0)
        times.pack_start(self.c_from, False, False, 0)
        times.pack_start(Gtk.Label(label="to"), False, False, 0)
        times.pack_start(self.c_to, False, False, 0)
        box.pack_start(times, False, False, 0)
        {"sun": self.r_sun, "times": self.r_times}.get(sched, self.r_manual).set_active(True)
        for r in (self.r_manual, self.r_sun, self.r_times):
            r.connect("toggled", lambda *_: times.set_sensitive(self.r_times.get_active()))
        times.set_sensitive(self.r_times.get_active())

        t = Gtk.Label(xalign=0)
        t.set_markup("<b>Warmth</b>")
        box.pack_start(t, False, False, 4)
        row = Gtk.Box(spacing=8)
        lo, hi = self.WARMTH
        # left: least warm, right: warmest
        self.scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, hi - lo, 100)
        self.scale.set_draw_value(False)
        self.scale.set_value(hi - self.nl.temp(self.conf))
        row.pack_start(Gtk.Label(label="Less warm"), False, False, 0)
        row.pack_start(self.scale, True, True, 0)
        row.pack_start(Gtk.Label(label="Warmer"), False, False, 0)
        box.pack_start(row, False, False, 0)
        self.show_all()

    def time_combo(self, value):
        combo = Gtk.ComboBoxText()
        h0, m0 = self.nl.hhmm(value, (21, 0))
        best = 0
        for i in range(48):
            h, m = divmod(i * 30, 60)
            combo.append(f"{h:02d}:{m:02d}", self.nl.clock(h, m))
            if (h, m) <= (h0, m0):
                best = i
        combo.set_active(best)
        return combo

    def sun_text(self):
        loc = self.nl.location(self.conf)
        if not loc:
            return "Your time zone isn't known, so sunset can't be worked out. Set it in Date and Time."
        lat, lon, where = loc
        import datetime
        times = self.nl.sun_times(datetime.date.today(), lat, lon)
        if not times:
            return f"The sun doesn't set or rise today in {where}."
        rise, sset = times
        return (f"Today in {where}: sunset at {self.nl.clock_ts(sset)}, sunrise at {self.nl.clock_ts(rise)}. "
                "(Set your city in the Weather gadget to be more exact.)")

    def sync_now(self):
        _args, warm, _tip = self.nl.plan()
        self.now_button.set_label("Turn off now" if warm else "Turn on now")

    def on_now(self, _b):
        subprocess.run(["firox-nightlight", "toggle"], timeout=10)
        GLib.timeout_add(300, lambda: self.sync_now() or False)

    def apply(self):
        before = self.conf.get("SCHEDULE", "manual")
        self.conf["SCHEDULE"] = "sun" if self.r_sun.get_active() else \
            "times" if self.r_times.get_active() else "manual"
        if self.conf["SCHEDULE"] != before:
            self.nl.save_override("", 0)    # a new schedule starts fresh
        self.conf["FROM"] = self.c_from.get_active_id() or "21:00"
        self.conf["TO"] = self.c_to.get_active_id() or "07:00"
        self.conf["TEMP"] = str(int(self.WARMTH[1] - self.scale.get_value()))
        self.nl.save_conf(self.conf)
        spawn(["firox-nightlight", "reload"])



class PowerDialog(Gtk.Dialog):
    """XP-style Power Options: idle timers for the monitor, lock and sleep."""

    def __init__(self, parent):
        super().__init__(title="Power Options", transient_for=parent, modal=True)
        self.add_button("Cancel", Gtk.ResponseType.CANCEL)
        self.add_button("Apply", Gtk.ResponseType.APPLY)
        self.set_default_size(420, -1)
        box = self.get_content_area()
        box.set_spacing(10)
        box.set_border_width(16)
        header = Gtk.Box(spacing=12)
        header.pack_start(Gtk.Image.new_from_icon_name("preferences-system-power", Gtk.IconSize.DIALOG),
                          False, False, 0)
        intro = Gtk.Label(xalign=0, wrap=True, max_width_chars=44,
                          label="Save power by turning off the monitor or putting the computer "
                                "to sleep when you're not using it. Videos and full-screen apps "
                                "keep the screen on.")
        header.pack_start(intro, True, True, 0)
        box.pack_start(header, False, False, 0)

        self.values = {}
        for line in run_text(["firox-power"]).splitlines():
            if "=" in line and not line.startswith("#"):
                k, v = line.split("=", 1)
                self.values[k] = int(v) if v.isdigit() else 0
        self.before = dict(self.values)
        battery = has_battery()

        grid = Gtk.Grid(column_spacing=12, row_spacing=8)
        cols = [("AC", "Plugged in")] + ([("BATTERY", "On battery")] if battery else [])
        if battery:
            for i, (_k, title) in enumerate(cols):
                t = Gtk.Label(xalign=0)
                t.set_markup(f"<b>{title}</b>")
                grid.attach(t, i + 1, 0, 1, 1)
        rows = [("MONITOR", "Turn off the monitor:"), ("SLEEP", "Put the computer to sleep:")]
        for r, (key, label) in enumerate(rows, start=1):
            grid.attach(Gtk.Label(label=label, xalign=0), 0, r, 1, 1)
            for i, (suffix, _t) in enumerate(cols):
                grid.attach(self.combo(f"{key}_{suffix}"), i + 1, r, 1, 1)
        grid.attach(Gtk.Label(label="Lock the screen:", xalign=0), 0, 3, 1, 1)
        grid.attach(self.combo("LOCK"), 1, 3, 1, 1)
        box.pack_start(grid, False, False, 0)

        wake = Gtk.CheckButton(label="Ask for my password when the computer wakes up")
        wake.set_active(self.values.get("LOCK_ON_WAKE", 1) == 1)
        wake.connect("toggled", lambda b: self.values.__setitem__("LOCK_ON_WAKE", int(b.get_active())))
        box.pack_start(wake, False, False, 0)

        if battery:
            box.pack_start(Gtk.Separator(), False, False, 4)
            title = Gtk.Label(xalign=0)
            title.set_markup("<b>Battery</b>")
            box.pack_start(title, False, False, 0)
            bgrid = Gtk.Grid(column_spacing=12, row_spacing=8)
            bgrid.attach(Gtk.Label(label="Warn me when it's down to:", xalign=0), 0, 0, 1, 1)
            bgrid.attach(self.percent_combo("BATTERY_LOW", [0, 5, 10, 15, 20, 25, 30]), 1, 0, 1, 1)
            bgrid.attach(Gtk.Label(label="Warn me again, urgently, at:", xalign=0), 0, 1, 1, 1)
            bgrid.attach(self.percent_combo("BATTERY_CRITICAL", [0, 3, 4, 5, 6, 7, 8, 10]), 1, 1, 1, 1)
            bgrid.attach(Gtk.Label(label="When it reaches", xalign=0), 0, 2, 1, 1)
            row = Gtk.Box(spacing=8)
            row.pack_start(self.percent_combo("BATTERY_ACTION", [1, 2, 3, 4, 5], off=False), False, False, 0)
            kinds = [(0, "do nothing"), (1, "go to sleep")]
            if can_hibernate():
                kinds.append((2, "hibernate"))
            kinds.append((3, "shut down"))
            kind = Gtk.ComboBoxText()
            for k, label in kinds:
                kind.append(str(k), label)
            kind.set_active_id(str(self.values.get("BATTERY_ACTION_KIND", 1)))
            if kind.get_active_id() is None:
                kind.set_active_id("1")
            kind.connect("changed", lambda w: self.values.__setitem__("BATTERY_ACTION_KIND", int(w.get_active_id())))
            row.pack_start(kind, False, False, 0)
            bgrid.attach(row, 1, 2, 1, 1)
            box.pack_start(bgrid, False, False, 0)
        self.show_all()

    def percent_combo(self, key, choices, off=True):
        cur = self.values.get(key, 0)
        if cur not in choices:
            choices = sorted(choices + [cur])
        c = Gtk.ComboBoxText()
        for p in choices:
            c.append(str(p), "Off" if p == 0 and off else f"{p}%")
        c.set_active_id(str(cur))
        c.connect("changed", lambda w: self.values.__setitem__(key, int(w.get_active_id())))
        return c

    def combo(self, key):
        cur = self.values.get(key, 0)
        choices = POWER_CHOICES if cur in POWER_CHOICES else sorted(POWER_CHOICES[:-1] + [cur]) + [0]
        c = Gtk.ComboBoxText()
        for m in choices:
            c.append(str(m), minutes_label(m))
        c.set_active_id(str(cur))
        c.connect("changed", lambda w: self.values.__setitem__(key, int(w.get_active_id())))
        return c

    def apply(self):
        changed = [f"{k}={v}" for k, v in self.values.items() if self.before.get(k) != v]
        if changed:
            subprocess.run(["firox-power", "set"] + changed)


PICTURES_DIR = "/usr/share/firox/pictures"
FACE = os.path.expanduser("~/.face")
DEFAULT_FACE = "/usr/share/firox/icons/user-default.svg"
FACE_SIZE = 256


def display_name():
    try:
        e = pwd.getpwuid(os.getuid())
        return e.pw_gecos.split(",")[0].strip() or e.pw_name
    except KeyError:
        return GLib.get_user_name()


def square_pixbuf(path, size):
    """Load an image, centre-crop it to a square and scale it to size x size."""
    if path.lower().endswith(".svg"):
        return GdkPixbuf.Pixbuf.new_from_file_at_scale(path, size, size, True)
    pb = GdkPixbuf.Pixbuf.new_from_file(path)
    pb = pb.apply_embedded_orientation() or pb
    side = min(pb.get_width(), pb.get_height())
    pb = pb.new_subpixbuf((pb.get_width() - side) // 2, (pb.get_height() - side) // 2, side, side)
    return pb.scale_simple(size, size, GdkPixbuf.InterpType.HYPER)


class AccountsDialog(Gtk.Dialog):
    """XP-style User Accounts: change your picture (saved to ~/.face, which
    the Start menu shows) or your password."""

    def __init__(self, parent):
        super().__init__(title="User Accounts", transient_for=parent, modal=True)
        self.add_button("Cancel", Gtk.ResponseType.CANCEL)
        self.apply_btn = self.add_button("Change Picture", Gtk.ResponseType.APPLY)
        self.apply_btn.set_sensitive(False)
        self.set_default_size(520, -1)
        self.choice = None
        box = self.get_content_area()
        box.set_spacing(12)
        box.set_border_width(16)

        top = Gtk.Box(spacing=14)
        self.preview = Gtk.Image()
        self._show_preview(FACE if os.path.isfile(FACE) else DEFAULT_FACE)
        top.pack_start(self.preview, False, False, 0)
        info = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        info.set_valign(Gtk.Align.CENTER)
        name = Gtk.Label(xalign=0)
        name.set_markup(f"<span size='large' weight='bold'>{GLib.markup_escape_text(display_name())}</span>")
        info.pack_start(name, False, False, 0)
        info.pack_start(Gtk.Label(label="Pick a new picture for your account. It appears in the Start menu.",
                                  xalign=0, wrap=True, max_width_chars=40), False, False, 0)
        pw = Gtk.Button(label="Change my password\u2026")
        pw.set_halign(Gtk.Align.START)
        pw.connect("clicked", lambda *_: spawn(["firox-terminal", "-T", "Change Password", "-x", "sh", "-c",
                                                "passwd; echo; read -r -p 'Press Enter to close' _"]))
        info.pack_start(pw, False, False, 0)
        top.pack_start(info, True, True, 0)
        box.pack_start(top, False, False, 0)

        flow = Gtk.FlowBox()
        flow.set_selection_mode(Gtk.SelectionMode.SINGLE)
        flow.set_max_children_per_line(5)
        flow.set_min_children_per_line(5)
        flow.set_column_spacing(6)
        flow.set_row_spacing(6)
        for path in sorted(glob.glob(os.path.join(PICTURES_DIR, "*.svg")) +
                           glob.glob(os.path.join(PICTURES_DIR, "*.png"))):
            child = Gtk.FlowBoxChild()
            try:
                child.add(Gtk.Image.new_from_pixbuf(square_pixbuf(path, 64)))
            except GLib.Error:
                continue
            child.path = path
            child.set_tooltip_text(os.path.splitext(os.path.basename(path))[0].title())
            flow.add(child)
        flow.connect("child-activated", lambda _f, c: self._choose(c.path))
        box.pack_start(flow, False, False, 0)

        browse = Gtk.Button(label="Browse for more pictures\u2026")
        browse.set_halign(Gtk.Align.START)
        browse.connect("clicked", self._browse)
        box.pack_start(browse, False, False, 0)
        self.show_all()

    def _show_preview(self, path):
        try:
            self.preview.set_from_pixbuf(square_pixbuf(path, 96))
        except GLib.Error:
            self.preview.set_from_icon_name("avatar-default", Gtk.IconSize.DIALOG)

    def _choose(self, path):
        self.choice = path
        self._show_preview(path)
        self.apply_btn.set_sensitive(True)

    def _browse(self, *_):
        chooser = Gtk.FileChooserDialog(title="Choose a picture", transient_for=self,
                                        action=Gtk.FileChooserAction.OPEN)
        chooser.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Open", Gtk.ResponseType.ACCEPT)
        flt = Gtk.FileFilter()
        flt.set_name("Pictures")
        flt.add_pixbuf_formats()
        chooser.add_filter(flt)
        pictures = GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_PICTURES)
        if pictures and os.path.isdir(pictures):
            chooser.set_current_folder(pictures)
        if chooser.run() == Gtk.ResponseType.ACCEPT:
            path = chooser.get_filename()
            try:
                square_pixbuf(path, 32)
                self._choose(path)
            except GLib.Error as err:
                msg = Gtk.MessageDialog(transient_for=self, message_type=Gtk.MessageType.ERROR,
                                        buttons=Gtk.ButtonsType.OK, text="That file isn't a picture Firox can read.")
                msg.format_secondary_text(err.message)
                msg.run()
                msg.destroy()
        chooser.destroy()

    def apply(self):
        if not self.choice:
            return
        pb = square_pixbuf(self.choice, FACE_SIZE)
        tmp = FACE + ".tmp"
        pb.savev(tmp, "png", [], [])
        os.chmod(tmp, 0o644)
        os.replace(tmp, FACE)
        # Show it on the login screen too
        subprocess.Popen(["/usr/libexec/firox/account-picture", "--force"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


class ControlPanel(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Settings")
        self.set_default_size(820, 560)
        self.set_icon_name("preferences-system")

        self.provider = Gtk.CssProvider()
        Gtk.StyleContext.add_provider_for_screen(self.get_screen(), self.provider,
                                                 Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        self.reload_theme()

        root = Gtk.Box()
        self.add(root)

        sidebar = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        sidebar.set_name("sidebar")
        sidebar.set_size_request(200, -1)
        sidebar.pack_start(self._panel("See Also", [
            ("Help and Support", ["firox-open", "help"]),
            ("System Update", ["firox-open", "update"]),
            ("Computer", ["firox-open", "computer"]),
        ]), False, False, 0)
        root.pack_start(sidebar, False, False, 0)

        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        content.set_name("content")
        heading = Gtk.Label(label="Settings", xalign=0)
        heading.set_name("heading")
        content.pack_start(heading, False, False, 0)

        flow = Gtk.FlowBox()
        flow.set_valign(Gtk.Align.START)
        flow.set_selection_mode(Gtk.SelectionMode.NONE)
        flow.set_activate_on_single_click(True)
        flow.set_max_children_per_line(3)
        flow.set_min_children_per_line(1)
        flow.set_column_spacing(8)
        flow.set_row_spacing(8)
        flow.set_margin_start(12)
        flow.set_margin_end(12)
        self.applets = {}
        # Alphabetical, like XP's Control Panel in Classic View
        for icon, title, desc, argv in sorted(APPLETS, key=lambda a: a[1].casefold()):
            child = Gtk.FlowBoxChild()
            row = Gtk.Box(spacing=10)
            row.set_size_request(180, -1)
            if title == "Bazaar":
                icon = bazaar_icon()
            if icon.startswith("/"):
                img = Gtk.Image.new_from_gicon(Gio.FileIcon.new(Gio.File.new_for_path(icon)),
                                               Gtk.IconSize.DIALOG)
            else:
                img = Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.DIALOG)
            img.set_pixel_size(40)
            row.pack_start(img, False, False, 0)
            text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            text.set_valign(Gtk.Align.CENTER)
            t = Gtk.Label(label=title, xalign=0, wrap=True)
            t.get_style_context().add_class("applet-title")
            d = Gtk.Label(label=desc, xalign=0, wrap=True, max_width_chars=26)
            d.get_style_context().add_class("applet-desc")
            text.pack_start(t, False, False, 0)
            text.pack_start(d, False, False, 0)
            row.pack_start(text, True, True, 0)
            child.add(row)
            child.argv = argv
            child.set_tooltip_text(desc)
            flow.add(child)
        flow.connect("child-activated", lambda _f, c: self.open_applet(c.argv))

        scroller = Gtk.ScrolledWindow()
        scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroller.add(flow)
        content.pack_start(scroller, True, True, 0)
        root.pack_start(content, True, True, 0)
        self.show_all()

    def reload_theme(self):
        try:
            self.provider.load_from_path(theme_file(current_theme(), "control-panel.css"))
        except GLib.Error as err:
            print(f"control-panel: {err.message}", file=sys.stderr)

    def _panel(self, title, links):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        t = Gtk.Label(label=title, xalign=0)
        t.get_style_context().add_class("panel-title")
        box.pack_start(t, False, False, 0)
        inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        inner.get_style_context().add_class("panel")
        for label, argv in links:
            b = Gtk.Button(label=label)
            b.get_child().set_xalign(0)
            b.connect("clicked", lambda _b, a=argv: spawn(a))
            inner.pack_start(b, False, False, 0)
        box.pack_start(inner, False, False, 0)
        return box

    def open_applet(self, argv):
        if argv == ["@appearance"]:
            dlg = AppearanceDialog(self)
            if dlg.run() == Gtk.ResponseType.APPLY:
                dlg.apply()
                self.reload_theme()
            dlg.destroy()
        elif argv == ["@screensaver"]:
            dlg = ScreenSaverDialog(self)
            if dlg.run() == Gtk.ResponseType.APPLY:
                dlg.apply()
            dlg.destroy()
        elif argv in (["@mouse"], ["@keyboard"]):
            dlg = (MouseDialog if argv == ["@mouse"] else KeyboardDialog)(self)
            if dlg.run() == Gtk.ResponseType.APPLY:
                dlg.apply()
            dlg.destroy()
        elif argv in (["@taskbar"], ["@defaults"]):
            dlg = (TaskbarDialog if argv == ["@taskbar"] else DefaultsDialog)(self)
            if dlg.run() == Gtk.ResponseType.APPLY:
                dlg.apply()
            dlg.destroy()
        elif argv == ["@clipboard"]:
            dlg = ClipboardDialog(self)
            if dlg.run() == Gtk.ResponseType.APPLY:
                dlg.apply()
            dlg.destroy()
        elif argv == ["@background"]:
            dlg = BackgroundDialog(self)
            if dlg.run() == Gtk.ResponseType.APPLY:
                dlg.apply()
            dlg.destroy()
        elif argv == ["@display"]:
            dlg = DisplayDialog(self)
            if dlg.run() == Gtk.ResponseType.APPLY:
                dlg.apply()
            dlg.destroy()
        elif argv == ["@nightlight"]:
            dlg = NightLightDialog(self)
            if dlg.run() == Gtk.ResponseType.APPLY:
                dlg.apply()
            dlg.destroy()
        elif argv == ["@power"]:
            dlg = PowerDialog(self)
            if dlg.run() == Gtk.ResponseType.APPLY:
                dlg.apply()
            dlg.destroy()
        elif argv == ["@accounts"]:
            dlg = AccountsDialog(self)
            if dlg.run() == Gtk.ResponseType.APPLY:
                dlg.apply()
            dlg.destroy()
        elif argv == ["@system"]:
            dlg = SystemDialog(self)
            dlg.run()
            dlg.destroy()
        elif argv == ["@datetime"]:
            dlg = DateTimeDialog(self)
            if dlg.run() == Gtk.ResponseType.APPLY:
                dlg.apply()
            dlg.destroy()
        else:
            spawn(argv)


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.firox.ControlPanel",
                         flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.win = None

    def do_command_line(self, cmdline):
        args = cmdline.get_arguments()[1:]
        page = args[0] if args else None
        direct = {"system": ["@system"], "datetime": ["@datetime"], "appearance": ["@appearance"],
                  "accounts": ["@accounts"], "power": ["@power"], "nightlight": ["@nightlight"],
                  "screensaver": ["@screensaver"], "clipboard": ["@clipboard"],
                  "mouse": ["@mouse"], "keyboard": ["@keyboard"],
                  "taskbar": ["@taskbar"], "defaults": ["@defaults"],
                  "display": ["@display"], "background": ["@background"],
                  "startup": ["firox-startup"]}
        if page in direct and self.win is None:
            # Open just the applet, without the panel window
            if direct[page][0].startswith("@"):
                self.hold()
                cls = {"system": SystemDialog, "datetime": DateTimeDialog,
                       "appearance": AppearanceDialog, "accounts": AccountsDialog,
                       "power": PowerDialog, "screensaver": ScreenSaverDialog,
                       "nightlight": NightLightDialog,
                       "clipboard": ClipboardDialog, "taskbar": TaskbarDialog,
                       "defaults": DefaultsDialog, "display": DisplayDialog,
                       "background": BackgroundDialog,
                       "mouse": MouseDialog, "keyboard": KeyboardDialog}[page]
                dlg = cls(None)
                if dlg.run() == Gtk.ResponseType.APPLY:
                    dlg.apply()
                dlg.destroy()
                self.release()
            else:
                spawn(direct[page])
            return 0
        if self.win is None:
            self.win = ControlPanel(self)
        self.win.present()
        if page in direct:
            self.win.open_applet(direct[page])
        return 0


if __name__ == "__main__":
    sys.exit(App().run(sys.argv))
