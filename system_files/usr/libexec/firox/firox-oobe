        self.hostname = Gtk.Entry()
        self.hostname.connect("activate", lambda _e: self.go(1))
        self.field(box, "Computer name", self.hostname, "Letters, numbers and hyphens.")
        return box

    def page_finish(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        self.finish_title = self.title("Setting up your computer…", "This takes a moment.")
        box.pack_start(self.finish_title, False, False, 0)
        self.spinner = Gtk.Spinner()
        self.spinner.set_size_request(32, 32)
        box.pack_start(self.spinner, False, False, 0)
        return box

    # ------------------------------------------------------- behaviour --
    def suggest_user(self, entry):
        if self.user_edited and self.username.get_text():
            return
        first = (entry.get_text().strip().split() or [""])[0].lower()
        slug = re.sub(r"[^a-z0-9]", "", first)
        if slug and not slug[0].isalpha():
            slug = "u" + slug
        self.username.set_text(slug[:32])
        self.user_edited = False

    def show_step(self):
        name = self.STEPS[self.index]
        self.stack.set_visible_child_name(name)
        self.error.set_text("")
        self.back.set_visible(0 < self.index < len(self.STEPS) - 1 and name != "update")
        self.next.set_visible(self.index < len(self.STEPS) - 1)
        self.next.set_label({"welcome": "_Get started", "computer": "_Finish", "update": "_Skip"}.get(name, "_Next"))
        self.next.set_use_underline(True)
        self.step_label.set_text("" if name in ("welcome", "finish") else
                                 f"Step {self.index} of {len(self.STEPS) - 2}")
        hints = {"welcome": "Let's set up your computer", "network": "Getting online", "region": "Where you are",
                 "account": "Who you are", "computer": "Almost done", "update": "The latest Firox",
                 "finish": "Getting ready"}
        self.hint.set_text(hints[name])
        if name == "network" and not hasattr(self, "is_online"):
            self.network_refresh()
        if name == "update":
            self.back.set_visible(False)
            self.start_update()
        if name == "account":
            self.fullname.grab_focus()
        if name == "computer" and not self.hostname.get_text():
            self.hostname.set_text(f"{self.username.get_text() or 'firox'}-pc")
            self.hostname.grab_focus()

    def check(self, name):
        """Why this page can't be left yet, or None."""
        if name == "region":
            tz = self.tz.get_child().get_text().strip()
            if not os.path.isfile(os.path.join("/usr/share/zoneinfo", tz)) or ".." in tz:
                return "Choose a time zone from the list."
        if name == "account":
            user = self.username.get_text().strip()
            if not self.fullname.get_text().strip():
                return "Type your name."
            if not USER_RE.match(user):
                return "The user name needs lower-case letters and numbers, starting with a letter."
            if user in RESERVED:
                return f"{user} is kept for the system: choose another user name."
            try:
                import pwd
                pwd.getpwnam(user)
                return f"There's already an account called {user}."
            except KeyError:
                pass
            pw = self.password.get_text()
            if len(pw) < min_password():
                return f"The password needs at least {min_password()} characters."
            if pw != self.password2.get_text():
                return "The two passwords aren't the same."
        if name == "computer":
            if not HOST_RE.match(self.hostname.get_text().strip()):
                return "The computer name can have letters, numbers and hyphens (not at the start or end)."
        return None

    def go(self, step):
        name = self.STEPS[self.index]
        if step > 0:
            problem = self.check(name)
            if problem:
                self.error.set_text(problem)
                return
        self.index = max(0, min(len(self.STEPS) - 1, self.index + step))
        self.show_step()
        if self.STEPS[self.index] == "finish":
            self.apply()

    # -- the latest Firox (while the account's details wait)
    def start_update(self):
        if self.updating or self.staged:
            return
        if not getattr(self, "is_online", False) and not online():
            # nothing to get it from: Firox updates itself later
            GLib.idle_add(lambda: self.go(1) or False)
            return
        self.updating = True
        if has_nvidia():
            labels = self.update_title.get_children()
            labels[0].set_text("Getting Firox with NVIDIA's driver…")
            labels[1].set_text("This computer has an NVIDIA graphics card, so it gets the version of Firox with "
                               "NVIDIA's driver built in. It restarts by itself when it's done.")
        self.update_log.set_text("Starting…")
        self.pulse = GLib.timeout_add(150, lambda: self.update_bar.pulse() or True)

        def work():
            rc, err = 1, ""
            try:
                proc = subprocess.Popen(["pkexec", APPLY], env=PKEXEC_ENV, stdin=subprocess.PIPE,
                                        stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, bufsize=1)
                proc.stdin.write(json.dumps({"update": True}))
                proc.stdin.close()
                for line in proc.stdout:
                    GLib.idle_add(self.update_line, line.rstrip("\n"))
                rc, err = proc.wait(), proc.stderr.read().strip()
            except (OSError, subprocess.SubprocessError) as e:
                err = str(e)
            GLib.idle_add(self.update_done, rc, err)
        threading.Thread(target=work, daemon=True).start()

    def update_line(self, line):
        kind, _, text = line.partition(" ")
        if kind == "STEP":
            self.update_log.set_text(text)
        elif kind == "LOG":
            m = re.search(r"(\d{1,3})%", text)
            if m and self.pulse:
                GLib.source_remove(self.pulse)
                self.pulse = None
            if m:
                self.update_bar.set_fraction(min(100, int(m.group(1))) / 100)
            self.update_log.set_text(text)
        elif kind == "RESULT":
            self.staged = text == "staged"
        elif kind == "MOK":
            self.mok = text
        return False

    def update_done(self, rc, err):
        self.updating = False
        if self.pulse:
            GLib.source_remove(self.pulse)
            self.pulse = None
        if self.STEPS[self.index] != "update":
            return False            # (skipped: it finished in the background, for the next restart)
        if rc != 0:
            self.staged = False
            self.update_log.set_text("Couldn't get it now (" + (err.splitlines()[-1] if err else "error") +
                                     "): Firox will update itself later.")
            GLib.timeout_add(3000, lambda: self.go(1) or False)
        else:
            self.update_bar.set_fraction(1.0)
            self.go(1)
        return False

    def apply(self):
        self.spinner.start()
        settings = {"user": self.username.get_text().strip(), "fullname": self.fullname.get_text().strip(),
                    "password": self.password.get_text(), "hostname": self.hostname.get_text().strip(),
                    "timezone": self.tz.get_child().get_text().strip(),
                    "layout": self.layout_codes[self.kb.get_active()] if self.kb.get_active() >= 0 else "us"}
        if self.staged:
            # restart into the update (with time to read how to enrol the key, if Secure Boot needs it)
            settings["reboot"] = 60 if self.mok else 5

        def work():
            try:
                p = subprocess.run(["pkexec", APPLY], env=PKEXEC_ENV, input=json.dumps(settings), capture_output=True,
                                   text=True, timeout=300)
                ok, msg = p.returncode == 0, (p.stderr or p.stdout).strip()
            except (OSError, subprocess.SubprocessError) as e:
                ok, msg = False, str(e)
            problem = (log_in(settings["user"], settings["password"], session_command())
                       if ok and not self.staged else None)
            GLib.idle_add(self.applied, ok, msg, problem)
        threading.Thread(target=work, daemon=True).start()

    def applied(self, ok, msg, login_problem):
        self.spinner.stop()
        if not ok:
            self.index = self.STEPS.index("computer")
            self.show_step()
            self.error.set_text("Setup couldn't finish: " + (msg.splitlines()[-1] if msg else "unknown error"))
            return False
        if self.staged:
            self.result = 3                 # (it restarts by itself: oobe-apply scheduled it)
            if self.mok:
                self.set_finish("Restarting in a minute: one more step",
                                "This computer uses Secure Boot, so NVIDIA's driver needs its key enrolled once. "
                                "After the restart a blue screen appears: choose Enroll MOK, then Continue, "
                                f"then Yes, and type the password {self.mok} (it isn't shown as you type). "
                                "Then choose Reboot. After that, log in with the account you just made.")
            else:
                self.set_finish("Restarting into the latest Firox",
                                "Then log in with the account you just made.")
            return False
        if login_problem is None:
            self.result = 0                 # greetd starts the desktop once this exits
            self.set_finish("Welcome", "Starting your desktop…")
            GLib.timeout_add(400, Gtk.main_quit)
        else:
            self.result = 3                 # the login screen asks for the password
            self.set_finish("Your computer is ready", "Log in with the account you just made.")
            GLib.timeout_add(1500, Gtk.main_quit)
        return False

    def on_key(self, _w, event):
        """Ctrl+Shift+F3, as in Windows: audit mode instead of setup."""
        mods = event.state & (Gdk.ModifierType.CONTROL_MASK | Gdk.ModifierType.SHIFT_MASK)
        if event.keyval == Gdk.KEY_F3 and mods == (Gdk.ModifierType.CONTROL_MASK | Gdk.ModifierType.SHIFT_MASK):
            self.index = self.STEPS.index("finish")
            self.show_step()
            self.set_finish("Audit mode", "Logging in as audit, to set this computer up…")
            self.spinner.start()

            def work():
                try:
                    p = subprocess.run(["pkexec", APPLY], env=PKEXEC_ENV, input=json.dumps({"audit": True}),
                                       capture_output=True, text=True, timeout=120)
                    ok, msg = p.returncode == 0, (p.stderr or p.stdout).strip()
                except (OSError, subprocess.SubprocessError) as e:
                    ok, msg = False, str(e)
                GLib.idle_add(self.audit_done, ok, msg)
            threading.Thread(target=work, daemon=True).start()
            return True
        return False

    def audit_done(self, ok, msg):
        if ok:
            self.result = 0                 # greetd restarts and logs audit in
            GLib.timeout_add(3000, Gtk.main_quit)
        else:
            self.spinner.stop()
            self.index = 0
            self.show_step()
            self.error.set_text("Audit mode couldn't start: " + (msg.splitlines()[-1] if msg else "unknown error"))
        return False

    def set_finish(self, title, sub):
        labels = self.finish_title.get_children()
        labels[0].set_text(title)
        labels[1].set_text(sub)


def main(argv):
    theme = None
    args = argv[1:]
    while args:
        a = args.pop(0)
        if a == "--theme" and args:
            theme = args.pop(0)
        else:
            print(__doc__.strip(), file=sys.stderr)
            return 2
    win = Setup(theme_name(theme))
    Gtk.main()
    return win.result


if __name__ == "__main__":
    sys.exit(main(sys.argv))
