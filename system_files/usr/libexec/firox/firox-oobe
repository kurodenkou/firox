#!/usr/bin/python3
"""
firox-oobe: first-time setup (the out-of-box experience).

Shown on the login screen instead of the list of people while
/var/lib/firox/oobe exists: after System Preparation (firox-sysprep) with
"Enter first-time setup", or after a Powerwash. It asks for

    the time zone and keyboard
    your account (name, user name, password): an administrator
    the computer's name

(Ctrl+Shift+F3 starts audit mode instead, as in Windows: see firox-sysprep)
then makes them with /usr/libexec/firox/oobe-apply (through pkexec: a polkit
rule lets the login screen run that one program, and the program only does
anything while setup is waiting) and logs you straight in through greetd.

Run by firox-greeter inside cage as the greetd user:
    firox-oobe [--theme NAME]
Exits 0 once you're logged in (greetd starts the desktop), 3 if setup is done
but the login screen should ask for the password, 1 on failure.
"""

import json
import os
import re
import shlex
import socket
import struct
import subprocess
import sys
import threading

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gdk, GLib, Gtk  # noqa: E402

THEMES = "/usr/share/firox/themes"
APPLY = "/usr/libexec/firox/oobe-apply"
ENVIRONMENTS = "/etc/greetd/environments"
MANAGED = "/var/lib/firox/policy/managed.json"
XKB_LIST = "/usr/share/X11/xkb/rules/evdev.lst"
USER_RE = re.compile(r"^[a-z_][a-z0-9_-]{0,31}$")
HOST_RE = re.compile(r"^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?$")
RESERVED = {"root", "bin", "daemon", "adm", "lp", "sync", "shutdown", "halt", "mail", "operator", "games",
            "ftp", "nobody", "greetd", "admin", "administrator", "guest", "user"}

