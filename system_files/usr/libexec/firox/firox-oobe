    def network_refresh(self, scan=False):
        """Online? Otherwise list the Wi-Fi networks (in the background: scanning takes seconds)."""
        self.net_state.set_text("Checking the connection…")

        def work():
            up = online()
            nets = [] if up and not scan else wifi_networks()
            GLib.idle_add(self.network_shown, up, nets)
        threading.Thread(target=work, daemon=True).start()

    def network_shown(self, up, nets):
        self.is_online = up
        for row in self.wifi_list.get_children():
            row.destroy()
        for ssid, signal, secured in nets:
            row = Gtk.ListBoxRow()
            row.net = (ssid, secured)
            line = Gtk.Box(spacing=8)
            line.pack_start(Gtk.Label(label=ssid, xalign=0), True, True, 0)
            info = Gtk.Label(label=f"{'🔒 ' if secured else ''}{signal}%")
            info.get_style_context().add_class("dim")
            line.pack_end(info, False, False, 0)
            row.add(line)
            self.wifi_list.add(row)
        self.wifi_list.show_all()
        if up:
            self.net_state.set_text("✓ Connected to the internet.")
        elif nets:
            self.net_state.set_text("Choose your Wi-Fi network.")
        else:
            self.net_state.set_text("Not connected. Plug in a network cable, or click Look again for Wi-Fi.")
        self.wifi_box.set_visible(bool(nets) or not up)
        return False

    def wifi_selected(self, _lb, row):
        secured = row is not None and row.net[1]
        self.wifi_password.set_visible(secured)
        if secured:
            self.wifi_password.grab_focus()

    def wifi_connect(self):
        row = self.wifi_list.get_selected_row()
        if row is None:
            self.error.set_text("Choose a Wi-Fi network first.")
            return
        ssid, secured = row.net
        cmd = ["nmcli", "device", "wifi", "connect", ssid]
        if secured:
            cmd += ["password", self.wifi_password.get_text()]
        self.error.set_text("")
        self.net_state.set_text(f"Connecting to {ssid}…")
        self.wifi_go.set_sensitive(False)

        def work():
            try:
                p = subprocess.run(cmd, capture_output=True, text=True, timeout=60)
                ok, msg = p.returncode == 0, (p.stderr or p.stdout).strip()
            except (OSError, subprocess.SubprocessError) as e:
                ok, msg = False, str(e)
            GLib.idle_add(self.wifi_connected, ssid, ok and online(), msg)
        threading.Thread(target=work, daemon=True).start()

    def wifi_connected(self, ssid, ok, msg):
        self.wifi_go.set_sensitive(True)
        self.is_online = ok
        if ok:
            self.net_state.set_text(f"✓ Connected to {ssid}.")
            self.wifi_password.set_text("")
        else:
            self.net_state.set_text(f"Couldn't connect to {ssid}.")
            self.error.set_text("Check the password and try again." if "secrets" in msg.lower() or "password" in
                                msg.lower() else (msg.splitlines()[-1] if msg else ""))
        return False

