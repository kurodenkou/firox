def theme_name(arg=None):
    name = arg
    if not name:
        try:
            with open("/etc/firox/theme") as fh:
                name = fh.read().strip()
        except OSError:
            name = "modern"
    return name if os.path.exists(os.path.join(THEMES, name or "", "welcome.css")) else "classic"


def session_command():
    try:
        with open(ENVIRONMENTS) as fh:
            for line in fh:
                if line.strip() and not line.startswith("#"):
                    return shlex.split(line.strip())
    except OSError:
        pass
    return ["firox-session"]


def min_password():
    """A policy's minimum password length (firox-policy), else 1."""
    try:
        with open(MANAGED) as fh:
            n = (json.load(fh).get("settings") or {}).get("password.min_length")
        return max(1, int(n)) if n else 1
    except (OSError, ValueError, TypeError, AttributeError):
        return 1


def timezones():
    try:
        out = subprocess.run(["timedatectl", "list-timezones"], capture_output=True, text=True,
                             timeout=10).stdout.split()
    except (OSError, subprocess.SubprocessError):
        out = []
    return out or ["UTC"]


def current_timezone():
    try:
        link = os.readlink("/etc/localtime")
        return link.split("zoneinfo/", 1)[1]
    except (OSError, IndexError):
        return "UTC"


def layouts():
    """[(code, description)] from XKB's list, else a few common ones."""
    out, inside = [], False
    try:
        with open(XKB_LIST) as fh:
            for line in fh:
                if line.startswith("!"):
                    inside = line.strip() == "! layout"
                    continue
                if inside and line.strip():
                    code, _, desc = line.strip().partition(" ")
                    out.append((code, desc.strip()))
    except OSError:
        pass
    return sorted(out, key=lambda x: x[1].lower()) or [("us", "English (US)"), ("gb", "English (UK)"),
                                                       ("de", "German"), ("fr", "French"), ("es", "Spanish")]


def current_layout():
    try:
        with open("/etc/X11/xorg.conf.d/00-keyboard.conf") as fh:
            m = re.search(r'Option\s+"XkbLayout"\s+"([^",]+)', fh.read())
            if m:
                return m.group(1)
    except OSError:
        pass
    return "us"


class Greetd:
    """Minimal greetd IPC client (as in firox-welcome)."""

    def __init__(self, path):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.connect(path)

    def request(self, msg):
        data = json.dumps(msg).encode()
        self.sock.sendall(struct.pack("=I", len(data)) + data)
        (length,) = struct.unpack("=I", self._read(4))
        return json.loads(self._read(length))

    def _read(self, n):
        buf = b""
        while len(buf) < n:
            chunk = self.sock.recv(n - len(buf))
            if not chunk:
                raise ConnectionError("greetd closed the connection")
            buf += chunk
        return buf


def log_in(user, password, session):
    """Log the new account in through greetd. None, or why not."""
    path = os.environ.get("GREETD_SOCK")
    if not path:
        return "no login service"
    try:
        g = Greetd(path)
        reply = g.request({"type": "create_session", "username": user})
        for _ in range(6):
            kind = reply.get("type")
            if kind == "success":
                break
            if kind == "auth_message":
                secret = reply.get("auth_message_type") in ("secret", "visible")
                reply = g.request({"type": "post_auth_message_response", "response": password if secret else None})
                continue
            g.request({"type": "cancel_session"})
            return reply.get("description") or "the login was refused"
        reply = g.request({"type": "start_session", "cmd": session, "env": []})
        return None if reply.get("type") == "success" else (reply.get("description") or "the desktop didn't start")
    except (OSError, ConnectionError, ValueError, KeyError) as e:
        return str(e)


class Setup(Gtk.Window):
    STEPS = ["welcome", "region", "account", "computer", "finish"]

    def __init__(self, theme):
        super().__init__(title="Set up Firox Linux")
        self.result = 1
        for css, priority in ((os.path.join(THEMES, theme, "welcome.css"), Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION),):
            p = Gtk.CssProvider()
            try:
                p.load_from_path(css)
                Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), p, priority)
            except GLib.Error:
                pass
        p = Gtk.CssProvider()
        p.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), p,
                                                 Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 1)
        self.set_name("welcome")
        self.connect("destroy", Gtk.main_quit)
        self.connect("key-press-event", self.on_key)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.add(root)
        top = Gtk.Box()
        top.set_name("topbar")
        root.pack_start(top, False, False, 0)
        line = Gtk.Box()
        line.set_name("topline")
        root.pack_start(line, False, False, 0)
        middle = Gtk.Box()
        middle.set_name("middle")
        root.pack_start(middle, True, True, 0)

        left = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        left.set_name("left")
        left.set_valign(Gtk.Align.CENTER)
        logo = Gtk.Label(label="firox", xalign=1)
        logo.set_name("logo")
        left.pack_start(logo, False, False, 0)
        self.hint = Gtk.Label(label="Let's set up your computer", xalign=1)
        self.hint.set_name("hint")
        left.pack_start(self.hint, False, False, 0)
        middle.pack_start(left, True, True, 0)
        divider = Gtk.Box()
        divider.set_name("divider")
        middle.pack_start(divider, False, False, 0)

        right = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        right.set_name("right")
        right.set_valign(Gtk.Align.CENTER)
        right.set_halign(Gtk.Align.START)
        middle.pack_start(right, True, True, 0)
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        card.set_name("card")
        card.set_size_request(460, -1)
        right.pack_start(card, False, False, 0)
        self.step_label = Gtk.Label(xalign=0)
        self.step_label.get_style_context().add_class("step")
        card.pack_start(self.step_label, False, False, 0)
        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.SLIDE_LEFT_RIGHT,
                               vhomogeneous=False)
        card.pack_start(self.stack, False, False, 0)
        self.error = Gtk.Label(xalign=0, wrap=True, max_width_chars=50)
        self.error.get_style_context().add_class("error")
        card.pack_start(self.error, False, False, 0)
        buttons = Gtk.Box(spacing=8)
        self.back = Gtk.Button.new_with_mnemonic("_Back")
        self.back.set_no_show_all(True)
        self.back.connect("clicked", lambda _b: self.go(-1))
        self.next = Gtk.Button.new_with_mnemonic("_Next")
        self.next.set_no_show_all(True)
        self.next.get_style_context().add_class("suggested-action")
        self.next.connect("clicked", lambda _b: self.go(1))
        buttons.pack_end(self.next, False, False, 0)
        buttons.pack_end(self.back, False, False, 0)
        card.pack_start(buttons, False, False, 0)

        self.stack.add_named(self.page_welcome(), "welcome")
