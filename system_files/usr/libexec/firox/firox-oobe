    # ---------------------------------------------------------- pages --
    @staticmethod
    def title(text, sub):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        t = Gtk.Label(label=text, xalign=0, wrap=True)
        t.get_style_context().add_class("title")
        box.pack_start(t, False, False, 0)
        if sub:
            s = Gtk.Label(label=sub, xalign=0, wrap=True, max_width_chars=52)
            s.get_style_context().add_class("dim")
            box.pack_start(s, False, False, 0)
        return box

    @staticmethod
    def field(box, label, widget, note=None):
        lab = Gtk.Label(label=label, xalign=0)
        box.pack_start(lab, False, False, 0)
        box.pack_start(widget, False, False, 0)
        if note:
            n = Gtk.Label(label=note, xalign=0, wrap=True, max_width_chars=52)
            n.get_style_context().add_class("dim")
            box.pack_start(n, False, False, 0)

    def page_welcome(self):
        box = self.title("Welcome to Firox Linux",
                         "A few questions and your computer is ready: where you are, your keyboard, "
                         "your account and a name for this computer.")
        return box

    def page_region(self):
        box = self.title("Time zone and keyboard", None)
        self.tz = Gtk.ComboBoxText.new_with_entry()
        zones = timezones()
        for z in zones:
            self.tz.append_text(z)
        completion = Gtk.EntryCompletion()
        store = Gtk.ListStore(str)
        for z in zones:
            store.append([z])
        completion.set_model(store)
        completion.set_text_column(0)
        completion.set_match_func(lambda c, key, it, _d: key.lower() in c.get_model()[it][0].lower(), None)
        self.tz.get_child().set_completion(completion)
        self.tz.get_child().set_text(current_timezone())
        self.field(box, "Time zone (type a city, such as London or New_York)", self.tz)
        self.kb = Gtk.ComboBoxText()
        self.layout_codes = []
        here = current_layout()
        for i, (code, desc) in enumerate(layouts()):
            self.kb.append_text(f"{desc} ({code})")
            self.layout_codes.append(code)
            if code == here:
                self.kb.set_active(i)
        if self.kb.get_active() < 0:
            self.kb.set_active(0)
        self.field(box, "Keyboard", self.kb, "Also used to type your password when logging in.")
        return box

    def page_account(self):
        box = self.title("Your account", "You'll be this computer's administrator: you can install "
                                         "updates and change its settings.")
        self.fullname = Gtk.Entry(placeholder_text="Your name")
        self.fullname.connect("changed", self.suggest_user)
        self.field(box, "Your name", self.fullname)
        self.username = Gtk.Entry(placeholder_text="user name, such as kim")
        self.username.connect("changed", lambda _e: setattr(self, "user_edited", True))
        self.user_edited = False
        self.field(box, "User name", self.username, "Lower-case letters and numbers, no spaces.")
        self.password = Gtk.Entry(visibility=False, input_purpose=Gtk.InputPurpose.PASSWORD)
        self.password2 = Gtk.Entry(visibility=False, input_purpose=Gtk.InputPurpose.PASSWORD)
        self.password2.connect("activate", lambda _e: self.go(1))
        n = min_password()
        self.field(box, "Password", self.password,
                   f"At least {n} characters." if n > 1 else None)
        self.field(box, "Type it again", self.password2)
        return box

    def page_computer(self):
        box = self.title("Name this computer", "How it shows on the network, in Firox Stream and Sync.")
        self.hostname = Gtk.Entry()
        self.hostname.connect("activate", lambda _e: self.go(1))
        self.field(box, "Computer name", self.hostname, "Letters, numbers and hyphens.")
        return box

    def page_finish(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        self.finish_title = self.title("Setting up your computer…", "This takes a moment.")
        box.pack_start(self.finish_title, False, False, 0)
        self.spinner = Gtk.Spinner()
        self.spinner.set_size_request(32, 32)
        box.pack_start(self.spinner, False, False, 0)
        return box

    # ------------------------------------------------------- behaviour --
    def suggest_user(self, entry):
        if self.user_edited and self.username.get_text():
            return
        first = (entry.get_text().strip().split() or [""])[0].lower()
        slug = re.sub(r"[^a-z0-9]", "", first)
        if slug and not slug[0].isalpha():
            slug = "u" + slug
        self.username.set_text(slug[:32])
        self.user_edited = False

    def show_step(self):
        name = self.STEPS[self.index]
        self.stack.set_visible_child_name(name)
        self.error.set_text("")
        self.back.set_visible(0 < self.index < len(self.STEPS) - 1)
        self.next.set_visible(self.index < len(self.STEPS) - 1)
        self.next.set_label({"welcome": "_Get started", "computer": "_Finish"}.get(name, "_Next"))
        self.next.set_use_underline(True)
        self.step_label.set_text("" if name in ("welcome", "finish") else
                                 f"Step {self.index} of {len(self.STEPS) - 2}")
        hints = {"welcome": "Let's set up your computer", "region": "Where you are",
                 "account": "Who you are", "computer": "Almost done", "finish": "Getting ready"}
        self.hint.set_text(hints[name])
        if name == "account":
            self.fullname.grab_focus()
        if name == "computer" and not self.hostname.get_text():
            self.hostname.set_text(f"{self.username.get_text() or 'firox'}-pc")
            self.hostname.grab_focus()

    def check(self, name):
        """Why this page can't be left yet, or None."""
        if name == "region":
            tz = self.tz.get_child().get_text().strip()
            if not os.path.isfile(os.path.join("/usr/share/zoneinfo", tz)) or ".." in tz:
                return "Choose a time zone from the list."
        if name == "account":
            user = self.username.get_text().strip()
            if not self.fullname.get_text().strip():
                return "Type your name."
            if not USER_RE.match(user):
                return "The user name needs lower-case letters and numbers, starting with a letter."
            if user in RESERVED:
                return f"{user} is kept for the system: choose another user name."
            try:
                import pwd
                pwd.getpwnam(user)
                return f"There's already an account called {user}."
            except KeyError:
                pass
            pw = self.password.get_text()
            if len(pw) < min_password():
                return f"The password needs at least {min_password()} characters."
            if pw != self.password2.get_text():
                return "The two passwords aren't the same."
        if name == "computer":
            if not HOST_RE.match(self.hostname.get_text().strip()):
                return "The computer name can have letters, numbers and hyphens (not at the start or end)."
        return None

    def go(self, step):
        name = self.STEPS[self.index]
        if step > 0:
            problem = self.check(name)
            if problem:
                self.error.set_text(problem)
                return
        self.index = max(0, min(len(self.STEPS) - 1, self.index + step))
        self.show_step()
        if self.STEPS[self.index] == "finish":
            self.apply()

    def apply(self):
        self.spinner.start()
        settings = {"user": self.username.get_text().strip(), "fullname": self.fullname.get_text().strip(),
                    "password": self.password.get_text(), "hostname": self.hostname.get_text().strip(),
                    "timezone": self.tz.get_child().get_text().strip(),
                    "layout": self.layout_codes[self.kb.get_active()] if self.kb.get_active() >= 0 else "us"}

        def work():
            try:
                p = subprocess.run(["pkexec", APPLY], input=json.dumps(settings), capture_output=True,
                                   text=True, timeout=300)
                ok, msg = p.returncode == 0, (p.stderr or p.stdout).strip()
            except (OSError, subprocess.SubprocessError) as e:
                ok, msg = False, str(e)
            problem = log_in(settings["user"], settings["password"], session_command()) if ok else None
            GLib.idle_add(self.applied, ok, msg, problem)
        threading.Thread(target=work, daemon=True).start()

    def applied(self, ok, msg, login_problem):
        self.spinner.stop()
        if not ok:
            self.index = self.STEPS.index("computer")
            self.show_step()
            self.error.set_text("Setup couldn't finish: " + (msg.splitlines()[-1] if msg else "unknown error"))
            return False
        if login_problem is None:
            self.result = 0                 # greetd starts the desktop once this exits
            self.set_finish("Welcome", "Starting your desktop…")
            GLib.timeout_add(400, Gtk.main_quit)
        else:
            self.result = 3                 # the login screen asks for the password
            self.set_finish("Your computer is ready", "Log in with the account you just made.")
            GLib.timeout_add(1500, Gtk.main_quit)
        return False

    def on_key(self, _w, event):
        """Ctrl+Shift+F3, as in Windows: audit mode instead of setup."""
        mods = event.state & (Gdk.ModifierType.CONTROL_MASK | Gdk.ModifierType.SHIFT_MASK)
        if event.keyval == Gdk.KEY_F3 and mods == (Gdk.ModifierType.CONTROL_MASK | Gdk.ModifierType.SHIFT_MASK):
            self.index = self.STEPS.index("finish")
            self.show_step()
            self.set_finish("Audit mode", "Logging in as audit, to set this computer up…")
            self.spinner.start()

            def work():
                try:
                    p = subprocess.run(["pkexec", APPLY], input=json.dumps({"audit": True}), capture_output=True,
                                       text=True, timeout=120)
                    ok, msg = p.returncode == 0, (p.stderr or p.stdout).strip()
                except (OSError, subprocess.SubprocessError) as e:
                    ok, msg = False, str(e)
                GLib.idle_add(self.audit_done, ok, msg)
            threading.Thread(target=work, daemon=True).start()
            return True
        return False

    def audit_done(self, ok, msg):
        if ok:
            self.result = 0                 # greetd restarts and logs audit in
            GLib.timeout_add(3000, Gtk.main_quit)
        else:
            self.spinner.stop()
            self.index = 0
            self.show_step()
            self.error.set_text("Audit mode couldn't start: " + (msg.splitlines()[-1] if msg else "unknown error"))
        return False

    def set_finish(self, title, sub):
        labels = self.finish_title.get_children()
        labels[0].set_text(title)
        labels[1].set_text(sub)


def main(argv):
    theme = None
    args = argv[1:]
    while args:
        a = args.pop(0)
        if a == "--theme" and args:
            theme = args.pop(0)
        else:
            print(__doc__.strip(), file=sys.stderr)
            return 2
    win = Setup(theme_name(theme))
    Gtk.main()
    return win.result


if __name__ == "__main__":
    sys.exit(main(sys.argv))
