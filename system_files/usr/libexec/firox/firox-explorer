    def on_key(self, _w, event):
        key = event.keyval
        mods = event.state & (Gdk.ModifierType.CONTROL_MASK | Gdk.ModifierType.MOD1_MASK
                              | Gdk.ModifierType.SHIFT_MASK)
        ctrl = Gdk.ModifierType.CONTROL_MASK
        alt = Gdk.ModifierType.MOD1_MASK
        typing = self.address.has_focus() or self.search.has_focus()
        if (key == Gdk.KEY_F10 and not mods) or (mods == alt and Gdk.keyval_to_lower(key) in MNEMONICS):
            self.refill_menus()
            return False                      # GTK opens the menu
        if mods == alt and key == Gdk.KEY_Left or (key == Gdk.KEY_BackSpace and not typing and not mods):
            self.go_back()
        elif mods == alt and key == Gdk.KEY_Right:
            self.go_forward()
        elif mods == alt and key == Gdk.KEY_Up:
            self.go_up()
        elif key == Gdk.KEY_F5:
            self.refresh()
        elif mods == ctrl and key in (Gdk.KEY_l, Gdk.KEY_L):
            self.focus_address()
        elif mods == ctrl and key in (Gdk.KEY_f, Gdk.KEY_F):
            self.search.grab_focus()
        elif mods == ctrl | Gdk.ModifierType.SHIFT_MASK and key in (Gdk.KEY_f, Gdk.KEY_F):
            self.find_files()
        elif mods == ctrl and key in (Gdk.KEY_h, Gdk.KEY_H):
            self.toggle_hidden()
        elif mods == ctrl and key in (Gdk.KEY_n, Gdk.KEY_N):
            spawn([sys.argv[0], self.current.get_uri()])
        elif mods == ctrl and key in (Gdk.KEY_t, Gdk.KEY_T):
            self.new_tab()
        elif mods == ctrl and key in (Gdk.KEY_w, Gdk.KEY_W):
            self.close_tab()
        elif (mods == ctrl | Gdk.ModifierType.SHIFT_MASK and key in (Gdk.KEY_w, Gdk.KEY_W)) or (
                mods == ctrl and key in (Gdk.KEY_q, Gdk.KEY_Q)):
            self.close()
        elif (mods == ctrl and key == Gdk.KEY_Tab) or (mods == ctrl and key == Gdk.KEY_Page_Down):
            self.switch_tab(1)
        elif (mods == ctrl | Gdk.ModifierType.SHIFT_MASK and key in (Gdk.KEY_ISO_Left_Tab, Gdk.KEY_Tab)) or (
                mods == ctrl and key == Gdk.KEY_Page_Up):
            self.switch_tab(-1)
        elif mods == alt and Gdk.KEY_1 <= key <= Gdk.KEY_9:
            self.switch_tab(index=key - Gdk.KEY_1)
        elif mods == ctrl and key in (Gdk.KEY_1, Gdk.KEY_KP_1):
            self.set_view("icons")
        elif mods == ctrl and key in (Gdk.KEY_2, Gdk.KEY_KP_2):
            self.set_view("details")
        elif mods == ctrl and key in (Gdk.KEY_d, Gdk.KEY_D):
            self.add_bookmark()
        elif mods == ctrl and key in (Gdk.KEY_b, Gdk.KEY_B):
            self.edit_bookmarks()
        elif key == Gdk.KEY_F9 and not mods:
            self.toggle_sidebar()
        elif key == Gdk.KEY_F1 and not mods:
            self.show_help()
        elif key == Gdk.KEY_question and mods & ctrl:
            self.show_shortcuts()
        elif mods == alt and key == Gdk.KEY_Home:
            self.navigate(HOME)
        elif mods == ctrl | Gdk.ModifierType.SHIFT_MASK and key in (Gdk.KEY_n, Gdk.KEY_N):
            self.new_folder()
        elif typing:
            return False
        elif key == Gdk.KEY_F2:
            self.rename()
        elif key == Gdk.KEY_Delete:
            (self.delete_forever if mods == Gdk.ModifierType.SHIFT_MASK else self.trash)()
        elif mods == ctrl and key in (Gdk.KEY_c, Gdk.KEY_C):
            self.copy(False)
        elif mods == ctrl and key in (Gdk.KEY_x, Gdk.KEY_X):
            self.copy(True)
        elif mods == ctrl and key in (Gdk.KEY_v, Gdk.KEY_V):
            self.paste()
        elif mods == ctrl and key in (Gdk.KEY_a, Gdk.KEY_A):
            self.select_all()
        elif mods == ctrl | Gdk.ModifierType.SHIFT_MASK and key in (Gdk.KEY_a, Gdk.KEY_A):
            self.select_none()
        elif mods == ctrl and key in (Gdk.KEY_i, Gdk.KEY_I):
            self.invert_selection()
        elif mods == ctrl | Gdk.ModifierType.SHIFT_MASK and key in (Gdk.KEY_c, Gdk.KEY_C):
            self.copy_location()
        elif mods == alt and key == Gdk.KEY_Return:
            self.properties()
        else:
            return False
        return True

    # ---- drag and drop
    def setup_dnd(self, view):
        targets = [Gtk.TargetEntry.new("text/uri-list", 0, 0)]
        actions = Gdk.DragAction.COPY | Gdk.DragAction.MOVE | Gdk.DragAction.LINK
        view.enable_model_drag_source(Gdk.ModifierType.BUTTON1_MASK, targets, actions)
        view.enable_model_drag_dest(targets, actions)
        view.connect("drag-data-get", self.on_drag_get)
        view.connect("drag-data-received", self.on_drop)

    def on_drag_get(self, _view, _ctx, data, _info, _time):
        data.set_uris([r[C_URI] for r in self.selected_rows()])

    def on_drop(self, view, ctx, x, y, data, _info, time_):
        view.stop_emission_by_name("drag-data-received")   # not a row reorder
        uris = [u for u in (data.get_uris() or []) if u]
        target = None
        if view is self.icons:
            path = self.icons.get_path_at_pos(x, y)
        else:
            hit = self.details.get_dest_row_at_pos(x, y)
            path = hit[0] if hit else None
        if path is not None and self.filter[path][C_DIR] and self.filter[path][C_URI] not in uris:
            target = Gio.File.new_for_uri(self.filter[path][C_URI])
        src = Gtk.drag_get_source_widget(ctx)
        if src in (self.icons, self.details) and target is None:
            Gtk.drag_finish(ctx, False, False, time_)
            return                          # dropped back in the same folder
        move = ctx.get_selected_action() == Gdk.DragAction.MOVE or src in self.all_views()
        self.transfer(uris, target, move=move)
        Gtk.drag_finish(ctx, True, False, time_)


