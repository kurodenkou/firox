    def invert_selection(self):
        chosen = {tuple(p.get_indices()) for p in self.selected_paths()}
        self.select_none()
        for i in range(len(self.filter)):
            if (i,) not in chosen:
                path = Gtk.TreePath.new_from_indices([i])
                (self.icons.select_path if self.view_mode == "icons" else
                 self.details.get_selection().select_path)(path)

