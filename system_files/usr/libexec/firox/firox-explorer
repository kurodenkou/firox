def special_dir(which):
    d = GLib.get_user_special_dir(which)
    return d if d and os.path.isdir(d) and os.path.realpath(d) != os.path.realpath(HOME) else None


class IconCache:
    def __init__(self):
        self.cache = {}
        self.theme = Gtk.IconTheme.get_default()
        self.theme.connect("changed", lambda *_: self.cache.clear())

    def get(self, gicon, size, thumb=None):
        key = (thumb or (gicon.to_string() if gicon else ""), size)
        if key in self.cache:
            return self.cache[key]
        pix = None
        if thumb and os.path.exists(thumb):
            try:
                pix = GdkPixbuf.Pixbuf.new_from_file_at_scale(thumb, size, size, True)
            except GLib.Error:
                pix = None
        if pix is None:
            info = self.theme.lookup_by_gicon(gicon, size, Gtk.IconLookupFlags.FORCE_SIZE) if gicon else None
            if info is None:
                info = self.theme.lookup_icon("text-x-generic", size, Gtk.IconLookupFlags.FORCE_SIZE)
            try:
                pix = info.load_icon() if info else None
            except GLib.Error:
                pix = None
        self.cache[key] = pix
        return pix


