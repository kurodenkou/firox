class Job:
    """Copy/move/delete in the background with a small progress window if it
    takes more than a moment."""

    def __init__(self, parent, title, steps, done):
        self.parent, self.title, self.steps, self.done = parent, title, steps, done
        self.proc = None
        self.cancelled = False
        self.errors = []
        self.dialog = None
        GLib.timeout_add(600, self.show_progress)
        threading.Thread(target=self.run, daemon=True).start()

    def show_progress(self):
        if self.steps is None:
            return False
        self.dialog = Gtk.Dialog(title=self.title, transient_for=self.parent, modal=False)
        self.dialog.add_button("Cancel", Gtk.ResponseType.CANCEL)
        box = self.dialog.get_content_area()
        box.set_border_width(14)
        box.set_spacing(8)
        self.label = Gtk.Label(label=self.title + "…", xalign=0)
        box.pack_start(self.label, False, False, 0)
        self.bar = Gtk.ProgressBar()
        box.pack_start(self.bar, False, False, 0)
        self.dialog.connect("response", lambda *_: self.cancel())
        self.dialog.show_all()
        GLib.timeout_add(150, self.pulse)
        return False

    def pulse(self):
        if self.dialog is None:
            return False
        self.bar.pulse()
        return True

    def cancel(self):
        self.cancelled = True
        if self.proc is not None:
            self.proc.terminate()

    def run(self):
        total = len(self.steps)
        for i, (label, argv) in enumerate(self.steps):
            if self.cancelled:
                break
            GLib.idle_add(self.set_label, f"{label} ({i + 1} of {total})")
            try:
                self.proc = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                             stderr=subprocess.PIPE, text=True)
                _out, err = self.proc.communicate()
                if self.proc.returncode != 0 and not self.cancelled:
                    self.errors.append((err or "").strip() or f"{label} failed")
            except OSError as e:
                self.errors.append(str(e))
        steps, self.steps = self.steps, None
        GLib.idle_add(self.finish)

    def set_label(self, text):
        if self.dialog is not None:
            self.label.set_text(text)
        return False

    def finish(self):
        if self.dialog is not None:
            self.dialog.destroy()
            self.dialog = None
        if self.errors:
            error_box(self.parent, f"{self.title}: something went wrong", "\n".join(self.errors[:6]))
        self.done()
        return False


def error_box(parent, title, detail=""):
    dlg = Gtk.MessageDialog(transient_for=parent, modal=True, message_type=Gtk.MessageType.ERROR,
                            buttons=Gtk.ButtonsType.CLOSE, text=title)
    if detail:
        dlg.format_secondary_text(detail)
    dlg.run()
    dlg.destroy()


def confirm(parent, title, detail, ok, destructive=False):
    dlg = Gtk.MessageDialog(transient_for=parent, modal=True, message_type=Gtk.MessageType.QUESTION,
                            buttons=Gtk.ButtonsType.NONE, text=title)
    dlg.format_secondary_text(detail)
    dlg.add_button("Cancel", Gtk.ResponseType.CANCEL)
    b = dlg.add_button(ok, Gtk.ResponseType.OK)
    if destructive:
        b.get_style_context().add_class("destructive-action")
    dlg.set_default_response(Gtk.ResponseType.CANCEL)
    answer = dlg.run() == Gtk.ResponseType.OK
    dlg.destroy()
    return answer


def enter_ok(entry, dialog):
    """Enter in this box presses the dialog's OK button (handled directly:
    a text box's "activate" isn't always sent)."""
    def on_key(_e, ev):
        if ev.keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            dialog.response(Gtk.ResponseType.OK)
            return True
        return False
    entry.connect("key-press-event", on_key)


def ask_text(parent, title, label, value, select_stem=False):
    dlg = Gtk.Dialog(title=title, transient_for=parent, modal=True)
    dlg.add_button("Cancel", Gtk.ResponseType.CANCEL)
    dlg.add_button("OK", Gtk.ResponseType.OK)
    dlg.set_default_response(Gtk.ResponseType.OK)
    box = dlg.get_content_area()
    box.set_border_width(14)
    box.set_spacing(8)
    box.pack_start(Gtk.Label(label=label, xalign=0), False, False, 0)
    entry = Gtk.Entry(text=value, activates_default=True, width_chars=40)
    enter_ok(entry, dlg)
    box.pack_start(entry, False, False, 0)
    dlg.show_all()
    if select_stem:
        stem = os.path.splitext(value)[0] if "." in value[1:] else value
        entry.select_region(0, len(stem))
    answer = entry.get_text().strip() if dlg.run() == Gtk.ResponseType.OK else None
    dlg.destroy()
    return answer


