def read_settings():
    p = configparser.ConfigParser(interpolation=None)
    try:
        p.read(CONF)
    except configparser.Error:
        pass
    out = dict(SETTINGS_DEFAULT)
    if p.has_section("Explorer"):
        out.update({k: v for k, v in p["Explorer"].items() if k in out})
    return out


def write_settings(settings):
    p = configparser.ConfigParser(interpolation=None)
    p["Explorer"] = settings
    try:
        os.makedirs(os.path.dirname(CONF), exist_ok=True)
        with open(CONF + ".tmp", "w") as fh:
            p.write(fh)
        os.replace(CONF + ".tmp", CONF)
    except OSError:
        pass


# The GTK bookmarks file, so bookmarks also show up in every program's
