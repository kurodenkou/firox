        def remove():
            it = selected()
            if it is not None:
                store.remove(it)
                save()

        def move(step):
            it = selected()
            if it is None:
                return
            other = store.iter_previous(it) if step < 0 else store.iter_next(it)
            if other is not None:
                store.swap(it, other)
                save()

        def rename():
            it = selected()
            if it is not None:
                view.set_cursor(store.get_path(it), col, True)
