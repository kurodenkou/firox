class ConnectDialog(Gtk.Dialog):
    """Add or edit a network connection."""

    def __init__(self, parent, conn=None):
        super().__init__(title="Connect to Server" if conn is None else "Edit Connection",
                         transient_for=parent, modal=True)
        self.add_button("Cancel", Gtk.ResponseType.CANCEL)
        self.add_button("Connect" if conn is None else "Save", Gtk.ResponseType.OK)
        self.set_default_response(Gtk.ResponseType.OK)
        self.conn = dict(conn or {})
        box = self.get_content_area()
        box.set_border_width(14)
        box.set_spacing(10)
        intro = Gtk.Label(xalign=0, wrap=True, max_width_chars=56)
        intro.set_markup("Connect to a shared folder or cloud storage. It's available only to you, "
                         "until you disconnect or log off." +
                         ("" if firox_mounts.keyring_available() else
                          "\n<b>Your keyring isn't available, so passwords can't be remembered.</b>"))
        box.pack_start(intro, False, False, 0)
        self.grid = Gtk.Grid(column_spacing=10, row_spacing=8)
        box.pack_start(self.grid, False, False, 0)
        self.kind = Gtk.ComboBoxText()
        for key, (label, _i, _b, _p) in firox_mounts.KINDS.items():
            self.kind.append(key, label)
        self.kind.set_active_id(self.conn.get("kind", "smb"))
        self.kind.connect("changed", lambda *_: self.layout())
        self.fields = {}
        for key in ("name", "host", "port", "share", "path", "domain", "user", "secret", "bucket",
                    "region", "endpoint"):
            e = Gtk.Entry(activates_default=True, width_chars=34)
            e.set_text(str(self.conn.get(key, "") or ""))
            enter_ok(e, self)
            self.fields[key] = e
        self.fields["secret"].set_visibility(False)
        self.fields["secret"].set_input_purpose(Gtk.InputPurpose.PASSWORD)
        self.provider = Gtk.ComboBoxText()
        for key, label in firox_mounts.S3_PROVIDERS:
            self.provider.append(key, label)
        self.provider.set_active_id(self.conn.get("provider") or "AWS")
        self.remember = Gtk.CheckButton(label="Remember the password in my keyring")
        self.remember.set_active(self.conn.get("remember", True) and firox_mounts.keyring_available())
        self.remember.set_sensitive(firox_mounts.keyring_available())
        self.auto = Gtk.CheckButton(label="Connect when I log in")
        self.auto.set_active(bool(self.conn.get("auto")))
        box.pack_start(self.remember, False, False, 0)
        box.pack_start(self.auto, False, False, 0)
        self.note = Gtk.Label(xalign=0, wrap=True, max_width_chars=56)
        self.note.get_style_context().add_class("dim-label")
        box.pack_start(self.note, False, False, 0)
        self.layout()
        self.show_all()

    def layout(self):
        for child in self.grid.get_children():
            self.grid.remove(child)
        kind = self.kind.get_active_id()
        rows = [("Type:", self.kind), ("Name:", self.fields["name"])]
        if kind in ("s3", "b2"):
            if kind == "s3":
                rows += [("Provider:", self.provider), ("Endpoint:", self.fields["endpoint"]),
                         ("Region:", self.fields["region"]), ("Access key ID:", self.fields["user"]),
                         ("Secret access key:", self.fields["secret"])]
            else:
                rows += [("Key ID:", self.fields["user"]), ("Application key:", self.fields["secret"])]
            rows += [("Bucket:", self.fields["bucket"]), ("Folder (optional):", self.fields["path"])]
            self.note.set_text("Mounted with rclone. For S3-compatible storage (Wasabi, R2, MinIO…) "
                               "type its endpoint address, e.g. https://s3.eu-central-1.wasabisys.com.")
        else:
            rows += [("Server:", self.fields["host"]), ("Port (optional):", self.fields["port"])]
            if kind == "smb":
                rows += [("Share:", self.fields["share"]), ("Domain (optional):", self.fields["domain"])]
            rows += [("Folder (optional):", self.fields["path"]), ("User name:", self.fields["user"]),
                     ("Password:", self.fields["secret"])]
            self.note.set_text({"smb": "e.g. server: nas.local, share: Public. Leave the user name empty "
                                       "for guest access.",
                                "sftp": "The first time, you'll be asked to check the server's key.",
                                "ftp": "Plain FTP isn't encrypted; use FTPS or SFTP if the server has it.",
                                }.get(kind, ""))
        for i, (label, widget) in enumerate(rows):
            self.grid.attach(Gtk.Label(label=label, xalign=0), 0, i, 1, 1)
            self.grid.attach(widget, 1, i, 1, 1)
        if self.conn.get("id") and not self.fields["secret"].get_text():
            self.fields["secret"].set_placeholder_text("(unchanged)")
        self.grid.show_all()

    def result(self):
        """(conn, secret dict or None) from the form, or an error string."""
        kind = self.kind.get_active_id()
        f = {k: e.get_text().strip() for k, e in self.fields.items()}
        conn = {"id": self.conn.get("id") or firox_mounts.new_id(f["name"] or f["host"] or f["bucket"] or kind),
                "kind": kind, "name": f["name"], "user": f["user"], "path": f["path"],
                "remember": self.remember.get_active(), "auto": self.auto.get_active()}
        if kind in ("s3", "b2"):
            if not f["bucket"]:
                return "Type the bucket's name."
            if not f["user"]:
                return "Type the key ID."
            conn.update(bucket=f["bucket"], region=f["region"], endpoint=f["endpoint"],
                        provider=self.provider.get_active_id() if kind == "s3" else "")
            conn["name"] = conn["name"] or f["bucket"]
            secret = {firox_mounts.secret_fields(kind)[0][0]: f["secret"]} if f["secret"] else None
        else:
            if not f["host"]:
                return "Type the server's name or address."
            if kind == "smb" and not f["share"]:
                return "Type the name of the share."
            if f["port"] and not f["port"].isdigit():
                return "The port is a number."
            conn.update(host=f["host"], port=f["port"], share=f["share"], domain=f["domain"])
            conn["name"] = conn["name"] or (f"{f['share']} on {f['host']}" if kind == "smb" else f["host"])
            secret = {"password": f["secret"]} if f["secret"] else None
        return conn, secret


