BOOKMARKS = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config"),
                         "gtk-3.0", "bookmarks")


def bookmark_label(uri):
    gfile = Gio.File.new_for_uri(uri)
    if gfile.get_path() == HOME:
        return os.environ.get("USER") or "Home"
    return gfile.get_basename() if gfile.get_path() else (urllib.parse.unquote(uri.rstrip("/").rsplit("/", 1)[-1])
                                                           or uri)


def read_bookmarks():
    out = []
    try:
        with open(BOOKMARKS) as fh:
            for line in fh:
                line = line.strip()
                if not line or "://" not in line:
                    continue
                uri, _, label = line.partition(" ")
                out.append((uri, label.strip() or bookmark_label(uri)))
    except OSError:
        pass
    return out


def write_bookmarks(marks):
    os.makedirs(os.path.dirname(BOOKMARKS), exist_ok=True)
    with open(BOOKMARKS + ".tmp", "w") as fh:
        for uri, label in marks:
            fh.write(uri + ("" if label == bookmark_label(uri) else " " + label) + "\n")
    os.replace(BOOKMARKS + ".tmp", BOOKMARKS)


