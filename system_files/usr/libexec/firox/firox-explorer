        """The selected items' paths (or this folder's), as text."""
        files = self.selected_files() or ([self.current] if self.current is not None else [])
        copy_text("\n".join(f.get_path() or f.get_uri() for f in files))

    def new_document(self):
        dest = self.dest_path()
        if dest is None:
            return
        name = ask_text(self, "New Text Document", "Name of the new document:", os.path.basename(
            unique_path(dest, "New Text Document.txt")), select_stem=True)
        if not name:
            return
        if "/" in name:
            error_box(self, "Couldn't make the document", "A name can't contain “/”.")
            return
        try:
            fd = os.open(os.path.join(dest, name), os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o644)
            os.close(fd)
        except OSError as err:
            error_box(self, "Couldn't make the document", err.strerror or str(err))

    def test_connection(self, conn):
        """Run the step-by-step check in a terminal, so its report can be
        read, copied and found later in the log folder."""
        argv = [os.path.abspath(sys.argv[0]), "--test", conn["id"]]
        if not spawn(["firox-terminal", "--hold", "--title", f"Testing {conn.get('name')}", "-x"] + argv):
            error_box(self, "Couldn't open a terminal", "Run this in a terminal instead:\n" + " ".join(argv))

    def show_log(self, conn):
        try:
            Gio.AppInfo.launch_default_for_uri(Gio.File.new_for_path(firox_mounts.log_path(conn)).get_uri(), None)
        except GLib.Error as err:
            error_box(self, "Couldn't open the log", err.message)

    def disconnect_all(self):
        for conn in firox_mounts.load():
            if firox_mounts.is_mounted(conn):
                self.disconnect(conn)

    def add_bookmark(self):
        marks = read_bookmarks()
        uri = self.current.get_uri()
        if any(u == uri for u, _l in marks):
            return
        marks.append((uri, bookmark_label(uri)))
        try:
            write_bookmarks(marks)
        except OSError as err:
            error_box(self, "Couldn't add the bookmark", str(err))
        self.fill_sidebar()

    def remove_bookmark(self, uri):
        try:
            write_bookmarks([m for m in read_bookmarks() if m[0] != uri])
        except OSError as err:
            error_box(self, "Couldn't remove the bookmark", str(err))
        self.fill_sidebar()

    def rename_bookmark(self, uri):
        marks = read_bookmarks()
        old = next((label for u, label in marks if u == uri), bookmark_label(uri))
        new = ask_text(self, "Rename Bookmark", "Name:", old)
        if not new or new == old:
            return
        try:
            write_bookmarks([(u, new.strip() if u == uri else label) for u, label in marks])
        except OSError as err:
            error_box(self, "Couldn't rename the bookmark", str(err))
        self.fill_sidebar()

    def edit_bookmarks(self):
        dlg = Gtk.Dialog(title="Edit Bookmarks", transient_for=self, modal=True)
        esc_closes(dlg)
        dlg.add_button("_Close", Gtk.ResponseType.CLOSE)
        dlg.set_default_size(480, 340)
        store = Gtk.ListStore(str, str, str)     # label, uri, where (shown)
        for uri, label in read_bookmarks():
            store.append([label, uri, Gio.File.new_for_uri(uri).get_parse_name()])
        view = Gtk.TreeView(model=store)
