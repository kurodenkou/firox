    # ---- menus and keys
    @staticmethod
    def menu_item(menu, label, cb, sensitive=True, accel=None, check=None, radio=False):
        """A menu item. `accel` ("<Control>n") is only shown: on_key does the
        work, so the keys also work with the menu bar hidden. `check`
        True/False makes a tick box (`radio`: drawn as a dot)."""
        if check is None:
            it = Gtk.MenuItem.new_with_mnemonic(label)
        else:
            it = Gtk.CheckMenuItem.new_with_mnemonic(label)
            it.set_draw_as_radio(radio)
            it.set_active(check)
        it.set_sensitive(sensitive and cb is not None)
        if accel:
            key, mods = Gtk.accelerator_parse(accel)
            child = it.get_child()
            if isinstance(child, Gtk.AccelLabel):
                child.set_accel(key, mods)
        if cb is not None:
            it.connect("activate", lambda _i: cb())
        menu.append(it)
        return it

    def build_menubar(self):
        """File, Edit, View, Go, Bookmarks, Tools, Help. Each menu is filled
        as it opens, so what's greyed out matches the selection and folder."""
        bar = self.menubar = Gtk.MenuBar()
        self.menus = []
        for label, fill in (("_File", self.fill_file), ("_Edit", self.fill_edit), ("_View", self.fill_view),
                            ("_Go", self.fill_go), ("_Bookmarks", self.fill_bookmarks),
                            ("_Tools", self.fill_tools), ("_Help", self.fill_help)):
            top = Gtk.MenuItem.new_with_mnemonic(label)
            menu = Gtk.Menu()
            top.set_submenu(menu)
            self.menus.append((menu, fill))
            bar.append(top)
        # Filled just before the bar opens (a click on it here, F10 and
        # Alt+letter in on_key), never while a menu is showing.
        bar.connect("button-press-event", lambda *_: self.refill_menus() and False)
        return bar

    def refill_menus(self):
        if self.menubar.get_selected_item() is not None:
            return False                      # already open
        for menu, fill in self.menus:
            for child in menu.get_children():
                menu.remove(child)
            fill(menu)
            menu.show_all()
        return False

