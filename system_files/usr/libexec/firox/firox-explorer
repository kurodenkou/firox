    # ---- tabs
    def build_tab(self):
        """A tab's views: Icons and Details on one model, and the grey
        message shown over them when there's nothing to show."""
        tab = Tab()
        tab.store = Gtk.ListStore(str, GdkPixbuf.Pixbuf, str, bool, GObjectInt64(), GObjectInt64(),
                                   str, str, str, bool, GdkPixbuf.Pixbuf, str, bool, str)
        tab.store.set_default_sort_func(self.sort_func)
        tab.store.set_sort_column_id(Gtk.TREE_SORTABLE_DEFAULT_SORT_COLUMN_ID, Gtk.SortType.ASCENDING)
        tab.filter = tab.store.filter_new()
        tab.filter.set_visible_func(self.visible_func, tab)
        tab.icons = Gtk.IconView(model=tab.filter)
        tab.icons.set_pixbuf_column(C_PIX)
        tab.icons.set_text_column(C_NAME)
        tab.icons.set_item_width(96)
        tab.icons.set_selection_mode(Gtk.SelectionMode.MULTIPLE)
        tab.icons.connect("item-activated", lambda _v, path: self.open_paths([path]))
        tab.icons.connect("button-press-event", self.on_view_press)
        tab.icons.connect("selection-changed", lambda *_: self.update_status())
        tab.details = Gtk.TreeView(model=tab.filter)
        tab.details.get_selection().set_mode(Gtk.SelectionMode.MULTIPLE)
        tab.details.set_rubber_banding(True)
        name_col = Gtk.TreeViewColumn("Name")
        pix = Gtk.CellRendererPixbuf()
        name_col.pack_start(pix, False)
        name_col.add_attribute(pix, "pixbuf", C_SMALL)
        txt = Gtk.CellRendererText(ellipsize=Pango.EllipsizeMode.END)
        name_col.pack_start(txt, True)
        name_col.add_attribute(txt, "text", C_NAME)
        name_col.set_expand(True)
        name_col.set_resizable(True)
        tab.details.append_column(name_col)
        for title, column in (("Size", C_SIZE_TEXT), ("Type", C_TYPE), ("Date modified", C_DATE_TEXT)):
            c = Gtk.TreeViewColumn(title, Gtk.CellRendererText(), text=column)
            c.set_resizable(True)
            tab.details.append_column(c)
        # where a search result is (only shown for subfolder searches)
        tab.where_col = Gtk.TreeViewColumn("Location", Gtk.CellRendererText(
            ellipsize=Pango.EllipsizeMode.START), text=C_WHERE)
        tab.where_col.set_resizable(True)
        tab.where_col.set_min_width(160)
        tab.where_col.set_visible(False)
        tab.details.append_column(tab.where_col)
        tab.details.connect("row-activated", lambda _v, path, _c: self.open_paths([path]))
        tab.details.connect("button-press-event", self.on_view_press)
        tab.details.get_selection().connect("changed", lambda *_: self.update_status())
        for view in (tab.icons, tab.details):
            self.setup_dnd(view)
        tab.stack = Gtk.Stack()
        for name, view in (("icons", tab.icons), ("details", tab.details)):
            sc = Gtk.ScrolledWindow()
            sc.add(view)
            tab.stack.add_named(sc, name)
        tab.empty = Gtk.Label(label="")
        tab.empty.get_style_context().add_class("dim-label")
        overlay = tab.page = Gtk.Overlay()
        overlay.add(tab.stack)
        tab.empty.set_halign(Gtk.Align.CENTER)
        tab.empty.set_valign(Gtk.Align.CENTER)
        tab.empty.set_no_show_all(True)
        overlay.add_overlay(tab.empty)
        overlay.set_overlay_pass_through(tab.empty, True)
        return tab

    def ui(self):
        """True when the tab being worked on is the one on show: only then
        do the address bar, title and status bar follow it."""
        return self.tab is self.active

    @contextlib.contextmanager
    def in_tab(self, tab):
        """Work on `tab` (for callbacks that finish after you switched tabs)."""
        prev = self.tab
        self.tab = tab
        try:
            yield
        finally:
            self.tab = prev if prev in self.page_tabs.values() else self.active

    def tabs(self):
        return [self.page_tabs[self.notebook.get_nth_page(i)] for i in range(self.notebook.get_n_pages())]

    def all_views(self):
        return [v for t in self.page_tabs.values() for v in (t.icons, t.details)]

    def new_tab(self, location=None, switch=True):
        tab = self.build_tab()
        tab.label = Gtk.Label(label="…", ellipsize=Pango.EllipsizeMode.END, max_width_chars=24, width_chars=12)
        close = Gtk.Button.new_from_icon_name("window-close-symbolic", Gtk.IconSize.MENU)
        close.set_relief(Gtk.ReliefStyle.NONE)
        close.set_focus_on_click(False)
        close.set_tooltip_text("Close tab (Ctrl+W)")
        close.connect("clicked", lambda *_: self.close_tab(tab))
        box = Gtk.Box(spacing=4)
        box.pack_start(Gtk.Image.new_from_icon_name("folder", Gtk.IconSize.MENU), False, False, 0)
        box.pack_start(tab.label, True, True, 0)
        box.pack_start(close, False, False, 0)
        handle = Gtk.EventBox(visible_window=False)
        handle.add(box)
        # middle-click closes; files dropped on a tab go into its folder
        handle.connect("button-press-event", lambda _w, ev: ev.button == 2 and (self.close_tab(tab) or True))
        handle.drag_dest_set(Gtk.DestDefaults.ALL, [Gtk.TargetEntry.new("text/uri-list", 0, 0)],
                             Gdk.DragAction.COPY | Gdk.DragAction.MOVE)
        handle.connect("drag-data-received", lambda _w, ctx, _x, _y, data, _i, t: self.drop_on_tab(tab, ctx, data, t))
        handle.show_all()
        tab.page.show_all()
        self.page_tabs[tab.page] = tab
        n = self.notebook.append_page(tab.page, handle)
        self.notebook.set_tab_reorderable(tab.page, True)
        self.notebook.set_show_tabs(self.notebook.get_n_pages() > 1)
        tab.stack.set_visible_child_name(self.view_mode)
        start = location or (self.active.current if self.active is not None and self.active.current else HOME)
        with self.in_tab(tab):
            self.navigate(start, remember=False)
        if switch:
            self.notebook.set_current_page(n)
        return tab

    def close_tab(self, tab=None):
        tab = tab or self.active
        if tab is None:
            return
        if self.notebook.get_n_pages() <= 1:
            self.close()
            return
        for c in (tab.loading, tab.search_cancel):
            if c is not None:
                c.cancel()
        if tab.monitor is not None:
            tab.monitor.cancel()
        if tab.reload_timer:
            GLib.source_remove(tab.reload_timer)
            tab.reload_timer = None
        self.notebook.remove_page(self.notebook.page_num(tab.page))
        del self.page_tabs[tab.page]
        self.notebook.set_show_tabs(self.notebook.get_n_pages() > 1)

    def switch_tab(self, step=None, index=None):
        n = self.notebook.get_n_pages()
        if index is None:
            index = (self.notebook.get_current_page() + step) % n
        if 0 <= index < n:
            self.notebook.set_current_page(index)

    def on_switch_page(self, _nb, page, _n):
        tab = self.page_tabs.get(page)
        if tab is None:
            return
        self.tab = self.active = tab
        self.side.get_selection().unselect_all()       # the sidebar showed the last tab's place
        self.sync_ui()

    def sync_ui(self):
        """Make the window (address bar, title, buttons, search box, status
        bar) show the tab on show."""
        tab = self.active
        if tab is None or tab.current is None:
            return
        path = local_path(tab.current)
        self.address.set_text(path if path else urllib.parse.unquote(tab.current.get_uri()))
        self.set_title(f"{tab.title} - Firox Explorer")
        self.back.set_sensitive(bool(tab.history))
        self.fwd.set_sensitive(bool(tab.future))
        self.up.set_sensitive(tab.current.get_parent() is not None)
        tab.stack.set_visible_child_name(self.view_mode)
        self.resetting_search = True
        self.search.set_text(tab.search_text)
        self.deep.set_active(tab.deep_on)
        self.resetting_search = False
        self.search.set_placeholder_text("Search here and in subfolders" if tab.deep_on else "Search this folder")
        if tab.busy:
            self.status.set_text("Loading…")
        elif tab.search_cancel is not None:
            self.status.set_text("Searching…")
        else:
            self.update_status()

    def drop_on_tab(self, tab, ctx, data, time_):
        uris = [u for u in (data.get_uris() or []) if u]
        if not uris or tab.current is None:
            Gtk.drag_finish(ctx, False, False, time_)
            return
        src = Gtk.drag_get_source_widget(ctx)
        if src in (tab.icons, tab.details):
            Gtk.drag_finish(ctx, False, False, time_)
            return                          # its own folder
        move = ctx.get_selected_action() == Gdk.DragAction.MOVE or src in self.all_views()
        self.transfer(uris, tab.current, move=move)
        Gtk.drag_finish(ctx, True, False, time_)

    # ---- small helpers
    @staticmethod
    def tool(icon, tip, cb):
        b = Gtk.Button.new_from_icon_name(icon, Gtk.IconSize.LARGE_TOOLBAR)
        b.set_relief(Gtk.ReliefStyle.NONE)
        b.set_tooltip_text(tip)
        b.connect("clicked", lambda _b: cb())
        return b

    def view(self):
        return self.icons if self.view_mode == "icons" else self.details

    # ---- sidebar
    def fill_sidebar(self):
        sel = None
        self.side_store.clear()
        places = self.side_store.append(None, ["", "<b>Places</b>", None, "header"])
        user = os.environ.get("USER") or os.path.basename(HOME)
        items = [("user-home", user, HOME)]
        for which, icon, label in ((GLib.UserDirectory.DIRECTORY_DESKTOP, "user-desktop", "Desktop"),
                                   (GLib.UserDirectory.DIRECTORY_DOCUMENTS, "folder-documents", "Documents"),
                                   (GLib.UserDirectory.DIRECTORY_DOWNLOAD, "folder-download", "Downloads"),
                                   (GLib.UserDirectory.DIRECTORY_PICTURES, "folder-pictures", "Pictures"),
                                   (GLib.UserDirectory.DIRECTORY_MUSIC, "folder-music", "Music"),
                                   (GLib.UserDirectory.DIRECTORY_VIDEOS, "folder-videos", "Videos")):
            d = special_dir(which)
            if d:
                items.append((icon, label, d))
        items.append(("user-trash", "Recycle Bin", "trash:///"))
        for icon, label, target in items:
            self.side_store.append(places, [icon, GLib.markup_escape_text(label), target, "place"])
        marks = read_bookmarks()
        if marks:
            parent = self.side_store.append(None, ["", "<b>Bookmarks</b>", None, "header"])
            for uri, label in marks:
                self.side_store.append(parent, ["folder-remote" if uri.split(":", 1)[0] != "file" else "folder",
                                                GLib.markup_escape_text(label), uri, "bookmark"])
        drives =self.side_store.append(None, ["", "<b>Computer</b>", None, "header"])
        self.side_store.append(drives, ["computer", "Computer", "computer:///", "place"])
        self.side_store.append(drives, ["drive-harddisk", "File System", "/", "place"])
        vm = Gio.VolumeMonitor.get()
        seen = set()
        for vol in vm.get_volumes():
            m = vol.get_mount()
            name = vol.get_name()
            if m is not None:
                seen.add(m.get_root().get_uri())
            icon = self.icon_name(vol.get_symbolic_icon() or vol.get_icon(), "drive-removable-media")
            label = GLib.markup_escape_text(name) + ("" if m else " <small>(not mounted)</small>")
            self.side_store.append(drives, [icon, label, vol, "volume"])
        for m in vm.get_mounts():
            root = m.get_root()
            if root.get_uri() in seen or m.is_shadowed() or root.get_uri_scheme() != "file":
                continue
            self.side_store.append(drives, [self.icon_name(m.get_icon(), "drive-removable-media"),
                                            GLib.markup_escape_text(m.get_name()), m, "mount"])
        net = self.side_store.append(None, ["", "<b>Network</b>", None, "header"])
        self.side_store.append(net, ["network-workgroup", "Network", "network:///", "place"])
        for conn in firox_mounts.load():
            on = firox_mounts.is_mounted(conn)
            label = GLib.markup_escape_text(conn.get("name") or conn["id"])
            label += "" if on else " <small>(disconnected)</small>"
            self.side_store.append(net, ["folder-remote" if on else "network-offline", label, conn, "conn"])
        self.side_store.append(net, ["list-add", "Connect to Server…", None, "add"])
        self.side.expand_all()
        return False

    @staticmethod
    def icon_name(gicon, fallback):
        if isinstance(gicon, Gio.ThemedIcon):
            for n in gicon.get_names():
                if Gtk.IconTheme.get_default().has_icon(n):
                    return n
        return fallback

    def on_side_selected(self, sel):
        model, it = sel.get_selected()
        if it is None:
            return
        kind = model[it][3]
        if kind in ("place", "bookmark"):
            self.navigate(model[it][2])

    def on_side_activated(self, view, path, _col):
        it = self.side_store.get_iter(path)
        kind, payload = self.side_store[it][3], self.side_store[it][2]
        if kind == "volume":
            self.open_volume(payload)
        elif kind == "mount":
            self.navigate(payload.get_root().get_uri())
        elif kind == "conn":
            self.open_connection(payload)
        elif kind == "add":
            self.add_connection()

    def on_side_press(self, view, event):
        hit = view.get_path_at_pos(int(event.x), int(event.y))
        if hit is None:
            return False
        it = self.side_store.get_iter(hit[0])
        kind, payload = self.side_store[it][3], self.side_store[it][2]
        if event.type == Gdk.EventType.BUTTON_PRESS and event.button == 2 and kind in ("place", "bookmark"):
            self.new_tab(payload, switch=False)
            return True
        if event.type == Gdk.EventType.BUTTON_PRESS and event.button == 1 and kind in (
                "volume", "mount", "conn", "add"):
            view.get_selection().select_path(hit[0])
            self.on_side_activated(view, hit[0], None)
            return True
        if event.type == Gdk.EventType.BUTTON_PRESS and event.button == 3:
            menu = Gtk.Menu()
            if kind == "conn":
                on = firox_mounts.is_mounted(payload)
                self.menu_item(menu, "_Open", lambda: self.open_connection(payload))
                self.menu_item(menu, "_Disconnect" if on else "_Connect",
                               (lambda: self.disconnect(payload)) if on else (lambda: self.open_connection(payload)))
                menu.append(Gtk.SeparatorMenuItem())
                self.menu_item(menu, "_Edit…", lambda: self.edit_connection(payload))
                self.menu_item(menu, "_Test Connection…", lambda: self.test_connection(payload))
                self.menu_item(menu, "Show _Log", lambda: self.show_log(payload),
                               os.path.exists(firox_mounts.log_path(payload)))
                menu.append(Gtk.SeparatorMenuItem())
                self.menu_item(menu, "Re_move", lambda: self.remove_connection(payload))
            elif kind in ("volume", "mount"):
                mount = payload.get_mount() if kind == "volume" else payload
                if mount is not None:
                    self.menu_item(menu, "_Open", lambda: self.navigate(mount.get_root().get_uri()))
                    self.menu_item(menu, "_Eject" if mount.can_eject() else "_Unmount",
                                   lambda: self.eject(mount))
                else:
                    self.menu_item(menu, "_Mount", lambda: self.open_volume(payload))
            elif kind == "bookmark":
                self.menu_item(menu, "_Open", lambda: self.navigate(payload))
                self.menu_item(menu, "Open in New _Tab", lambda: self.new_tab(payload))
                self.menu_item(menu, "Open in New _Window", lambda: spawn([sys.argv[0], payload]))
                menu.append(Gtk.SeparatorMenuItem())
                self.menu_item(menu, "Re_name…", lambda: self.rename_bookmark(payload))
                self.menu_item(menu, "_Remove Bookmark", lambda: self.remove_bookmark(payload))
            else:
                return False
            menu.show_all()
            menu.popup_at_pointer(event)
            return True
        return False

    def eject(self, mount):
        def done(m, res):
            try:
                (m.eject_with_operation_finish if m.can_eject() else m.unmount_with_operation_finish)(res)
            except GLib.Error as err:
                error_box(self, "Couldn't remove the drive", err.message)
            self.fill_sidebar()
        op = Gtk.MountOperation(parent=self)
        if mount.can_eject():
            mount.eject_with_operation(Gio.MountUnmountFlags.NONE, op, None, done)
        else:
            mount.unmount_with_operation(Gio.MountUnmountFlags.NONE, op, None, done)

    def open_volume(self, vol):
        m = vol.get_mount()
        if m is not None:
            self.navigate(m.get_root().get_uri())
            return

        def done(v, res):
            try:
                v.mount_finish(res)
                self.navigate(v.get_mount().get_root().get_uri())
            except GLib.Error as err:
                error_box(self, f"Couldn't open {v.get_name()}", err.message)
            self.fill_sidebar()
        vol.mount(Gio.MountMountFlags.NONE, Gtk.MountOperation(parent=self), None, done)

    # ---- network connections
    def add_connection(self):
        dlg = ConnectDialog(self)
        while dlg.run() == Gtk.ResponseType.OK:
            res = dlg.result()
            if isinstance(res, str):
                error_box(dlg, "Check the details", res)
                continue
            conn, secret = res
            dlg.destroy()
            firox_mounts.upsert(conn)
            if secret and conn.get("remember"):
                firox_mounts.store_secret(conn, secret)
            self.sync_autostart()
            self.fill_sidebar()
            self.open_connection(conn, secret)
            return
        dlg.destroy()

    def edit_connection(self, conn):
        dlg = ConnectDialog(self, conn)
        while dlg.run() == Gtk.ResponseType.OK:
            res = dlg.result()
            if isinstance(res, str):
                error_box(dlg, "Check the details", res)
                continue
            new, secret = res
            if firox_mounts.is_mounted(conn):
                firox_mounts.unmount(conn)
            firox_mounts.upsert(new)
            if secret and new.get("remember"):
                firox_mounts.store_secret(new, secret)
            elif not new.get("remember"):
                firox_mounts.forget_secret(new)
            break
        dlg.destroy()
        self.sync_autostart()
        self.fill_sidebar()

    def remove_connection(self, conn):
        if confirm(self, f"Remove “{conn.get('name')}”?",
                   "It's disconnected and its remembered password is deleted from your keyring.", "Remove",
                   destructive=True):
            firox_mounts.remove(conn)
            self.sync_autostart()
            self.fill_sidebar()

    def disconnect(self, conn):
        if self.current is not None and self.current.get_uri().startswith(firox_mounts.location(conn).get_uri()):
            self.navigate(HOME)
        firox_mounts.unmount(conn, lambda err: (err and error_box(self, "Couldn't disconnect", err),
                                                self.fill_sidebar()))

    def open_connection(self, conn, secret=None):
        if firox_mounts.is_mounted(conn):
            self.navigate(firox_mounts.location(conn).get_uri())
            return
        self.status.set_text(f"Connecting to {conn.get('name')}…")
        if secret and not conn.get("remember"):
            # Use what was just typed this once, without keeping it
            original = firox_mounts.lookup_secret
            firox_mounts.lookup_secret = lambda c, s=secret, cid=conn["id"]: s if c["id"] == cid else original(c)
        else:
            original = None

        def done(err):
            if original is not None:
                firox_mounts.lookup_secret = original
            self.fill_sidebar()
            if err:
                error_box(self, f"Couldn't connect to {conn.get('name')}", err)
                self.update_status()
            elif err is None:
                self.navigate(firox_mounts.location(conn).get_uri())
            else:
                self.update_status()
        firox_mounts.mount(conn, lambda kind, *a: self.ask(conn, kind, *a), done)

    def ask(self, conn, kind, *args):
        if kind == "question":
            message, choices = args
            dlg = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.WARNING,
                                    buttons=Gtk.ButtonsType.NONE, text=f"Connecting to {conn.get('name')}")
            dlg.format_secondary_text(message)
            for i, c in enumerate(choices):
                dlg.add_button(c, i)
            r = dlg.run()
            dlg.destroy()
            return r if r >= 0 else None
        if kind == "password":
            message = args[0]
            dlg = Gtk.Dialog(title=f"Connect to {conn.get('name')}", transient_for=self, modal=True)
            dlg.add_button("Cancel", Gtk.ResponseType.CANCEL)
            dlg.add_button("Connect", Gtk.ResponseType.OK)
            dlg.set_default_response(Gtk.ResponseType.OK)
            box = dlg.get_content_area()
            box.set_border_width(14)
            box.set_spacing(8)
            box.pack_start(Gtk.Label(label=message, xalign=0, wrap=True, max_width_chars=48), False, False, 0)
            user = Gtk.Entry(text=conn.get("user", ""), placeholder_text="User name", activates_default=True)
            pw = Gtk.Entry(visibility=False, placeholder_text="Password", activates_default=True)
            remember = Gtk.CheckButton(label="Remember the password in my keyring")
            remember.set_active(bool(conn.get("remember")) and firox_mounts.keyring_available())
            remember.set_sensitive(firox_mounts.keyring_available())
            for w in (user, pw, remember):
                box.pack_start(w, False, False, 0)
            enter_ok(user, dlg)
            enter_ok(pw, dlg)
            dlg.show_all()
            pw.grab_focus()
            ok = dlg.run() == Gtk.ResponseType.OK
            answer = (user.get_text().strip(), pw.get_text(), remember.get_active()) if ok else None
            dlg.destroy()
            return answer
        if kind == "keys":
            dlg = Gtk.Dialog(title=f"Connect to {conn.get('name')}", transient_for=self, modal=True)
            dlg.add_button("Cancel", Gtk.ResponseType.CANCEL)
            dlg.add_button("Connect", Gtk.ResponseType.OK)
            dlg.set_default_response(Gtk.ResponseType.OK)
            box = dlg.get_content_area()
            box.set_border_width(14)
            box.set_spacing(8)
            entries = {}
            for key, label in firox_mounts.secret_fields(conn["kind"]):
                box.pack_start(Gtk.Label(label=label + ":", xalign=0), False, False, 0)
                e = Gtk.Entry(visibility=False, activates_default=True, width_chars=40)
                enter_ok(e, dlg)
                box.pack_start(e, False, False, 0)
                entries[key] = e
            remember = Gtk.CheckButton(label="Remember it in my keyring")
            remember.set_active(firox_mounts.keyring_available())
            remember.set_sensitive(firox_mounts.keyring_available())
            box.pack_start(remember, False, False, 0)
            dlg.show_all()
            ok = dlg.run() == Gtk.ResponseType.OK
            answer = ({k: e.get_text() for k, e in entries.items()}, remember.get_active()) if ok else None
            dlg.destroy()
            return answer
        return None

    def sync_autostart(self):
        """Connections marked "Connect when I log in": an autostart entry."""
        path = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"),
                            "autostart", "firox-connections.desktop")
        if any(c.get("auto") for c in firox_mounts.load()):
            os.makedirs(os.path.dirname(path), exist_ok=True)
            with open(path, "w") as fh:
                fh.write("[Desktop Entry]\nType=Application\nName=Network connections\n"
                         "Comment=Connect Firox Explorer's network places marked to connect at login\n"
                         "Exec=/usr/libexec/firox/firox-explorer --connect-saved\nIcon=folder-remote\n"
                         "X-Firox-Explorer=true\n")
        elif os.path.exists(path):
            os.remove(path)

    # ---- navigation
    def navigate(self, target, remember=True):
        gfile = target if isinstance(target, Gio.File) else (
            Gio.File.new_for_uri(target) if "://" in str(target) else Gio.File.new_for_path(str(target)))
        if remember and self.current is not None and not self.current.equal(gfile):
            self.history.append(self.current)
            self.future.clear()
        self.current = gfile
        self.load()

    def go_back(self):
        if self.history:
            self.future.append(self.current)
            self.current = self.history.pop()
            self.load()

    def go_forward(self):
        if self.future:
            self.history.append(self.current)
            self.current = self.future.pop()
            self.load()

    def go_up(self):
        parent = self.current.get_parent() if self.current else None
        if parent is not None:
            self.navigate(parent)

    def refresh(self):
        self.load()

    def on_address(self, entry):
        text = entry.get_text().strip()
        if text.startswith("~"):
            text = os.path.expanduser(text)
        self.navigate(text if "://" in text else Gio.File.new_for_path(text))

    def load(self, keep_search=False):
        if self.search_cancel is not None:
            self.search_cancel.cancel()
            self.search_cancel = None
        self.searching = None
        self.where_col.set_visible(False)
        gfile = self.current
        tab = self.tab
        path = local_path(gfile)
        try:
            info = gfile.query_info("standard::display-name", Gio.FileQueryInfoFlags.NONE, None)
            title = info.get_display_name()
        except GLib.Error:
            title = gfile.get_basename() or gfile.get_uri()
        if gfile.get_uri() == "trash:///":
            title = "Recycle Bin"
        tab.title = title
        tab.label.set_text(title)
        tab.label.get_parent().get_parent().set_tooltip_text(path or urllib.parse.unquote(gfile.get_uri()))
        if not keep_search:
            tab.search_text = ""
        tab.busy = True
        if self.ui():
            self.sync_ui()
        self.store.clear()
        self.empty.hide()
        if self.monitor is not None:
            self.monitor.cancel()
            self.monitor = None
        cancel = Gio.Cancellable()
        if self.loading is not None:
            self.loading.cancel()
        self.loading = cancel

        def got_enum(f, res):
            try:
                enum = f.enumerate_children_finish(res)
            except GLib.Error as err:
                if not err.matches(Gio.io_error_quark(), Gio.IOErrorEnum.CANCELLED):
                    with self.in_tab(tab):
                        self.failed(f, err)
                return
            enum.next_files_async(200, GLib.PRIORITY_DEFAULT, cancel, got_batch)

        def got_batch(enum, res):
            try:
                infos = enum.next_files_finish(res)
            except GLib.Error:
                return
            if cancel.is_cancelled():
                return
            with self.in_tab(tab):
                for info in infos:
                    self.add_row(gfile, info)
                if not infos:
                    self.loaded()
            if infos:
                enum.next_files_async(200, GLib.PRIORITY_DEFAULT, cancel, got_batch)
            else:
                enum.close_async(GLib.PRIORITY_DEFAULT, None, None, None)
        gfile.enumerate_children_async(ATTRS, Gio.FileQueryInfoFlags.NONE, GLib.PRIORITY_DEFAULT, cancel, got_enum)

    def failed(self, f, err):
        if err.matches(Gio.io_error_quark(), Gio.IOErrorEnum.NOT_MOUNTED):
            # e.g. smb://server/share typed in the address bar: mount it
            op = Gtk.MountOperation(parent=self)
            tab = self.tab

            def mounted(gf, res):
                try:
                    gf.mount_enclosing_volume_finish(res)
                    with self.in_tab(tab):
                        self.load()
                except GLib.Error as e:
                    if e.matches(Gio.io_error_quark(), Gio.IOErrorEnum.ALREADY_MOUNTED):
                        with self.in_tab(tab):
                            self.load()
                        return
                    tab.busy = False
                    if tab is self.active:
                        self.status.set_text("")
                    if not e.matches(Gio.io_error_quark(), Gio.IOErrorEnum.FAILED_HANDLED):
                        error_box(self, "Couldn't open the location", e.message)
            f.mount_enclosing_volume(Gio.MountMountFlags.NONE, op, None, mounted)
            return
        self.busy = False
        if self.ui():
            self.status.set_text("")
        self.empty.set_text(f"Can't open this folder: {err.message}")
        self.empty.show()

    def add_row(self, folder, info, where=""):
        name = info.get_display_name()
        ftype = info.get_file_type()
        child = folder.get_child(info.get_name())
        target = info.get_attribute_string("standard::target-uri")
        uri = target or child.get_uri()
        # In Network and Computer, servers, shares and drives are shortcuts
        # or mountables: open them like folders (mounting first if needed)
        is_dir = ftype == Gio.FileType.DIRECTORY or (
            ftype in (Gio.FileType.SHORTCUT, Gio.FileType.MOUNTABLE) and (
                target is not None or ftype == Gio.FileType.MOUNTABLE))
        mountable = ftype == Gio.FileType.MOUNTABLE and target is None
        mtime = info.get_attribute_uint64("time::modified")
        size = info.get_size() if info.has_attribute("standard::size") else 0
        ct = info.get_content_type() or ""
        thumb = info.get_attribute_byte_string("thumbnail::path") if self.flag("thumbnails") else None
        gicon = info.get_icon()
        hidden = (info.has_attribute("standard::is-hidden") and info.get_is_hidden()) or (
            info.has_attribute("standard::is-backup") and info.get_is_backup()) or info.get_name().startswith(".")
        orig = info.get_attribute_byte_string("trash::orig-path") or ""
        self.store.append([name, ICONS.get(gicon, ICON_SIZE_BIG, thumb), uri, is_dir, size, mtime,
                           "Folder" if is_dir else (Gio.content_type_get_description(ct) or "File"),
                           "" if is_dir else human_size(size),
                           us_date(mtime) if mtime else "",
                           hidden, ICONS.get(gicon, ICON_SIZE_SMALL), orig, mountable, where])

    def loaded(self):
        self.busy = False
        try:
            self.monitor = self.current.monitor_directory(Gio.FileMonitorFlags.WATCH_MOVES, None)
            self.reload_timer = None
            self.monitor.connect("changed", self.on_changed, self.tab)
        except GLib.Error:
            self.monitor = None
        self.update_empty()
        self.update_status()

    def update_empty(self):
        """The grey message over an empty view (not for subfolder searches,
        which say so themselves)."""
        if self.searching is not None:
            return
        q = self.tab.search_text.strip()
        if len(self.filter) > 0:
            self.empty.hide()
            return
        if len(self.store) == 0:
            self.empty.set_text("This folder is empty.")
        elif q:
            self.empty.set_text(f"Nothing called “{q}” in this folder. Click Subfolders to look inside "
                                "the folders in it too.")
        else:
            self.empty.set_text("Only hidden files here (Ctrl+H shows them).")
        self.empty.show()

    def on_changed(self, *args):
        tab = args[-1]
        if tab not in self.page_tabs.values():
            return
        if tab.reload_timer:
            GLib.source_remove(tab.reload_timer)

        def again():
            tab.reload_timer = None
            if tab not in self.page_tabs.values():
                return False
            with self.in_tab(tab):
                selected = {self.filter[p][C_URI] for p in self.selected_paths()}
                self.load_keep(selected)
            return False
        tab.reload_timer = GLib.timeout_add(300, again)

    def load_keep(self, selected):
        """Reload this folder (it changed), keeping the selection, the
        history and what's typed in the search box."""
        tab = self.tab
        hist, fut = list(self.history), list(self.future)
        self.load(keep_search=True)
        self.history, self.future = hist, fut

        def reselect():
            if tab not in self.page_tabs.values():
                return False
            if tab.busy:
                return True
            for i, row in enumerate(tab.filter):
                if row[C_URI] in selected:
                    path = Gtk.TreePath.new_from_indices([i])
                    (tab.icons.select_path if self.view_mode == "icons" else
                     tab.details.get_selection().select_path)(path)
            return False
        GLib.timeout_add(100, reselect)

    def sort_func(self, model, a, b, _data=None):
        ra, rb = model[a], model[b]
        if self.flag("folders_first") and ra[C_DIR] != rb[C_DIR]:
            return -1 if ra[C_DIR] else 1
        na, nb = (ra[C_NAME] or "").casefold(), (rb[C_NAME] or "").casefold()
        key = self.settings["sort"]
        if key == "size":
            ka, kb = (0 if ra[C_DIR] else ra[C_SIZE], na), (0 if rb[C_DIR] else rb[C_SIZE], nb)
        elif key == "type":
            ka, kb = ((ra[C_TYPE] or "").casefold(), na), ((rb[C_TYPE] or "").casefold(), nb)
        elif key == "mtime":
            ka, kb = (ra[C_MTIME], na), (rb[C_MTIME], nb)
        else:
            ka, kb = na, nb
        res = (ka > kb) - (ka < kb)
        return -res if self.flag("descending") else res

    # ---- settings
    def flag(self, key):
        return self.settings.get(key) == "true"

    def set_setting(self, key, value):
        self.settings[key] = value if isinstance(value, str) else ("true" if value else "false")
        write_settings(self.settings)

    def resort(self):
        for tab in self.page_tabs.values():
            tab.store.set_default_sort_func(self.sort_func)  # sorts again

    def set_sort(self, key=None, descending=None, folders_first=None):
        if key is not None:
            self.set_setting("sort", key)
        if descending is not None:
            self.set_setting("descending", descending)
        if folders_first is not None:
            self.set_setting("folders_first", folders_first)
        self.resort()

    def set_bar(self, key, widget, on):
        widget.set_visible(on)
        self.set_setting(key, on)

    def visible_func(self, model, it, tab):
        if model[it][C_HIDDEN] and not self.show_hidden:
            return False
        if tab.searching is not None:
            return True                       # subfolder results: all matches
        q = tab.search_text.strip().casefold()
        return not q or q in (model[it][C_NAME] or "").casefold()

    # ---- searching
    def on_search_changed(self):
        if self.resetting_search or self.current is None:
            return
        self.tab.search_text = self.search.get_text()
        self.tab.deep_on = self.deep.get_active()
        q = self.tab.search_text.strip()
        self.search.set_placeholder_text("Search here and in subfolders" if self.deep.get_active()
                                         else "Search this folder")
        if self.deep.get_active() and len(q) >= 2:
            self.start_deep_search(q)
        elif self.searching is not None:
            self.load(keep_search=True)        # back to the folder, filtered as you type
        else:
            self.filter.refilter()
            if not self.busy:
                self.update_empty()
            self.update_status()

    def find_files(self):
        """Search this folder and its subfolders (Start > Search, Ctrl+Shift+F)."""
        if not self.toolbar.get_visible():
            self.set_bar("toolbar", self.toolbar, True)
        self.deep.set_active(True)
        self.search.grab_focus()

    def start_deep_search(self, query):
        if self.search_cancel is not None:
            self.search_cancel.cancel()
        if self.loading is not None:
            self.loading.cancel()
        if self.monitor is not None:
            self.monitor.cancel()
            self.monitor = None
        cancel = Gio.Cancellable()
        tab = self.tab
        self.search_cancel = cancel
        self.searching = query
        self.store.clear()
        self.empty.hide()
        self.where_col.set_visible(True)
        root = self.current
        root_path = local_path(root)
        place = root_path or urllib.parse.unquote(root.get_uri())
        tab.title = f"Search: {query}"
        tab.label.set_text(tab.title)
        if self.ui():
            self.set_title(f"Search results for “{query}” in {os.path.basename(place.rstrip('/')) or place}"
                           " - Firox Explorer")
            self.status.set_text("Searching…")
        needle = query.casefold()
        hidden_ok = self.show_hidden
        found = {"n": 0}

        def where_of(folder):
            p = folder.get_path()
            if p and root_path and (p == root_path or p.startswith(root_path.rstrip("/") + "/")):
                rel = os.path.relpath(p, root_path)
                return "" if rel == "." else rel
            return p or urllib.parse.unquote(folder.get_uri())

        def flush(batch, finished=False, capped=False):
            if cancel.is_cancelled() or tab not in self.page_tabs.values():
                return False
            with self.in_tab(tab):
                flush_here(batch, finished, capped)
            return False

        def flush_here(batch, finished, capped):
            for folder, info in batch:
                self.add_row(folder, info, where_of(folder) or "(this folder)")
            if finished:
                self.search_cancel = None
                if found["n"] == 0:
                    self.empty.set_text(f"Nothing called “{query}” here or in the folders inside.")
                    self.empty.show()
                self.update_status()
                if capped and self.ui():
                    self.status.set_text(self.status.get_text() + f"    —    stopped at {SEARCH_LIMIT} results")
            elif self.ui():
                self.status.set_text(f"Searching…  {found['n']} found")

        def walk():
            stack, batch = [root], []
            while stack and not cancel.is_cancelled() and found["n"] < SEARCH_LIMIT:
                folder = stack.pop()
                try:
                    enum = folder.enumerate_children(ATTRS, Gio.FileQueryInfoFlags.NOFOLLOW_SYMLINKS, cancel)
                except GLib.Error:
                    continue
                children = []
                while True:
                    try:
                        info = enum.next_file(cancel)
                    except GLib.Error:
                        break
                    if info is None:
                        break
                    name = info.get_name()
                    if name.startswith(".") and not hidden_ok:
                        continue
                    if info.get_file_type() == Gio.FileType.DIRECTORY:
                        child = folder.get_child(name)
                        if child.get_path() not in SEARCH_SKIP:
                            children.append(child)
                    if needle in (info.get_display_name() or name).casefold():
                        batch.append((folder, info))
                        found["n"] += 1
                        if len(batch) >= 50:
                            GLib.idle_add(flush, batch)
                            batch = []
                        if found["n"] >= SEARCH_LIMIT:
                            break
                try:
                    enum.close(None)
                except GLib.Error:
                    pass
                stack.extend(reversed(children))        # depth-first, in name order
            GLib.idle_add(flush, batch, True, found["n"] >= SEARCH_LIMIT)
        threading.Thread(target=walk, daemon=True).start()

    def update_status(self):
        if not self.ui() or self.tab is None:
            return
        n = len(self.filter)
        sel = len(self.selected_paths())
        text = f"{n} item{'s' if n != 1 else ''}" if self.searching is None else \
            f"{n} result{'s' if n != 1 else ''} for “{self.searching}”"
        if sel:
            size = sum(self.filter[p][C_SIZE] for p in self.selected_paths() if not self.filter[p][C_DIR])
            text += f", {sel} selected" + (f" ({human_size(size)})" if size else "")
        try:
            info = self.current.query_filesystem_info("filesystem::free", None)
            free = info.get_attribute_uint64("filesystem::free")
            if free:
                text += f"    —    {human_size(free)} free"
        except GLib.Error:
            pass
        self.status.set_text(text)

    def toggle_view(self):
        self.set_view("details" if self.view_mode == "icons" else "icons")

    def set_view(self, mode, save=True):
        selected = {r[C_URI] for r in self.selected_rows()} if save else set()
        self.view_mode = mode
        self.stack.set_visible_child_name(self.view_mode)
        self.view_btn.set_image(Gtk.Image.new_from_icon_name(
            "view-grid" if self.view_mode == "details" else "view-list-details", Gtk.IconSize.LARGE_TOOLBAR))
        for i, row in enumerate(self.filter):
            if row[C_URI] in selected:
                path = Gtk.TreePath.new_from_indices([i])
                (self.icons.select_path if mode == "icons" else self.details.get_selection().select_path)(path)
        if save:
            self.set_setting("view", mode)

    # ---- selection
    def selected_paths(self):
        if self.view_mode == "icons":
            return sorted(self.icons.get_selected_items(), key=lambda p: p.get_indices()[0])
        model, paths = self.details.get_selection().get_selected_rows()
        return paths

    def selected_rows(self):
        return [self.filter[p] for p in self.selected_paths()]

    def selected_files(self):
        return [Gio.File.new_for_uri(r[C_URI]) for r in self.selected_rows()]

    # ---- opening
    def open_paths(self, paths):
        rows = [self.filter[p] for p in paths]
        for row in rows:
            gfile = Gio.File.new_for_uri(row[C_URI])
            if row[C_MOUNTABLE]:
                self.open_mountable(gfile)
                continue
            if row[C_DIR]:
                if len(rows) == 1:
                    self.navigate(gfile)
                else:
                    self.new_tab(gfile.get_uri(), switch=False)     # several folders: a tab each
                continue
            self.open_file(gfile, row[C_NAME])

    def open_mountable(self, gfile):
        """A server, share or drive that isn't mounted yet: mount it (asking
        for a password if it needs one), then go in."""
        self.status.set_text("Connecting…")

        def mounted(f, res):
            try:
                target = f.mount_mountable_finish(res)
            except GLib.Error as err:
                if err.matches(Gio.io_error_quark(), Gio.IOErrorEnum.ALREADY_MOUNTED):
                    target = None
                elif err.matches(Gio.io_error_quark(), Gio.IOErrorEnum.FAILED_HANDLED):
                    self.update_status()             # cancelled in the password box
                    return
                else:
                    self.update_status()
                    error_box(self, "Couldn't connect", err.message)
                    return
            if target is None:
                try:
                    info = f.query_info("standard::target-uri", Gio.FileQueryInfoFlags.NONE, None)
                    t = info.get_attribute_string("standard::target-uri")
                    target = Gio.File.new_for_uri(t) if t else f
                except GLib.Error:
                    target = f
            self.navigate(target)
        gfile.mount_mountable(Gio.MountMountFlags.NONE, Gtk.MountOperation(parent=self), None, mounted)

    def open_file(self, gfile, name):
        path = local_path(gfile)
        ct = Gio.content_type_guess(path, None)[0] if path else ""
        if path and (Gio.content_type_is_a(ct, "application/x-msdownload") or ct == "application/x-msi"):
            # Windows programs: Proton-GE (firox-windows), whether or not
            # they're marked runnable; it asks before running a download
            spawn(["firox-windows", path], cwd=os.path.dirname(path))
            return
        if path and (path.lower().endswith(".appimage") or (
                os.access(path, os.X_OK) and Gio.content_type_can_be_executable(
                    Gio.content_type_guess(path, None)[0]) and not path.endswith((".sh", ".py")))):
            if not os.access(path, os.X_OK):
                if not confirm(self, f"Run “{name}”?", "This program isn't marked as one you can run yet. "
                               "Only run programs from people you trust.", "Run"):
                    return
                os.chmod(path, os.stat(path).st_mode | 0o111)
            spawn([path], cwd=os.path.dirname(path))
            return
        try:
            Gio.AppInfo.launch_default_for_uri(gfile.get_uri(), None)
        except GLib.Error as err:
            if path and path.endswith(".desktop"):
                try:
                    Gio.DesktopAppInfo.new_from_filename(path).launch([], None)
                    return
                except (TypeError, GLib.Error):
                    pass
            error_box(self, f"Couldn't open {name}", err.message)

    def desktop_shortcut(self, program):
        """A launcher on the desktop for this program (firox_launcher)."""
        import firox_launcher
        desktop = GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_DESKTOP) or os.path.expanduser("~/Desktop")
        firox_launcher.LauncherDialog(self, desktop, program).run_and_create()

    def open_with(self, gfile):
        dlg = Gtk.AppChooserDialog.new(self, Gtk.DialogFlags.MODAL, gfile)
        if dlg.run() == Gtk.ResponseType.OK and dlg.get_app_info():
            try:
                dlg.get_app_info().launch([gfile], None)
            except GLib.Error as err:
                error_box(self, "Couldn't open it", err.message)
        dlg.destroy()

    # ---- operations
    def dest_path(self, folder=None):
        folder = folder or self.current
        path = local_path(folder)
        if path is None:
            error_box(self, "Can't put files here", "This place doesn't have a folder on disk.")
        return path

    def transfer(self, uris, folder=None, move=False):
        dest = self.dest_path(folder)
        if dest is None or not uris:
            return
        steps = []
        for uri in uris:
            src = local_path(Gio.File.new_for_uri(uri))
            base = urllib.parse.unquote(os.path.basename(urllib.parse.urlparse(uri).path.rstrip("/"))) or "file"
            if src is not None:
                if move and os.path.dirname(os.path.abspath(src)) == os.path.abspath(dest):
                    continue
                if os.path.abspath(dest).startswith(os.path.abspath(src) + os.sep) or \
                        os.path.abspath(dest) == os.path.abspath(src):
                    error_box(self, "Can't put a folder inside itself", src)
                    return
                target = unique_path(dest, os.path.basename(src.rstrip("/")))
                argv = ["mv", "-n", "--", src, target] if move else ["cp", "-a", "--", src, target]
            else:
                target = unique_path(dest, base)
                argv = ["gio", "move" if move else "copy", "--", uri, target]
            steps.append((f"{'Moving' if move else 'Copying'} {os.path.basename(target)}", argv))
        if steps:
            Job(self, "Moving files" if move else "Copying files", steps, self.update_status)

    def copy(self, cut):
        uris = [r[C_URI] for r in self.selected_rows()]
        if uris:
            clipboard_set(uris, cut)
            self.cut_uris = set(uris) if cut else set()

    def paste(self, folder=None):
        action, uris = clipboard_get()
        if uris:
            self.transfer(uris, folder, move=action == "cut")
            if action == "cut":
                subprocess.run(["wl-copy", "--clear"], check=False)

    def trash(self):
        files = self.selected_files()
        if not files:
            return
        if self.current.get_uri_scheme() == "trash":
            self.delete_forever()
            return
        errors = []
        for f in files:
            try:
                f.trash(None)
            except GLib.Error as err:
                errors.append(f"{f.get_basename()}: {err.message}")
        if errors:
            if confirm(self, "Some items can't go to the Recycle Bin",
                       "\n".join(errors[:5]) + "\n\nDelete them permanently instead?", "Delete", True):
                self.delete_files([f for f in files if f.query_exists(None)])

    def delete_forever(self):
        files = self.selected_files()
        if not files:
            return
        what = f"“{files[0].get_basename()}”" if len(files) == 1 else f"these {len(files)} items"
        if confirm(self, f"Delete {what} permanently?", "You can't get them back.", "Delete", True):
            self.delete_files(files)

    def delete_files(self, files):
        steps = []
        for f in files:
            path = local_path(f)
            argv = ["rm", "-rf", "--", path] if path else ["gio", "remove", "-f", "--", f.get_uri()]
            steps.append((f"Deleting {f.get_basename()}", argv))
        Job(self, "Deleting", steps, self.update_status)

    def restore(self):
        for row in self.selected_rows():
            orig = row[C_ORIG]
            if not orig:
                continue
            target = orig if not os.path.lexists(orig) else unique_path(os.path.dirname(orig),
                                                                          os.path.basename(orig))
            try:
                os.makedirs(os.path.dirname(target), exist_ok=True)
                Gio.File.new_for_uri(row[C_URI]).move(Gio.File.new_for_path(target), Gio.FileCopyFlags.NONE,
                                                      None, None, None)
            except (GLib.Error, OSError) as err:
                error_box(self, f"Couldn't put back {row[C_NAME]}", str(getattr(err, "message", err)))

    def empty_trash(self):
        if confirm(self, "Empty the Recycle Bin?", "Everything in it will be deleted permanently.",
                   "Empty Recycle Bin", True):
            Job(self, "Emptying the Recycle Bin", [("Emptying", ["gio", "trash", "--empty"])], self.refresh)

    def rename(self):
        rows = self.selected_rows()
        if len(rows) != 1:
            return
        row = rows[0]
        gfile = Gio.File.new_for_uri(row[C_URI])
        new = ask_text(self, "Rename", "New name:", row[C_NAME], select_stem=not row[C_DIR])
        if not new or new == row[C_NAME]:
            return
        if "/" in new:
            error_box(self, "Couldn't rename", "A name can't contain “/”.")
            return
        try:
            renamed = gfile.set_display_name(new, None)
        except GLib.Error as err:
            error_box(self, "Couldn't rename", err.message)
            return
        # A launcher shows its Name=, not its file name (on the desktop, in
        # menus): keep them the same
        path = renamed.get_path()
        if path and row[C_NAME].endswith(".desktop") and new.endswith(".desktop") and new != ".desktop":
            import firox_launcher
            try:
                firox_launcher.set_launcher_name(path, new[:-len(".desktop")], rename_file=False)
            except OSError:
                pass

    def new_folder(self):
        dest = self.dest_path()
        if dest is None:
            return
        name = ask_text(self, "New Folder", "Name of the new folder:", os.path.basename(
            unique_path(dest, "New Folder")))
        if not name:
            return
        try:
            os.mkdir(os.path.join(dest, name))
        except OSError as err:
            error_box(self, "Couldn't make the folder", str(err))

    def properties(self):
        rows = self.selected_rows()
        if not rows:
            return
        row = rows[0]
        gfile = Gio.File.new_for_uri(row[C_URI])
        dlg = Gtk.Dialog(title=f"{row[C_NAME]} Properties", transient_for=self, modal=True)
        dlg.add_button("Close", Gtk.ResponseType.CLOSE)
        box = dlg.get_content_area()
        box.set_border_width(16)
        box.set_spacing(10)
        head = Gtk.Box(spacing=12)
        head.pack_start(Gtk.Image.new_from_pixbuf(row[C_PIX]), False, False, 0)
        head.pack_start(Gtk.Label(label=row[C_NAME], xalign=0, selectable=True, wrap=True), True, True, 0)
        box.pack_start(head, False, False, 0)
        grid = Gtk.Grid(column_spacing=14, row_spacing=6)
        path = local_path(gfile)
        info_rows = [("Type:", row[C_TYPE]), ("Location:", os.path.dirname(path) if path else
                                                urllib.parse.unquote(gfile.get_parent().get_uri()))]
        if row[C_DIR] and path:
            size_label = Gtk.Label(label="Counting…", xalign=0)

            def count():
                total = files = 0
                for dirpath, _dirs, names in os.walk(path):
                    for n in names:
                        files += 1
                        try:
                            total += os.lstat(os.path.join(dirpath, n)).st_size
                        except OSError:
                            pass
                GLib.idle_add(size_label.set_text, f"{human_size(total)} in {files:,} files")
            threading.Thread(target=count, daemon=True).start()
        else:
            size_label = Gtk.Label(label=f"{human_size(row[C_SIZE])} ({row[C_SIZE]:,} bytes)", xalign=0)
        info_rows.append(("Size:", size_label))
        info_rows.append(("Modified:", row[C_DATE_TEXT]))
        for i, (k, v) in enumerate(info_rows):
            grid.attach(Gtk.Label(label=k, xalign=0), 0, i, 1, 1)
            grid.attach(v if isinstance(v, Gtk.Widget) else Gtk.Label(label=v, xalign=0, selectable=True,
                                                                      wrap=True, max_width_chars=50), 1, i, 1, 1)
        box.pack_start(grid, False, False, 0)
        if path and not row[C_DIR]:
            run = Gtk.CheckButton(label="Allow running this file as a program")
            run.set_active(os.access(path, os.X_OK))

            def toggled(b):
                mode = os.stat(path).st_mode
                os.chmod(path, mode | 0o111 if b.get_active() else mode & ~0o111)
            run.connect("toggled", toggled)
            box.pack_start(run, False, False, 0)
        dlg.show_all()
        dlg.run()
        dlg.destroy()

