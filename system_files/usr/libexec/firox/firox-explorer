class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE
                         | Gio.ApplicationFlags.NON_UNIQUE)

    def do_command_line(self, cmdline):
        global ICONS
        if ICONS is None:
            ICONS = IconCache()
        args = cmdline.get_arguments()[1:]
        find = bool(args) and args[0] == "--find"
        connect = bool(args) and args[0] == "--connect"
        if find or connect:
            args = args[1:]
        target = args[0] if args else HOME
        if target.startswith("file://") or "://" not in target:
            target = os.path.abspath(os.path.expanduser(urllib.parse.unquote(target.replace("file://", ""))))
        win = Explorer(self, target)
        if find:
            win.find_files()
        if connect:
            GLib.idle_add(lambda: win.add_connection() and False)
        return 0


def connect_saved():
    """At login: connect the ones marked "Connect when I log in" (only those
    whose password is remembered: nothing pops up at login)."""
    loop = GLib.MainLoop()
    todo = [c for c in firox_mounts.load() if c.get("auto")]
    pending = {"n": len(todo)}
    if not todo:
        return 0

    def done(conn, err):
        if err:
            print(f"firox-explorer: {conn.get('name')}: {err}", file=sys.stderr)
            subprocess.run(["notify-send", "-a", "Firox Explorer", "-i", "network-offline",
                            f"Couldn't connect to {conn.get('name')}", err[:300]], check=False)
        pending["n"] -= 1
        if pending["n"] <= 0:
            loop.quit()
    for conn in todo:
        if firox_mounts.is_mounted(conn):
            done(conn, None)
            continue
        firox_mounts.mount(conn, lambda *a: None, lambda err, c=conn: done(c, err))
    GLib.timeout_add_seconds(60, loop.quit)
    loop.run()
    return 0


def test_cli(name):
    conn = firox_mounts.find(name)
    if conn is None:
        names = ", ".join(repr(c.get("name") or c["id"]) for c in firox_mounts.load()) or "none"
        print(f"No saved connection called {name!r}. Saved connections: {names}", file=sys.stderr)
        return 2

    def ask(fields):
        if not sys.stdin.isatty():
            return None
        import getpass
        print("Nothing is remembered in the keyring for this connection.")
        return {k: getpass.getpass(f"{label} (not shown, not saved): ") for k, label in fields}
    path = firox_mounts.diagnose(conn, out=lambda t: print(t, flush=True), ask_secret=ask)
    print(f"\nThis report is saved in {path}")
    print("Secrets are replaced by ***, but read it through before you share it.")
    return 0


if __name__ == "__main__":
    if "--connect-saved" in sys.argv[1:]:
        sys.exit(connect_saved())
    if len(sys.argv) >= 3 and sys.argv[1] == "--test":
        sys.exit(test_cli(" ".join(sys.argv[2:])))
    sys.exit(App().run(sys.argv))
