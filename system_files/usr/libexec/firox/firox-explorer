def us_date(stamp):
    """11/12/2026 3:07 PM, the way Windows shows dates in the US."""
    t = time.localtime(stamp)
    return f"{t.tm_mon}/{t.tm_mday}/{t.tm_year} {(t.tm_hour % 12) or 12}:{t.tm_min:02d} {'AM' if t.tm_hour < 12 else 'PM'}"


