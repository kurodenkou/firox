// First-time setup (firox-oobe) runs on the login screen as the greetd
// user and makes the first account with /usr/libexec/firox/oobe-apply.
// The login screen may run that one program without a password; it only
// does anything while setup is waiting (/var/lib/firox/oobe).
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.policykit.exec" &&
        action.lookup("program") == "/usr/libexec/firox/oobe-apply" &&
        subject.user == "greetd") {
        return polkit.Result.YES;
    }
});

// First-time setup's Network step joins Wi-Fi from the login screen (the
// installer hands over to it): the login screen's user may connect, scan
// and save a network for the whole computer.
polkit.addRule(function(action, subject) {
    if (subject.user == "greetd" &&
        (action.id == "org.freedesktop.NetworkManager.network-control" ||
         action.id == "org.freedesktop.NetworkManager.settings.modify.system" ||
         action.id == "org.freedesktop.NetworkManager.wifi.scan" ||
         action.id == "org.freedesktop.NetworkManager.enable-disable-wifi")) {
        return polkit.Result.YES;
    }
});
