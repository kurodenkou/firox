# Firox Linux session autostart (run by labwc at login).
# Per-user overrides: ~/.config/labwc/autostart replaces this file.

# Tell systemd the desktop session has started (firox-session.target): the
# desktop portal, which Flatpak apps use for screen sharing, file pickers and
# light/dark mode, only runs during a graphical session. labwc has already
# passed WAYLAND_DISPLAY etc. to systemd; the import covers nested or test
# sessions. A personal ~/.config/labwc/autostart should keep these lines.
systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_SESSION_DESKTOP 2>/dev/null
systemctl --user start firox-session.target 2>/dev/null

# Classic or Modern look: see `firox-theme` and Settings > Appearance
CFG="${XDG_CONFIG_HOME:-$HOME/.config}"

# keep-running starts the desktop and the taskbar again if they crash, e.g.
# when a monitor switches off or wakes up (restarts are logged in
# ~/.local/state/firox/session.log)
KEEP=/usr/libexec/firox/keep-running
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/firox"
mkdir -p "$STATE"

# Desktop: wallpaper on every monitor, icons (Computer, Recycle Bin, the
# files in ~/Desktop) on the main display: firox-desktop. (It exits with 3
# if the compositor can't show a desktop layer; that's noted in its log.)
# (~/Desktop etc. must exist first)
xdg-user-dirs-update
(
    $KEEP firox-desktop 2>"$STATE/desktop.log"
    [ $? -eq 3 ] && echo "firox-desktop: no layer-shell here, no desktop" >>"$STATE/desktop.log"
) >/dev/null 2>&1 &

# Taskbar: firox-panel (its log: ~/.local/state/firox/panel.log). If you
# set up waybar yourself (~/.config/waybar), that runs instead; waybar is
# also the fallback when firox-panel can't run here (it exits with 3).
if [ -e "$CFG/waybar/config" ] || [ -e "$CFG/waybar/config.jsonc" ] || [ -e "$CFG/waybar/style.css" ]; then
    if [ -e "$CFG/waybar/style.css" ]; then
        $KEEP waybar >/dev/null 2>&1 &
    else
        $KEEP waybar -s "$(firox-theme path waybar.css)" >/dev/null 2>&1 &
    fi
else
    : >"$STATE/panel.log"
    (
        $KEEP firox-panel 2>>"$STATE/panel.log"
        [ $? -eq 3 ] && exec $KEEP waybar -s "$(firox-theme path waybar.css)"
    ) >/dev/null 2>&1 &
fi

# Notification history for the bell in the notification area (start it
# before anything sends a notification)
firox-notifications daemon >/dev/null 2>&1 &

# Notifications ("balloon tips")
if [ -f "$CFG/mako/config" ]; then
    mako >/dev/null 2>&1 &
else
    # (the theme's settings, shown on the main display: firox-displays)
    mako -c "$(firox-displays mako-conf "$(firox-theme path mako.conf)")" >/dev/null 2>&1 &
fi

# Network and Bluetooth: the taskbar's own icons and pop-ups (firox-network,
# firox-bluetooth). The pairing helper answers Bluetooth PIN requests. The
# classic nm-applet and Blueman tray icons are off unless turned on in
# Settings > Startup Programs (Blueman then pairs devices itself).
( sleep 2; firox-startup want network && exec nm-applet --indicator ) >/dev/null 2>&1 &
( sleep 2; firox-startup want bluetooth && exec blueman-applet ) >/dev/null 2>&1 &
( sleep 3; firox-bluetooth daemon ) >/dev/null 2>&1 &

# Password prompts for admin tasks
/usr/libexec/polkit-mate-authentication-agent-1 >/dev/null 2>&1 &

# Monitor layout saved from Settings > Display: kanshi applies it (and
# re-applies on hotplug); firox-displays then double-checks and fixes
# anything kanshi couldn't, logging to ~/.local/state/firox/displays.log
kanshi >/dev/null 2>&1 &
( sleep 3; firox-displays restore ) >/dev/null 2>&1 &

# Clipboard: keep what you copied after the app closes, and remember
# recent items for Super+V (Settings > Clipboard, see `firox-clipboard`)
firox-clipboard start

# Power saving: lock, screen off and sleep timers from Settings >
# Power Options (~/.config/firox/power.conf, see `firox-power`)
firox-power start
# Low-battery warnings (laptops only; exits straight away without a battery)
firox-power battery-watch >/dev/null 2>&1 &

# Backups every hour, and when the backup drive is plugged in (firox-backup)
firox-backup watch >/dev/null 2>&1 &
# Sync between Firox computers, if it's on (firox-sync)
firox-sync daemon >/dev/null 2>&1 &

# Desktop Gadgets (the Sidebar; off in Settings > Taskbar or `firox-gadgets off`)
firox-gadgets start >/dev/null 2>&1 &

# "Firox Linux was updated" once after an update was applied
( sleep 20; firox-updates login ) >/dev/null 2>&1 &

# Security Center: a notification if the firewall, updates or SELinux are
# off (once for each new problem)
( sleep 45; firox-security login ) >/dev/null 2>&1 &

# Your startup programs (Settings > Startup Programs, ~/.config/autostart),
# once the taskbar's notification area is up for their icons
( sleep 4; firox-startup run ) >/dev/null 2>&1 &

# One-time per-user setup (folders, web app runtime, welcome tip)
firox-user-setup >/dev/null 2>&1 &
