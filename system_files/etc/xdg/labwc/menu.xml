<?xml version="1.0" encoding="UTF-8"?>
<openbox_menu>
  <!-- Right-click on an empty desktop (fallback when firox-desktop isn't drawing it) -->
  <menu id="root-menu" label="">
    <item label="Arrange Icons / Refresh">
      <action name="Reconfigure" />
    </item>
    <separator />
    <item label="Command Prompt">
      <action name="Execute" command="firox-terminal" />
    </item>
    <item label="Computer">
      <action name="Execute" command="firox-open computer" />
    </item>
    <separator />
    <item label="Properties">
      <action name="Execute" command="firox-control-panel display" />
    </item>
  </menu>
</openbox_menu>
