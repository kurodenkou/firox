# Firox Linux session environment (labwc reads this before starting).
# Override per-user in ~/.config/labwc/environment.
XDG_CURRENT_DESKTOP=labwc:wlroots
XCURSOR_THEME=Breeze_Light
XCURSOR_SIZE=24
QT_QPA_PLATFORM=wayland;xcb
QT_QPA_PLATFORMTHEME=lxqt
MOZ_ENABLE_WAYLAND=1
# Proton draws games through XWayland. Wine's native Wayland driver
# (PROTON_ENABLE_WAYLAND=1) is not on by default: it still gets the mouse
# wrong in many games (clicks lost, the pointer held in a small area when a
# game confines it). Per game, Steam launch options: PROTON_ENABLE_WAYLAND=1 %command%
GTK_IM_MODULE=simple
_JAVA_AWT_WM_NONREPARENTING=1
